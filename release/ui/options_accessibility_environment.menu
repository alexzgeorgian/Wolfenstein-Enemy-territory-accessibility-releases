#include "ui/menudef.h"
#include "ui/menumacros.h"

// Accessibility - Environment //
//
// What the mod tells you about the world around you: the objectives,
// your surroundings and the openings as you walk, the players near you
// and what is on the ground, which way you face,
// where you are and what kind of place it is, what you can use, the
// command map, and the sounds
// placed in the world for doors, construction sites, demolition
// targets, flags and ladders, landmines, the crosshair, your marker, and
// walking into walls and things. Each row is
// a yes or no.

#define WINDOW_X      16
#define WINDOW_Y      16
#define WINDOW_WIDTH  608
#define WINDOW_HEIGHT 448
#define GROUP_NAME    "grpOptionsAccessibilityEnvironment"

menuDef {
	name        "options_accessibility_environment"
	visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED

	onESC {
		close options_accessibility_environment ;
		open  options_accessibility
	}

// Window //
	WINDOW(_("ENVIRONMENT"), 150)

// What you are told //
#define SPEAKS_Y SUBWINDOW_OPTION_Y_START
#define SPEAKS_H SUBWINDOW_OPTION_COMPUTE_H(20)
	SUBWINDOW(SUBWINDOW_OPTION_HEADER_X1_START, SPEAKS_Y, SUBWINDOW_OPTION_HEADER_WIDTH_L, SPEAKS_H, _("WHAT YOU ARE TOLD"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 1), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Objectives:"), .2, 8, "eta_objectiveCallouts", _("When an objective is finished or failed"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 2), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Surroundings:"), .2, 8, "eta_environmentCallouts", _("The ground underfoot, walls and doors ahead, stairs, drops and water"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 3), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Openings as you walk:"), .2, 8, "eta_openingCallouts", _("A side street or a corner opening to the north, east, south or west, and the wall coming back"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 4), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Players near you:"), .2, 8, "eta_playerCallouts", _("An enemy in sight, a teammate close by or wounded - ahead, left, right or behind, how far, and coming closer or moving away"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 5), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Things on the ground:"), .2, 8, "eta_groundCallouts", _("A weapon, ammo or health lying close by - and for a covert op, an enemy body with its uniform"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 6), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Furniture and things in a room:"), .2, 8, "eta_furnitureCallouts", _("A chair, a bed, a bookcase, a crate, a window from inside, said as you come within a metre and a half"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 7), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Direction:"), .2, 8, "eta_facingCallouts", _("Which way you are facing, and what you are looking at up or down"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 8), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Location:"), .2, 8, "eta_locationCallouts", _("Where you are, using the map's own names for its places"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 9), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Kind of place:"), .2, 8, "eta_placeCallouts", _("A street and which way it runs, an alley, a square, a building, a balcony, a roof or a ledge, as you come into it"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 10), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("What you can use:"), .2, 8, "eta_interactionCallouts", _("Named when the game shows the icon for it - pliers, dynamite, a door"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 11), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Command map survey:"), .2, 8, "eta_mapCallouts", _("Open the map and walk the grid with the keypad arrows"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 12), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Map key opens and closes:"), .2, 8, "eta_mapToggle", _("Yes: one press opens the command map and the next closes it. No: it shows while held"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 13), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Door sounds:"), .2, 8, "eta_doorCues", _("A creak placed on every door within about ten metres"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 14), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Construction, demolition, flag and tank sounds:"), .2, 8, "eta_siteCues", _("Hammer taps from a site your team can build, a fuse hiss from an enemy objective you can blow up, a bell from a flag you can capture, and an engine from the tank, within about twenty-five metres"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 15), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Ladder sounds:"), .2, 8, "eta_ladderCues", _("Knocks climbing wooden rungs from the nearest ladders within about fifteen metres - walk to it and F climbs"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 16), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Pickup sounds:"), .2, 8, "eta_pickupCues", _("A sound from each health pack, ammo pack and weapon within about ten metres and in sight, so you can walk to it"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 17), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Landmine warnings:"), .2, 8, "eta_mineCues", _("A landmine the game shows you - spotted, or one of your team's - said within about ten metres, with fast beeps from it within six"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 18), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Crosshair sounds:"), .2, 8, "eta_crosshairCues", _("A tick while your crosshair is on somebody - bright for an enemy"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 19), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Marker sound:"), .2, 8, "eta_markerCues", _("A ping from the way to your marker, to walk toward by ear"))
	YESNO(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(SPEAKS_Y, 20), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Bump sounds:"), .2, 8, "eta_bumpCues", _("A dull thud when you walk into a wall, a hollow knock when you walk into a thing - a door, a crate, a vehicle"))

// Buttons //
	BUTTON(SUBWINDOW_OPTION_HEADER_X1_START, WINDOW_HEIGHT - 22, .33 * (WINDOW_WIDTH - 24), 18, _("MSGID_MENU_BACK"), .3, 14, close options_accessibility_environment ; open options_accessibility)
}
