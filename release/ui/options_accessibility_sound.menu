#include "ui/menudef.h"
#include "ui/menumacros.h"

// Accessibility - Sound //
//
// How loud each of the mod's own sounds is, the game's announcer, and
// players' voice chats.
// The tester asked for these on a page of their own, apart from SPEECH,
// which is the screen reader's. Each runs from 0, silent, to 100, the
// level it always had; turning a sound off altogether is on ENVIRONMENT.

#define WINDOW_X      16
#define WINDOW_Y      16
#define WINDOW_WIDTH  608
#define WINDOW_HEIGHT 448
#define GROUP_NAME    "grpOptionsAccessibilitySound"

menuDef {
	name        "options_accessibility_sound"
	visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED

	onESC {
		close options_accessibility_sound ;
		open  options_accessibility
	}

// Window //
	WINDOW(_("SOUND"), 150)

// Volumes //
#define VOLUME_Y SUBWINDOW_OPTION_Y_START
#define VOLUME_H SUBWINDOW_OPTION_COMPUTE_H(10)
	SUBWINDOW(SUBWINDOW_OPTION_HEADER_X1_START, VOLUME_Y, SUBWINDOW_OPTION_HEADER_WIDTH_L, VOLUME_H, _("VOLUMES"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 1), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Marker volume:"), .2, 8, "eta_markerVolume" 100 0 100, _("The ping from the way to your marker"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 2), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Objective sounds volume:"), .2, 8, "eta_siteVolume" 100 0 100, _("The hammer taps, fuse hiss, bell and engine from construction sites, demolition targets, flags and the tank"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 3), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Door sounds volume:"), .2, 8, "eta_doorVolume" 100 0 100, _("The creak on doors"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 4), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Ladder sounds volume:"), .2, 8, "eta_ladderVolume" 100 0 100, _("The knocks from ladders"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 5), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Crosshair sounds volume:"), .2, 8, "eta_crosshairVolume" 100 0 100, _("The tick while your crosshair is on somebody"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 6), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Alert sounds volume:"), .2, 8, "eta_cueVolume" 100 0 100, _("Low health, something to use, where damage came from, the objective's direction, and the landmine beep"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 7), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Pickup sounds volume:"), .2, 8, "eta_pickupVolume" 100 0 100, _("The sounds from health packs, ammo packs and weapons lying close by"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 8), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Announcer volume:"), .2, 8, "eta_announcerVolume" 100 0 100, _("The map's recorded voice telling you what happened to an objective. 100 is the game's own level"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 9), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Bump sounds volume:"), .2, 8, "eta_bumpVolume" 100 0 100, _("The thud of walking into a wall, and the knock of walking into a thing"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOLUME_Y, 10), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Voice chat volume:"), .2, 8, "eta_voiceVolume" 100 0 100, _("Players and bots calling out - Medic!, Need ammo and the rest. Their words are still read in the chat. 100 is the game's own level"))

// Buttons //
	BUTTON(SUBWINDOW_OPTION_HEADER_X1_START, WINDOW_HEIGHT - 22, .33 * (WINDOW_WIDTH - 24), 18, _("MSGID_MENU_BACK"), .3, 14, close options_accessibility_sound ; open options_accessibility)
}
