#include "ui/menudef.h"
#include "ui/menumacros.h"

// Accessibility - Speech //
//
// How the narrator's voice sounds, and how the music makes room for it.
// Rate, pitch and volume are SAPI 5 only: NVDA speaks with the settings
// its own user chose, and a game overriding them would be a bug. How loud
// the sounds are is on the SOUND page.

#define WINDOW_X      16
#define WINDOW_Y      16
#define WINDOW_WIDTH  608
#define WINDOW_HEIGHT 448
#define GROUP_NAME    "grpOptionsAccessibilitySpeech"

menuDef {
	name        "options_accessibility_speech"
	visible     0
	fullscreen  0
	rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style WINDOW_STYLE_FILLED

	onESC {
		close options_accessibility_speech ;
		open  options_accessibility
	}

// Window //
	WINDOW(_("SPEECH"), 150)

// The voice //
#define VOICE_Y SUBWINDOW_OPTION_Y_START
#define VOICE_H SUBWINDOW_OPTION_COMPUTE_H(4)
	SUBWINDOW(SUBWINDOW_OPTION_HEADER_X1_START, VOICE_Y, SUBWINDOW_OPTION_HEADER_WIDTH_L, VOICE_H, _("THE VOICE"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOICE_Y, 1), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Music while talking:"), .2, 8, "eta_musicDuck" 1 0 1, _("How far the music steps back while the narrator is speaking. 1 leaves it alone"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOICE_Y, 2), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Speech rate:"), .2, 8, "eta_speechRate" 0 -10 10, _("SAPI 5 only. NVDA speaks at the rate you set in NVDA"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOICE_Y, 3), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Speech pitch:"), .2, 8, "eta_speechPitch" 0 -10 10, _("SAPI 5 only. NVDA speaks at the pitch you set in NVDA"))
	SLIDER(SUBWINDOW_OPTION_X1_START, SUBWINDOW_OPTION_COMPUTE_Y(VOICE_Y, 4), SUBWINDOW_OPTION_WIDTH_L, SUBWINDOW_OPTION_HEIGHT, _("Speech volume:"), .2, 8, "eta_speechVolume" 100 0 100, _("SAPI 5 only. NVDA speaks at the volume you set in NVDA"))

// Buttons //
	BUTTON(SUBWINDOW_OPTION_HEADER_X1_START, WINDOW_HEIGHT - 22, .33 * (WINDOW_WIDTH - 24), 18, _("MSGID_MENU_BACK"), .3, 14, close options_accessibility_speech ; open options_accessibility)
}
