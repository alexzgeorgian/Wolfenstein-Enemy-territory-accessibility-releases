+/*
+================
+BG_OfferTesla
+
+The Tesla gun is only on servers built with the accessibility mode; a
+stock No Quarter server does not know it. Soldiers carry it last, after
+the Venom: the client offers it only where the server says it has it.
+================
+*/
+void BG_OfferTesla( qboolean offered ) {
+	bg_playerclass_t	*soldiers[2] = { &bg_allies_playerclasses[PC_SOLDIER], &bg_axis_playerclasses[PC_SOLDIER] };
+	int					i, j;
+
+	for( i = 0; i < 2; i++ ) {
+		for( j = 0; j < MAX_WEAPS_PER_CLASS - 1; j++ ) {
+			if( soldiers[i]->classWeapons[j] == WP_VENOM ) {
+				soldiers[i]->classWeapons[j+1] = offered ? WP_TESLA : WP_NONE;
+				break;
+			}
+		}
+	}
+}
