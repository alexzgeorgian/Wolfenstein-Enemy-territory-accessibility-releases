 	VectorMA (ent->client->ps.velocity, -96.0f, forward, ent->client->ps.velocity);
 }
 
+/*
+===============
+Weapon_TeslaFire
+
+The Tesla gun, from RTCW: an arc of lightning that reaches the nearest
+enemies in front of the gun, up to TESLA_MAX_TARGETS of them, each in
+sight and within TESLA_RANGE. It fires every nextShotTime while held.
+===============
+*/
+#define TESLA_RANGE			600
+#define TESLA_MAX_TARGETS	3
+#define TESLA_CONE			0.85f	// cosine of the half angle, about 32 degrees
+
+static void Weapon_TeslaFire( gentity_t *ent ) {
+	int			entityList[MAX_GENTITIES];
+	gentity_t	*targets[TESLA_MAX_TARGETS];
+	float		distances[TESLA_MAX_TARGETS];
+	int			numListed, numTargets = 0, i, j;
+	vec3_t		forward, mins, maxs, aim, dir;
+	trace_t		tr;
+
+	AngleVectors( ent->client->ps.viewangles, forward, NULL, NULL );
+
+	for( i = 0; i < 3; i++ ) {
+		mins[i] = muzzleTrace[i] - TESLA_RANGE;
+		maxs[i] = muzzleTrace[i] + TESLA_RANGE;
+	}
+	numListed = trap_EntitiesInBox( mins, maxs, entityList, MAX_GENTITIES );
+
+	for( i = 0; i < numListed; i++ ) {
+		gentity_t	*target = &g_entities[entityList[i]];
+		float		dist;
+
+		if( target == ent || !target->client || !target->takedamage || target->health <= 0 ) {
+			continue;
+		}
+		if( target->client->sess.sessionTeam != TEAM_AXIS && target->client->sess.sessionTeam != TEAM_ALLIES ) {
+			continue;
+		}
+		if( OnSameTeam( ent, target ) ) {
+			continue;
+		}
+
+		VectorCopy( target->r.currentOrigin, aim );
+		aim[2] += target->client->ps.viewheight * 0.5f;
+		VectorSubtract( aim, muzzleTrace, dir );
+		dist = VectorNormalize( dir );
+		if( dist > TESLA_RANGE || DotProduct( dir, forward ) < TESLA_CONE ) {
+			continue;
+		}
+
+		trap_Trace( &tr, muzzleTrace, NULL, NULL, aim, ent->s.number, MASK_SHOT );
+		if( tr.entityNum != target->s.number ) {
+			continue;
+		}
+
+		// keep the nearest ones
+		for( j = numTargets; j > 0 && distances[j-1] > dist; j-- ) {
+			if( j < TESLA_MAX_TARGETS ) {
+				targets[j] = targets[j-1];
+				distances[j] = distances[j-1];
+			}
+		}
+		if( j < TESLA_MAX_TARGETS ) {
+			targets[j] = target;
+			distances[j] = dist;
+			if( numTargets < TESLA_MAX_TARGETS ) {
+				numTargets++;
+			}
+		}
+	}
+
+	for( i = 0; i < numTargets; i++ ) {
+		VectorSubtract( targets[i]->r.currentOrigin, muzzleTrace, dir );
+		VectorNormalize( dir );
+		G_Damage( targets[i], ent, ent, dir, targets[i]->r.currentOrigin, BG_Weapons[WP_TESLA].damage, DAMAGE_NO_KNOCKBACK, MOD_TESLA );
+#ifndef DEBUG_STATS
+		if( g_gamestate.integer == GS_PLAYING )
+#endif
+			ent->client->sess.aWeaponStats[WS_TESLA].hits++;
+	}
+}
