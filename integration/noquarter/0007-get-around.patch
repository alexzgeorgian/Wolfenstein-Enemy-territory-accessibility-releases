+	CG_AccessibilityMapStep(ETA_MAP_STEP_WEST);
+}
+
+void CG_AccessibilityMapUp_f(void)
+{
+	ETA_HudNarrator_HoldPassive(cg.time);
+	CG_AccessibilityMapLayer(1);
+}
+
