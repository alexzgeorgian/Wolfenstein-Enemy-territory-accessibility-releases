+/**
+ * @brief How many rooms the map has in a square of the command map, for
+ * the survey.
+ */
+static int ETA_RoomsInCell(int column, int row)
+{
+	vec2_t start, step;
+	int    columns, rows;
+
+	if (!eta_rooms.built || !ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return 0;
+	}
+
+	return ETA_RoomList_CountIn(&eta_rooms.list,
+	                            start[0] + (float)column * step[0], start[1] - (float)(row + 1) * step[1],
+	                            start[0] + (float)(column + 1) * step[0], start[1] - (float)row * step[1]);
+}
+
+/**
+ * @brief Whether the way up to the sniper spot under the marker was found.
+ *
+ * A roof can look out a long way and have no way onto it at all: on
+ * Oasis about a third of the raised places that see far are the tops of
+ * walls and of houses nobody can climb. Looking for the way to every one
+ * of them is minutes of searching, so it is looked for only for the spot
+ * chosen - the search the marker makes anyway. When that search gives
+ * up right underneath the spot, there is no way up from here: the player
+ * is told, the marker taken away, and the spot left off the list.
+ */
+#define ETA_SPOT_UNDER_UNITS 320.0f   /* given up this close to it, flat: underneath */
+
+/* Whether the search for the way to a spot or room under the marker
+   gave up right underneath it: then there is no way up from here. */
+static qboolean ETA_WayStopsUnder(const float origin[3])
+{
+	float end[3];
+	int   points = ETA_PathFinder_PointCount();
+
+	if (ETA_PathFinder_State() != ETA_PATH_PARTIAL || points <= 0)
+	{
+		return qfalse;
+	}
+
+	ETA_PathFinder_Point(points - 1, end);
+	return (qboolean)((end[0] - origin[0]) * (end[0] - origin[0])
+	                  + (end[1] - origin[1]) * (end[1] - origin[1]) < ETA_SPOT_UNDER_UNITS * ETA_SPOT_UNDER_UNITS
+	                  && origin[2] - end[2] > 64.0f);
+}
+
+static void ETA_SpotJudgeWay(void)
+{
+	ETA_PathState state;
+
+	if (!eta_marker.active || !eta_route.jumps)
+	{
+		return;
+	}
+	state = ETA_PathFinder_State();
+
+	if (!eta_spots.judged && eta_spots.marked >= 0 && eta_spots.marked < eta_spots.list.count)
+	{
+		ETA_Spot *spot = &eta_spots.list.spots[eta_spots.marked];
+
+		if (!VectorCompare(spot->origin, eta_marker.origin))
+		{
+			eta_spots.marked = -1;   /* the marker was put somewhere else */
+		}
+		else if (state == ETA_PATH_FOUND || state == ETA_PATH_PARTIAL)
+		{
+			eta_spots.judged = qtrue;
+			if (ETA_WayStopsUnder(spot->origin))
+			{
+				spot->unreachable   = 1;
+				eta_marker.active   = qfalse;
+				eta_spots.lastPress = 0;
+				ETA_RouteForget();
+
+				ETA_Speech_BeginReport();
+				ETA_Speech_Say("No way up to that sniper spot from here. It is left off the list; ask for the next");
+				ETA_Speech_EndReport();
+				return;
+			}
+		}
+	}
+
+	if (!eta_rooms.judged && eta_rooms.marked >= 0 && eta_rooms.marked < eta_rooms.list.count)
+	{
+		ETA_Room *room = &eta_rooms.list.rooms[eta_rooms.marked];
+
+		if (!VectorCompare(room->origin, eta_marker.origin))
+		{
+			eta_rooms.marked = -1;
+		}
+		else if (state == ETA_PATH_FOUND || state == ETA_PATH_PARTIAL)
+		{
+			eta_rooms.judged = qtrue;
+			if (ETA_WayStopsUnder(room->origin))
+			{
+				room->unreachable   = 1;
+				eta_marker.active   = qfalse;
+				eta_rooms.lastPress = 0;
+				ETA_RouteForget();
+
+				ETA_Speech_BeginReport();
+				ETA_Speech_Say("No way into that room from here. It is left off the list; ask for the next");
+				ETA_Speech_EndReport();
+			}
+		}
+	}
+}
