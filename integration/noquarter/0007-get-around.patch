+
+/**
+ * @brief Turning with the keys the way the mouse turns.
+ *
+ * A tester put it exactly: with the mouse, turning to the west says
+ * "west" at once; with the keys it took three or four taps before
+ * anything was said. That is the engine's own key speed and nothing
+ * else. A turn key moves the view at cl_yawspeed, 140 degrees a second,
+ * so a quick tap moves it about fifteen degrees - a third of a compass
+ * point - and nothing has changed that is worth a word.
+ *
+ * So a tap now finishes the turn itself: it carries on to the next of
+ * the eight compass points, quickly, stops on it, and says it. Two taps
+ * turn a quarter. Holding the key is untouched - it turns smoothly for
+ * as long as it is held and stops where it is let go, which aiming at
+ * somebody needs - and while it is held each point is named as it is
+ * crossed rather than after the view has settled there.
+ *
+ * Nothing here can write the view angles: that is the client's, and
+ * this is the cgame. What it can do is what a player can - press the
+ * engine's own +left and +right, and the walk key that makes them turn
+ * faster by cl_anglespeedkey - and let go at the right moment. They are
+ * pressed under key numbers no keyboard has, so a player's own keys on
+ * the same buttons are never released by this. cl_anglespeedkey is the
+ * one setting touched, and only while a step runs: it is not saved to
+ * the player's config, and it is put back as soon as the step ends, on
+ * a map change and on shutdown.
+ */
+#define ETA_TURN_KEY_LEFT   "998"
+#define ETA_TURN_KEY_RIGHT  "999"
+#define ETA_TURN_KEY_SPEED  "997"
+
+/* Shorter than this between press and release is a tap. A tap at 140
+   degrees a second covers about 35 degrees in this time, under a
+   compass point, so a tap can never finish past the point it meant. */
+#define ETA_TURN_TAP_MS 250
+
+/* How far past the heading a tap started from the next point must be.
+   Facing 40 degrees short of a point, a tap goes there; facing five
+   degrees short, it goes to the one after - five degrees is already
+   "there" to the ear, and a tap that said the point you were on would
+   sound like a tap that did nothing. */
+#define ETA_TURN_STEP_MARGIN 10.0f
+
+/* The step's speed: cl_yawspeed times this while the walk key is held
+   down by the step. 140 x 5 is 700 degrees a second, so a compass point
+   takes about 65 ms - the length of a flick of the mouse. */
+#define ETA_TURN_FAST_SCALE "5"
+#define ETA_TURN_FAST_FACTOR 5.0f
+
+/* The last few degrees go at the ordinary speed, so the view stops on the
+   point rather than a few degrees past it. */
+#define ETA_TURN_SLOW_DEGREES 12.0f
+
+/* However long a step has been running, it stops here - a view that has
+   not reached its point in this time is not going to. */
+#define ETA_TURN_STEP_LIMIT_MS 1500
+
+typedef struct
+{
+	int      held;          /* -1 left, 1 right, 0 none: a turn key is down */
+	int      pressedAt;
+	float    startYaw;
+	int      passthrough;   /* the setting is off: a plain +left or +right */
+	int      step;          /* -1 left, 1 right, 0 none: a step is running */
+	int      stepStarted;
+	float    target;        /* the yaw it stops at */
+	qboolean fast;
+	char     savedScale[32];
+} eta_turn_t;
+
+static eta_turn_t eta_turn;
+
+static void ETA_TurnKey(int direction, qboolean down)
+{
+	trap_SendConsoleCommand(va("%s%s %s\n", down ? "+" : "-",
+	                           direction < 0 ? "left" : "right",
+	                           direction < 0 ? ETA_TURN_KEY_LEFT : ETA_TURN_KEY_RIGHT));
+}
+
+static void ETA_TurnBoost(qboolean on)
+{
+	if (on && !eta_turn.fast)
+	{
+		trap_Cvar_VariableStringBuffer("cl_anglespeedkey", eta_turn.savedScale,
+		                               sizeof(eta_turn.savedScale));
+		trap_Cvar_Set("cl_anglespeedkey", ETA_TURN_FAST_SCALE);
+		trap_SendConsoleCommand("+speed " ETA_TURN_KEY_SPEED "\n");
+		eta_turn.fast = qtrue;
+	}
+	else if (!on && eta_turn.fast)
+	{
+		trap_SendConsoleCommand("-speed " ETA_TURN_KEY_SPEED "\n");
+		trap_Cvar_Set("cl_anglespeedkey", eta_turn.savedScale[0] ? eta_turn.savedScale : "1.5");
+		eta_turn.fast = qfalse;
+	}
+}
+
+/**
+ * @brief The next of the eight compass points in the direction of turn.
+ *
+ * The points sit at every 45 degrees of yaw. Turning right lowers the
+ * yaw - the engine's own convention, in CL_AdjustAngles - so right goes
+ * down to the next multiple of 45 and left goes up.
+ */
+static float ETA_TurnNextPoint(float yaw, int direction)
+{
+	if (direction > 0)
+	{
+		return 45.0f * floorf((yaw - ETA_TURN_STEP_MARGIN) / 45.0f);
+	}
+
+	return 45.0f * ceilf((yaw + ETA_TURN_STEP_MARGIN) / 45.0f);
+}
+
+/**
+ * @brief Degrees still to turn, positive until the point is reached.
+ */
+static float ETA_TurnRemaining(void)
+{
+	float yaw = cg.predictedPlayerState.viewangles[YAW];
+
+	return eta_turn.step > 0 ? AngleSubtract(yaw, eta_turn.target)
+	                         : AngleSubtract(eta_turn.target, yaw);
+}
+
+static void ETA_TurnStopStep(qboolean arrived)
+{
+	ETA_TurnKey(eta_turn.step, qfalse);
+	ETA_TurnBoost(qfalse);
+	eta_turn.step = 0;
+	ETA_HudNarrator_SetFacingKeyTurn(0);
+
+	if (arrived)
+	{
+		ETA_Facing facing = ETA_HudNarrator_FacingFromYaw(eta_turn.target);
+
+		/* Said here, at once, rather than left to the compass: waiting
+		   for it to settle is exactly the delay the tap exists to
+		   remove. Marked held so the compass does not say it again. */
+		ETA_HudNarrator_SetFacingHeld(facing);
+
+		if (eta_facingCallouts.integer)
+		{
+			ETA_Speech_BeginReport();
+			ETA_HudNarrator_SpeakFacing(facing);
+			ETA_Speech_EndReport();
+		}
+	}
+}
+
+/**
+ * @brief Aiming with a key: at the nearest thing to use, and at an enemy.
+ *
+ * A tester asked for both - a quick way to turn to the thing in front of
+ * them they can use, and a lock that keeps the sights on an enemy - after
+ * a match in which they barely brought one enemy down. The view is turned
+ * the only way this module can turn it: by holding the engine's own turn
+ * and look keys, fast while far off and at the ordinary speed for the
+ * last few degrees, and letting go on the target - the tap turn's way.
+ *
+ *   - The use key, F: see CG_AccessibilityActivateDown_f. It once had a
+ *     key of its own beside it, DEL, for turning to things further off;
+ *     the tester asked for one key, and F now does both.
+ *   - "Lock on to an enemy", held: the nearest enemy in sight is said and
+ *     followed for as long as the key is down. Lose them and the next one
+ *     in sight is taken; when there is none, "Lock lost". It runs only
+ *     where aim assistance is fair - see CG_AccessibilityAimAssistAllowed.
+ *   - The lock by itself (eta_autoLock): the tester found holding a key
+ *     too slow - by the time it was down the enemy had the first shot. So
+ *     where the lock may run at all, an enemy coming into sight is locked
+ *     on to without a key, silently - the callout has already said where
+ *     they are, and the crosshair tick says the sights are on them. A turn
+ *     key, a snap, the map or a build being counted out stand it down, and
+ *     a turn by hand keeps it off for ETA_AIM_MANUAL_MS.
+ *   - Things to use are turned to only when F is pressed. They were once
+ *     turned to by themselves, on stopping beside one; in matches that
+ *     swung the view away from where the tester was looking, and they
+ *     asked for it gone - F is enough.
+ *
+ * Pitch moves too: the keys look up and down as well as turn. The two
+ * key numbers for looking are the turn keys' neighbours, so the player's
+ * own arrow keys on the same buttons are never let go by this.
+ */
+#define ETA_AIM_KEY_UP      "996"
+#define ETA_AIM_KEY_DOWN    "995"
+#define ETA_AIM_SNAP_MS     1500
+#define ETA_AIM_CYCLE_MS    4000
+#define ETA_AIM_LOST_MS     400
+#define ETA_AIM_MAX_TARGETS 16
+#define ETA_AIM_MANUAL_MS   2000
+#define ETA_AIM_AUTO_METERS 40.0f
+#define ETA_USE_KEY         "994"
+#define ETA_USE_REACH_METERS 2.5f
+/* The game's use reaches CH_ACTIVATE_DIST from the eyes, and a thing on
+   the floor is far below them: a weapon two and a half metres off along
+   the ground is out of its reach, and F pressed at it did nothing. So a
+   thing on the ground is in reach by the eyes, a little inside the
+   game's own reach. */
+#define ETA_USE_EYE_REACH    88.0f
+#define ETA_UNIFORM_HOLD_MS  4000
+
+typedef enum
+{
+	ETA_AIM_NONE,
+	ETA_AIM_SNAP,
+	ETA_AIM_LOCK,
+	ETA_AIM_FOLLOW   /* kept on a chosen thing while the player walks to it */
+} eta_aimMode_t;
+
+typedef struct
+{
+	eta_aimMode_t mode;
+	int           entityNum;    /* -1: none yet, or a fixed point */
+	vec3_t        point;
+	int           started;
+	int           yaw;          /* the turn key held: -1 left, 1 right */
+	int           pitch;        /* the look key held: -1 up, 1 down */
+	int           lostSince;
+	qboolean      saidLost;
+	int           cycleIndex;
+	int           cycleAt;
+	qboolean      automatic;    /* the lock or the snap took this by itself */
+	int           manualUntil;  /* no lock by itself before this */
+	int           nextSearch;
+	float         lift;         /* raised this much over the point, to clear what lies in the way */
+	vec3_t        itemAim;      /* where on a thing on the ground, from its origin */
+	int           itemTry;      /* the last of ETA_UseItemAims tried, -1 none */
+	etaAimTarget_t follow;      /* the chosen thing being walked to */
+	qboolean      saidReach;
+	int           refreshAt;
+} eta_aim_t;
+
+static eta_aim_t eta_aim;
+
+/* The use key, pressed on the player's behalf. */
+static struct
+{
+	qboolean pressed;   /* +activate is down under ETA_USE_KEY */
+	qboolean pending;   /* use it on arriving */
+	qboolean held;      /* the player's key is still down */
+	int      releaseAt;
+	qboolean uniform;   /* what is pressed at on arrival is an enemy body */
+	int      body;      /* the body whose uniform is being taken */
+	int      bodyUntil; /* held on it until then: 0, not taking one */
+	qboolean disguised; /* in disguise already when it began */
+} eta_use;
+
+static void ETA_UseKey(qboolean down)
+{
+	if (down == eta_use.pressed)
+	{
+		return;
+	}
+
+	trap_SendConsoleCommand(va("%sactivate %s\n", down ? "+" : "-", ETA_USE_KEY));
+	eta_use.pressed   = down;
+	eta_use.releaseAt = 0;
+	if (!down)
+	{
+		eta_use.bodyUntil = 0;
+	}
+}
+
+/**
+ * @brief Taking an enemy's uniform: use held on the body until it is on.
+ *
+ * The game takes a uniform only for use held on the body for two and a
+ * half seconds; F pressed at it and let go a moment later, so a blind
+ * covert op never got one. So on arriving at a body F holds use for the
+ * player, until the uniform is taken, the body is gone, or
+ * ETA_UNIFORM_HOLD_MS have passed - and says which.
+ */
+static void ETA_UniformStart(int body)
+{
+	ETA_UseKey(qtrue);
+	eta_use.releaseAt = 0;
+	eta_use.body      = body;
+	eta_use.bodyUntil = cg.time + ETA_UNIFORM_HOLD_MS;
+	eta_use.disguised = (qboolean)(cg.predictedPlayerState.powerups[PW_OPS_DISGUISED] != 0);
+	ETA_Speech_Say("Taking the uniform");
+}
+
+static void ETA_UniformEnd(const char *text)
+{
+	ETA_UseKey(qfalse);
+	eta_use.bodyUntil = 0;
+	ETA_Speech_Say(text);
+}
+
+static void ETA_UniformFrame(void)
+{
+	const centity_t *cent;
+
+	if (!eta_use.bodyUntil)
+	{
+		return;
+	}
+
+	cent = (eta_use.body >= 0 && eta_use.body < MAX_GENTITIES) ? &cg_entities[eta_use.body] : NULL;
+
+	/* Taken: the body's uniform is marked gone - or, with two bodies
+	   close together, the player is in disguise who was not. */
+	if ((cent && cent->currentValid && cent->currentState.eType == ET_CORPSE && cent->currentState.time2 == 1)
+	    || (!eta_use.disguised && cg.predictedPlayerState.powerups[PW_OPS_DISGUISED]))
+	{
+		ETA_UniformEnd("Uniform taken, you are in disguise");
+		return;
+	}
+
+	/* The player down themselves: nothing to say about the uniform. */
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_UseKey(qfalse);
+		eta_use.bodyUntil = 0;
+		return;
+	}
+
+	if (!cent || !cent->currentValid || cent->currentState.eType != ET_CORPSE)
+	{
+		ETA_UniformEnd("The body is gone");
+		return;
+	}
+
+	if (cg.time >= eta_use.bodyUntil || eta_use.bodyUntil - cg.time > ETA_UNIFORM_HOLD_MS)
+	{
+		ETA_UniformEnd("No uniform taken. Walk right up to the body and press F again");
+	}
+}
+
+static void ETA_AimKeys(int yaw, int pitch)
+{
+	if (yaw != eta_aim.yaw)
+	{
+		if (eta_aim.yaw)
+		{
+			ETA_TurnKey(eta_aim.yaw, qfalse);
+		}
+		if (yaw)
+		{
+			ETA_TurnKey(yaw, qtrue);
+		}
+		eta_aim.yaw = yaw;
+	}
+
+	if (pitch != eta_aim.pitch)
+	{
+		if (eta_aim.pitch)
+		{
+			trap_SendConsoleCommand(va("-%s %s\n", eta_aim.pitch < 0 ? "lookup" : "lookdown",
+			                           eta_aim.pitch < 0 ? ETA_AIM_KEY_UP : ETA_AIM_KEY_DOWN));
+		}
+		if (pitch)
+		{
+			trap_SendConsoleCommand(va("+%s %s\n", pitch < 0 ? "lookup" : "lookdown",
+			                           pitch < 0 ? ETA_AIM_KEY_UP : ETA_AIM_KEY_DOWN));
+		}
+		eta_aim.pitch = pitch;
+	}
+}
+
+static void ETA_AimStop(void)
+{
+	ETA_AimKeys(0, 0);
+	ETA_TurnBoost(qfalse);
+	eta_aim.mode      = ETA_AIM_NONE;
+	eta_aim.automatic = qfalse;
+	eta_use.pending   = qfalse;
+}
+
+/**
+ * @brief One frame of steering toward a point. qtrue once on it.
+ *
+ * Turning right lowers the yaw and looking down raises the pitch - the
+ * engine's own sense, in CL_AdjustAngles - so a target at a higher yaw
+ * is to the left, and one at a higher pitch is below.
+ */
+static qboolean ETA_AimSteerAngles(const vec3_t wanted, float tolerance)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	float               yawError, pitchError, worst, perFrame, deadzone;
+	int                 yaw = 0, pitch = 0;
+
+	yawError   = AngleSubtract(wanted[YAW], ps->viewangles[YAW]);
+	pitchError = AngleSubtract(wanted[PITCH], ps->viewangles[PITCH]);
+	worst      = MAX(fabs(yawError), fabs(pitchError));
+
+	ETA_TurnBoost((qboolean)(worst > ETA_TURN_SLOW_DEGREES));
+
+	/* Let go within half a frame's turn of the point, as the tap does. */
+	perFrame = 0.14f * (float)cg.frametime * (eta_turn.fast ? ETA_TURN_FAST_FACTOR : 1.0f);
+	deadzone = MAX(tolerance, perFrame * 0.5f);
+
+	if (fabs(yawError) > deadzone)
+	{
+		yaw = yawError > 0.0f ? -1 : 1;
+	}
+	if (fabs(pitchError) > deadzone)
+	{
+		pitch = pitchError > 0.0f ? 1 : -1;
+	}
+
+	ETA_AimKeys(yaw, pitch);
+
+	return (qboolean)(!yaw && !pitch);
+}
+
+static qboolean ETA_AimSteer(const vec3_t point, float tolerance)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              eye, delta, wanted;
+
+	VectorCopy(ps->origin, eye);
+	eye[2] += ps->viewheight;
+	VectorSubtract(point, eye, delta);
+	vectoangles(delta, wanted);
+
+	return ETA_AimSteerAngles(wanted, tolerance);
+}
+
+/**
+ * @brief Climbing a ladder with the use key.
+ *
+ * A ladder in ET is climbed with the view and the walk keys together:
+ * facing it and walking forward climbs it while the view is level or
+ * up, and climbs down while the view is well down; walking backward
+ * reverses either (PM_LadderMove). Getting on from the top means
+ * walking off the edge toward the ladder and catching it on the way
+ * down - the game grabs a ladder within 48 units ahead of a falling
+ * player. None of that can be done by ear without a lot of falling.
+ *
+ * So the use key does it, with keys pressed for the player as the
+ * turning does, and the game's own movement doing the climbing:
+ *
+ *   - up: face the ladder, view a little up, walk forward; off the top,
+ *     a few more steps onto the ledge;
+ *   - down, ladder on the far side of the hole: face it, look well
+ *     down, walk forward off the edge onto it, and on down;
+ *   - down, ladder on the wall under the player's own edge: face that
+ *     wall, view level, walk backward off the edge onto it, and on down.
+ *
+ * It stops at the top or the bottom, says so, and gives the keys back.
+ * The player turning by hand, the use key again, the map, death, or a
+ * climb that never got onto the ladder all stop it too - after five
+ * seconds, not three: a tester's walk from two metres off sometimes
+ * needed more.
+ */
+#define ETA_CLIMB_KEY_FORWARD "993"
+#define ETA_CLIMB_KEY_BACK    "992"
+#define ETA_CLIMB_GRAB_MS     5000
+#define ETA_CLIMB_LIMIT_MS    20000
+#define ETA_CLIMB_STEP_OFF_MS 400
+#define ETA_CLIMB_FACING      20.0f
+
+typedef struct
+{
+	qboolean active;
+	qboolean goesUp;
+	qboolean behind;
+	vec3_t   point;
+	vec3_t   normal;
+	int      started;
+	int      move;      /* the walk key held: 1 forward, -1 back */
+	qboolean latched;   /* has been on the ladder */
+	int      offSince;  /* off the top of it, since */
+	float    startZ;
+} eta_climb_t;
+
+static eta_climb_t eta_climb;
+
+qboolean CG_AccessibilityClimbing(void)
+{
+	return eta_climb.active;
+}
+
+static void ETA_ClimbMove(int move)
+{
+	if (move == eta_climb.move)
+	{
+		return;
+	}
+
+	if (eta_climb.move)
+	{
+		trap_SendConsoleCommand(va("-%s %s\n", eta_climb.move > 0 ? "forward" : "back",
+		                           eta_climb.move > 0 ? ETA_CLIMB_KEY_FORWARD : ETA_CLIMB_KEY_BACK));
+	}
+	if (move)
+	{
+		trap_SendConsoleCommand(va("+%s %s\n", move > 0 ? "forward" : "back",
+		                           move > 0 ? ETA_CLIMB_KEY_FORWARD : ETA_CLIMB_KEY_BACK));
+	}
+
+	eta_climb.move = move;
+}
+
+static void ETA_ClimbStop(const char *say)
+{
+	if (!eta_climb.active)
+	{
+		return;
+	}
+
+	ETA_ClimbMove(0);
+	ETA_AimKeys(0, 0);
+	ETA_TurnBoost(qfalse);
+	eta_climb.active = qfalse;
+
+	if (say)
+	{
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(say);
+		ETA_Speech_EndReport();
+	}
+}
+
+static void ETA_ClimbStart(const etaLadder_t *ladder)
+{
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+	ETA_AimStop();
+
+	memset(&eta_climb, 0, sizeof(eta_climb));
+	eta_climb.active  = qtrue;
+	eta_climb.goesUp  = ladder->goesUp;
+	eta_climb.behind  = ladder->behind;
+	eta_climb.started = cg.time;
+	eta_climb.startZ  = cg.predictedPlayerState.origin[2];
+	VectorCopy(ladder->point, eta_climb.point);
+	VectorCopy(ladder->normal, eta_climb.normal);
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(ladder->goesUp ? "Climbing up" : "Climbing down");
+	ETA_Speech_EndReport();
+}
+
+static void ETA_ClimbFrame(void)
+{
+	const playerState_t *ps       = &cg.predictedPlayerState;
+	qboolean            onLadder  = (qboolean)((ps->pm_flags & PMF_LADDER) != 0);
+	qboolean            onGround  = (qboolean)(ps->groundEntityNum != ENTITYNUM_NONE);
+	vec3_t              wanted, toLadder;
+	float               yawError;
+
+	if (!cg.snap || ps->pm_type != PM_NORMAL || cgs.autoMapExpanded)
+	{
+		ETA_ClimbStop(NULL);
+		return;
+	}
+
+	if (cg.time < eta_climb.started || cg.time - eta_climb.started > ETA_CLIMB_LIMIT_MS)
+	{
+		ETA_ClimbStop("Climb stopped");
+		return;
+	}
+
+	if (onLadder)
+	{
+		eta_climb.latched = qtrue;
+	}
+
+	if (!eta_climb.latched && cg.time - eta_climb.started > ETA_CLIMB_GRAB_MS)
+	{
+		ETA_ClimbStop("Could not get onto the ladder");
+		return;
+	}
+
+	/* Arrived. */
+	if (eta_climb.latched)
+	{
+		if (eta_climb.goesUp)
+		{
+			if (!onLadder)
+			{
+				if (!eta_climb.offSince)
+				{
+					eta_climb.offSince = cg.time;
+				}
+
+				if (onGround && ps->origin[2] < eta_climb.startZ + 16.0f)
+				{
+					/* Back where it started: let go of the ladder, or
+					   never got up it. */
+					ETA_ClimbStop("Off the ladder");
+					return;
+				}
+
+				if (onGround && cg.time - eta_climb.offSince > ETA_CLIMB_STEP_OFF_MS)
+				{
+					ETA_ClimbStop("Top of the ladder");
+					return;
+				}
+			}
+			else
+			{
+				eta_climb.offSince = 0;
+			}
+		}
+		else if (onGround && ps->origin[2] < eta_climb.startZ - 32.0f)
+		{
+			ETA_ClimbStop("Bottom of the ladder");
+			return;
+		}
+	}
+
+	/* Facing: at the ladder's face once on it, or from behind its wall;
+	   on the way to a ladder ahead, at the spot where it was found. */
+	if (eta_climb.latched || eta_climb.behind)
+	{
+		VectorScale(eta_climb.normal, -1.0f, toLadder);
+	}
+	else
+	{
+		VectorSubtract(eta_climb.point, ps->origin, toLadder);
+	}
+	toLadder[2] = 0.0f;
+
+	wanted[YAW]  = vectoyaw(toLadder);
+	wanted[ROLL] = 0.0f;
+
+	if (eta_climb.goesUp)
+	{
+		wanted[PITCH] = -10.0f;     /* a little up: climbs */
+	}
+	else if (eta_climb.behind)
+	{
+		wanted[PITCH] = 0.0f;       /* level, walking backward: climbs down */
+	}
+	else
+	{
+		wanted[PITCH] = 70.0f;      /* well down, walking forward: climbs down */
+	}
+
+	ETA_AimSteerAngles(wanted, 2.0f);
+
+	/* Walk only once facing about the right way, so the first step is
+	   never off a ledge in some other direction. */
+	yawError = AngleSubtract(wanted[YAW], ps->viewangles[YAW]);
+
+	if (Q_fabs(yawError) < ETA_CLIMB_FACING || eta_climb.latched)
+	{
+		ETA_ClimbMove(eta_climb.behind ? -1 : 1);
+	}
+	else
+	{
+		ETA_ClimbMove(0);
+	}
+}
+
+static void ETA_AimSay(const char *what, const vec3_t point)
+{
+	int  meters = (int)(Distance(cg.predictedPlayerState.origin, point) * ETA_QU_TO_METERS + 0.5f);
+	char height[48];
+
+	/* Up or down as well as which way: a thing on the floor above is
+	   "ahead" too, and walking at it finds the wall below it. */
+	ETA_HudNarrator_HeightText((point[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS,
+	                           height, sizeof(height));
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s, %s, %d meter%s%s%s", what,
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(point)),
+	                  meters < 1 ? 1 : meters, meters == 1 ? "" : "s",
+	                  height[0] ? ", " : "", height));
+	ETA_Speech_EndReport();
+}
+
+/* An enemy for the lock: the nearest in sight, within maxMeters when it
+   is above zero. qfalse when there is none. */
+static qboolean ETA_AimAcquire(float maxMeters)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+
+	if (CG_AccessibilityEnemyTargets(list, ETA_AIM_MAX_TARGETS) <= 0
+	    || (maxMeters > 0.0f && list[0].meters > maxMeters))
+	{
+		return qfalse;
+	}
+
+	eta_aim.entityNum = list[0].entityNum;
+	VectorCopy(list[0].point, eta_aim.point);
+	eta_aim.lostSince = 0;
+	eta_aim.saidLost  = qfalse;
+	return qtrue;
+}
+
+/* Turns to a thing to use and says what it is - or, with no label,
+   quietly, leaving the game's own use icon to name it. */
+static void ETA_AimStartSnap(const etaAimTarget_t *target, const char *label)
+{
+	/* A tap turn still running would fight this for the same keys. */
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+
+	ETA_AimStop();
+	eta_aim.mode      = ETA_AIM_SNAP;
+	eta_aim.entityNum = target->entityNum;
+	eta_aim.started   = cg.time;
+	eta_aim.lift      = 0.0f;
+	eta_aim.itemTry   = -1;
+	VectorSet(eta_aim.itemAim, 0.0f, 0.0f, 8.0f);
+	VectorCopy(target->point, eta_aim.point);
+
+	if (label)
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_AimSay(label, target->point);
+	}
+}
+
+/**
+ * @brief Choosing what F turns to, with the bracket keys.
+ *
+ * The tester could not get to the dynamite spot on Oasis's Old City
+ * wall: there were several things to use close together, and F took
+ * whichever was nearest, or whatever the crosshair was already on. So ]
+ * steps through the things to use from nearest to furthest, and [ back,
+ * each said - name, direction, distance, "2 of 4" - without turning the
+ * view. F then turns to the one chosen, and uses it in reach, whatever is
+ * under the crosshair.
+ *
+ * The choice stays until it is used. It was let go as soon as F turned
+ * to it, and the tester, turned to a gun out of reach, walked up to it,
+ * pressed F again - and was turned to whatever was nearest. Now it is
+ * kept while the player walks there, each F turning to it again, and let
+ * go once use is pressed on it, once it is no longer on the list, or
+ * half a minute after the last F or bracket. A ladder or stairs, which
+ * F climbs or walks rather than uses, and a thing that is never pressed
+ * at, are let go once turned to, as before.
+ */
+#define ETA_CHOOSE_HOLD_MS 30000
+
+static struct
+{
+	qboolean       held;
+	int            at;          /* when it was chosen */
+	etaAimTarget_t target;
+} eta_choose;
+
+/* Where a target is on the list now: by its entity, or for a ladder,
+   which has none, by where it stands. -1 when it is gone. */
+static int ETA_ChooseFind(const etaAimTarget_t *list, int count, const etaAimTarget_t *want)
+{
+	int i;
+
+	for (i = 0; i < count; i++)
+	{
+		if (want->entityNum >= 0 ? list[i].entityNum == want->entityNum
+		    : (list[i].entityNum < 0 && list[i].ladder == want->ladder
+		       && Distance(list[i].point, want->point) < 48.0f))
+		{
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+static void ETA_ChooseStep(int step)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	int            count, index;
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	/* Choosing again lets go of the one being walked to. */
+	if (eta_aim.mode == ETA_AIM_FOLLOW)
+	{
+		ETA_AimStop();
+	}
+
+	count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+
+	if (count <= 0)
+	{
+		eta_choose.held = qfalse;
+		ETA_Speech_Say("Nothing to use close by");
+		return;
+	}
+
+	index = (eta_choose.held && cg.time >= eta_choose.at && cg.time - eta_choose.at < ETA_CHOOSE_HOLD_MS)
+	        ? ETA_ChooseFind(list, count, &eta_choose.target) : -1;
+
+	if (index < 0)
+	{
+		/* A fresh choice starts at the nearest, or from the far end
+		   going back. */
+		index = step > 0 ? 0 : count - 1;
+	}
+	else
+	{
+		index = (index + step + count) % count;
+	}
+
+	eta_choose.held   = qtrue;
+	eta_choose.at     = cg.time;
+	eta_choose.target = list[index];
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_AimSay(va("%s, %d of %d", list[index].name, index + 1, count), list[index].point);
+}
+
+void CG_AccessibilityUseNext_f(void)
+{
+	ETA_ChooseStep(1);
+}
+
+void CG_AccessibilityUsePrev_f(void)
+{
+	ETA_ChooseStep(-1);
+}
+
+/**
+ * @brief Turns to a flight of stairs: to its foot from further off, and
+ * standing at the foot, straight up or down the flight - so walking
+ * forward climbs it. Nothing is pressed: stairs are walked.
+ */
+#define ETA_STAIRS_AT_FOOT_METERS 1.5f
+
+static void ETA_StairsTurn(const etaAimTarget_t *target, const char *place)
+{
+	if (target->meters <= ETA_STAIRS_AT_FOOT_METERS)
+	{
+		etaAimTarget_t up = *target;
+
+		VectorCopy(target->along, up.point);
+		ETA_AimStartSnap(&up, NULL);
+		ETA_HudNarrator_HoldPassive(cg.time);
+		ETA_Speech_Say(va("Facing %s the stairs. Walk forward",
+		                  target->along[2] > target->point[2] ? "up" : "down"));
+		return;
+	}
+
+	ETA_AimStartSnap(target, place ? va("%s, %s", target->name, place) : target->name);
+}
+
+/* The chosen one, if there still is one: F's answer before anything
+   else. qfalse when nothing is chosen, or it is gone. */
+static qboolean ETA_ChooseTake(const etaAimTarget_t *list, int count, int *index)
+{
+	if (!eta_choose.held || cg.time < eta_choose.at || cg.time - eta_choose.at >= ETA_CHOOSE_HOLD_MS)
+	{
+		eta_choose.held = qfalse;
+		return qfalse;
+	}
+
+	eta_choose.held = qfalse;
+	*index          = ETA_ChooseFind(list, count, &eta_choose.target);
+
+	if (*index < 0)
+	{
+		ETA_Speech_Say(va("%s is no longer close by", eta_choose.target.name));
+		return qfalse;
+	}
+
+	return qtrue;
+}
+
+/* Whether use, pressed now, reaches a thing on the list: a thing on the
+   ground by the eyes (ETA_USE_EYE_REACH), anything else as it was. */
+static qboolean ETA_UseInReach(const etaAimTarget_t *target)
+{
+	vec3_t eye;
+
+	if (target->entityNum >= 0 && target->entityNum < MAX_GENTITIES
+	    && cg_entities[target->entityNum].currentState.eType == ET_ITEM)
+	{
+		VectorCopy(cg.predictedPlayerState.origin, eye);
+		eye[2] += cg.predictedPlayerState.viewheight;
+		return (qboolean)(Distance(eye, target->point) <= ETA_USE_EYE_REACH);
+	}
+
+	return (qboolean)(target->meters <= ETA_USE_REACH_METERS);
+}
+
+/**
+ * @brief Kept facing the thing F turned to while walking to it.
+ *
+ * The tester chose a weapon a few metres off, F turned them to it, and
+ * walking there the view drifted off it: they arrived facing elsewhere,
+ * and could not pick it up. So F, on a thing out of reach, turns to it
+ * and stays on it - the view following it as the player walks, the way
+ * the enemy lock follows an enemy - and says once it is in reach, when F
+ * uses it. It lets go when F uses it, a turn key is pressed, another is
+ * chosen, or it is out of sight for a moment; a choice is kept all the
+ * while. At first only a thing chosen with the bracket keys was
+ * followed; the tester then found F by itself said nothing on reaching
+ * the nearest thing, so that is followed too.
+ */
+#define ETA_FOLLOW_REFRESH_MS 250
+#define ETA_FOLLOW_LOST_MS    1000
+
+static void ETA_AimStartFollow(const etaAimTarget_t *target, const char *label)
+{
+	ETA_AimStartSnap(target, label ? label : target->name);
+	eta_aim.mode      = ETA_AIM_FOLLOW;
+	eta_aim.follow    = *target;
+	eta_aim.saidReach = qfalse;
+	eta_aim.refreshAt = cg.time + ETA_FOLLOW_REFRESH_MS;
+	eta_aim.lostSince = 0;
+}
+
+static void ETA_FollowFrame(void)
+{
+	etaAimTarget_t *target = &eta_aim.follow;
+
+	if (cg.time >= eta_aim.refreshAt || eta_aim.refreshAt - cg.time > ETA_FOLLOW_REFRESH_MS)
+	{
+		etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+		int            count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+		int            index = ETA_ChooseFind(list, count, target);
+
+		eta_aim.refreshAt = cg.time + ETA_FOLLOW_REFRESH_MS;
+
+		if (index < 0)
+		{
+			if (!eta_aim.lostSince)
+			{
+				eta_aim.lostSince = cg.time;
+			}
+			if (cg.time - eta_aim.lostSince >= ETA_FOLLOW_LOST_MS || cg.time < eta_aim.lostSince)
+			{
+				ETA_AimStop();
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say(va("%s is out of sight. F turns to it again", target->name));
+				return;
+			}
+		}
+		else
+		{
+			eta_aim.lostSince = 0;
+			*target           = list[index];
+			VectorCopy(target->point, eta_aim.point);
+
+			/* Walked to, it stays chosen however long the walk. */
+			if (eta_choose.held && ETA_ChooseFind(target, 1, &eta_choose.target) == 0)
+			{
+				eta_choose.at = cg.time;
+			}
+
+			if (!eta_aim.saidReach && ETA_UseInReach(target))
+			{
+				eta_aim.saidReach = qtrue;
+				ETA_HudNarrator_HoldPassive(cg.time);
+				ETA_Speech_Say(va("%s, in reach, F to use", target->name));
+			}
+		}
+	}
+
+	ETA_AimSteer(eta_aim.point, 1.0f);
+}
+
+/**
+ * @brief The use key, and the one key for everything to use.
+ *
+ * The tester had two keys for one job - DEL to turn to things, F to use
+ * them - and asked for one. So F does all of it:
+ *
+ *   - something already under the crosshair that the game offers to use
+ *     (the use icon is showing) is used at once, as the plain key would;
+ *   - otherwise, the nearest thing to use is turned to and named, with its
+ *     direction and distance. Within reach, it is used on arrival - unless
+ *     it is a door that will not open for this player. Further off, the
+ *     walk is the player's;
+ *   - pressed again within a few seconds, with still nothing under the
+ *     crosshair, the next one along;
+ *   - with nothing close by at all, the key does what it always did.
+ */
+void CG_AccessibilityActivateDown_f(void)
+{
+	etaAimTarget_t list[ETA_AIM_MAX_TARGETS];
+	qboolean       hint;
+	int            count, index = 0;
+
+	if (eta_use.held)
+	{
+		return;
+	}
+
+	eta_use.held = qtrue;
+
+	/* Taking a uniform: F again leaves it to finish. */
+	if (eta_use.bodyUntil)
+	{
+		return;
+	}
+
+	/* The game's ladder icon is not something the use key does anything
+	   with, so it is not a hint here: the key climbs the ladder. Nor is
+	   the icon for anything else use does nothing with - a thing to shoot
+	   or to knife, water, a door locked to this player, a use already
+	   done: the tester, facing one, found F did nothing at all, not even
+	   turn to the thing beside it. F turns to the nearest thing instead. */
+	hint = (qboolean)(cg.cursorHintIcon != HINT_NONE && cg.cursorHintIcon != HINT_LADDER
+	                  && cg.cursorHintIcon != HINT_BREAKABLE && cg.cursorHintIcon != HINT_BREAKABLE_DYNAMITE
+	                  && cg.cursorHintIcon != HINT_KNIFE && cg.cursorHintIcon != HINT_WATER
+	                  && cg.cursorHintIcon != HINT_DOOR_LOCKED && cg.cursorHintIcon != HINT_DOOR_ROTATING_LOCKED
+	                  && cg.cursorHintIcon != HINT_RESTRICTED && cg.cursorHintIcon != HINT_BAD_USER
+	                  && cg.cursorHintIcon != HINT_COMPLETED && cg.cursorHintIcon != HINT_NO_DARM_FIRST_REVIVE
+	                  && cg.cursorHintTime != 0 && cg.cursorHintFade > 0
+	                  && cg.time - cg.cursorHintTime < cg.cursorHintFade);
+
+	/* Pressed while climbing: stop. */
+	if (eta_climb.active)
+	{
+		ETA_ClimbStop("Climb stopped");
+		return;
+	}
+
+	/* Something chosen with the bracket keys comes before anything
+	   else - before what the crosshair is on, and before a ladder in
+	   reach. */
+	if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL && eta_choose.held)
+	{
+		count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+
+		if (ETA_ChooseTake(list, count, &index))
+		{
+			/* Turned to and said; used on arrival when in reach - but a
+			   ladder is climbed with F once there, and a locked door is
+			   never pressed at. */
+			if (list[index].stairs)
+			{
+				ETA_StairsTurn(&list[index], NULL);
+			}
+			else
+			{
+				qboolean reach = ETA_UseInReach(&list[index]);
+
+				/* Out of reach: turned to, and kept facing it while the
+				   player walks there. */
+				if (!list[index].ladder && !list[index].locked && !reach)
+				{
+					ETA_AimStartFollow(&list[index], NULL);
+				}
+				else
+				{
+					ETA_AimStartSnap(&list[index], list[index].name);
+					eta_use.pending = (qboolean)(!list[index].ladder && !list[index].locked && reach);
+					eta_use.uniform = list[index].uniform;
+				}
+
+				/* Kept until it is used: walked up to, F turns to it
+				   again, not to whatever is nearest by then. */
+				if (!list[index].ladder && !list[index].locked)
+				{
+					eta_choose.held   = qtrue;
+					eta_choose.at     = cg.time;
+					eta_choose.target = list[index];
+				}
+			}
+			eta_aim.cycleIndex = index;
+			eta_aim.cycleAt    = cg.time;
+			return;
+		}
+	}
+
+	count = (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL && !hint)
+	        ? CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS) : 0;
+
+	/* A ladder within reach, nearer than anything else to use: climb it.
+	   The ladders on the list are the same ladders seen from further
+	   off, so it is weighed against the nearest thing that is not one. */
+	if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL && !hint)
+	{
+		etaLadder_t ladder;
+		int         other;
+
+		for (other = 0; other < count && list[other].ladder; other++)
+		{
+		}
+
+		if (CG_AccessibilityLadderNear(&ladder) && (other >= count || ladder.meters < list[other].meters))
+		{
+			ETA_ClimbStart(&ladder);
+			return;
+		}
+	}
+
+	/* The crosshair already on an enemy body: its uniform is taken, the
+	   key held for the player, whether F is held or tapped. */
+	if (hint && cg.cursorHintIcon == HINT_UNIFORM && cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL)
+	{
+		int j;
+
+		count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+		for (j = 0; j < count; j++)
+		{
+			if (list[j].uniform)
+			{
+				ETA_UniformStart(list[j].entityNum);
+				return;
+			}
+		}
+	}
+
+	if (hint || count <= 0)
+	{
+		/* Used: what was walked to has done its job. */
+		if (eta_aim.mode == ETA_AIM_FOLLOW)
+		{
+			ETA_AimStop();
+		}
+		/* Nothing to turn to: said, never silence - the tester could not
+		   tell F finding nothing from F not working. Use is still
+		   pressed, as the plain key would. */
+		if (!hint && cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL)
+		{
+			ETA_HudNarrator_HoldPassive(cg.time);
+			ETA_Speech_Say("Nothing to use within 15 meters");
+		}
+		ETA_UseKey(qtrue);
+		return;
+	}
+
+	/* Walked up to what F turned to: F uses it, rather than moving on
+	   to the next one along. */
+	if (eta_aim.mode == ETA_AIM_FOLLOW && ETA_UseInReach(&eta_aim.follow))
+	{
+		int j = ETA_ChooseFind(list, count, &eta_aim.follow);
+
+		if (j >= 0 && !list[j].ladder && !list[j].stairs)
+		{
+			ETA_AimStartSnap(&list[j], list[j].name);
+			eta_use.pending    = (qboolean)!list[j].locked;
+			eta_use.uniform    = list[j].uniform;
+			eta_aim.cycleIndex = j;
+			eta_aim.cycleAt    = cg.time;
+			return;
+		}
+	}
+
+	/* Pressed again soon after: the next one along. */
+	if (eta_aim.cycleAt && cg.time >= eta_aim.cycleAt && cg.time - eta_aim.cycleAt < ETA_AIM_CYCLE_MS)
+	{
+		index = (eta_aim.cycleIndex + 1) % count;
+	}
+	else if (list[0].stairs)
+	{
+		/* Stairs underfoot do not stand in the way of something to use
+		   within reach: that is what F was pressed for. */
+		int j;
+
+		for (j = 1; j < count; j++)
+		{
+			if (!list[j].stairs && list[j].meters <= ETA_USE_REACH_METERS)
+			{
+				index = j;
+				break;
+			}
+		}
+	}
+
+	eta_aim.cycleIndex = index;
+	eta_aim.cycleAt    = cg.time;
+
+	/* Stairs: turned to their foot, and from there up or down them. */
+	if (list[index].stairs)
+	{
+		ETA_StairsTurn(&list[index], count > 1 ? va("%d of %d", index + 1, count) : NULL);
+		return;
+	}
+
+	/* A ladder is turned to and said, always: pressing use at it does
+	   nothing, and F climbs it once the player is there. */
+	if (list[index].ladder)
+	{
+		ETA_AimStartSnap(&list[index],
+		                 count > 1 ? va("%s, %d of %d", list[index].name, index + 1, count) : list[index].name);
+		return;
+	}
+
+	/* Within reach: turned to, said, and used on arrival. It was used
+	   quietly, leaving the game's own icon to name it - and a door that
+	   would not open said nothing at all, so the tester heard F pass the
+	   doors by. Now it is always said, and a door that will not open is
+	   not pressed at. */
+	if (ETA_UseInReach(&list[index]))
+	{
+		ETA_AimStartSnap(&list[index], list[index].name);
+		eta_use.pending = (qboolean)!list[index].locked;
+		eta_use.uniform = list[index].uniform;
+		return;
+	}
+
+	/* Further off: turned to, said, and kept facing while the player
+	   walks there, "in reach" said on arrival - but a door that will not
+	   open is only turned to. */
+	if (!list[index].locked)
+	{
+		ETA_AimStartFollow(&list[index],
+		                   count > 1 ? va("%s, %d of %d", list[index].name, index + 1, count) : NULL);
+		return;
+	}
+
+	ETA_AimStartSnap(&list[index],
+	                 count > 1 ? va("%s, %d of %d", list[index].name, index + 1, count) : list[index].name);
+}
+
+void CG_AccessibilityActivateUp_f(void)
+{
+	eta_use.held = qfalse;
+
+	/* Pressed for the player: let go with them, unless it is still to be
+	   pressed on arrival, which lets go by itself a moment later, or a
+	   uniform is being taken. */
+	if (eta_use.pressed && !eta_use.pending && !eta_use.bodyUntil)
+	{
+		ETA_UseKey(qfalse);
+	}
+}
+
+void CG_AccessibilityAimLockDown_f(void)
+{
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		return;
+	}
+
+	if (eta_aim.mode == ETA_AIM_LOCK)
+	{
+		/* Already on one by itself: the key makes it the player's. */
+		if (eta_aim.automatic)
+		{
+			eta_aim.automatic = qfalse;
+			ETA_AimSay("Locked, enemy", eta_aim.point);
+		}
+		return;
+	}
+
+	if (!CG_AccessibilityAimAssistAllowed())
+	{
+		ETA_Speech_Say("Enemy lock works in a game you host, or on a server that allows it");
+		return;
+	}
+
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+
+	ETA_AimStop();
+	eta_aim.mode    = ETA_AIM_LOCK;
+	eta_aim.started = cg.time;
+
+	if (ETA_AimAcquire(0.0f))
+	{
+		ETA_AimSay("Locked, enemy", eta_aim.point);
+	}
+	else
+	{
+		eta_aim.entityNum = -1;
+		eta_aim.saidLost  = qtrue;
+		ETA_Speech_Say("No enemy in sight");
+	}
+}
+
+void CG_AccessibilityAimLockUp_f(void)
+{
+	if (eta_aim.mode == ETA_AIM_LOCK && !eta_aim.automatic)
+	{
+		ETA_AimStop();
+	}
+}
+
+/**
+ * @brief The lock by itself: an enemy in sight, where the lock may run.
+ */
+static void ETA_AutoLock(void)
+{
+	if (!eta_autoLock.integer || cgs.autoMapExpanded || eta_turn.step || eta_turn.held
+	    || CG_AccessibilityBuildBusy() || !CG_AccessibilityAimAssistAllowed())
+	{
+		return;
+	}
+
+	/* A turn by hand keeps it off a moment, so the player can look away. */
+	if (cg.time < eta_aim.manualUntil && eta_aim.manualUntil - cg.time <= ETA_AIM_MANUAL_MS)
+	{
+		return;
+	}
+
+	/* Ten looks a second is plenty, and spares the traces. */
+	if (cg.time < eta_aim.nextSearch && eta_aim.nextSearch - cg.time <= 100)
+	{
+		return;
+	}
+	eta_aim.nextSearch = cg.time + 100;
+
+	if (!ETA_AimAcquire(ETA_AIM_AUTO_METERS))
+	{
+		return;
+	}
+
+	eta_aim.mode      = ETA_AIM_LOCK;
+	eta_aim.automatic = qtrue;
+	eta_aim.started   = cg.time;
+}
+
+/**
+ * @brief The keys belong to the map while it is open.
+ *
+ * With the map open, the arrow keys still turned and looked and the
+ * movement keys still walked, so walking the survey with the arrows
+ * moved the player as well. A tester put it plainly: while the map is
+ * open the arrows should walk the map, and nothing should move; close it
+ * and everything is as it was.
+ *
+ * So opening the map (as a switch - held, its release must still reach
+ * the game) gives the keys to this module: the arrow keys and the keypad
+ * arrows move the survey cursor, the map key or Escape closes it, a key
+ * on one of the mod's own commands - the reports, the marker, the
+ * survey's other keys - still does its job, and every held action -
+ * walking, firing, looking - is ignored. Letting go of a key that was
+ * already held still reaches the game, which the client guarantees for
+ * every + command, so nothing is left running.
+ */
+static qboolean eta_mapCatching;
+
+void CG_AccessibilityMapCatchKeys(qboolean on)
+{
+	if (on && !eta_mapCatching && cgs.eventHandling == CGAME_EVENT_NONE)
+	{
+		if (eta_turn.step)
+		{
+			ETA_TurnStopStep(qfalse);
+		}
+		ETA_AimStop();
+		trap_Key_SetCatcher(trap_Key_GetCatcher() | KEYCATCH_CGAME);
+		eta_mapCatching = qtrue;
+	}
+	else if (!on && eta_mapCatching)
+	{
+		if (cgs.eventHandling == CGAME_EVENT_NONE)
+		{
+			trap_Key_SetCatcher(trap_Key_GetCatcher() & ~KEYCATCH_CGAME);
+		}
+		eta_mapCatching = qfalse;
+	}
+}
+
+/* Escape is the client's: it takes the keys back without asking. Then the
+   map closes too, rather than staying open with the keys gone. */
+static void ETA_MapCatchFrame(void)
+{
+	if (!eta_mapCatching)
+	{
+		return;
+	}
+
+	if (cgs.eventHandling != CGAME_EVENT_NONE)
+	{
+		/* Another panel - the limbo menu - has the keys now. */
+		eta_mapCatching = qfalse;
+		return;
+	}
+
+	if (!(trap_Key_GetCatcher() & KEYCATCH_CGAME) || !cgs.autoMapExpanded)
+	{
+		eta_mapCatching = qfalse;
+		if (cgs.autoMapExpanded)
+		{
+			CG_AutomapCollapse();
+			ETA_Speech_Say("Map closed");
+		}
+		else if (trap_Key_GetCatcher() & KEYCATCH_CGAME)
+		{
+			trap_Key_SetCatcher(trap_Key_GetCatcher() & ~KEYCATCH_CGAME);
+		}
+	}
+}
+
+/**
+ * @brief A key while the map has them. qtrue when it was the map's.
+ */
+qboolean CG_AccessibilityMapKeyEvent(int key, qboolean down)
+{
+	char binding[256];
+
+	if (!eta_mapCatching)
+	{
+		return qfalse;
+	}
+
+	if (!cgs.autoMapExpanded || cgs.eventHandling != CGAME_EVENT_NONE)
+	{
+		CG_AccessibilityMapCatchKeys(qfalse);
+		return qfalse;
+	}
+
+	/* Letting go is the client's to deliver, and it already has. */
+	if (!down)
+	{
+		return qtrue;
+	}
+
+	switch (key)
+	{
+	case K_UPARROW:
+	case K_KP_UPARROW:
+		CG_AccessibilityMapNorth_f();
+		return qtrue;
+	case K_DOWNARROW:
+	case K_KP_DOWNARROW:
+		CG_AccessibilityMapSouth_f();
+		return qtrue;
+	case K_RIGHTARROW:
+	case K_KP_RIGHTARROW:
+		CG_AccessibilityMapEast_f();
+		return qtrue;
+	case K_LEFTARROW:
+	case K_KP_LEFTARROW:
+		CG_AccessibilityMapWest_f();
+		return qtrue;
+	case K_ESCAPE:
+		CG_AutomapCollapse();
+		ETA_Speech_Say("Map closed");
+		return qtrue;
+	default:
+		break;
+	}
+
+	trap_Key_GetBindingBuf(key, binding, sizeof(binding));
+
+	if (!Q_stricmp(binding, "+mapexpand"))
+	{
+		CG_AutomapCollapse();
+		ETA_Speech_Say("Map closed");
+		return qtrue;
+	}
+
+	/* A command that does a thing once - a report, the marker, the rest
+	   of the survey, a chat line - still does it. A held action - walking,
+	   firing, looking, turning - waits until the map is closed. */
+	if (binding[0] && binding[0] != '+')
+	{
+		trap_SendConsoleCommand(va("%s\n", binding));
+	}
+
+	return qtrue;
+}
+
+/**
+ * @brief Every frame: steers a running aim onto its target.
+ */
+/**
+ * @brief What lies on the ground across the use key's line, short of
+ * what the player was turned to: the entity, or -1 for nothing.
+ *
+ * The tester chose the mounted gun, and F picked up an enemy's weapon
+ * lying by it. The game's use takes the first thing its line from the
+ * eyes meets (Cmd_Activate_f), and a weapon or a pack on the ground is
+ * one - picked up, a weapon in place of the player's own. The cgame's
+ * own traces pass through them, so each is tested here by the box the
+ * game gives it (g_items.c), along the line the view is on now.
+ */
+#define ETA_USE_LIFT_MAX  24.0f   /* the most the aim is raised to clear one */
+#define ETA_USE_LIFT_STEP 8.0f
+
+/* Where on a thing on the ground F may aim, from its origin, inside the
+   box the game gives it (ITEM_RADIUS round, twice that high): low, high,
+   and to each side, then the corners. */
+#define ETA_USE_ITEM_AIMS 10
+static const vec3_t eta_useItemAims[ETA_USE_ITEM_AIMS] =
+{
+	{ 0, 0, 4 }, { 0, 0, 16 }, { 6, 0, 8 }, { -6, 0, 8 }, { 0, 6, 8 }, { 0, -6, 8 },
+	{ 6, 6, 4 }, { -6, -6, 4 }, { 6, -6, 4 }, { -6, 6, 4 }
+};
+
+static int ETA_UseLineBlocked(const vec3_t eye, const vec3_t end, int target)
+{
+	vec3_t dir;
+	float  length = Distance(eye, end);
+	int    i, a;
+
+	if (!cg.snap || length < 1.0f)
+	{
+		return -1;
+	}
+	VectorSubtract(end, eye, dir);
+	VectorScale(dir, 1.0f / length, dir);
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		const vec_t         *at = cg_entities[es->number].lerpOrigin;
+		float               enter = 0.0f, leave = length;
+		qboolean            hit = qtrue;
+
+		if (es->eType != ET_ITEM || es->number == target || (es->eFlags & EF_NODRAW))
+		{
+			continue;
+		}
+
+		/* Both of the game's item boxes in one: from a radius below the
+		   origin to two above. */
+		for (a = 0; a < 3 && hit; a++)
+		{
+			float lo = at[a] - ITEM_RADIUS, hi = at[a] + (a == 2 ? 2.0f * ITEM_RADIUS : ITEM_RADIUS);
+
+			if (fabs(dir[a]) < 0.0001f)
+			{
+				hit = (qboolean)(eye[a] >= lo && eye[a] <= hi);
+			}
+			else
+			{
+				float t0 = (lo - eye[a]) / dir[a], t1 = (hi - eye[a]) / dir[a];
+
+				if (t0 > t1)
+				{
+					float swap = t0;
+
+					t0 = t1;
+					t1 = swap;
+				}
+				enter = MAX(enter, t0);
+				leave = MIN(leave, t1);
+				hit   = (qboolean)(enter <= leave);
+			}
+		}
+
+		/* Met before the point itself, by more than a hand's width. */
+		if (hit && enter < length - 4.0f)
+		{
+			return es->number;
+		}
+	}
+
+	return -1;
+}
+
+/* Where the use key's line ends now: along the view, as far as the point. */
+static void ETA_UseLineEnd(const vec3_t eye, const vec3_t point, vec3_t end)
+{
+	vec3_t forward;
+
+	AngleVectors(cg.predictedPlayerState.viewangles, forward, NULL, NULL);
+	VectorMA(eye, Distance(eye, point), forward, end);
+}
+
+void CG_AccessibilityAimFrame(void)
+{
+	ETA_MapCatchFrame();
+
+	/* A climb has the keys to itself. */
+	if (eta_climb.active)
+	{
+		ETA_ClimbFrame();
+		return;
+	}
+
+	ETA_UniformFrame();
+
+	/* A use pressed on arrival lets go a moment later, if the player's
+	   own key already has. */
+	if (eta_use.pressed && !eta_use.held && eta_use.releaseAt
+	    && (cg.time >= eta_use.releaseAt || eta_use.releaseAt - cg.time > 1000))
+	{
+		ETA_UseKey(qfalse);
+	}
+
+	if (eta_aim.mode == ETA_AIM_NONE)
+	{
+		if (cg.snap && cg.predictedPlayerState.pm_type == PM_NORMAL)
+		{
+			ETA_AutoLock();
+		}
+		if (eta_aim.mode == ETA_AIM_NONE)
+		{
+			return;
+		}
+	}
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL || cg.time < eta_aim.started)
+	{
+		ETA_AimStop();
+		return;
+	}
+
+	/* A lock taken by itself stands down for the map and for a build. */
+	if (eta_aim.automatic && (cgs.autoMapExpanded || CG_AccessibilityBuildBusy() || !eta_autoLock.integer))
+	{
+		ETA_AimStop();
+		return;
+	}
+
+	if (eta_aim.mode == ETA_AIM_FOLLOW)
+	{
+		ETA_FollowFrame();
+		return;
+	}
+
+	if (eta_aim.mode == ETA_AIM_SNAP)
+	{
+		qboolean item = (qboolean)(eta_aim.entityNum >= 0 && eta_aim.entityNum < MAX_GENTITIES
+		                           && cg_entities[eta_aim.entityNum].currentValid
+		                           && cg_entities[eta_aim.entityNum].currentState.eType == ET_ITEM);
+
+		/* A wounded teammate or a dropped weapon can move; follow it. */
+		if (item)
+		{
+			VectorAdd(cg_entities[eta_aim.entityNum].lerpOrigin, eta_aim.itemAim, eta_aim.point);
+		}
+
+		if (ETA_AimSteer(eta_aim.point, 2.0f) || cg.time - eta_aim.started > ETA_AIM_SNAP_MS)
+		{
+			qboolean use  = eta_use.pending;
+			int      body = eta_aim.entityNum;
+
+			/* Something on the ground across the line would be what is
+			   used: aim a little higher over it, and failing that, say
+			   so rather than pick it up. */
+			if (use && !eta_use.uniform)
+			{
+				vec3_t eye, end;
+				int    blocker;
+
+				VectorCopy(cg.predictedPlayerState.origin, eye);
+				eye[2] += cg.predictedPlayerState.viewheight;
+				ETA_UseLineEnd(eye, eta_aim.point, end);
+				blocker = ETA_UseLineBlocked(eye, end, body);
+
+				/* A thing on the ground beside another: aimed at a part of
+				   it nothing else covers. Aiming over the other, as for
+				   anything else, passes over a weapon on the floor too. */
+				if (blocker >= 0 && item)
+				{
+					int k;
+
+					for (k = eta_aim.itemTry + 1; k < ETA_USE_ITEM_AIMS; k++)
+					{
+						vec3_t at;
+
+						VectorAdd(cg_entities[body].lerpOrigin, eta_useItemAims[k], at);
+						if (ETA_UseLineBlocked(eye, at, body) < 0)
+						{
+							VectorCopy(eta_useItemAims[k], eta_aim.itemAim);
+							VectorCopy(at, eta_aim.point);
+							eta_aim.itemTry = k;
+							eta_aim.started = cg.time;
+							return;
+						}
+					}
+				}
+				else if (blocker >= 0)
+				{
+					float lift;
+
+					for (lift = eta_aim.lift + ETA_USE_LIFT_STEP; lift <= ETA_USE_LIFT_MAX; lift += ETA_USE_LIFT_STEP)
+					{
+						vec3_t higher;
+
+						VectorCopy(eta_aim.point, higher);
+						higher[2] += lift - eta_aim.lift;
+						if (ETA_UseLineBlocked(eye, higher, body) < 0)
+						{
+							VectorCopy(higher, eta_aim.point);
+							eta_aim.lift    = lift;
+							eta_aim.started = cg.time;
+							return;
+						}
+					}
+				}
+
+				if (blocker >= 0)
+				{
+					{
+						char name[64];
+
+						if (!CG_AccessibilityObjectName(&cg_entities[blocker].currentState, name, sizeof(name)))
+						{
+							Q_strncpyz(name, "something", sizeof(name));
+						}
+						ETA_AimStop();
+						ETA_HudNarrator_HoldPassive(cg.time);
+						ETA_Speech_Say(va("Not used: %s on the ground is in the way, and would be picked up. "
+						                  "Step to one side, then F", name));
+					}
+					return;
+				}
+			}
+
+			ETA_AimStop();
+
+			/* Used: what was chosen has done its job. */
+			if (use && eta_choose.held && eta_choose.target.entityNum >= 0 && eta_choose.target.entityNum == body)
+			{
+				eta_choose.held = qfalse;
+			}
+
+			if (use && eta_use.uniform)
+			{
+				ETA_UniformStart(body);
+			}
+			else if (use)
+			{
+				ETA_UseKey(qtrue);
+				if (!eta_use.held)
+				{
+					eta_use.releaseAt = cg.time + 150;
+				}
+			}
+		}
+		return;
+	}
+
+	/* The lock, while held. */
+	if (eta_aim.entityNum >= 0 && CG_AccessibilityEnemyAimPoint(eta_aim.entityNum, eta_aim.point))
+	{
+		eta_aim.lostSince = 0;
+		ETA_AimSteer(eta_aim.point, 1.0f);
+		return;
+	}
+
+	/* Gone - down, behind a wall, out of view: hold still a moment, then
+	   take the next one in sight, or say it is over. */
+	ETA_AimKeys(0, 0);
+	ETA_TurnBoost(qfalse);
+
+	if (!eta_aim.lostSince)
+	{
+		eta_aim.lostSince = cg.time;
+	}
+
+	if (cg.time - eta_aim.lostSince < ETA_AIM_LOST_MS && eta_aim.entityNum >= 0)
+	{
+		return;
+	}
+
+	if (eta_aim.automatic)
+	{
+		/* By itself, it moves on or lets go without a word: the callouts
+		   already say who comes and goes. */
+		if (!ETA_AimAcquire(ETA_AIM_AUTO_METERS))
+		{
+			ETA_AimStop();
+		}
+		return;
+	}
+
+	if (ETA_AimAcquire(0.0f))
+	{
+		ETA_AimSay("Locked, enemy", eta_aim.point);
+		return;
+	}
+
+	eta_aim.entityNum = -1;
+
+	if (!eta_aim.saidLost)
+	{
+		eta_aim.saidLost = qtrue;
+		ETA_Speech_Say("Lock lost");
+	}
+}
+
+static void CG_AccessibilityTurnDown(int direction)
+{
+	/* A second press of a key already down is a repeat, not a tap. The
+	   engine drops keyboard repeats in play, but a repeat reaching here
+	   would restart the tap timer - so a hold would read as a tap - or
+	   add a compass point to a step nobody asked for. */
+	if (!cg.snap || eta_turn.held == direction || eta_turn.passthrough == direction)
+	{
+		return;
+	}
+
+	/* The player turning by hand takes over from any aim or climb, and
+	   the lock leaves them to it for a moment. */
+	if (eta_climb.active)
+	{
+		ETA_ClimbStop("Climb stopped");
+	}
+	if (eta_aim.mode != ETA_AIM_NONE)
+	{
+		ETA_AimStop();
+	}
+	eta_aim.manualUntil = cg.time + ETA_AIM_MANUAL_MS;
+
+	if (!eta_turnSteps.integer)
+	{
+		eta_turn.passthrough = direction;
+		ETA_TurnKey(direction, qtrue);
+		return;
+	}
+
+	if (eta_turn.step == direction)
+	{
+		/* Tapped again before the last step finished: one more point.
+		   Two quick taps are a quarter turn, as a flick would be. Held
+		   under half a turn, so which way is "still to go" can never be
+		   mistaken for which way is "already past". */
+		if (ETA_TurnRemaining() + 45.0f < 170.0f)
+		{
+			eta_turn.target = eta_turn.target - 45.0f * (float)direction;
+		}
+		eta_turn.held = direction;
+		return;
+	}
+
+	if (eta_turn.step)
+	{
+		/* The other way: stop where the view is and start from there. */
+		ETA_TurnStopStep(qfalse);
+	}
+
+	/* The compass is told the key is down only once this is known to be
+	   a hold (see CG_AccessibilityTurnFrame): a tap's own few degrees of
+	   travel are not worth a word before it lands. */
+	eta_turn.held      = direction;
+	eta_turn.pressedAt = cg.time;
+	eta_turn.startYaw  = cg.predictedPlayerState.viewangles[YAW];
+	ETA_TurnKey(direction, qtrue);
+}
+
+static void CG_AccessibilityTurnUp(int direction)
+{
+	if (eta_turn.passthrough == direction)
+	{
+		eta_turn.passthrough = 0;
+		ETA_TurnKey(direction, qfalse);
+		return;
+	}
+
+	if (eta_turn.held != direction)
+	{
+		return;
+	}
+
+	eta_turn.held = 0;
+
+	if (eta_turn.step == direction)
+	{
+		/* The step this press extended is still running; it carries on
+		   and releases the key when it arrives. */
+		return;
+	}
+
+	if (cg.time - eta_turn.pressedAt < ETA_TURN_TAP_MS)
+	{
+		/* A tap: keep the key down, and let the frame finish the turn. */
+		eta_turn.step        = direction;
+		eta_turn.stepStarted = cg.time;
+		eta_turn.target      = ETA_TurnNextPoint(eta_turn.startYaw, direction);
+
+		/* A long tap from just short of a point can already have
+		   carried the view past it. Then the next one is meant. */
+		if (ETA_TurnRemaining() < 0.0f)
+		{
+			eta_turn.target = eta_turn.target - 45.0f * (float)direction;
+		}
+
+		if (ETA_TurnRemaining() > ETA_TURN_SLOW_DEGREES)
+		{
+			ETA_TurnBoost(qtrue);
+		}
+		return;
+	}
+
+	/* A hold: it stops where it was let go. */
+	ETA_TurnKey(direction, qfalse);
+	ETA_HudNarrator_SetFacingKeyTurn(0);
+}
+
+/**
+ * @brief Every frame: brings a running step in to land on its point.
+ */
+void CG_AccessibilityTurnFrame(void)
+{
+	float remaining, perFrame;
+
+	/* Held past a tap: a smooth turn, and every point it crosses is
+	   worth naming as it is crossed. */
+	if (eta_turn.held && !eta_turn.step && cg.time - eta_turn.pressedAt >= ETA_TURN_TAP_MS)
+	{
+		ETA_HudNarrator_SetFacingKeyTurn(1);
+	}
+
+	if (!eta_turn.step)
+	{
+		return;
+	}
+
+	if (!cg.snap || cg.predictedPlayerState.pm_type != PM_NORMAL
+	    || cg.time - eta_turn.stepStarted > ETA_TURN_STEP_LIMIT_MS
+	    || cg.time < eta_turn.stepStarted)
+	{
+		ETA_TurnStopStep(qfalse);
+		return;
+	}
+
+	remaining = ETA_TurnRemaining();
+
+	if (eta_turn.fast && remaining <= ETA_TURN_SLOW_DEGREES)
+	{
+		ETA_TurnBoost(qfalse);
+	}
+
+	/* How far the next frame will carry the view. A release sent now
+	   takes effect before the next frame's movement, so letting go once
+	   less than half of that is left lands within half a frame's turn of
+	   the point - under a degree at the ordinary speed. */
+	perFrame = 0.14f * (float)cg.frametime * (eta_turn.fast ? ETA_TURN_FAST_FACTOR : 1.0f);
+
+	if (remaining <= perFrame * 0.5f)
+	{
+		ETA_TurnStopStep(qtrue);
+	}
+}
+
+/**
+ * @brief Whether a tap is still on its way to a compass point.
+ *
+ * The compass stands down meanwhile. The tap says where it lands the
+ * moment it lands, and a compass that named a point on the way would
+ * either say the wrong one or say the right one twice.
+ */
+qboolean CG_AccessibilityTurnBusy(void)
+{
+	return (qboolean)(eta_turn.step
+	                  || (eta_turn.held && cg.time - eta_turn.pressedAt < ETA_TURN_TAP_MS));
+}
+
+/**
+ * @brief Lets go of everything, for a map change or a shutdown.
+ *
+ * A key this pressed stays down in the client until something releases
+ * it, and the client outlives the cgame - left alone, the view would
+ * keep turning into the next map.
+ */
+void CG_AccessibilityTurnShutdown(void)
+{
+	if (eta_turn.step)
+	{
+		ETA_TurnStopStep(qfalse);
+	}
+	if (eta_turn.held)
+	{
+		ETA_TurnKey(eta_turn.held, qfalse);
+	}
+	if (eta_turn.passthrough)
+	{
+		ETA_TurnKey(eta_turn.passthrough, qfalse);
+	}
+	ETA_ClimbStop(NULL);
+	memset(&eta_climb, 0, sizeof(eta_climb));
+	ETA_AimStop();
+	ETA_UseKey(qfalse);
+	CG_AccessibilityMapCatchKeys(qfalse);
+	memset(&eta_aim, 0, sizeof(eta_aim));
+	memset(&eta_use, 0, sizeof(eta_use));
+	ETA_TurnBoost(qfalse);
+	ETA_HudNarrator_SetFacingKeyTurn(0);
+	memset(&eta_turn, 0, sizeof(eta_turn));
+}
+
+void CG_AccessibilityTurnLeftDown_f(void)
+{
+	CG_AccessibilityTurnDown(-1);
+}
+
+void CG_AccessibilityTurnLeftUp_f(void)
+{
+	CG_AccessibilityTurnUp(-1);
+}
+
+void CG_AccessibilityTurnRightDown_f(void)
+{
+	CG_AccessibilityTurnDown(1);
+}
+
+void CG_AccessibilityTurnRightUp_f(void)
+{
+	CG_AccessibilityTurnUp(1);
+}
diff --git a/src/cgame/cg_accessibility_map.c b/src/cgame/cg_accessibility_map.c
new file mode 100644
index 0000000..00d34d5
--- /dev/null
+++ b/src/cgame/cg_accessibility_map.c
@@ -0,0 +1,4036 @@
+/*
+ * name:	cg_accessibility_map.c
+ *
+ * desc:	[Accessibility]: the map, walked by keyboard, and the player's
+ *			own marker with the way to it: routes round walls and up
+ *			ladders, the way out of a building, the rooms, the sniper spots
+ *			and the survey of each square. Ported from the accessibility
+ *			mode's ET: Legacy cgame, its cg_commandmap.c.
+ *
+ *			Only built with FEATURE_ACCESSIBILITY.
+ */
+
+#include "cg_local.h"
+
+#include "hud/hud_narrator.h"
+#include "map/map_survey.h"
+#include "navigation/navigation_system.h"
+#include "navigation/place_classifier.h"
+#include "navigation/sniper_spots.h"
+#include "navigation/rooms.h"
+#include "speech/speech_manager.h"
+
+/* Whether a disguised player on the map passes for one of the player's
+   own, as the stock command map decides it: further than 512 units. */
+static qboolean ETA_DisguiseMapCheck(const mapEntityData_t *mEnt)
+{
+	if (mEnt->data < 0 || mEnt->data >= MAX_CLIENTS || !cgs.clientinfo[mEnt->data].infoValid)
+	{
+		return qfalse;
+	}
+	if (!(cg_entities[mEnt->data].currentState.powerups & (1 << PW_OPS_DISGUISED)))
+	{
+		return qfalse;
+	}
+	return (qboolean)(Distance(cg.snap->ps.origin, cg_entities[mEnt->data].lerpOrigin) >= 512);
+}
+
+/* How long the list of what is in one square may get. */
+#define ETA_MAP_CONTENTS_MAX 256
+#define ETA_MAP_PLACES_MAX   180   /* with the things, a spoken line still fits */
+
+static qboolean ETA_MapGrid(vec2_t start, vec2_t step, int *columns, int *rows)
+{
+	BG_GetLocationGrid(start, step);
+
+	if (step[0] <= 0.0f || step[1] <= 0.0f)
+	{
+		return qfalse;
+	}
+
+	/* cg.mapcoordsMins[1] is the *north* edge: the y axis runs the other
+	   way from the x axis here, which is also why the row arithmetic
+	   below subtracts rather than adds. CG_DrawGrid makes the same
+	   assumption a few hundred lines above. */
+	*columns = (int)((cg.mapcoordsMaxs[0] - start[0]) / step[0]) + 1;
+	*rows    = (int)((start[1] - cg.mapcoordsMaxs[1]) / step[1]) + 1;
+
+	if (*columns < 1 || *rows < 1)
+	{
+		return qfalse;
+	}
+
+	return qtrue;
+}
+
+/**
+ * @brief Which square a world position falls in.
+ *
+ * Deliberately the same expression as BG_GetLocationString, negative
+ * clamp included, so the square this reports for the player is the one
+ * the location narration would name for them.
+ */
+static void ETA_MapCellFor(float x, float y, int *column, int *row)
+{
+	vec2_t start, step;
+	int    columns, rows;
+
+	*column = 0;
+	*row    = 0;
+
+	if (!ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return;
+	}
+
+	*column = (int)((x - start[0]) / step[0]);
+	*row    = (int)((start[1] - y) / step[1]);
+
+	if (*column < 0)
+	{
+		*column = 0;
+	}
+	if (*row < 0)
+	{
+		*row = 0;
+	}
+	if (*column >= columns)
+	{
+		*column = columns - 1;
+	}
+	if (*row >= rows)
+	{
+		*row = rows - 1;
+	}
+}
+
+/**
+ * @brief The middle of a square, in world coordinates.
+ *
+ * The distance and bearing the survey speaks are to here. A square is a
+ * place rather than a thing, so its middle is the honest target - and
+ * it is what a player walking toward the square should aim at.
+ */
+static void ETA_MapCellCentre(int column, int row, vec2_t out)
+{
+	vec2_t start, step;
+	int    columns, rows;
+
+	out[0] = out[1] = 0.0f;
+
+	if (!ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return;
+	}
+
+	out[0] = start[0] + ((float)column + 0.5f) * step[0];
+	out[1] = start[1] - ((float)row + 0.5f) * step[1];
+}
+
+/**
+ * @brief Where a command map entry actually is in the world.
+ *
+ * Two sources, and which one is used matters enough to say out loud.
+ *
+ * mEnt->x / mEnt->y are what the server sent, quantized to 128-unit
+ * steps by CG_ParseMapEntity - a little over three meters. That is
+ * plenty for placing an icon and coarse for a spoken distance, but for
+ * anything outside the player's snapshot it is the only thing that
+ * exists, and the alternative is saying nothing at all.
+ *
+ * Where the entry is a player who *is* in the snapshot, their real
+ * position is right there in cg_entities, so it is used instead. That
+ * is not extra information - it is the same player, located properly.
+ *
+ * @param[in]  mEnt
+ * @param[out] origin
+ * @return qtrue when this entry has a position worth using
+ */
+static qboolean ETA_MapEntityOrigin(const mapEntityData_t *mEnt, vec3_t origin)
+{
+	int oidIndex = -1;
+
+	/* Objectives resolve through the same path the narration already
+	   uses, which reaches the real entity and its true position. */
+	if (CG_AccessibilityMapObjectiveAt(mEnt, origin, &oidIndex))
+	{
+		return qtrue;
+	}
+
+	if ((mEnt->type == ME_PLAYER || mEnt->type == ME_PLAYER_REVIVE
+	     || mEnt->type == ME_PLAYER_DISGUISED)
+	    && mEnt->data >= 0 && mEnt->data < MAX_CLIENTS
+	    && cg_entities[mEnt->data].currentValid)
+	{
+		VectorCopy(cg_entities[mEnt->data].lerpOrigin, origin);
+		return qtrue;
+	}
+
+	origin[0] = (float)mEnt->x;
+	origin[1] = (float)mEnt->y;
+	origin[2] = (float)mEnt->z;
+
+	return qtrue;
+}
+
+/**
+ * @brief Whether an entry is on the floor the survey is looking at.
+ *
+ * On a map built in layers a roof and a cellar sit in the same square,
+ * and merging them would have the survey report enemies overhead as
+ * though they were in the room.
+ */
+static qboolean ETA_MapEntityOnLayer(const mapEntityData_t *mEnt, int layer)
+{
+	if (!cgs.ccLayers)
+	{
+		return qtrue;
+	}
+
+	return (qboolean)(CG_CurLayerForZ(mEnt->z) == layer);
+}
+
+/**
+ * @brief Adds one phrase to the contents list, with its comma.
+ */
+static void ETA_MapAppend(char *out, size_t outSize, const char *text)
+{
+	if (out[0])
+	{
+		Q_strcat(out, (int)outSize, ", ");
+	}
+
+	Q_strcat(out, (int)outSize, text);
+}
+
+/**
+ * @brief Adds "one thing" / "two things" for a count.
+ */
+static void ETA_MapAppendCount(char *out, size_t outSize, int count,
+                               const char *singular, const char *plural)
+{
+	char phrase[64];
+
+	if (count <= 0)
+	{
+		return;
+	}
+
+	if (count == 1)
+	{
+		Com_sprintf(phrase, sizeof(phrase), "one %s", singular);
+	}
+	else
+	{
+		Com_sprintf(phrase, sizeof(phrase), "%d %s", count, plural);
+	}
+
+	ETA_MapAppend(out, outSize, phrase);
+}
+
+/**
+ * @brief What is standing in one square of the map.
+ *
+ * Who is where comes out of the command map's own entity list, which is
+ * what the server chose to send this player's team: teammates, enemies
+ * their team has actually spotted, mines their team has detected, the
+ * objectives, the spawn points. Nothing about a person is looked up
+ * anywhere else, and the filters a player has set on their map are
+ * honoured - so this says what is on their screen and never more.
+ *
+ * Two things are added that the command map leaves out, and both are
+ * fixtures rather than people: the capturable flags and the doors, from
+ * the map's own entity list. A sighted player sees a flagpole and a
+ * doorway by looking; a blind one had no way to find either.
+ *
+ * The order is deliberate and is not the order the list happens to be
+ * in. Enemies first, because an enemy is the thing that ends the run
+ * and a long sentence can be cut off by the next keypress. Objectives
+ * next, because that is what the survey is usually being asked. Then
+ * the furniture.
+ *
+ * @param[in]  column
+ * @param[in]  row
+ * @param[in]  layer
+ * @param[out] out
+ * @param[in]  outSize
+ * @return qtrue when there is anything there at all
+ */
+static qboolean ETA_MapCellContents(int column, int row, int layer, char *out, size_t outSize)
+{
+	char   objectives[ETA_MAP_CONTENTS_MAX];
+	char   spawns[ETA_MAP_CONTENTS_MAX];
+	int    i;
+	int    teammates = 0, enemies = 0, mines = 0, revives = 0;
+	int    doors = 0, lockedDoors = 0, ladders = 0;
+	team_t team      = cgs.clientinfo[cg.clientNum].team;
+
+	out[0]        = '\0';
+	objectives[0] = '\0';
+	spawns[0]     = '\0';
+
+	for (i = 0; i < CG_AccessibilityMapEntityCount(); i++)
+	{
+		const mapEntityData_t *mEnt = CG_AccessibilityMapEntity(i);
+		vec3_t                origin;
+		int                   entColumn, entRow;
+		int                   oidIndex = -1;
+
+		if (!ETA_MapEntityOnLayer(mEnt, layer))
+		{
+			continue;
+		}
+
+		if (!ETA_MapEntityOrigin(mEnt, origin))
+		{
+			continue;
+		}
+
+		ETA_MapCellFor(origin[0], origin[1], &entColumn, &entRow);
+
+		if (entColumn != column || entRow != row)
+		{
+			continue;
+		}
+
+		switch (mEnt->type)
+		{
+		case ME_PLAYER:
+		case ME_PLAYER_REVIVE:
+		case ME_PLAYER_DISGUISED:
+			/* A disguised covert operative counts as whatever a sighted
+			   player would believe they are, decided by the engine's own
+			   check - the same rule the crosshair cue follows. Seeing
+			   through the disguise here would be an advantage no player
+			   has ever had. */
+			if (mEnt->team == team && !ETA_DisguiseMapCheck(mEnt))
+			{
+				if (mEnt->type == ME_PLAYER_REVIVE)
+				{
+					revives++;
+				}
+				else
+				{
+					teammates++;
+				}
+			}
+			else if (mEnt->team != team)
+			{
+				enemies++;
+			}
+			break;
+		case ME_LANDMINE:
+			mines++;
+			break;
+		case ME_CONSTRUCT:
+		case ME_DESTRUCT:
+		case ME_DESTRUCT_2:
+		case ME_TANK:
+		case ME_TANK_DEAD:
+		case ME_COMMANDMAP_MARKER:
+			if (CG_AccessibilityMapObjectiveAt(mEnt, origin, &oidIndex)
+			    && oidIndex >= 0 && oidIndex < MAX_OID_TRIGGERS
+			    && cgs.oidInfo[oidIndex].name[0])
+			{
+				char name[64];
+
+				Q_strncpyz(name, cgs.oidInfo[oidIndex].name, sizeof(name));
+				Q_CleanStr(name);
+
+				if (name[0])
+				{
+					ETA_MapAppend(objectives, sizeof(objectives), name);
+				}
+			}
+			break;
+		default:
+			break;
+		}
+	}
+
+	/* The flags and the doors are not on the command map's list at all:
+	   they come from the map's own entity list, which says where each
+	   flagpole and door stands (cg_spawn.c). Neither is anything a
+	   sighted player lacks - a flagpole and a door are there to be seen,
+	   and who holds a flag is announced to the whole server when it
+	   changes hands. */
+	for (i = 0; i < CG_AccessibilityFlagCount(); i++)
+	{
+		vec3_t     origin;
+		int        holder, flagColumn, flagRow;
+		qboolean   takeable;
+		const char *phrase;
+
+		if (!CG_AccessibilityFlag(i, origin, &holder, &takeable))
+		{
+			continue;
+		}
+
+		if (cgs.ccLayers && CG_CurLayerForZ((int)origin[2]) != layer)
+		{
+			continue;
+		}
+
+		ETA_MapCellFor(origin[0], origin[1], &flagColumn, &flagRow);
+
+		if (flagColumn != column || flagRow != row)
+		{
+			continue;
+		}
+
+		if (holder < 0)
+		{
+			phrase = "flag";
+		}
+		else if (holder == team)
+		{
+			phrase = "your team's flag";
+		}
+		else if (holder == TEAM_FREE)
+		{
+			phrase = takeable ? "flag to capture, nobody holds it" : "flag, nobody holds it";
+		}
+		else
+		{
+			phrase = takeable ? "enemy flag to capture" : "enemy flag";
+		}
+
+		ETA_MapAppend(objectives, sizeof(objectives), phrase);
+	}
+
+	for (i = 1; i < MAX_MODELS; i++)
+	{
+		vec3_t   origin;
+		qboolean opens;
+		int      doorColumn, doorRow;
+
+		if (!CG_AccessibilityDoorAt(i, origin, &opens))
+		{
+			continue;
+		}
+
+		if (cgs.ccLayers && CG_CurLayerForZ((int)origin[2]) != layer)
+		{
+			continue;
+		}
+
+		ETA_MapCellFor(origin[0], origin[1], &doorColumn, &doorRow);
+
+		if (doorColumn == column && doorRow == row)
+		{
+			if (opens)
+			{
+				doors++;
+			}
+			else
+			{
+				lockedDoors++;
+			}
+		}
+	}
+
+	/* Ladders, from the map file (cg_draw.c): counted in the square the
+	   middle of the ladder stands in, on the layer its foot is on. */
+	for (i = 0; i < CG_AccessibilityLadderCount(); i++)
+	{
+		vec3_t mins, maxs;
+		int    ladderColumn, ladderRow;
+
+		if (!CG_AccessibilityMapLadder(i, mins, maxs))
+		{
+			continue;
+		}
+
+		if (cgs.ccLayers && CG_CurLayerForZ((int)mins[2]) != layer)
+		{
+			continue;
+		}
+
+		ETA_MapCellFor((mins[0] + maxs[0]) * 0.5f, (mins[1] + maxs[1]) * 0.5f, &ladderColumn, &ladderRow);
+
+		if (ladderColumn == column && ladderRow == row)
+		{
+			ladders++;
+		}
+	}
+
+	/* Spawn points are their own list, not part of the entity one. */
+	if (!(cgs.ccFilter & CC_FILTER_SPAWNS))
+	{
+		for (i = 1; i < cg.spawnCount; i++)
+		{
+			int spawnColumn, spawnRow;
+
+			if (cg.spawnTeams[i] & 256)
+			{
+				continue;
+			}
+
+			if (cgs.ccLayers
+			    && CG_CurLayerForZ((int)cg.spawnCoordsUntransformed[i][2]) != layer)
+			{
+				continue;
+			}
+
+			ETA_MapCellFor(cg.spawnCoordsUntransformed[i][0],
+			               cg.spawnCoordsUntransformed[i][1],
+			               &spawnColumn, &spawnRow);
+
+			if (spawnColumn != column || spawnRow != row)
+			{
+				continue;
+			}
+
+			if (cg.spawnPoints[i][0])
+			{
+				char name[MAX_SPAWNDESC + 16];
+
+				Q_strncpyz(name, cg.spawnPoints[i], sizeof(name));
+				Q_CleanStr(name);
+
+				if (name[0])
+				{
+					Q_strcat(name, sizeof(name), " spawn");
+					ETA_MapAppend(spawns, sizeof(spawns), name);
+				}
+			}
+		}
+	}
+
+	/* Assembled in this order on purpose, and the order is the design.
+	   Speech delivers a new line by cutting off the one in progress, and
+	   a player walking the grid presses the next key before a long
+	   sentence finishes - so whatever must survive being cut off has to
+	   be said first. An enemy is what ends the run; the objective is
+	   what the survey is usually being asked; the furniture can wait. */
+	ETA_MapAppendCount(out, outSize, enemies, "enemy", "enemies");
+
+	if (objectives[0])
+	{
+		ETA_MapAppend(out, outSize, objectives);
+	}
+
+	if (spawns[0])
+	{
+		ETA_MapAppend(out, outSize, spawns);
+	}
+
+	ETA_MapAppendCount(out, outSize, revives, "teammate waiting for a revive",
+	                   "teammates waiting for a revive");
+	ETA_MapAppendCount(out, outSize, mines, "landmine", "landmines");
+	ETA_MapAppendCount(out, outSize, teammates, "teammate", "teammates");
+
+	/* A door is the way into a building and a ladder the way up or down
+	   inside one, which is why they are here at all; but they never
+	   move, so they are said last. */
+	ETA_MapAppendCount(out, outSize, doors, "door", "doors");
+	ETA_MapAppendCount(out, outSize, lockedDoors, "locked door", "locked doors");
+	ETA_MapAppendCount(out, outSize, ladders, "ladder", "ladders");
+
+	return (qboolean)(out[0] != '\0');
+}
+
+/**
+ * @brief The survey cursor, and where the player was when it opened.
+ */
+static ETA_MapCursor eta_mapCursor;
+
+/**
+ * @brief Speaks the square the cursor is on.
+ *
+ * Distance and bearing are to the middle of the square, because a
+ * square is a place rather than a thing. Both are left out for the
+ * square the player is standing in - there is no distance to give and
+ * no direction to turn - which is also how they hear that they have
+ * found themselves on the map.
+ */
+static void ETA_MapCellPlaces(int column, int row, int layer, char *out, size_t outSize);
+static int  ETA_RoomsInCell(int column, int row);
+
+static void ETA_MapSpeakCell(void)
+{
+	char   contents[ETA_MAP_CONTENTS_MAX + ETA_MAP_PLACES_MAX];
+	vec2_t centre;
+	vec3_t to;
+	int    playerColumn, playerRow;
+	int    distance = -1, bearing = -1;
+
+	if (!ETA_MapSurvey_IsOpen(&eta_mapCursor) || !cg.snap)
+	{
+		return;
+	}
+
+	ETA_MapCellContents(eta_mapCursor.column, eta_mapCursor.row,
+	                    eta_mapCursor.layer, contents, ETA_MAP_CONTENTS_MAX);
+
+	/* Then what kind of places it holds - after the things, which move
+	   and can end the run, and before nothing: a square with no things
+	   in it is described rather than called empty. */
+	{
+		char   places[ETA_MAP_PLACES_MAX];
+		size_t used = strlen(contents);
+
+		ETA_MapCellPlaces(eta_mapCursor.column, eta_mapCursor.row, eta_mapCursor.layer,
+		                  places, sizeof(places));
+
+		if (places[0])
+		{
+			Com_sprintf(contents + used, (int)(sizeof(contents) - used), "%s%s",
+			            used ? ", " : "", places);
+		}
+
+		/* And how many rooms there are in it to walk to. */
+		{
+			int rooms = ETA_RoomsInCell(eta_mapCursor.column, eta_mapCursor.row);
+
+			if (rooms > 0)
+			{
+				used = strlen(contents);
+				Com_sprintf(contents + used, (int)(sizeof(contents) - used), "%s%s",
+				            used ? ", " : "", rooms == 1 ? "one room" : va("%d rooms", rooms));
+			}
+		}
+	}
+
+	ETA_MapCellFor(cg.predictedPlayerState.origin[0],
+	               cg.predictedPlayerState.origin[1],
+	               &playerColumn, &playerRow);
+
+	if (playerColumn != eta_mapCursor.column || playerRow != eta_mapCursor.row
+	    || (cgs.ccLayers
+	        && CG_CurLayerForZ((int)cg.predictedPlayerState.origin[2]) != eta_mapCursor.layer))
+	{
+		ETA_MapCellCentre(eta_mapCursor.column, eta_mapCursor.row, centre);
+
+		to[0] = centre[0] - cg.predictedPlayerState.origin[0];
+		to[1] = centre[1] - cg.predictedPlayerState.origin[1];
+		to[2] = 0.0f;
+
+		distance = (int)(VectorLength(to) * ETA_QU_TO_METERS);
+		bearing  = (int)(ETA_HudNarrator_BearingFromYaw(vectoyaw(to)) + 0.5f) % 360;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakMapCell(ETA_MapSurvey_CellName(&eta_mapCursor),
+	                             contents[0] ? contents : NULL,
+	                             distance, bearing);
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Opens the survey on the square the player is standing in.
+ *
+ * Starting under the player's own feet rather than at a corner is what
+ * makes the first announcement mean something: it says where they are,
+ * in the grid the rest of the team is using, and every step from there
+ * is relative to somewhere they already understand.
+ *
+ * @return qtrue when the survey is usable
+ */
+static qboolean ETA_MapSurveyOpen(void)
+{
+	vec2_t start, step;
+	int    columns, rows;
+	int    column, row, layer = 0;
+
+	if (!cg.snap || !ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return qfalse;
+	}
+
+	if (!ETA_MapSurvey_Open(&eta_mapCursor, columns, rows,
+	                        cgs.ccLayers ? cgs.ccLayers : 1))
+	{
+		return qfalse;
+	}
+
+	ETA_MapCellFor(cg.predictedPlayerState.origin[0],
+	               cg.predictedPlayerState.origin[1], &column, &row);
+
+	if (cgs.ccLayers)
+	{
+		layer = CG_CurLayerForZ((int)cg.predictedPlayerState.origin[2]);
+	}
+
+	ETA_MapSurvey_MoveTo(&eta_mapCursor, column, row, layer);
+
+	return qtrue;
+}
+
+/**
+ * @brief Walks the cursor one square, and says what is there.
+ *
+ * A step that runs off the edge is announced as one. On a grid the
+ * player cannot see, a keypress that does nothing and a keypress that
+ * did not register are the same event, and they would press it again.
+ */
+void CG_AccessibilityMapStep(int step)
+{
+	if (!eta_mapCallouts.integer || !cgs.autoMapExpanded)
+	{
+		return;
+	}
+
+	if (!ETA_MapSurvey_IsOpen(&eta_mapCursor) && !ETA_MapSurveyOpen())
+	{
+		return;
+	}
+
+	if (!ETA_MapSurvey_Step(&eta_mapCursor, (ETA_MapStep)step))
+	{
+		ETA_Speech_BeginReport();
+		ETA_HudNarrator_SpeakMapEdge();
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	ETA_MapSpeakCell();
+}
+
+/**
+ * @brief Up or down a floor, on a map built in layers.
+ */
+void CG_AccessibilityMapLayer(int delta)
+{
+	if (!eta_mapCallouts.integer || !cgs.autoMapExpanded)
+	{
+		return;
+	}
+
+	if (!ETA_MapSurvey_IsOpen(&eta_mapCursor) && !ETA_MapSurveyOpen())
+	{
+		return;
+	}
+
+	if (!ETA_MapSurvey_StepLayer(&eta_mapCursor, delta))
+	{
+		ETA_Speech_BeginReport();
+		ETA_HudNarrator_SpeakMapEdge();
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakMapLayer(eta_mapCursor.layer, eta_mapCursor.layerCount);
+	ETA_Speech_EndReport();
+
+	ETA_MapSpeakCell();
+}
+
+/**
+ * @brief Puts the cursor back on the player.
+ */
+void CG_AccessibilityMapHome(void)
+{
+	if (!eta_mapCallouts.integer || !cgs.autoMapExpanded)
+	{
+		return;
+	}
+
+	if (!ETA_MapSurveyOpen())
+	{
+		return;
+	}
+
+	ETA_MapSpeakCell();
+}
+
+/**
+ * @brief Jumps to the next square with anything in it.
+ *
+ * Reading order - along each row, then down to the next - because that
+ * is the order the squares are named in and the only one a player can
+ * predict. It wraps once round the whole map and stops where it
+ * started, so a map with nothing left on it says so rather than
+ * spinning.
+ */
+void CG_AccessibilityMapNext(void)
+{
+	char contents[ETA_MAP_CONTENTS_MAX];
+	int  cells, i;
+	int  index;
+
+	if (!eta_mapCallouts.integer || !cgs.autoMapExpanded)
+	{
+		return;
+	}
+
+	if (!ETA_MapSurvey_IsOpen(&eta_mapCursor) && !ETA_MapSurveyOpen())
+	{
+		return;
+	}
+
+	cells = eta_mapCursor.columnCount * eta_mapCursor.rowCount;
+	index = eta_mapCursor.row * eta_mapCursor.columnCount + eta_mapCursor.column;
+
+	for (i = 1; i <= cells; i++)
+	{
+		int next   = (index + i) % cells;
+		int column = next % eta_mapCursor.columnCount;
+		int row    = next / eta_mapCursor.columnCount;
+
+		if (!ETA_MapCellContents(column, row, eta_mapCursor.layer,
+		                         contents, sizeof(contents)))
+		{
+			continue;
+		}
+
+		ETA_MapSurvey_MoveTo(&eta_mapCursor, column, row, eta_mapCursor.layer);
+		ETA_MapSpeakCell();
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say("Nothing else on this floor");
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Closes the survey when the map key is released.
+ *
+ * The cursor is deliberately not kept. Opening the map again starts
+ * from where the player is standing, which by then is somewhere else -
+ * and a cursor restored to a square they have since walked away from
+ * would be describing the battlefield relative to a position they no
+ * longer hold.
+ */
+void CG_AccessibilityMapClosed(void)
+{
+	ETA_MapSurvey_Close(&eta_mapCursor);
+}
+
+/**
+ * @brief A place the player chose to go, and the way there.
+ *
+ * The game has nothing like it. A sighted player does not need one: they
+ * look at the far side of the bridge, decide to go there, and go. What
+ * they are using is not the map, it is the ability to pick a destination
+ * of their own and keep it in view. The objective guidance cannot stand
+ * in for that - it only ever points where the map's script says - so
+ * this lets the player put down a destination and then hears them to it.
+ *
+ * Two kinds, from one key. With the command map up and the survey cursor
+ * moved onto a square, the marker goes on that square: anywhere on the
+ * map, in the grid the rest of the team already speaks. With the map
+ * down, it goes where the player is standing, which is how they get back
+ * to a spot - a doorway they found, the corner they were holding - after
+ * a death or a detour.
+ */
+typedef struct
+{
+	qboolean active;
+	qboolean square;   /* a map square rather than a spot */
+	qboolean leftIt;   /* has been far enough away for arriving to mean something */
+	qboolean objective;/* put on the objective, which has a name of its own */
+	vec3_t origin;     /* the spot, or the square's middle */
+	int column, row, layer;
+	char name[48];     /* the square's name, "C,3", or the objective's */
+} eta_marker_t;
+
+static eta_marker_t eta_marker;
+
+/**
+ * @brief How close to a spot counts as having reached it.
+ *
+ * A spot marker is where the player stood, so three metres is "back on
+ * it" without asking them to find the exact footprint. A square is
+ * reached by walking into it, which the grid decides rather than this.
+ */
+#define ETA_MARKER_ARRIVE_METERS 3.0f
+
+/**
+ * @brief How far toward the marker its sound is placed.
+ *
+ * The sound has to point, not to be where the marker is: a marker on the
+ * far side of the map would be far outside the engine's hearing range
+ * and play as silence. So it sits a few metres off in the marker's
+ * direction, where the engine gives it a clear left and right, and only
+ * closes to the marker itself once the player is nearer than this. That
+ * last part is what lets them walk onto it by ear.
+ */
+#define ETA_MARKER_BEACON_DISTANCE 256.0f
+
+/**
+ * @brief Where the player's ears are.
+ */
+static void ETA_MarkerEye(vec3_t eye)
+{
+	VectorCopy(cg.predictedPlayerState.origin, eye);
+	eye[2] += cg.predictedPlayerState.viewheight;
+}
+
+/**
+ * @brief How far from a square's middle still counts as being in it.
+ *
+ * A square is reached by walking into it anywhere, and its middle can be
+ * inside a building; the way there only has to get into the square.
+ */
+static float ETA_MarkerSquareRadius(void)
+{
+	vec2_t start, step;
+	int    columns, rows;
+
+	if (!ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return 256.0f;
+	}
+
+	return 0.45f * MIN(step[0], step[1]);
+}
+
+/**
+ * @brief The walkable way to the marker, around the walls.
+ *
+ * The ping used to sit straight toward the marker, and a tester reported
+ * what that does to someone who cannot see: it leads them into the wall
+ * between them and it, not to the doorway a sighted player would walk
+ * to without thinking. Two things now stand in the way of that.
+ *
+ * The way: the library's search (ETA_PathFinder) looks for a walkable
+ * way to the marker over a grid of half-metre squares, a little every
+ * frame, and the ping points at the furthest point of it that can be
+ * walked to in a straight line. Round a corner, that point moves on.
+ *
+ * The opening: whatever the ping is pointing at, several times a second
+ * the mod checks that the player could actually walk toward it. When a
+ * wall is in the way - because the way is not found yet, or the marker
+ * is too far for the search to reach, or it is a straight line that
+ * clips a corner - the ping moves to the nearest open way out, the one
+ * closest to where it was pointing. So it never points into a wall, from
+ * the moment the marker goes down. The first reported attempt pointed
+ * straight until a search finished, and on a real map, with the marker
+ * across the map behind a long wall, the search could run out of room
+ * first - so it pointed into the wall for good. tests/marker_route_sim
+ * _test.py walks a player to the marker by the ping through scenes like
+ * that one.
+ *
+ * The walk is judged against the map's own brushes alone. A closed door
+ * is a way through - it opens when used - and so is anything else that
+ * moves. The probe stands a step high, so kerbs and stairs are walked
+ * up; it is refused wherever the floor falls away further than a safe
+ * drop, and wherever the floor is lava or slime.
+ *
+ * It is 32 units across, against a player's 36. It was 24, so that a
+ * doorway would be found wherever the squares fell - and on the real
+ * Oasis map that sent the way to the Allied Command Post between a post
+ * and a ramp, through a gap the probe fitted and a player does not. A
+ * walk following the ping stopped there for good, which is what the
+ * tester met. 32 still finds every doorway a player uses: the squares
+ * are 32 apart, so a 64-unit doorway always has one with 16 to spare on
+ * each side.
+ */
+#define ETA_ROUTE_CELL          32.0f
+#define ETA_ROUTE_HALF_WIDTH    16.0f
+#define ETA_ROUTE_SLOPE_LIFT    20.0f   /* a second try, higher, for ramps */
+#define ETA_ROUTE_JUMP_LIFT     24.0f   /* a third, for a ledge to jump onto */
+#define ETA_ROUTE_MAX_DROP      96.0f
+#define ETA_ROUTE_BUDGET_MS     2       /* searching per frame, at most */
+#define ETA_ROUTE_BUDGET_STEP   4       /* squares between looks at the clock */
+#define ETA_ROUTE_REPLAN_MS     5000    /* the world changes: look again */
+#define ETA_ROUTE_RETRY_MS      3000    /* after finding no way at all */
+#define ETA_ROUTE_STRAY         128.0f  /* this far off the way: replan */
+#define ETA_ROUTE_STEER_MS      150
+#define ETA_ROUTE_LOOKAHEAD     16      /* points ahead worth checking */
+#define ETA_ROUTE_CLEAR_AHEAD   320.0f  /* how far toward the ping must be walkable */
+#define ETA_ROUTE_OPENING_REACH 512.0f  /* how far an opening is looked down */
+#define ETA_ROUTE_OPENING_MIN   192.0f  /* how far it must run to count */
+#define ETA_ROUTE_OPENING_STEP  15      /* degrees between the looks */
+#define ETA_ROUTE_ON_WAY        48.0f   /* this near the way's point: on it */
+
+typedef struct
+{
+	qboolean planned;     /* a search has been started for this marker */
+	int      startedAt;
+	qboolean done;        /* the current search has finished */
+	int      doneAt;
+	vec3_t   steer;       /* the point along the way */
+	qboolean steering;    /* steer is from the way, not the straight line */
+	vec3_t   aim;         /* where the ping and the turn words point */
+	qboolean aimSet;
+	int      steeredAt;
+	int      along;       /* the point of the way the player is at */
+	int      side;        /* which way round the last opening was: -1, 1, 0 */
+	int      saidJump;    /* the jump on the way last told of, by its point */
+	qboolean crouched;    /* told to crouch, and not yet to stand */
+	qboolean overEdge;    /* steer is across a jump or up a ladder */
+	qboolean onWay;       /* steer is the way's next point, from on the way */
+	qboolean jumps;       /* this search may jump: there was no way without */
+	qboolean throughMines; /* this search may cross a mine: there was no way round */
+	vec3_t   stairsAt;    /* the foot of the stairs last told of */
+	qboolean saidStairs;
+} eta_route_t;
+
+static eta_route_t eta_route;
+
+/**
+ * @brief Whether a whole player fits through the step, the probe aside.
+ *
+ * The probe that finds the way is narrower than a player, so that a
+ * doorway is found wherever the squares fall. That let the way through
+ * gaps a player does not fit: a walk following the ping on the real
+ * Oasis stopped for good at two of them, and the ping pointed at the
+ * gap the whole time. So each step is tried once more with the player's
+ * own width and standing height, from the middle of the square or a
+ * little to either side of it - a doorway the square's middle is
+ * off-centre in is still found - and the way keeps to wherever it
+ * fitted. The probe is only as tall as a crouching player, and nothing
+ * tells the player to crouch, so a way under something lower than a
+ * standing player is no way.
+ */
+#define ETA_ROUTE_BODY_HALF  18.0f   /* the player's own: -18 to 18 */
+#define ETA_ROUTE_BODY_NUDGE 10.0f
+#define ETA_ROUTE_BODY_TOP   48.0f   /* standing: playerMaxs in g_client.c */
+/* Crouched: the game's crouchMaxZ, standing less the drop from the
+   standing to the crouching view (40 - 16). The tunnels under Oasis are
+   lower than a player standing; the way refused them, and the way out of
+   them was never found. */
+#define ETA_ROUTE_CROUCH_TOP (ETA_ROUTE_BODY_TOP - (40.0f - 16.0f))
+
+static qboolean ETA_RouteRoom(const float from[3], float to[3], float lift, float top)
+{
+	static const vec3_t mins = { -ETA_ROUTE_BODY_HALF, -ETA_ROUTE_BODY_HALF, -24.0f + 18.0f };
+	static const vec3_t snugMins = { -ETA_ROUTE_BODY_HALF + 1.0f, -ETA_ROUTE_BODY_HALF + 1.0f, -24.0f + 18.0f };
+	const vec3_t        maxs     = { ETA_ROUTE_BODY_HALF, ETA_ROUTE_BODY_HALF, top };
+	const vec3_t        snugMaxs = { ETA_ROUTE_BODY_HALF - 1.0f, ETA_ROUTE_BODY_HALF - 1.0f, top };
+	static const float  nudges[5][2] =
+	{
+		{ 0.0f, 0.0f },
+		{ ETA_ROUTE_BODY_NUDGE, 0.0f }, { -ETA_ROUTE_BODY_NUDGE, 0.0f },
+		{ 0.0f, ETA_ROUTE_BODY_NUDGE }, { 0.0f, -ETA_ROUTE_BODY_NUDGE }
+	};
+	trace_t trace;
+	vec3_t  start, end;
+	int     i;
+
+	VectorSet(start, from[0], from[1], from[2] + lift);
+
+	for (i = 0; i < 5; i++)
+	{
+		VectorSet(end, to[0] + nudges[i][0], to[1] + nudges[i][1], from[2] + lift);
+		trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+		/* A player pressed against a wall touches it, and a box the
+		   player's own size set down there touches it too: the way out
+		   of a gap the player is standing in is tried a hair narrower,
+		   and only where they end up has to take their whole width. */
+		if (trace.startsolid)
+		{
+			trap_CM_BoxTrace(&trace, start, end, snugMins, snugMaxs, 0, MASK_PLAYERSOLID);
+			if (!trace.startsolid && trace.fraction >= 1.0f)
+			{
+				trap_CM_BoxTrace(&trace, end, end, mins, maxs, 0, MASK_PLAYERSOLID);
+			}
+			else
+			{
+				continue;
+			}
+		}
+
+		if (!trace.startsolid && trace.fraction >= 1.0f)
+		{
+			to[0] = end[0];
+			to[1] = end[1];
+			return qtrue;
+		}
+	}
+
+	return qfalse;
+}
+
+/**
+ * @brief Can a player walk one square, and at what height do they land.
+ */
+static int ETA_RouteMoveExact(void *context, const float from[3], float to[3])
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	/* The same body lowered a step onto the floor: bottom at the feet, top
+	   no higher than the probe above reached, so a low passage the
+	   sideways check fitted through is not refused on the way down. */
+	static const vec3_t footMins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f };
+	static const vec3_t footMaxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f - 18.0f };
+	static const float lifts[2] = { ETA_ROUTE_SLOPE_LIFT, ETA_ROUTE_JUMP_LIFT };
+	trace_t  trace;
+	vec3_t   start, end, down;
+	float    lift   = 0.0f;
+	qboolean ledge  = qfalse;
+	qboolean crouch = qfalse;
+	int      i;
+
+	(void)context;
+
+	VectorCopy(from, start);
+	VectorSet(end, to[0], to[1], from[2]);
+
+	trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.fraction < 1.0f)
+	{
+		/* What stopped the step: a slope rises faster than a step over
+		   one square, but its face leans back. A face that stands
+		   straight up is the edge of a ledge, which no amount of walking
+		   gets onto - it is jumped. */
+		/* Anything steeper than the game lets a player walk up - its
+		   MIN_WALK_NORMAL, 0.7 - is a face, not a slope: a rock leaning
+		   back a little was taken for a ramp beside the Axis command
+		   post on Oasis, and the way said to walk up it. */
+		ledge = (qboolean)(!trace.startsolid && trace.plane.normal[2] < 0.7f);
+
+		/* Again a little higher, and then as high as a jump reaches, if
+		   there is headroom to get there. ET's jump lifts the feet about
+		   45 units (JUMP_VELOCITY 270 against gravity 800); the probe's
+		   bottom stands a step above the feet, so a lift of 24 clears a
+		   ledge of 42 - a little short of the most, to leave room. */
+		for (i = 0; i < 2; i++)
+		{
+			lift = lifts[i];
+			VectorCopy(from, start);
+			VectorCopy(from, end);
+			end[2] += lift;
+			trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+			if (trace.startsolid || trace.fraction < 1.0f)
+			{
+				return ETA_PATH_NONE;
+			}
+
+			VectorCopy(end, start);
+			VectorSet(end, to[0], to[1], from[2] + lift);
+			trap_CM_BoxTrace(&trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID);
+
+			if (!trace.startsolid && trace.fraction >= 1.0f)
+			{
+				break;
+			}
+		}
+
+		if (i == 2)
+		{
+			return ETA_PATH_NONE;
+		}
+
+		/* Only a jump clears the higher of the two. */
+		if (i == 1)
+		{
+			ledge = qtrue;
+		}
+	}
+
+	/* Room for the player standing; or, on the level, crouched - a jump
+	   wants the headroom a crouch has not got. */
+	if (!ETA_RouteRoom(from, to, lift, ETA_ROUTE_BODY_TOP))
+	{
+		if (ledge || !ETA_RouteRoom(from, to, lift, ETA_ROUTE_CROUCH_TOP))
+		{
+			return ETA_PATH_NONE;
+		}
+		crouch = qtrue;
+	}
+	end[0] = to[0];
+	end[1] = to[1];
+
+	/* Down onto the floor there, from a step up. */
+	VectorCopy(end, start);
+	start[2] += 18.0f;
+	VectorCopy(start, down);
+	down[2] -= 18.0f + lift + ETA_ROUTE_MAX_DROP;
+
+	trap_CM_BoxTrace(&trace, start, down, footMins, footMaxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f
+	    || trace.plane.normal[2] < 0.7f)
+	{
+		return ETA_PATH_NONE;
+	}
+
+	if (CG_PointContents(trace.endpos, -1) & (CONTENTS_LAVA | CONTENTS_SLIME))
+	{
+		return ETA_PATH_NONE;
+	}
+
+	to[2] = trace.endpos[2];
+
+	/* Up onto a ledge, or over something and down the other side: either
+	   way the player has to jump, and is told to. Under a low ceiling,
+	   to crouch. */
+	return ledge ? ETA_PATH_JUMP : crouch ? ETA_PATH_CROUCH : ETA_PATH_WALK;
+}
+
+/**
+ * @brief The landmines the player has been shown: the way keeps clear
+ * of them.
+ *
+ * The tester kept dying to landmines. Only the ones the game shows the
+ * player are here - spotted by a teammate, or seen with the skill to see
+ * them (cg_draw.c sets them each frame) - so the way never steers round
+ * a mine a sighted player could not know of. A mine goes off for a
+ * player 64 units from it (sEntWillTriggerMine), so a square nearer
+ * than that and a little more is no square to step on. Where there is
+ * no way round - a mine in the one doorway - the way goes on through,
+ * and the warning says it is there.
+ */
+#define ETA_ROUTE_AVOID_RADIUS 72.0f
+#define ETA_ROUTE_AVOID_MAX    32   /* the most kept clear of at once */
+
+static float    eta_routeAvoid[ETA_ROUTE_AVOID_MAX][3];
+static int      eta_routeAvoidCount;
+static qboolean eta_routeAvoidNew;   /* a mine not known when the way was planned */
+
+void CG_AccessibilityRouteAvoid(const float (*points)[3], int count)
+{
+	float was[ETA_ROUTE_AVOID_MAX][3];
+	int   wasCount = eta_routeAvoidCount, i, k;
+
+	memcpy(was, eta_routeAvoid, sizeof(was));
+	eta_routeAvoidCount = 0;
+	for (i = 0; i < count && i < ETA_ROUTE_AVOID_MAX; i++)
+	{
+		qboolean known = qfalse;
+
+		eta_routeAvoid[i][0] = points[i][0];
+		eta_routeAvoid[i][1] = points[i][1];
+		eta_routeAvoid[i][2] = points[i][2];
+		eta_routeAvoidCount++;
+
+		for (k = 0; k < wasCount && !known; k++)
+		{
+			known = fabs(was[k][0] - points[i][0]) < 1.0f && fabs(was[k][1] - points[i][1]) < 1.0f
+			        && fabs(was[k][2] - points[i][2]) < 1.0f;
+		}
+		if (!known)
+		{
+			eta_routeAvoidNew = qtrue;
+		}
+	}
+}
+
+static qboolean ETA_RouteAvoided(const float at[3])
+{
+	int i;
+
+	if (eta_route.throughMines)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < eta_routeAvoidCount; i++)
+	{
+		float dx = at[0] - eta_routeAvoid[i][0], dy = at[1] - eta_routeAvoid[i][1];
+
+		if (dx * dx + dy * dy < ETA_ROUTE_AVOID_RADIUS * ETA_ROUTE_AVOID_RADIUS
+		    && fabs(at[2] - eta_routeAvoid[i][2]) < 64.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/**
+ * @brief Whether a straight walk goes nearer a mine than the way keeps.
+ *
+ * Every step of the way, and the straight walks that follow it: the way
+ * is followed by walking straight to the furthest point of it that can
+ * be walked to, which cuts its corners - and a corner round a mine, cut,
+ * goes over the mine. A walk that only takes the player further from a
+ * mine they are already near is let through: it is the way out.
+ */
+static qboolean ETA_RouteLineAvoided(const float from[3], const float to[3])
+{
+	float dx = to[0] - from[0], dy = to[1] - from[1];
+	float length2 = dx * dx + dy * dy;
+	int   i;
+
+	if (eta_route.throughMines)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < eta_routeAvoidCount; i++)
+	{
+		const float *mine = eta_routeAvoid[i];
+		float       f     = length2 > 0.0f ? ((mine[0] - from[0]) * dx + (mine[1] - from[1]) * dy) / length2 : 0.0f;
+		float       ax, ay, closest, already;
+
+		if (fabs(from[2] - mine[2]) >= 64.0f && fabs(to[2] - mine[2]) >= 64.0f)
+		{
+			continue;
+		}
+
+		f       = f < 0.0f ? 0.0f : f > 1.0f ? 1.0f : f;
+		ax      = from[0] + dx * f - mine[0];
+		ay      = from[1] + dy * f - mine[1];
+		closest = sqrt(ax * ax + ay * ay);
+		already = sqrt((from[0] - mine[0]) * (from[0] - mine[0]) + (from[1] - mine[1]) * (from[1] - mine[1]));
+
+		if (closest < ETA_ROUTE_AVOID_RADIUS && closest < already - 1.0f)
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+/**
+ * @brief A step to the next square, or to a point a little to either
+ * side of it.
+ *
+ * The squares are laid out from wherever the player stood when the way
+ * was asked for, so a gap narrower than a square is on the way only when
+ * the squares happen to fall inside it. On Oasis the short way to the
+ * Allied command post goes through such a gap, a narrow alley a little
+ * over a body wide: from some places the squares fell in it and the way
+ * went straight there, from others they fell on its walls and the way
+ * went right round through the excavation below. So a step that does not
+ * fit is tried again shifted across the way it goes - a quarter and a
+ * half of a square either side, which no gap a body fits through falls
+ * between - and the way keeps to wherever it fitted. A walk is taken
+ * over a jump wherever one fits.
+ */
+#define ETA_ROUTE_SHIFT 8.0f
+
+static int ETA_RouteMove(void *context, const float from[3], float to[3])
+{
+	static const float shifts[5] = { 0.0f, ETA_ROUTE_SHIFT, -ETA_ROUTE_SHIFT,
+		                             2.0f * ETA_ROUTE_SHIFT, -2.0f * ETA_ROUTE_SHIFT };
+	float dx    = to[0] - from[0], dy = to[1] - from[1];
+	float ax    = dx < 0.0f ? -dx : dx, ay = dy < 0.0f ? -dy : dy;
+	int   across, count, i, found = ETA_PATH_NONE;
+	float jumpTo[3];
+
+	/* Across the step: y for a step east or west, x for one north or
+	   south. A diagonal step is taken as it is. */
+	if (ax > 2.0f * ay)
+	{
+		across = 1;
+	}
+	else if (ay > 2.0f * ax)
+	{
+		across = 0;
+	}
+	else
+	{
+		across = -1;
+	}
+	count = across < 0 ? 1 : 5;
+
+	for (i = 0; i < count; i++)
+	{
+		float tried[3];
+		int   kind;
+
+		VectorCopy(to, tried);
+		if (across >= 0)
+		{
+			tried[across] += shifts[i];
+		}
+
+		if (ETA_RouteLineAvoided(from, tried))
+		{
+			continue;
+		}
+
+		kind = ETA_RouteMoveExact(context, from, tried);
+
+		if (kind == ETA_PATH_WALK)
+		{
+			VectorCopy(tried, to);
+			return kind;
+		}
+
+		/* A crouch is taken over a jump. */
+		if (kind != ETA_PATH_NONE && (found == ETA_PATH_NONE || (kind == ETA_PATH_CROUCH && found == ETA_PATH_JUMP)))
+		{
+			found = kind;
+			VectorCopy(tried, jumpTo);
+		}
+	}
+
+	if (found != ETA_PATH_NONE)
+	{
+		VectorCopy(jumpTo, to);
+	}
+	return found;
+}
+
+/**
+ * @brief How far a player could walk straight from one place toward
+ * another, up to the whole way: the fraction of it that is walkable.
+ */
+static float ETA_RouteWalkable(const vec3_t from, const vec3_t to)
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	trace_t trace;
+	vec3_t  a, b;
+	float   reach, length;
+	int     samples, i;
+
+	VectorCopy(from, a);
+	VectorCopy(to, b);
+
+	/* Somewhere higher up is walked to only up a slope. Looked at from
+	   down here, a slope leans back, and so does nothing else: a face
+	   that stands straight up is a wall, a ledge, or the riser of a
+	   stair too high to take in one, and the line stops there. Without
+	   this the higher end's floor was all that was looked at, and a
+	   floor above, reached by stairs round the side, was "straight
+	   ahead" - through the wall under it. */
+	if (b[2] > a[2] + 18.0f)
+	{
+		vec3_t level;
+
+		VectorSet(level, b[0], b[1], a[2]);
+		trap_CM_BoxTrace(&trace, a, level, mins, maxs, 0, MASK_PLAYERSOLID);
+
+		if (trace.startsolid)
+		{
+			return 0.0f;
+		}
+
+		/* Steeper than the game lets a player walk up - MIN_WALK_NORMAL,
+		   0.7 - is as good as a wall: the face of a rock leans back a
+		   little, and near the Allied camp on Oasis the ping pointed at
+		   one, over the top of it, and held a player against it. */
+		if (trace.fraction < 1.0f && trace.plane.normal[2] < 0.7f)
+		{
+			return trace.fraction;
+		}
+	}
+
+	/* Level with the higher end, so a straight run up a ramp is not cut by
+	   the ramp itself. */
+	a[2] = b[2] = MAX(a[2], b[2]);
+
+	trap_CM_BoxTrace(&trace, a, b, mins, maxs, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid)
+	{
+		return 0.0f;
+	}
+
+	reach  = trace.fraction;
+	length = Distance(from, to) * reach;
+
+	/* Somewhere lower down, more steeply than a stair runs, is not walked
+	   to either: it is a drop off an edge. */
+	if (from[2] - to[2] > ETA_ROUTE_MAX_DROP)
+	{
+		vec3_t flat;
+
+		VectorSubtract(to, from, flat);
+		flat[2] = 0.0f;
+
+		if (from[2] - to[2] > VectorLength(flat))
+		{
+			return 0.0f;
+		}
+	}
+
+	/* And floor all the way: a straight line across a hole the way goes
+	   round is not a way, and nor is one off the side of a stair or the
+	   end of a balcony. Looking only for some floor, however far down,
+	   let the line off a balcony near the Allied Command Post on Oasis
+	   to the floor seven metres under it - the way went down the
+	   stairs, and the ping said to walk off the edge. So from one look
+	   to the next the floor may fall no faster than a stair does, one
+	   unit down for one along, or a step where the looks are close; and
+	   the last look is at the end itself. Sampled every couple of
+	   squares, looking down as far as a safe drop. */
+	samples = (int)(length / (2.0f * ETA_ROUTE_CELL));
+
+	{
+		float lastFloor = from[2] - 24.0f, lastAt = 0.0f;
+
+		for (i = 1; i <= samples + 1; i++)
+		{
+			vec3_t point, below;
+			float  f = reach * (float)i / (float)(samples + 1);
+			float  along;
+
+			point[0] = from[0] + (to[0] - from[0]) * f;
+			point[1] = from[1] + (to[1] - from[1]) * f;
+			point[2] = a[2];
+			VectorCopy(point, below);
+			below[2] -= 24.0f + ETA_ROUTE_MAX_DROP + fabsf(from[2] - to[2]);
+
+			trap_CM_BoxTrace(&trace, point, below, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+			along = length * (float)i / (float)(samples + 1);
+
+			if (trace.fraction >= 1.0f
+			    || trace.endpos[2] < lastFloor - MAX(along - lastAt, 18.0f)
+			    || (CG_PointContents(trace.endpos, -1) & (CONTENTS_LAVA | CONTENTS_SLIME)))
+			{
+				return f - reach / (float)(samples + 1);
+			}
+
+			lastFloor = trace.endpos[2];
+			lastAt    = along;
+		}
+	}
+
+	return reach;
+}
+
+static qboolean ETA_RouteClear(const vec3_t from, const vec3_t to)
+{
+	return (qboolean)(ETA_RouteWalkable(from, to) >= 1.0f && !ETA_RouteLineAvoided(from, to));
+}
+
+/**
+ * @brief The open way out nearest to a direction, when that direction
+ * is walled off.
+ *
+ * Looks round from the direction the ping wants, a step at a time on
+ * either side, and takes the first that runs far enough to walk down.
+ * The side it found last time is looked at first, so walking along a
+ * wall the ping does not swap ends of it from one moment to the next.
+ */
+static qboolean ETA_RouteOpening(const vec3_t here, float wantYaw, int widest, vec3_t out)
+{
+	int step;
+
+	for (step = 1; step * ETA_ROUTE_OPENING_STEP <= widest; step++)
+	{
+		int turn;
+
+		for (turn = 0; turn < 2; turn++)
+		{
+			int    side = (turn == 0) ? (eta_route.side ? eta_route.side : 1) : -(eta_route.side ? eta_route.side : 1);
+			float  yaw  = wantYaw + (float)(side * step * ETA_ROUTE_OPENING_STEP);
+			vec3_t angles, forward, end;
+			float  reach;
+
+			VectorSet(angles, 0.0f, yaw, 0.0f);
+			AngleVectors(angles, forward, NULL, NULL);
+			VectorMA(here, ETA_ROUTE_OPENING_REACH, forward, end);
+
+			reach = ETA_RouteWalkable(here, end) * ETA_ROUTE_OPENING_REACH;
+
+			if (reach >= ETA_ROUTE_OPENING_MIN)
+			{
+				VectorMA(here, MIN(reach, ETA_MARKER_BEACON_DISTANCE), forward, out);
+				eta_route.side = side;
+				return qtrue;
+			}
+
+			if (step * ETA_ROUTE_OPENING_STEP == 180)
+			{
+				break;   /* straight behind: one look is enough */
+			}
+		}
+	}
+
+	return qfalse;
+}
+
+/**
+ * @brief Starts looking for the way from where the player is now.
+ */
+/**
+ * @brief The same question with jumping left out.
+ *
+ * The way is looked for on foot first, and only when there is none is it
+ * looked for again with jumps. A jump the player cannot see the edge of
+ * is a fall waiting to happen, and on the real Oasis the first search -
+ * which counted a jump as two metres more walking - sent the Allied way
+ * up a one-metre ledge with an ordinary step beside it. The search is
+ * built to find a good way quickly, not the very best, and a cost alone
+ * did not keep it off the ledge; leaving jumps out until they are needed
+ * does.
+ */
+static int ETA_RouteMoveOnFoot(void *context, const float from[3], float to[3])
+{
+	int kind = ETA_RouteMove(context, from, to);
+
+	return kind == ETA_PATH_JUMP ? ETA_PATH_NONE : kind;
+}
+
+static void ETA_RoutePlanWith(qboolean jumps)
+{
+	float start[3], goal[3];
+
+	start[0] = cg.predictedPlayerState.origin[0];
+	start[1] = cg.predictedPlayerState.origin[1];
+	start[2] = cg.predictedPlayerState.origin[2];
+	goal[0]  = eta_marker.origin[0];
+	goal[1]  = eta_marker.origin[1];
+	goal[2]  = eta_marker.origin[2];
+
+	ETA_PathFinder_Begin(start, goal, ETA_ROUTE_CELL,
+	                     eta_marker.square ? ETA_MarkerSquareRadius()
+	                                       : ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS,
+	                     eta_marker.square);
+
+	eta_route.planned   = qtrue;
+	eta_route.startedAt = cg.time;
+	eta_route.done      = qfalse;
+	eta_route.along     = 0;
+	eta_route.saidJump  = -1;
+	eta_route.jumps     = jumps;
+
+	eta_route.throughMines = qfalse;
+	eta_routeAvoidNew      = qfalse;
+}
+
+static void ETA_RoutePlan(void)
+{
+	ETA_RoutePlanWith(qfalse);
+}
+
+/**
+ * @brief Forgets the way, so the next frame looks for a new one.
+ */
+static void ETA_RouteForget(void)
+{
+	ETA_PathFinder_Reset();
+	memset(&eta_route, 0, sizeof(eta_route));
+}
+
+/**
+ * @brief ", press space": the key the player jumps with, for the jump
+ * callout. Nothing when jump is on no key.
+ */
+static const char *ETA_RouteKey(const char *binding)
+{
+	static char text[48];
+	char        name[32];
+	int         key = trap_Key_GetKey(binding);
+
+	if (key < 0)
+	{
+		return "";
+	}
+
+	name[0] = '\0';
+	trap_Key_KeynumToStringBuf(key, name, sizeof(name));
+	if (!name[0])
+	{
+		return "";
+	}
+
+	Q_strlwr(name);
+	Com_sprintf(text, sizeof(text), ", press %s", name);
+	return text;
+}
+
+static const char *ETA_RouteJumpKey(void)
+{
+	return ETA_RouteKey("+moveup");
+}
+
+/**
+ * @brief "Jump up, ahead", once, as the player comes to a jump on the way.
+ *
+ * The way can lead onto a ledge too high to step up, or over something
+ * in the way, and the ping alone cannot say that the next step is a
+ * jump: walking at a ledge just walks into it. So the player is told,
+ * within a couple of metres of the edge, which way the jump is - and
+ * whether it is up onto something or over it and down. A ladder needs
+ * nothing here: the ladder is said as the player reaches it, with F to
+ * climb (cg_draw.c).
+ */
+#define ETA_ROUTE_JUMP_SAY 96.0f
+
+static void ETA_RouteSayJump(int special, int count, const vec3_t here)
+{
+	vec3_t edge, landing, delta;
+
+	if (special >= count || special < 1 || special == eta_route.saidJump
+	    || ETA_PathFinder_PointKind(special) != ETA_PATH_JUMP)
+	{
+		return;
+	}
+
+	ETA_PathFinder_Point(special - 1, edge);
+	ETA_PathFinder_Point(special, landing);
+	VectorSubtract(edge, here, delta);
+	delta[2] = 0.0f;
+
+	if (VectorLength(delta) > ETA_ROUTE_JUMP_SAY)
+	{
+		return;
+	}
+
+	eta_route.saidJump = special;
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s, %s%s", landing[2] > edge[2] + 8.0f ? "Jump up" : "Jump over",
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(landing)),
+	                  ETA_RouteJumpKey()));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief "Crouch, low ceiling ahead", once, as the way goes under one,
+ * and "Stand up" past it.
+ *
+ * The tunnels under Oasis are lower than a player standing, and a
+ * player who does not crouch walks into the roof at the entrance as if
+ * into a wall. So within a couple of metres of where the way first needs
+ * a crouch, it is said, with the key; and once the way has come out from
+ * under, standing is said too.
+ */
+#define ETA_ROUTE_CROUCH_SAY   96.0f   /* this near where it starts: told */
+#define ETA_ROUTE_CROUCH_AHEAD 4       /* points ahead looked at */
+
+static void ETA_RouteSayCrouch(int nearest, int count, const vec3_t here)
+{
+	int    i, start = -1;
+	vec3_t point;
+
+	for (i = nearest + 1; i < count && i <= nearest + ETA_ROUTE_CROUCH_AHEAD; i++)
+	{
+		if (ETA_PathFinder_PointKind(i) == ETA_PATH_CROUCH)
+		{
+			start = i;
+			break;
+		}
+	}
+
+	if (start < 0)
+	{
+		/* Out from under, and the way on stands up again. */
+		if (eta_route.crouched && ETA_PathFinder_PointKind(nearest) != ETA_PATH_CROUCH)
+		{
+			eta_route.crouched = qfalse;
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say("Stand up, the ceiling is high again");
+			ETA_Speech_EndReport();
+		}
+		return;
+	}
+
+	if (eta_route.crouched)
+	{
+		return;
+	}
+
+	/* Where the low ceiling begins: the point before the first crouch. */
+	ETA_PathFinder_Point(start - 1, point);
+	if (Distance(here, point) > ETA_ROUTE_CROUCH_SAY && ETA_PathFinder_PointKind(nearest) != ETA_PATH_CROUCH)
+	{
+		return;
+	}
+
+	eta_route.crouched = qtrue;
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("Crouch, low ceiling ahead%s", ETA_RouteKey("+movedown")));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief "Stairs up, ahead left", once, as the player comes to stairs.
+ *
+ * The tester could not get up to the Allied command post on Oasis, and
+ * asked to be told where the stairs are and which way they go, and when
+ * it is not stairs, that it is a jump and which key. The way already
+ * climbs the stairs, square by square, and the ping follows it; but the
+ * ping alone says only which way, not that the next few metres go up a
+ * flight - and a player who does not know it walks into the bottom step
+ * at an angle, or along it. So within a few metres of the foot of a
+ * climb on the way, it is said: stairs, or a ramp, up or down, which way
+ * they go from where the player faces, and how high.
+ */
+#define ETA_ROUTE_STAIRS_SAY    160.0f   /* this near the foot: told, about 4 metres */
+#define ETA_ROUTE_STAIRS_LOOK   12       /* points ahead looked at for a climb, about 10 metres */
+#define ETA_ROUTE_STAIRS_RISE   48.0f    /* this much up or down within four steps: a climb */
+#define ETA_ROUTE_STAIRS_HEIGHT 64.0f    /* and this much in all: worth saying */
+
+static void ETA_RouteSayStairs(int nearest, int special, const vec3_t here)
+{
+	vec3_t a, b, top, delta;
+	int    i, foot = -1, end, risers = 0, slopes = 0;
+	float  climb;
+
+	for (i = nearest; i + 4 < special && i < nearest + ETA_ROUTE_STAIRS_LOOK; i++)
+	{
+		ETA_PathFinder_Point(i, a);
+		ETA_PathFinder_Point(i + 4, b);
+
+		if (fabsf(b[2] - a[2]) >= ETA_ROUTE_STAIRS_RISE)
+		{
+			foot = i;
+			break;
+		}
+	}
+
+	if (foot < 0)
+	{
+		return;
+	}
+
+	/* Up the climb until it levels off or turns back. */
+	ETA_PathFinder_Point(foot, a);
+	climb = 0.0f;
+	for (end = foot + 1; end < special; end++)
+	{
+		float step;
+
+		ETA_PathFinder_Point(end - 1, b);
+		ETA_PathFinder_Point(end, top);
+		step = top[2] - b[2];
+
+		if ((climb > 0.0f && step < -2.0f) || (climb < 0.0f && step > 2.0f))
+		{
+			break;
+		}
+		if (fabsf(step) < 0.5f && end - foot > 4)
+		{
+			/* Level for two squares: the landing. */
+			vec3_t next;
+
+			if (end + 1 >= special)
+			{
+				break;
+			}
+			ETA_PathFinder_Point(end + 1, next);
+			if (fabsf(next[2] - top[2]) < 0.5f)
+			{
+				break;
+			}
+		}
+
+		climb += step;
+		if (fabsf(step) >= 8.0f)
+		{
+			risers++;
+		}
+		else if (fabsf(step) >= 0.5f)
+		{
+			slopes++;
+		}
+	}
+	ETA_PathFinder_Point(end - 1, top);
+
+	if (fabsf(top[2] - a[2]) < ETA_ROUTE_STAIRS_HEIGHT)
+	{
+		return;
+	}
+
+	VectorSubtract(a, here, delta);
+	delta[2] = 0.0f;
+	if (VectorLength(delta) > ETA_ROUTE_STAIRS_SAY)
+	{
+		return;
+	}
+
+	/* The same flight is said once; a new search finds its foot again a
+	   square or two off. */
+	if (eta_route.saidStairs && Distance(eta_route.stairsAt, a) < 128.0f)
+	{
+		return;
+	}
+	eta_route.saidStairs = qtrue;
+	VectorCopy(a, eta_route.stairsAt);
+
+	ETA_PathFinder_Point(MIN(foot + 3, end - 1), b);
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s %s, %s, %d meters", risers >= slopes ? "Stairs" : "Ramp",
+	                  top[2] > a[2] ? "up" : "down",
+	                  ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(b)),
+	                  (int)(fabsf(top[2] - a[2]) * ETA_QU_TO_METERS + 0.5f)));
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Follows the way found, if there is one: sets eta_route.steer.
+ */
+static void ETA_RouteFollow(ETA_PathState state, const vec3_t here)
+{
+	int    count = ETA_PathFinder_PointCount();
+	int    i, nearest = eta_route.along, best, special;
+	float  nearestDistance = 1.0e9f;
+	vec3_t point;
+
+	if (state != ETA_PATH_FOUND && state != ETA_PATH_PARTIAL)
+	{
+		return;
+	}
+
+	/* On a ladder the player leaves the way upward, a floor's height
+	   from its nearest point: that is the way, not a stray from it, and
+	   a new search from halfway up a ladder starts in mid air. The way
+	   is picked up again at the top. */
+	if (CG_AccessibilityClimbing())
+	{
+		return;
+	}
+
+	if (!eta_route.done)
+	{
+		/* How old the way is counts from when it was found, not from
+		   when the search began: a long search must not be thrown away
+		   the moment it finishes. */
+		eta_route.done   = qtrue;
+		eta_route.doneAt = cg.time;
+	}
+
+	/* Where along the way the player is: the nearest point, from where
+	   they were last time onward. */
+	for (i = eta_route.along; i < count; i++)
+	{
+		float distance;
+
+		ETA_PathFinder_Point(i, point);
+		distance = Distance(here, point);
+
+		if (distance < nearestDistance)
+		{
+			nearestDistance = distance;
+			nearest         = i;
+		}
+	}
+
+	if (nearestDistance > ETA_ROUTE_STRAY
+	    || cg.time - eta_route.doneAt > ETA_ROUTE_REPLAN_MS || cg.time < eta_route.doneAt
+	    || (state == ETA_PATH_PARTIAL && count - nearest < 4))
+	{
+		/* Off the way, or the way is old, or it ran out short of the
+		   marker and the player has got to its end: look again from
+		   here. The old point is kept until the new way is ready. */
+		ETA_RoutePlan();
+		return;
+	}
+
+	eta_route.along = nearest;
+
+	/* The next place the way is not a walk: a jump, or a ladder. Nothing
+	   past it is looked at, however straight the line: a ladder's top is
+	   over the wall it stands against, and a line to it leads into that
+	   wall rather than to the ladder's foot. */
+	special = count;
+	for (i = nearest + 1; i < count; i++)
+	{
+		if (ETA_PathFinder_PointKind(i) != ETA_PATH_WALK && ETA_PathFinder_PointKind(i) != ETA_PATH_CROUCH)
+		{
+			special = i;
+			break;
+		}
+	}
+
+	ETA_RouteSayJump(special, count, here);
+	ETA_RouteSayStairs(nearest, special, here);
+	ETA_RouteSayCrouch(nearest, count, here);
+
+	/* The furthest point a few steps on that can be walked to straight. */
+	best = nearest;
+	for (i = MIN(MIN(count - 1, special - 1), nearest + ETA_ROUTE_LOOKAHEAD); i > nearest; i--)
+	{
+		ETA_PathFinder_Point(i, point);
+
+		if (ETA_RouteClear(here, point))
+		{
+			best = i;
+			break;
+		}
+	}
+
+	eta_route.overEdge = qfalse;
+	eta_route.onWay    = qfalse;
+
+	if (state == ETA_PATH_FOUND && best == count - 1 && special == count)
+	{
+		/* The marker is in a straight line from the end of the way. */
+		eta_route.steering = qfalse;
+		return;
+	}
+
+	/* Off to the side of the way, with not even its nearest point in a
+	   straight line - round the corner of a rock, a step too high: the
+	   way is no longer from here. Near the Allied camp on Oasis the ping
+	   pointed on through a rock to the next point of a way the player
+	   had drifted off, and held them against it until the way was next
+	   looked for. Look for it again now, from where they are. */
+	if (best == nearest && nearestDistance > ETA_ROUTE_ON_WAY)
+	{
+		ETA_PathFinder_Point(nearest, point);
+
+		if (!ETA_RouteClear(here, point))
+		{
+			ETA_RoutePlan();
+			return;
+		}
+	}
+
+	if (best == nearest && best + 1 < count)
+	{
+		/* Nothing ahead is in a straight line - the player is past a
+		   corner the probe cannot see round, or on a stair, whose risers
+		   stop a straight line however short. The next point is still
+		   the way: the search stepped to it, square by square, the way a
+		   player walks. */
+		best++;
+		eta_route.onWay = (qboolean)(nearestDistance <= ETA_ROUTE_ON_WAY);
+	}
+
+	ETA_PathFinder_Point(best, point);
+	VectorCopy(point, eta_route.steer);
+	eta_route.steering = qtrue;
+	eta_route.overEdge = (qboolean)(best == special);
+}
+
+/**
+ * @brief Every frame: a little more searching, and where to point.
+ */
+static void ETA_RouteFrame(void)
+{
+	ETA_PathState state;
+	vec3_t        here, want, delta, angles;
+	float         distance;
+
+	if (!eta_route.planned)
+	{
+		ETA_RoutePlan();
+	}
+
+	/* By the clock, not by a count: a square costs a handful of traces,
+	   and a trace costs more on a detailed map and a slow machine. Two
+	   milliseconds a frame is searched however far that goes. */
+	{
+		int began = trap_Milliseconds();
+
+		do
+		{
+			state = ETA_PathFinder_Step(ETA_ROUTE_BUDGET_STEP,
+			                            eta_route.jumps ? ETA_RouteMove : ETA_RouteMoveOnFoot, NULL);
+		}
+		while (state == ETA_PATH_SEARCHING
+		       && trap_Milliseconds() - began < ETA_ROUTE_BUDGET_MS);
+	}
+
+	/* No way there on foot: look again, letting the way jump. */
+	if (!eta_route.jumps && (state == ETA_PATH_FAILED || state == ETA_PATH_PARTIAL))
+	{
+		ETA_RoutePlanWith(qtrue);
+		state = ETA_PathFinder_State();
+	}
+	/* No way round the mines at all: the way goes through, and the
+	   warning says where they are. */
+	else if (eta_route.jumps && !eta_route.throughMines && eta_routeAvoidCount > 0
+	         && (state == ETA_PATH_FAILED || state == ETA_PATH_PARTIAL))
+	{
+		ETA_RoutePlanWith(qtrue);
+		eta_route.throughMines = qtrue;
+		state                  = ETA_PathFinder_State();
+	}
+	/* A mine come into sight on the way already found: find it again. */
+	else if (eta_routeAvoidNew && !eta_route.throughMines && state != ETA_PATH_SEARCHING)
+	{
+		int count = ETA_PathFinder_PointCount(), i;
+
+		eta_routeAvoidNew = qfalse;
+		for (i = eta_route.along; i < count; i++)
+		{
+			float point[3];
+
+			ETA_PathFinder_Point(i, point);
+			if (ETA_RouteAvoided(point))
+			{
+				ETA_RoutePlanWith(eta_route.jumps);
+				state = ETA_PathFinder_State();
+				break;
+			}
+		}
+	}
+
+	if (state == ETA_PATH_FAILED
+	    && (cg.time - eta_route.startedAt > ETA_ROUTE_RETRY_MS || cg.time < eta_route.startedAt))
+	{
+		ETA_RoutePlan();
+	}
+
+	if (cg.time - eta_route.steeredAt < ETA_ROUTE_STEER_MS && cg.time >= eta_route.steeredAt)
+	{
+		return;
+	}
+	eta_route.steeredAt = cg.time;
+
+	VectorCopy(cg.predictedPlayerState.origin, here);
+
+	ETA_RouteFollow(state, here);
+
+	/* Where the ping wants to be: along the way, or straight at the
+	   marker. */
+	VectorCopy(eta_route.steering ? eta_route.steer : eta_marker.origin, want);
+	VectorSubtract(want, here, delta);
+	delta[2] = 0.0f;
+	distance = VectorLength(delta);
+
+	if (distance < 1.0f)
+	{
+		eta_route.aimSet = qfalse;
+		return;
+	}
+
+	/* Over a ledge, or up a ladder: there is a wall in the way, and
+	   that is the point - it is jumped, or climbed, and the ping says
+	   where. Looking for a way round it would lead away from the only
+	   way up. */
+	/* Or the next step of the way, taken from on it: a stair, a corner.
+	   Looking round for an opening here once sent the ping back down
+	   the stairs the way went up - "the way goes south-west" with the
+	   marker and the way both north-east - and the player turned round
+	   on every flight. */
+	if (eta_route.steering && (eta_route.overEdge || eta_route.onWay))
+	{
+		eta_route.aimSet = qfalse;
+		eta_route.side   = 0;
+		return;
+	}
+
+	/* Can the player walk that way, as far as it matters? Then that is
+	   where the ping goes. */
+	{
+		vec3_t ahead;
+
+		VectorMA(here, MIN(distance, ETA_ROUTE_CLEAR_AHEAD) / distance, delta, ahead);
+		ahead[2] = want[2];
+
+		if (ETA_RouteClear(here, ahead))
+		{
+			eta_route.aimSet = qfalse;
+			eta_route.side   = 0;
+			return;
+		}
+	}
+
+	/* A wall in the way: the nearest open way out instead. */
+	vectoangles(delta, angles);
+	/* Along the way, never further round than square on to it: the way
+	   is known to go on ahead, and an opening found behind the player
+	   turned them right round - "the way goes south-west" with the way
+	   and the marker both north-east. Straight at the marker, before
+	   there is a way, anywhere will do. */
+	eta_route.aimSet = ETA_RouteOpening(here, angles[YAW], eta_route.steering ? 90 : 180, eta_route.aim);
+}
+
+/**
+ * @brief Where the ping and the turn words point: the open way when the
+ * straight way is walled off, along the route when there is one, and
+ * straight at the marker when it is in plain reach.
+ */
+static void ETA_MarkerTarget(vec3_t out)
+{
+	if (eta_route.aimSet)
+	{
+		VectorCopy(eta_route.aim, out);
+	}
+	else if (eta_route.steering)
+	{
+		VectorCopy(eta_route.steer, out);
+	}
+	else
+	{
+		VectorCopy(eta_marker.origin, out);
+	}
+}
+
+/**
+ * @brief What kind of place a point is: street, alley, square, building,
+ * balcony or roof (navigation/place_classifier.c reads the measurements).
+ *
+ * Measured the way the route's probe measures, against the map's own
+ * walls and floors: from where the player stands, in each of the eight
+ * compass directions, how far the floor runs at about the same height
+ * before a wall stops a body or the floor drops away; whether the sky is
+ * straight overhead; and whether there is a storey's worth of space under
+ * the floor. A street is a long run between near walls; a balcony a
+ * narrow run in the open with a drop or rooms under it.
+ */
+#define ETA_PLACE_STEP      48.0f    /* between looks along each direction */
+#define ETA_PLACE_LOOK      800.0f   /* how far each direction is followed, 20 m */
+#define ETA_PLACE_SKY       2048.0f  /* how far up to look for the sky */
+#define ETA_PLACE_LEVEL     40.0f    /* a floor this much higher or lower is another level */
+#define ETA_PLACE_DROP_NEAR 112.0f   /* a drop this close is beside the player */
+#define ETA_PLACE_STOREY    96.0f    /* a room under the floor at least this deep */
+
+static void ETA_PlaceProbeAt(const vec3_t origin, ETA_PlaceProbe *probe)
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	trace_t trace;
+	vec3_t  start, end;
+	float   feet = origin[2] - 24.0f;
+	int     d;
+
+	memset(probe, 0, sizeof(*probe));
+
+	/* Sky straight overhead, from eye height. */
+	VectorSet(start, origin[0], origin[1], origin[2] + 16.0f);
+	VectorSet(end, origin[0], origin[1], origin[2] + ETA_PLACE_SKY);
+	trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_SOLID);
+	probe->skyAbove = (trace.fraction >= 1.0f || (trace.surfaceFlags & SURF_SKY)) ? 1 : 0;
+
+	/* A room under the floor: air through the floor's thickness, and a
+	   floor further down a storey below this one. Below the ground there
+	   is no floor to find, only the outside of the map. */
+	{
+		float z;
+
+		for (z = feet - 8.0f; z >= feet - 72.0f; z -= 8.0f)
+		{
+			vec3_t point;
+
+			VectorSet(point, origin[0], origin[1], z);
+			if (!(CG_PointContents(point, -1) & MASK_SOLID))
+			{
+				qboolean drawn;
+
+				/* The sealed space under a map is lined with surfaces
+				   nobody sees; a room under the floor has a ceiling and a
+				   floor that are drawn. On Oasis every street sits on such
+				   a space. */
+				VectorCopy(point, start);
+				VectorSet(end, point[0], point[1], feet + 4.0f);
+				trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_SOLID);
+				drawn = (qboolean)(trace.fraction < 1.0f && !(trace.surfaceFlags & SURF_NODRAW));
+
+				VectorSet(end, point[0], point[1], point[2] - 1024.0f);
+				trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_PLAYERSOLID);
+				if (drawn && !trace.startsolid && trace.fraction < 1.0f && trace.plane.normal[2] >= 0.7f
+				    && !(trace.surfaceFlags & SURF_NODRAW) && feet - trace.endpos[2] >= ETA_PLACE_STOREY)
+				{
+					probe->airBelow = 1;
+				}
+				break;
+			}
+		}
+	}
+
+	/* Along each direction: as far as the floor runs at this level. */
+	for (d = 0; d < ETA_PLACE_DIRECTIONS; d++)
+	{
+		float  bearing = (float)d * 45.0f * (float)M_PI / 180.0f;
+		vec3_t step, here, next, down;
+		float  floor = feet, run = 0.0f;
+
+		VectorSet(step, sinf(bearing) * ETA_PLACE_STEP, cosf(bearing) * ETA_PLACE_STEP, 0.0f);
+		VectorCopy(origin, here);
+
+		while (run + ETA_PLACE_STEP <= ETA_PLACE_LOOK)
+		{
+			VectorAdd(here, step, next);
+
+			/* A body's width, a step up off the floor: what stops it is
+			   a wall. */
+			trap_CM_BoxTrace(&trace, here, next, mins, maxs, 0, MASK_PLAYERSOLID);
+			if (trace.startsolid || trace.fraction < 1.0f)
+			{
+				/* Up to the wall's face: the part of the step the body
+				   got, and the body's own half-width in front of it. */
+				probe->wall[d] = 1;
+				if (!trace.startsolid)
+				{
+					run += trace.fraction * ETA_PLACE_STEP + ETA_ROUTE_HALF_WIDTH;
+				}
+				break;
+			}
+
+			/* The floor there: at about this level, or a drop. */
+			VectorCopy(next, start);
+			start[2] += 18.0f;
+			VectorSet(down, next[0], next[1], floor - 1024.0f);
+			trap_CM_BoxTrace(&trace, start, down, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+			if (trace.startsolid || trace.fraction >= 1.0f || trace.endpos[2] < floor - ETA_PLACE_LEVEL)
+			{
+				float depth = (trace.startsolid || trace.fraction >= 1.0f) ? 1024.0f : floor - trace.endpos[2];
+
+				if (run + ETA_PLACE_STEP <= ETA_PLACE_DROP_NEAR && depth > probe->dropBeside)
+				{
+					probe->dropBeside = depth;
+				}
+				break;
+			}
+
+			if (trace.endpos[2] > floor + ETA_PLACE_LEVEL)
+			{
+				/* Stairs or a ramp up out of this level. */
+				break;
+			}
+
+			floor = trace.endpos[2];
+			VectorSet(here, next[0], next[1], floor + 24.0f);
+			run += ETA_PLACE_STEP;
+		}
+
+		probe->reach[d] = run;
+	}
+}
+
+/**
+ * @brief What kind of place a point is - the probe above, read.
+ */
+void CG_AccessibilityPlace(const vec3_t origin, ETA_Place *out)
+{
+	ETA_PlaceProbe probe;
+
+	ETA_PlaceProbeAt(origin, &probe);
+	*out = ETA_Place_Classify(&probe);
+}
+
+/**
+ * @brief The distance to the marker, in metres.
+ *
+ * Flat for a square, which has no height of its own; straight-line for a
+ * spot, which does - a spot on the floor above is not where you are.
+ */
+static int ETA_MarkerDistance(void)
+{
+	vec3_t delta;
+
+	VectorSubtract(eta_marker.origin, cg.predictedPlayerState.origin, delta);
+
+	if (eta_marker.square)
+	{
+		delta[2] = 0.0f;
+	}
+
+	return (int)(VectorLength(delta) * ETA_QU_TO_METERS);
+}
+
+/**
+ * @brief The floors a player could stand on, straight down through one
+ * point of the map, highest first.
+ *
+ * Found the way a dropped stone would find them, again and again: down
+ * from far above, through the sky over the map, to the first surface
+ * that faces up; then on down from just under it, the trace starting
+ * inside that floor and so passing out of it, to the next. A floor with
+ * no room for a body over it is the top of something solid, not a floor.
+ * The sealed space under the map is lined with surfaces nobody sees, and
+ * the tops of the buildings that cannot be entered are sky: neither is a
+ * floor anyone stands on.
+ *
+ * @return how many were found, at most max
+ */
+#define ETA_SURVEY_HIGH 16384.0f
+
+static int ETA_SurveyFloors(float x, float y, vec3_t *out, int max)
+{
+	static const vec3_t mins = { -15.0f, -15.0f, 0.0f };
+	static const vec3_t maxs = { 15.0f, 15.0f, 56.0f };
+	trace_t trace;
+	vec3_t  start, end;
+	float   z     = ETA_SURVEY_HIGH;
+	int     count = 0, guard;
+
+	for (guard = 0; guard < 32 && count < max; guard++)
+	{
+		trace_t room;
+		vec3_t  body;
+
+		VectorSet(start, x, y, z);
+		VectorSet(end, x, y, -ETA_SURVEY_HIGH);
+		trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+		if (trace.allsolid || trace.fraction >= 1.0f)
+		{
+			break;
+		}
+
+		z = trace.endpos[2] - 1.0f;
+
+		if (guard == 0 || trace.plane.normal[2] < 0.7f
+		    || (trace.surfaceFlags & (SURF_NODRAW | SURF_SKY)))
+		{
+			continue;   /* the first is the outside of the sky over the map */
+		}
+
+		/* Lifted a little, so a sloping floor does not catch the box. */
+		VectorSet(body, x, y, trace.endpos[2] + 12.0f);
+		trap_CM_BoxTrace(&room, body, body, mins, maxs, 0, MASK_PLAYERSOLID);
+
+		if (!room.startsolid)
+		{
+			VectorCopy(trace.endpos, out[count]);
+			count++;
+		}
+	}
+
+	return count;
+}
+
+/**
+ * @brief What kind of places a square of the command map holds, in words.
+ *
+ * A grid of points across the square, ten to a side, and at each the
+ * same probe the walking callouts use stood on every floor there is -
+ * navigation/place_classifier.c then reads the grid as a whole. On a
+ * map built in layers only the floors of the layer being surveyed count.
+ */
+static void ETA_MapCellPlaces(int column, int row, int layer, char *out, size_t outSize)
+{
+	static ETA_PlaceSurvey survey;
+	vec2_t                 start, step;
+	int                    columns, rows, i, j;
+
+	out[0] = '\0';
+
+	if (!ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return;
+	}
+
+	ETA_PlaceSurvey_Clear(&survey);
+
+	for (j = 0; j < ETA_PLACE_SURVEY_SIDE; j++)
+	{
+		for (i = 0; i < ETA_PLACE_SURVEY_SIDE; i++)
+		{
+			float  x = start[0] + ((float)column + ((float)i + 0.5f) / ETA_PLACE_SURVEY_SIDE) * step[0];
+			float  y = start[1] - ((float)row + ((float)j + 0.5f) / ETA_PLACE_SURVEY_SIDE) * step[1];
+			vec3_t floors[ETA_PLACE_SURVEY_FLOORS];
+			int    count = ETA_SurveyFloors(x, y, floors, ETA_PLACE_SURVEY_FLOORS);
+			int    k;
+
+			/* Lowest first. */
+			for (k = count - 1; k >= 0; k--)
+			{
+				ETA_Place place;
+				vec3_t    origin;
+
+				if (cgs.ccLayers && CG_CurLayerForZ((int)floors[k][2]) != layer)
+				{
+					continue;
+				}
+
+				VectorSet(origin, floors[k][0], floors[k][1], floors[k][2] + 24.0f);
+				CG_AccessibilityPlace(origin, &place);
+				ETA_PlaceSurvey_Add(&survey, j, i, &place);
+			}
+		}
+	}
+
+	ETA_PlaceSurvey_Describe(&survey, out, outSize);
+}
+
+/**
+ * @brief Sniper spots: raised places with a long view, found by looking.
+ *
+ * The tester asked for help choosing a good place to use the sniper
+ * rifle from. A sighted player finds one by looking up at the roofs and
+ * balconies and judging what each one would see. This does the same
+ * with the map's walls and floors: across the whole map, every 128
+ * units, every floor a player could stand on that is up off the ground -
+ * a floor with another below it, or one at the edge of a drop - is stood
+ * on with the place probe, and if it is a roof, a balcony, a ledge or an
+ * upper floor, the view from a standing player's eyes is looked down in
+ * sixteen directions: each piece of ground out there, whether a standing
+ * enemy on it could be seen, and how far below it lies.
+ * navigation/sniper_spots.c judges the views and keeps the best.
+ *
+ * A whole map is thousands of looks, so it is done a millisecond a frame
+ * from the first frame of the map, and the list is ready in well under a
+ * minute; asked for sooner, the spots found so far are offered.
+ */
+#define ETA_SPOT_SPACING   128.0f   /* between the points looked at, about 3 metres */
+#define ETA_SPOT_STEP      192.0f   /* between the looks along each direction, about 5 metres */
+#define ETA_SPOT_LOOK      3072.0f  /* how far each direction is looked down, about 78 metres */
+#define ETA_SPOT_EYE       64.0f    /* a standing player's eyes over the floor */
+#define ETA_SPOT_CHEST     40.0f    /* an enemy's chest over the ground */
+#define ETA_SPOT_RAISED    96.0f    /* a drop this deep beside the floor: up off the ground */
+#define ETA_SPOT_BUDGET_MS 1
+
+static struct
+{
+	qboolean     started, done;
+	int          column, row, columns, rows;
+	ETA_SpotList list;
+	int          order[ETA_SPOT_MAX];
+	int          count, index, lastPress;
+	int          marked;      /* the spot under the marker, or -1 */
+	qboolean     judged;      /* whether the way there has been looked at */
+	int          checking;    /* the spot or room whose way down is being looked for, or -1 */
+	qboolean     checkingRoom;
+	int          checkSteps;
+} eta_spots;
+
+/* Down from a little over a floor, at a point beside it: how far down
+   the next floor is, or a long way when there is none. */
+static float ETA_SpotDropAt(const vec3_t floor, float dx, float dy)
+{
+	trace_t trace;
+	vec3_t  start, end;
+
+	VectorSet(start, floor[0] + dx, floor[1] + dy, floor[2] + 18.0f);
+	VectorSet(end, start[0], start[1], floor[2] - 1024.0f);
+	trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+	if (trace.startsolid)
+	{
+		return 0.0f;   /* a wall beside it, not a drop */
+	}
+	return trace.fraction >= 1.0f ? 1024.0f : floor[2] - trace.endpos[2];
+}
+
+static void ETA_SpotLook(const vec3_t floor, ETA_SpotView *view)
+{
+	vec3_t eye;
+	int    d;
+
+	ETA_SpotView_Clear(view);
+	VectorSet(eye, floor[0], floor[1], floor[2] + ETA_SPOT_EYE);
+
+	for (d = 0; d < ETA_SPOT_DIRECTIONS; d++)
+	{
+		float bearing = (float)d * (360.0f / ETA_SPOT_DIRECTIONS) * (float)M_PI / 180.0f;
+		float dx = sinf(bearing), dy = cosf(bearing);
+		float out;
+
+		for (out = ETA_SPOT_STEP; out <= ETA_SPOT_LOOK; out += ETA_SPOT_STEP)
+		{
+			trace_t trace;
+			vec3_t  at, below, ground, target;
+			qboolean seen;
+
+			VectorSet(at, eye[0] + dx * out, eye[1] + dy * out, eye[2]);
+			VectorSet(below, at[0], at[1], at[2] - 2048.0f);
+			trap_CM_BoxTrace(&trace, at, below, NULL, NULL, 0, MASK_SOLID);
+
+			if (trace.startsolid || trace.fraction >= 1.0f
+			    || (trace.surfaceFlags & (SURF_NODRAW | SURF_SKY)))
+			{
+				continue;   /* inside a building, or nothing there */
+			}
+			VectorCopy(trace.endpos, ground);
+
+			VectorSet(target, ground[0], ground[1], ground[2] + ETA_SPOT_CHEST);
+			trap_CM_BoxTrace(&trace, eye, target, NULL, NULL, 0, MASK_SOLID);
+			seen = (qboolean)(trace.fraction >= 1.0f);
+
+			/* A wall right in front: nothing further that way is seen.
+			   The edge of the spot's own floor hiding the ground just
+			   below it is not a wall - that is every roof and ledge. */
+			if (!seen && trace.fraction * Distance(eye, target) < 2.0f * ETA_SPOT_STEP
+			    && trace.endpos[2] > floor[2] + 18.0f)
+			{
+				break;
+			}
+
+			ETA_SpotView_Add(view, d, out * ETA_QU_TO_METERS, seen,
+			                 (floor[2] - ground[2]) * ETA_QU_TO_METERS, ETA_SPOT_STEP * ETA_QU_TO_METERS);
+		}
+	}
+}
+
+/**
+ * @brief Rooms: the indoor places of the map, found on the same look over
+ * it (navigation/rooms.c groups them).
+ *
+ * The tester asked for the rooms to be trackable on the map. At each
+ * floor of each point looked at, a roof straight overhead - not sky - is
+ * indoors, and the point is kept. Once the whole map has been looked
+ * over, points next to each other at the same height that a player
+ * could walk straight between are one room; a wall between them makes
+ * two. Each room takes the map's own name for the place, where it has
+ * one.
+ */
+static struct
+{
+	ETA_RoomSample samples[ETA_ROOM_MAX_SAMPLES];
+	int            sampleCount;
+	qboolean       built;
+	ETA_RoomList   list;
+	int            order[ETA_ROOM_MAX];
+	int            count, index, lastPress;
+	int            marked;   /* the room under the marker, or -1 */
+	qboolean       judged;
+} eta_rooms;
+
+static void ETA_RoomSamplePoint(const vec3_t floor, qboolean upper, int column, int row)
+{
+	trace_t         trace;
+	vec3_t          start, end;
+	ETA_RoomSample *sample;
+
+	if (eta_rooms.sampleCount >= ETA_ROOM_MAX_SAMPLES)
+	{
+		return;
+	}
+
+	VectorSet(start, floor[0], floor[1], floor[2] + ETA_SPOT_EYE);
+	VectorSet(end, floor[0], floor[1], floor[2] + 2048.0f);
+	trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_SOLID);
+
+	if (trace.startsolid || trace.fraction >= 1.0f || (trace.surfaceFlags & SURF_SKY))
+	{
+		return;   /* open sky: not a room */
+	}
+
+	sample            = &eta_rooms.samples[eta_rooms.sampleCount++];
+	sample->column    = column;
+	sample->row       = row;
+	sample->origin[0] = floor[0];
+	sample->origin[1] = floor[1];
+	sample->origin[2] = floor[2] + 24.0f;
+	sample->upper     = upper ? 1 : 0;
+}
+
+/* Whether a player could walk straight from one point to the next, at
+   the route probe's size: a wall between them, or a step too high, and
+   they are not the same room. */
+static int ETA_RoomLink(void *context, const float from[3], const float to[3])
+{
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f + 18.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	trace_t trace;
+	vec3_t  a, b;
+
+	(void)context;
+	VectorSet(a, from[0], from[1], from[2]);
+	VectorSet(b, to[0], to[1], from[2]);
+	trap_CM_BoxTrace(&trace, a, b, mins, maxs, 0, MASK_PLAYERSOLID);
+	return !trace.startsolid && trace.fraction >= 1.0f;
+}
+
+static void ETA_RoomsBuild(void)
+{
+	int i;
+
+	ETA_Rooms_Build(eta_rooms.samples, eta_rooms.sampleCount, ETA_SPOT_SPACING,
+	                ETA_RoomLink, NULL, &eta_rooms.list);
+
+	for (i = 0; i < eta_rooms.list.count; i++)
+	{
+		ETA_Room   *room = &eta_rooms.list.rooms[i];
+		const char *name = CG_GetLocationMsg(-1, room->origin);
+
+		if (name && Q_stricmp(name, "Unknown"))
+		{
+			Q_strncpyz(room->name, name, sizeof(room->name));
+			Q_CleanStr(room->name);
+		}
+	}
+
+	eta_rooms.built = qtrue;
+}
+
+/* One point of the map: its floors, any spot among them, and any room. */
+static void ETA_SpotScanPoint(float x, float y, int column, int row)
+{
+	vec3_t floors[ETA_PLACE_SURVEY_FLOORS];
+	int    count = ETA_SurveyFloors(x, y, floors, ETA_PLACE_SURVEY_FLOORS);
+	int    k;
+
+	for (k = 0; k < count; k++)
+	{
+		qboolean  raised = (qboolean)(k < count - 1 && floors[k][2] - floors[count - 1][2] >= ETA_SPOT_RAISED);
+		ETA_Place place;
+		vec3_t    origin;
+
+		ETA_RoomSamplePoint(floors[k], raised, column, row);
+
+		/* The lowest floor is up off the ground only at the edge of a
+		   drop - a terrace, the top of a wall. */
+		if (!raised)
+		{
+			raised = (qboolean)(ETA_SpotDropAt(floors[k], 96.0f, 0.0f) >= ETA_SPOT_RAISED
+			                    || ETA_SpotDropAt(floors[k], -96.0f, 0.0f) >= ETA_SPOT_RAISED
+			                    || ETA_SpotDropAt(floors[k], 0.0f, 96.0f) >= ETA_SPOT_RAISED
+			                    || ETA_SpotDropAt(floors[k], 0.0f, -96.0f) >= ETA_SPOT_RAISED);
+		}
+		if (!raised)
+		{
+			continue;
+		}
+
+		VectorSet(origin, floors[k][0], floors[k][1], floors[k][2] + 24.0f);
+		CG_AccessibilityPlace(origin, &place);
+
+		if (place.kind == ETA_PLACE_ROOFTOP || place.kind == ETA_PLACE_BALCONY
+		    || place.kind == ETA_PLACE_LEDGE || place.kind == ETA_PLACE_UPPER_FLOOR)
+		{
+			ETA_SpotView   view;
+			ETA_SpotRating rating;
+
+			ETA_SpotLook(floors[k], &view);
+			rating = ETA_Spot_Rate(&view);
+			ETA_SpotList_Offer(&eta_spots.list, origin, place.kind, &rating);
+		}
+	}
+}
+
+/**
+ * @brief A little more of the map looked over, every frame, until done.
+ */
+static void ETA_SpotScanFrame(void)
+{
+	int began;
+
+	if (eta_spots.done || !cg.snap)
+	{
+		return;
+	}
+
+	if (!eta_spots.started)
+	{
+		eta_spots.started  = qtrue;
+		eta_spots.marked   = -1;
+		eta_spots.checking = -1;
+		eta_rooms.marked   = -1;
+		eta_spots.columns = (int)((cg.mapcoordsMaxs[0] - cg.mapcoordsMins[0]) / ETA_SPOT_SPACING);
+		eta_spots.rows    = (int)((cg.mapcoordsMins[1] - cg.mapcoordsMaxs[1]) / ETA_SPOT_SPACING);
+		ETA_SpotList_Clear(&eta_spots.list);
+
+		if (!cg.mapcoordsValid || eta_spots.columns <= 0 || eta_spots.rows <= 0)
+		{
+			eta_spots.done  = qtrue;
+			eta_rooms.built = qtrue;
+			return;
+		}
+	}
+
+	began = trap_Milliseconds();
+
+	while (trap_Milliseconds() - began < ETA_SPOT_BUDGET_MS)
+	{
+		/* mapcoordsMins[1] is the north edge; rows run south from it. */
+		ETA_SpotScanPoint(cg.mapcoordsMins[0] + ((float)eta_spots.column + 0.5f) * ETA_SPOT_SPACING,
+		                  cg.mapcoordsMins[1] - ((float)eta_spots.row + 0.5f) * ETA_SPOT_SPACING,
+		                  eta_spots.column, eta_spots.row);
+
+		if (++eta_spots.column >= eta_spots.columns)
+		{
+			eta_spots.column = 0;
+			if (++eta_spots.row >= eta_spots.rows)
+			{
+				eta_spots.done = qtrue;
+				ETA_RoomsBuild();
+				return;
+			}
+		}
+	}
+}
+
+/**
+ * @brief Whether each spot can be got up to, looked for from the spot.
+ *
+ * About a third of the high places that see far on Oasis are the tops of
+ * walls and of houses nobody can climb. Looking for the way up to one of
+ * those searches the whole map before it gives up, which is many
+ * seconds; looking the other way, for a way down from it that could be
+ * walked back up, is over as soon as its few squares of roof are tried.
+ * So once the map has been looked over, while there is no marker out,
+ * each spot is searched from: steps a player could take toward it,
+ * walked backwards. A spot shut in on its own is left off the list; one
+ * whose search goes on spreading over the map is one a player can reach.
+ */
+#define ETA_SPOT_CHECK_STEPS 1500   /* squares tried: past this, the spot is on the map at large */
+
+/* The way out of a building, or into one: see CG_AccessibilityWayOut.
+   Here because the spot check stands down while it searches - they
+   share the one way-finder. */
+#define ETA_WAYOUT_MAX 4
+
+static struct
+{
+	qboolean searching;
+	qboolean in;            /* the way into a building, not out of one */
+	int      steps;
+	int      lastPress;
+	int      found;         /* ways already given this round */
+	vec3_t   ways[ETA_WAYOUT_MAX];
+} eta_wayOut;
+
+static int ETA_RouteMoveExact(void *context, const float from[3], float to[3]);
+static int ETA_RouteMove(void *context, const float from[3], float to[3]);
+
+static int ETA_RouteMoveBackExact(void *context, const float from[3], float to[3])
+{
+	static const vec3_t footMins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f };
+	static const vec3_t footMaxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f - 18.0f };
+	/* Where a step onto this square could come from: level with it or a
+	   jump below, or up to a drop above. Each is looked for in turn, the
+	   floor found from each checked by stepping forward from it. */
+	static const float above[3] = { 18.0f, 60.0f, 18.0f + ETA_ROUTE_MAX_DROP };
+	trace_t trace;
+	vec3_t  start, end;
+	float   back[3], here[3];
+	int     kind, i;
+
+	for (i = 0; i < 3; i++)
+	{
+		VectorSet(start, to[0], to[1], from[2] + above[i]);
+		VectorSet(end, to[0], to[1], from[2] - 18.0f - ETA_ROUTE_MAX_DROP);
+		trap_CM_BoxTrace(&trace, start, end, footMins, footMaxs, 0, MASK_PLAYERSOLID);
+		if (trace.startsolid || trace.allsolid || trace.fraction >= 1.0f || trace.plane.normal[2] < 0.7f)
+		{
+			continue;
+		}
+
+		VectorCopy(trace.endpos, back);
+		VectorCopy(from, here);
+
+		kind = ETA_RouteMove(context, back, here);
+		if (kind == ETA_PATH_NONE || fabsf(here[2] - from[2]) > 24.0f
+		    || (here[0] - from[0]) * (here[0] - from[0]) + (here[1] - from[1]) * (here[1] - from[1]) > 24.0f * 24.0f)
+		{
+			continue;
+		}
+
+		to[2] = back[2];
+		return kind;
+	}
+
+	return ETA_PATH_NONE;
+}
+
+/* Shifted across the way, as a step forward is: a narrow passage is a
+   way back as well as a way on. */
+static int ETA_RouteMoveBack(void *context, const float from[3], float to[3])
+{
+	static const float shifts[5] = { 0.0f, ETA_ROUTE_SHIFT, -ETA_ROUTE_SHIFT,
+		                             2.0f * ETA_ROUTE_SHIFT, -2.0f * ETA_ROUTE_SHIFT };
+	float dx = to[0] - from[0], dy = to[1] - from[1];
+	float ax = dx < 0.0f ? -dx : dx, ay = dy < 0.0f ? -dy : dy;
+	int   across = ax > 2.0f * ay ? 1 : ay > 2.0f * ax ? 0 : -1;
+	int   i;
+
+	for (i = 0; i < (across < 0 ? 1 : 5); i++)
+	{
+		float tried[3];
+		int   kind;
+
+		VectorCopy(to, tried);
+		if (across >= 0)
+		{
+			tried[across] += shifts[i];
+		}
+
+		kind = ETA_RouteMoveBackExact(context, from, tried);
+		if (kind != ETA_PATH_NONE)
+		{
+			VectorCopy(tried, to);
+			return kind;
+		}
+	}
+
+	return ETA_PATH_NONE;
+}
+
+static void ETA_SpotCheckFrame(void)
+{
+	int began, i;
+
+	if (!eta_spots.done || eta_marker.active || eta_wayOut.searching || !cg.snap
+	    || cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		eta_spots.checking = -1;   /* the way-finder is the marker's; start again later */
+		return;
+	}
+
+	/* The spots first, then the rooms: a room shut in on its own is a
+	   space the map's builder sealed off, not one to send a player to. */
+	if (eta_spots.checking < 0)
+	{
+		const float *origin = NULL;
+
+		for (i = 0; i < eta_spots.list.count && eta_spots.list.spots[i].checked; i++)
+		{
+		}
+		if (i < eta_spots.list.count)
+		{
+			eta_spots.checkingRoom = qfalse;
+			origin                 = eta_spots.list.spots[i].origin;
+		}
+		else if (eta_rooms.built)
+		{
+			for (i = 0; i < eta_rooms.list.count && eta_rooms.list.rooms[i].checked; i++)
+			{
+			}
+			if (i < eta_rooms.list.count)
+			{
+				eta_spots.checkingRoom = qtrue;
+				origin                 = eta_rooms.list.rooms[i].origin;
+			}
+		}
+		if (!origin)
+		{
+			return;
+		}
+
+		eta_spots.checking   = i;
+		eta_spots.checkSteps = 0;
+		ETA_PathFinder_Begin(origin, cg.predictedPlayerState.origin, ETA_ROUTE_CELL,
+		                     ETA_MARKER_ARRIVE_METERS / ETA_QU_TO_METERS, 0);
+	}
+
+	began = trap_Milliseconds();
+
+	while (trap_Milliseconds() - began < ETA_SPOT_BUDGET_MS)
+	{
+		ETA_PathState state = ETA_PathFinder_Step(ETA_ROUTE_BUDGET_STEP, ETA_RouteMoveBack, NULL);
+		int           shut;
+
+		eta_spots.checkSteps += ETA_ROUTE_BUDGET_STEP;
+
+		if (state == ETA_PATH_SEARCHING && eta_spots.checkSteps < ETA_SPOT_CHECK_STEPS)
+		{
+			continue;
+		}
+
+		/* Found the player, or still spreading: on the map at large.
+		   Everywhere reachable from it tried, and the player not among
+		   it: shut in. */
+		shut = (state == ETA_PATH_PARTIAL || state == ETA_PATH_FAILED) ? 1 : 0;
+		if (eta_spots.checkingRoom)
+		{
+			eta_rooms.list.rooms[eta_spots.checking].checked     = 1;
+			eta_rooms.list.rooms[eta_spots.checking].unreachable = shut;
+		}
+		else
+		{
+			eta_spots.list.spots[eta_spots.checking].checked     = 1;
+			eta_spots.list.spots[eta_spots.checking].unreachable = shut;
+		}
+		eta_spots.checking = -1;
+		ETA_PathFinder_Reset();
+		return;
+	}
+}
+
+/**
+ * @brief Whether the player is in the marked square right now.
+ */
+static qboolean ETA_MarkerSquareUnderfoot(void)
+{
+	int column, row;
+
+	ETA_MapCellFor(cg.predictedPlayerState.origin[0],
+	               cg.predictedPlayerState.origin[1], &column, &row);
+
+	if (column != eta_marker.column || row != eta_marker.row)
+	{
+		return qfalse;
+	}
+
+	if (cgs.ccLayers
+	    && CG_CurLayerForZ((int)cg.predictedPlayerState.origin[2]) != eta_marker.layer)
+	{
+		return qfalse;
+	}
+
+	return qtrue;
+}
+
+/**
+ * @brief Which way to turn for the marker, in the words the objective uses.
+ *
+ * The same two parts as the objective's: a turn, and then the two compass
+ * points together, because "turn left" alone never says how far round.
+ */
+static void ETA_MarkerSpeakWay(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	vec3_t              delta, angles, target, straight;
+	float               relativeYaw;
+	char                compass[96];
+
+	/* The turn is toward the way there, the compass point toward the
+	   marker itself: "turn right" to get round the wall, and where the
+	   marker actually lies, so the two together say it is a detour. */
+	ETA_MarkerTarget(target);
+	VectorSubtract(target, ps->origin, delta);
+	delta[2] = 0.0f;
+	vectoangles(delta, angles);
+
+	/* Written the way the objective's is, through the same call, so that
+	   tests/bearing_regression_test.py lifts this chain too and checks it
+	   against the engine's own maths. Both integrations once shipped the
+	   objective's turn mirrored; a new copy is a new chance to. */
+	relativeYaw = AngleSubtract(angles[YAW], ps->viewangles[YAW]);
+
+	if (fabsf(relativeYaw) <= 15.0f)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Marker is ahead");
+	}
+	else if (relativeYaw > 0.0f)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Turn left toward the marker");
+	}
+	else
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Turn right toward the marker");
+	}
+
+	VectorSubtract(eta_marker.origin, ps->origin, straight);
+	straight[2] = 0.0f;
+	vectoangles(straight, straight);
+
+	if (eta_route.steering || eta_route.aimSet)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection(
+			va("The way goes %s",
+			   ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(angles[YAW]))));
+	}
+
+	Com_sprintf(compass, sizeof(compass), "Marker lies %s, you are facing %s",
+	            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(straight[YAW])),
+	            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(ps->viewangles[YAW])));
+	ETA_NavigationSystem_AnnounceRouteCorrection(compass);
+}
+
+/**
+ * @brief The square's name, and its floor on a map that has floors.
+ */
+static void ETA_MarkerSquareName(char *out, size_t outSize)
+{
+	if (cgs.ccLayers > 1)
+	{
+		Com_sprintf(out, outSize, "%s, floor %d", eta_marker.name, eta_marker.layer + 1);
+	}
+	else
+	{
+		Q_strncpyz(out, eta_marker.name, outSize);
+	}
+}
+
+/**
+ * @brief Puts the marker down.
+ */
+void CG_AccessibilityMarkerPlace(void)
+{
+	char text[64];
+	int  distance;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	if (cgs.autoMapExpanded && ETA_MapSurvey_IsOpen(&eta_mapCursor))
+	{
+		vec2_t centre;
+		int    column, row;
+
+		/* The cursor is still on the player's own square: they opened
+		   the map and pressed the key without walking anywhere. A marker
+		   there would be reached before it was heard. */
+		ETA_MapCellFor(cg.predictedPlayerState.origin[0],
+		               cg.predictedPlayerState.origin[1], &column, &row);
+
+		if (column == eta_mapCursor.column && row == eta_mapCursor.row
+		    && (!cgs.ccLayers
+		        || CG_CurLayerForZ((int)cg.predictedPlayerState.origin[2]) == eta_mapCursor.layer))
+		{
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say(va("You are already in %s. Move the cursor to another square first",
+			                  ETA_MapSurvey_CellName(&eta_mapCursor)));
+			ETA_Speech_EndReport();
+			return;
+		}
+
+		ETA_MapCellCentre(eta_mapCursor.column, eta_mapCursor.row, centre);
+
+		eta_marker.square    = qtrue;
+		eta_marker.objective = qfalse;
+		eta_marker.leftIt    = qtrue;
+		eta_marker.origin[0] = centre[0];
+		eta_marker.origin[1] = centre[1];
+		eta_marker.origin[2] = cg.predictedPlayerState.origin[2];
+		eta_marker.column    = eta_mapCursor.column;
+		eta_marker.row       = eta_mapCursor.row;
+		eta_marker.layer     = eta_mapCursor.layer;
+		Q_strncpyz(eta_marker.name, ETA_MapSurvey_CellName(&eta_mapCursor), sizeof(eta_marker.name));
+	}
+	else
+	{
+		/* Where a dead or spectating player's view happens to be is not a
+		   place they can walk back to. */
+		if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+		{
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say("Hold the map key and move to a square to place a marker");
+			ETA_Speech_EndReport();
+			return;
+		}
+
+		eta_marker.square    = qfalse;
+		eta_marker.objective = qfalse;
+		eta_marker.leftIt    = qfalse;
+		VectorCopy(cg.predictedPlayerState.origin, eta_marker.origin);
+		eta_marker.name[0] = '\0';
+	}
+
+	eta_marker.active = qtrue;
+	ETA_RouteForget();
+	distance          = ETA_MarkerDistance();
+	ETA_NavigationSystem_StartMarkerApproach(distance);
+
+	ETA_Speech_BeginReport();
+
+	if (eta_marker.square)
+	{
+		char name[32];
+
+		ETA_MarkerSquareName(name, sizeof(name));
+		Com_sprintf(text, sizeof(text), "Marker on %s", name);
+		ETA_Speech_Say(text);
+		ETA_NavigationSystem_AnnounceMarkerDistance(distance);
+		ETA_MarkerSpeakWay();
+	}
+	else
+	{
+		ETA_Speech_Say("Marker set where you are standing");
+	}
+
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Puts the marker on the current objective, and leads there.
+ *
+ * The objective report says which way and how far, and since the last
+ * version how far up - but it points in a straight line, and an
+ * objective on a floor above is not reached in a straight line. The
+ * tester walked at the Oasis command post and met the wall under it.
+ * The marker's way already goes round walls and up stairs; with a jump
+ * and a ladder known to it as well, it can take the player up. So this
+ * puts the marker there, and the marker's ping leads the way.
+ *
+ * The marker goes on the floor under the objective's point, where the
+ * player will stand: the point itself is the middle of the objective's
+ * trigger, often a metre or more up, where nobody can stand.
+ *
+ * The first press takes the current objective - the one the map says is
+ * next. But that is not always where a player means to go: a command
+ * post to build, a gun nest to defend, the cabinets to restock at. So
+ * pressing again within a few seconds moves the marker to the next
+ * objective on the team's command map, nearest first, and round again:
+ * "Marker on Garrison MG Nest, 3 of 7". The list is taken at the first
+ * press and kept while the presses come, so walking a step between them
+ * does not shuffle it.
+ */
+#define ETA_MARKER_OBJECTIVES      24
+#define ETA_MARKER_CYCLE_MS        5000
+
+static struct
+{
+	int lastPress;
+	int index;
+	int count;
+	int entityNums[ETA_MARKER_OBJECTIVES];
+} eta_objectiveCycle;
+
+void CG_AccessibilityMarkerObjective(void)
+{
+	/* The route probe's body, so the height is the one the way is
+	   searched at: the player's origin, standing there. */
+	static const vec3_t mins = { -ETA_ROUTE_HALF_WIDTH, -ETA_ROUTE_HALF_WIDTH, -24.0f };
+	static const vec3_t maxs = { ETA_ROUTE_HALF_WIDTH, ETA_ROUTE_HALF_WIDTH, 24.0f };
+	etaObjective_t objective;
+	trace_t        trace;
+	vec3_t         below;
+	int            distance;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say("Only in play: spawn first, then ask for the way to the objective");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	{
+		team_t         team = cgs.clientinfo[cg.clientNum].team;
+		etaObjective_t list[ETA_MARKER_OBJECTIVES], current;
+		int            count, i, found = -1;
+		qboolean       cycling = (qboolean)(eta_objectiveCycle.lastPress
+		                                    && cg.time >= eta_objectiveCycle.lastPress
+		                                    && cg.time - eta_objectiveCycle.lastPress < ETA_MARKER_CYCLE_MS);
+
+		count = CG_AccessibilityObjectiveList(team, cg.predictedPlayerState.origin, list, ETA_MARKER_OBJECTIVES);
+
+		if (!cycling)
+		{
+			/* A fresh list: the current objective first, then the rest
+			   nearest first. */
+			if (CG_AccessibilityObjective(team, cg.predictedPlayerState.origin, &current))
+			{
+				for (i = 0; i < count && list[i].entityNum != current.entityNum; i++)
+				{
+				}
+				if (i == count)
+				{
+					/* Not on the list: it goes in front, and with the
+					   list full the furthest makes room. */
+					if (count < ETA_MARKER_OBJECTIVES)
+					{
+						count++;
+					}
+					else
+					{
+						i = count - 1;
+					}
+				}
+				for (; i > 0; i--)
+				{
+					list[i] = list[i - 1];
+				}
+				list[0] = current;
+			}
+
+			eta_objectiveCycle.count = count;
+			for (i = 0; i < count; i++)
+			{
+				eta_objectiveCycle.entityNums[i] = list[i].entityNum;
+			}
+			eta_objectiveCycle.index = 0;
+		}
+		else if (eta_objectiveCycle.count > 0)
+		{
+			eta_objectiveCycle.index = (eta_objectiveCycle.index + 1) % eta_objectiveCycle.count;
+		}
+
+		/* The one the list says, if it is still on the command map; one
+		   that has gone - built over, blown up - is passed by. */
+		for (i = 0; i < eta_objectiveCycle.count && found < 0; i++)
+		{
+			int want = eta_objectiveCycle.entityNums[(eta_objectiveCycle.index + i) % eta_objectiveCycle.count];
+			int j;
+
+			for (j = 0; j < count; j++)
+			{
+				if (list[j].entityNum == want)
+				{
+					found                    = j;
+					eta_objectiveCycle.index = (eta_objectiveCycle.index + i) % eta_objectiveCycle.count;
+					break;
+				}
+			}
+		}
+
+		eta_objectiveCycle.lastPress = cg.time;
+
+		if (found < 0)
+		{
+			eta_objectiveCycle.lastPress = 0;
+			ETA_Speech_BeginReport();
+			ETA_Speech_Say("No objectives on your command map");
+			ETA_Speech_EndReport();
+			return;
+		}
+
+		objective = list[found];
+	}
+
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	eta_marker.square    = qfalse;
+	eta_marker.objective = qtrue;
+	eta_marker.leftIt    = qtrue;
+	VectorCopy(objective.origin, eta_marker.origin);
+	Q_strncpyz(eta_marker.name, objective.name ? objective.name : "the objective", sizeof(eta_marker.name));
+	Q_CleanStr(eta_marker.name);
+
+	/* Down onto the floor, as a player standing there: the height the
+	   way is searched at, and measured to. */
+	VectorCopy(objective.origin, below);
+	below[2] -= 256.0f;
+	trap_CM_BoxTrace(&trace, objective.origin, below, mins, maxs, 0, MASK_PLAYERSOLID);
+	if (!trace.startsolid && !trace.allsolid && trace.fraction < 1.0f)
+	{
+		VectorCopy(trace.endpos, eta_marker.origin);
+	}
+
+	eta_marker.active = qtrue;
+	ETA_RouteForget();
+	distance = ETA_MarkerDistance();
+	ETA_NavigationSystem_StartMarkerApproach(distance);
+
+	ETA_Speech_BeginReport();
+	if (eta_objectiveCycle.count > 1)
+	{
+		ETA_Speech_Say(va("Marker on %s, %d of %d", eta_marker.name,
+		                  eta_objectiveCycle.index + 1, eta_objectiveCycle.count));
+	}
+	else
+	{
+		ETA_Speech_Say(va("Marker on %s", eta_marker.name));
+	}
+	ETA_NavigationSystem_AnnounceMarkerDistance(distance);
+	ETA_NavigationSystem_AnnounceMarkerHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	ETA_MarkerSpeakWay();
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Puts the marker on the nearest sniper spot, or the next one.
+ *
+ * Pressed again within a few seconds, the next spot further off, as the
+ * objective key steps through the objectives. Each is said with what it
+ * looks out over - "Rooftop, sees 60 meters to the south-east, 6 meters
+ * up" - and the marker's sound then leads the way there, up the stairs
+ * or the ladder. Arriving says which way to look.
+ */
+void CG_AccessibilitySniperSpot(void)
+{
+	const ETA_Spot *spot;
+	char            text[128];
+	int             distance;
+	qboolean        cycling;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_Speech_Say("Only in play: spawn first, then ask for a sniper spot");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	cycling = (qboolean)(eta_spots.lastPress && cg.time >= eta_spots.lastPress
+	                     && cg.time - eta_spots.lastPress < ETA_MARKER_CYCLE_MS);
+
+	if (!cycling || eta_spots.count <= 0)
+	{
+		eta_spots.count = ETA_SpotList_Nearest(&eta_spots.list, cg.predictedPlayerState.origin,
+		                                       eta_spots.order, ETA_SPOT_MAX);
+		eta_spots.index = 0;
+	}
+	else
+	{
+		eta_spots.index = (eta_spots.index + 1) % eta_spots.count;
+	}
+
+	if (eta_spots.count <= 0)
+	{
+		eta_spots.lastPress = 0;
+		ETA_Speech_Say(eta_spots.done ? "No sniper spots found on this map"
+		                              : "Still looking over the map for sniper spots. Ask again in a moment");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	eta_spots.lastPress = cg.time;
+	eta_spots.marked    = eta_spots.order[eta_spots.index];
+	eta_spots.judged    = qfalse;
+	spot                = &eta_spots.list.spots[eta_spots.marked];
+
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	eta_marker.objective = qtrue;
+	eta_marker.leftIt    = qtrue;
+	VectorCopy(spot->origin, eta_marker.origin);
+	Q_strncpyz(eta_marker.name, va("sniper spot, look %s", ETA_Spot_Compass(spot->rating.bearing)),
+	           sizeof(eta_marker.name));
+	eta_marker.active = qtrue;
+	ETA_RouteForget();
+	distance = ETA_MarkerDistance();
+	ETA_NavigationSystem_StartMarkerApproach(distance);
+
+	ETA_Spot_Text(spot->kind, &spot->rating, text, sizeof(text));
+	ETA_Speech_Say(va("Sniper spot %d of %d%s: %s", eta_spots.index + 1, eta_spots.count,
+	                  eta_spots.done ? "" : ", more still being looked for", text));
+	ETA_NavigationSystem_AnnounceMarkerDistance(distance);
+	ETA_NavigationSystem_AnnounceMarkerHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	ETA_MarkerSpeakWay();
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Puts the marker on the nearest room, or the next one.
+ *
+ * As the sniper spot key does: pressed again within a few seconds, the
+ * next room further off. Each is said with the map's own name for the
+ * place, which floor it is on and its size - "Room 2 of 12: Water Pump,
+ * ground floor, 8 by 6 meters" - and the marker's sound leads the way
+ * there, through the door. Arriving says "inside" it.
+ */
+void CG_AccessibilityRoom(void)
+{
+	const ETA_Room *room;
+	char            text[128];
+	int             distance;
+	qboolean        cycling;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_Speech_Say("Only in play: spawn first, then ask for a room");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	cycling = (qboolean)(eta_rooms.lastPress && cg.time >= eta_rooms.lastPress
+	                     && cg.time - eta_rooms.lastPress < ETA_MARKER_CYCLE_MS);
+
+	if (!cycling || eta_rooms.count <= 0)
+	{
+		eta_rooms.count = eta_rooms.built
+		                  ? ETA_RoomList_Nearest(&eta_rooms.list, cg.predictedPlayerState.origin,
+		                                         eta_rooms.order, ETA_ROOM_MAX)
+		                  : 0;
+		eta_rooms.index = 0;
+	}
+	else
+	{
+		eta_rooms.index = (eta_rooms.index + 1) % eta_rooms.count;
+	}
+
+	if (eta_rooms.count <= 0)
+	{
+		eta_rooms.lastPress = 0;
+		ETA_Speech_Say(eta_rooms.built ? "No rooms found on this map"
+		                               : "Still looking over the map for rooms. Ask again in a moment");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	eta_rooms.lastPress = cg.time;
+	eta_rooms.marked    = eta_rooms.order[eta_rooms.index];
+	eta_rooms.judged    = qfalse;
+	room                = &eta_rooms.list.rooms[eta_rooms.marked];
+
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	eta_marker.objective = qtrue;
+	eta_marker.leftIt    = qtrue;
+	VectorCopy(room->origin, eta_marker.origin);
+	Q_strncpyz(eta_marker.name, room->name[0] ? va("inside %s", room->name) : "inside the room",
+	           sizeof(eta_marker.name));
+	eta_marker.active = qtrue;
+	ETA_RouteForget();
+	distance = ETA_MarkerDistance();
+	ETA_NavigationSystem_StartMarkerApproach(distance);
+
+	ETA_Room_Text(room, ETA_SPOT_SPACING, text, sizeof(text));
+	ETA_Speech_Say(va("Room %d of %d: %s", eta_rooms.index + 1, eta_rooms.count, text));
+	ETA_NavigationSystem_AnnounceMarkerDistance(distance);
+	ETA_NavigationSystem_AnnounceMarkerHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	ETA_MarkerSpeakWay();
+	ETA_Speech_EndReport();
+}
