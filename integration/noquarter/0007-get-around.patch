+/*
+ * Every objective on the team's command map, nearest first: what a
+ * sighted player sees as icons, the health and ammo cabinets with them.
+ * Each objective once, however many icons it has. Returns how many.
+ */
+int CG_AccessibilityObjectiveList( team_t team, const vec3_t from, etaObjective_t *out, int max ) {
+	int i, j, count = 0;
+
+	for( i = 0; i < CG_AccessibilityMapEntityCount() && count < max; i++ ) {
+		const mapEntityData_t *mEnt = CG_AccessibilityMapEntity( i );
+		vec3_t origin;
+		int oidIndex = -1;
+		qboolean seen = qfalse;
+
+		if( mEnt->team != team || !CG_AccessibilityMapObjectiveAt( mEnt, origin, &oidIndex )
+			|| oidIndex < 0 || oidIndex >= MAX_OID_TRIGGERS ) {
+			continue;
+		}
+
+		for( j = 0; j < count; j++ ) {
+			if( out[j].entityNum == cgs.oidInfo[oidIndex].entityNum ) {
+				seen = qtrue;
+				break;
+			}
+		}
+		if( seen ) {
+			continue;
+		}
+
+		out[count].name = cgs.oidInfo[oidIndex].name[0] ? cgs.oidInfo[oidIndex].name : NULL;
+		out[count].entityNum = cgs.oidInfo[oidIndex].entityNum;
+		VectorCopy( origin, out[count].origin );
+		count++;
+	}
+
+	/* Nearest first: a handful at most, so a plain insertion sort. */
+	for( i = 1; i < count; i++ ) {
+		etaObjective_t item = out[i];
+		float here = Distance( from, item.origin );
+
+		for( j = i; j > 0 && Distance( from, out[j - 1].origin ) > here; j-- ) {
+			out[j] = out[j - 1];
+		}
+		out[j] = item;
+	}
+
+	return count;
+}
+
+/* The command map's icons, both of No Quarter's lists as one, for the
+   survey to walk: the objective icons first, then the players. */
+int CG_AccessibilityMapEntityCount( void ) {
+	return mapEntityCount2 + mapEntityCount;
+}
+
+mapEntityData_t *CG_AccessibilityMapEntity( int index ) {
+	return index < mapEntityCount2 ? &mapEntities2[index] : &mapEntities[index - mapEntityCount2];
+}
 #endif
