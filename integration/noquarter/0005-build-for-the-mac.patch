+/*
+ * No Quarter's game module for the Mac, written out of this mod's pk3
+ * into the mod's folder, where the game loads it from to run a game the
+ * player hosts. No Quarter ships no Mac version, so this mod brings one,
+ * and it used to be a file to copy in by hand. A file downloaded from the
+ * web carries the Mac's quarantine mark, and the Mac would not load it -
+ * the error said the file was missing while it sat in the folder - and
+ * on one tester's Mac "Open Anyway" never offered to let it. A file the
+ * game writes itself carries no mark. The game does the same for cgame_mac
+ * and ui_mac, from this same pk3, but not for the game module, which it
+ * only looks for loose in the folder.
+ *
+ * Written when missing, different, or carrying the mark; left alone when
+ * it is this build's already. Written beside it and renamed over it, so a
+ * write cut short never leaves half a library in its place.
+ */
+#define UI_ETA_MAC_GAME_IN_PAK "eta/qagame_mac"
+
+/*
+ * Whether the Mac will load the game module, tried as the menus start.
+ * When it will not, every map - hosted from the menus or started with
+ * /map - ends the game with an error that says the file is missing, and
+ * the console is the only place the Mac's reason appears. So it is said
+ * aloud, once the menus have settled, in the Mac's own words. Loaded and
+ * let go again at once: nothing in it runs but its constructors.
+ */
+static void UI_AccessibilityMacCheckGame( const char *path ) {
+	void *library = dlopen( path, RTLD_NOW | RTLD_LOCAL );
+	char reason[512];
+
+	if( library ) {
+		void *entry = dlsym( library, "vmMain" );
+
+		dlclose( library );
+		if( entry ) {
+			Com_Printf( "Accessibility: %s loads\n", path );
+			return;
+		}
+		Q_strncpyz( reason, "it has no vmMain", sizeof(reason) );
+	}
+	else {
+		const char *error = dlerror();
+
+		Q_strncpyz( reason, error ? error : "no reason given", sizeof(reason) );
+	}
+
+	Com_Printf( "^3Accessibility: the Mac will not load %s: %s\n", path, reason );
+	UI_AccessibilitySayLater( va( "Maps will not start: the Mac will not load No Quarter's game module. The Mac says: %s", reason ) );
+}
+
+static void UI_AccessibilityMacInstallGame( void ) {
+	static byte packed[65536];
+	static byte local[65536];
+	char homepath[MAX_OSPATH];
+	char gamedir[MAX_QPATH];
+	char path[MAX_OSPATH];
+	char temp[MAX_OSPATH + 8];
+	fileHandle_t f = 0;
+	FILE *existing;
+	FILE *out;
+	int length, left;
+	qboolean same, failed = qfalse;
+
+	length = trap_FS_FOpenFile( UI_ETA_MAC_GAME_IN_PAK, &f, FS_READ );
+	if( length <= 0 || !f ) {
+		if( f ) {
+			trap_FS_FCloseFile( f );
+		}
+		return; /* a pk3 built without it */
+	}
+
+	trap_Cvar_VariableStringBuffer( "fs_homepath", homepath, sizeof(homepath) );
+	trap_Cvar_VariableStringBuffer( "fs_game", gamedir, sizeof(gamedir) );
+	if( !homepath[0] ) {
+		trap_FS_FCloseFile( f );
+		return;
+	}
+	if( !gamedir[0] ) {
+		Q_strncpyz( gamedir, "nq", sizeof(gamedir) );
+	}
+	Com_sprintf( path, sizeof(path), "%s/%s/qagame_mac", homepath, gamedir );
+	Com_sprintf( temp, sizeof(temp), "%s.new", path );
+
+	existing = fopen( path, "rb" );
+	same = existing && getxattr( path, "com.apple.quarantine", NULL, 0, 0, 0 ) < 0;
+
+	out = fopen( temp, "wb" );
+	if( !out ) {
+		Com_Printf( "^3Accessibility: could not write %s\n", temp );
+		if( existing ) {
+			fclose( existing );
+		}
+		trap_FS_FCloseFile( f );
+		UI_AccessibilityMacCheckGame( path );
+		return;
+	}
+
+	for( left = length; left > 0; ) {
+		int chunk = left < (int)sizeof(packed) ? left : (int)sizeof(packed);
+
+		trap_FS_Read( packed, chunk, f );
+		if( (int)fwrite( packed, 1, chunk, out ) != chunk ) {
+			failed = qtrue;
+			break;
+		}
+		if( same && ( (int)fread( local, 1, chunk, existing ) != chunk || memcmp( packed, local, chunk ) ) ) {
+			same = qfalse;
+		}
+		left -= chunk;
+	}
+	if( same && fgetc( existing ) != EOF ) {
+		same = qfalse; /* the one there is longer */
+	}
+
+	trap_FS_FCloseFile( f );
+	if( existing ) {
+		fclose( existing );
+	}
+	if( fclose( out ) != 0 ) {
+		failed = qtrue;
+	}
+
+	if( failed || same ) {
+		remove( temp );
+		if( failed ) {
+			Com_Printf( "^3Accessibility: could not write %s\n", temp );
+		}
+	}
+	else if( rename( temp, path ) != 0 ) {
+		remove( temp );
+		Com_Printf( "^3Accessibility: could not put the game module at %s\n", path );
+	}
+	else {
+		Com_Printf( "Accessibility: wrote No Quarter's game module for the Mac to %s\n", path );
+	}
+	UI_AccessibilityMacCheckGame( path );
+}
+#endif
