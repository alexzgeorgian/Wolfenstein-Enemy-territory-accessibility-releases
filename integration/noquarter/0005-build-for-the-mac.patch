+				if( UI_AccessibilityLogLineCounts( lines[i] ) ) {
+					found++;
+				}
+			}
+			for( i++; i < before; i++ ) {
+				if( UI_AccessibilityLogLineCounts( lines[i] ) ) {
+					Q_strcat( said, sizeof(said), " " );
+					Q_strcat( said, sizeof(said), UI_AccessibilityLogLineSaid( lines[i] ) );
