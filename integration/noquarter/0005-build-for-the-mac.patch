+static qboolean UI_AccessibilityLogLineCounts( const char *line ) {
+	/* Banners and blank lines say nothing. */
+	for( ; *line; line++ ) {
+		if( *line != ' ' && *line != '*' && *line != '-' && *line != '=' && *line != '\r' ) {
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
