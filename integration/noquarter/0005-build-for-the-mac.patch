+/* A log line as it is said: without the dashes and stars round banners. */
+static const char *UI_AccessibilityLogLineSaid( const char *line ) {
+	static char trimmed[MAX_STRING_CHARS];
+	int length;
+
+	while( *line == ' ' || *line == '-' || *line == '*' || *line == '=' ) {
+		line++;
+	}
+	Q_strncpyz( trimmed, line, sizeof(trimmed) );
+	for( length = strlen( trimmed ); length > 0; length-- ) {
+		char c = trimmed[length - 1];
+
+		if( c != ' ' && c != '-' && c != '*' && c != '=' && c != '\r' ) {
+			break;
+		}
+	}
+	trimmed[length] = '\0';
+	return trimmed;
+}
