-// MAPVOTE END
\ No newline at end of file
+// MAPVOTE END
+#ifdef FEATURE_ACCESSIBILITY
+/*
+=====================================================================
+The end of the match, spoken
+
+The debriefing is four pages - the map vote, the scoreboard, the awards
+and every player's stats - worked with the mouse. Here they are pages
+of speech: Page Up and Page Down change the page, the arrows move
+through the maps, the awards or the players, Enter votes for a map,
+Home says the page again and End says you are ready. Typing still
+chats, and Enter sends the chat while there is any.
+=====================================================================
+*/
+
+static int		eta_dbSpokenMode = -1;		// the page last spoken
+static qboolean	eta_dbIntroduced;
+static qboolean	eta_dbMapsWaiting;			// map vote page said before the list came
+static int		eta_dbWeaponsWaiting = -1;	// player whose weapon stats are still coming
+static int		eta_dbAward = -1;			// award the arrows are on
+
+static const char *ETA_DebriefPageName(int mode) {
+	switch (mode) {
+	case 0:	return "Map vote";
+	case 1:	return "Scoreboard";
+	case 2:	return "Awards";
+	default: return "Player stats";
+	}
+}
+
+static qboolean ETA_DebriefHasPage(int mode) {
+	return (qboolean)(mode != 0 || cgs.gametype == GT_WOLF_MAPVOTE);
+}
+
+static void ETA_DebriefSayMap(int map) {
+	int k;
+	const char *choice = "";
+
+	if (map < 0 || map >= cgs.dbNumMaps) {
+		return;
+	}
+	for (k = 0; k < 3; k++) {
+		if (cgs.dbMapVotedFor[k] == map) {
+			choice = !cgs.dbMapMultiVote ? ", your vote" : (k == 0 ? ", your first choice" : k == 1 ? ", your second choice" : ", your third choice");
+		}
+	}
+	ETA_Speech_Say(va("%s, %d of %d, %d %s%s", cgs.dbMapDispName[map], map + 1, cgs.dbNumMaps,
+		cgs.dbMapVotes[map], cgs.dbMapVotes[map] == 1 ? "vote" : "votes", choice));
+}
+
+static void ETA_DebriefSayPlayer(int clientNum) {
+	clientInfo_t	*ci;
+	score_t			*score = NULL;
+	int				i;
+
+	if (clientNum < 0 || clientNum >= cgs.maxclients || !cgs.clientinfo[clientNum].infoValid) {
+		return;
+	}
+	ci = &cgs.clientinfo[clientNum];
+	for (i = 0; i < cgs.maxclients; i++) {
+		if (cg.scores[i].client == clientNum) {
+			score = &cg.scores[i];
+			break;
+		}
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(va("%s%s, %s, %d XP", ci->cleanname, clientNum == cg.clientNum ? ", you" : "",
+		CG_Debriefing_FullRankNameForClientInfo(ci), ci->score));
+	if (cgs.dbPlayerKillsDeathsRecieved) {
+		ETA_Speech_Say(va("%d kills, %d deaths", ci->kills, ci->deaths));
+		if (ci->team_kills_i > 0) {
+			ETA_Speech_Say(va("%d team kills", ci->team_kills_i));
+		}
+	}
+	if (cgs.dbAccuraciesRecieved) {
+		ETA_Speech_Say(va("accuracy %d percent", ci->totalWeapAcc));
+	}
+	if (score) {
+		ETA_Speech_Say(va("%d %s played", score->time, score->time == 1 ? "minute" : "minutes"));
+	}
+	if (cgs.dbWeaponStatsRecieved && cgs.dbSelectedClient == clientNum) {
+		int pos;
+
+		for (pos = CG_Debriefing_GetNextWeaponStat(-1); pos != -1; pos = CG_Debriefing_GetNextWeaponStat(pos)) {
+			ETA_Speech_Say(va("%s, %d shots, %d hits, %d %s", CG_AccessibilityStatsWeaponName(pos),
+				cgs.dbWeaponStats[pos].numShots, cgs.dbWeaponStats[pos].numHits,
+				cgs.dbWeaponStats[pos].numKills, cgs.dbWeaponStats[pos].numKills == 1 ? "kill" : "kills"));
+		}
+		eta_dbWeaponsWaiting = -1;
+	}
+	else {
+		eta_dbWeaponsWaiting = clientNum;
+	}
+	ETA_Speech_EndReport();
+}
+
+static void ETA_DebriefSayAward(int award) {
+	if (award < 0 || award >= NUM_ENDGAME_AWARDS || cgs.dbAwardTeams[award] == -1) {
+		return;
+	}
+	ETA_Speech_Say(va("%s: %s, %s", awardNames[award], cgs.dbAwardNames[award],
+		cgs.dbAwardTeams[award] == TEAM_AXIS ? "Axis" : "Allies"));
+}
+
+static int ETA_DebriefAwardCount(void) {
+	int i, n = 0;
+
+	for (i = 0; i < NUM_ENDGAME_AWARDS; i++) {
+		if (cgs.dbAwardTeams[i] != -1) {
+			n++;
+		}
+	}
+	return n;
+}
+
+static void ETA_DebriefSayPage(void) {
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(ETA_DebriefPageName(cgs.dbMode));
+
+	switch (cgs.dbMode) {
+	case 0:
+		if (!cgs.dbMapListReceived) {
+			ETA_Speech_Say("the maps are on their way");
+			eta_dbMapsWaiting = qtrue;
+			break;
+		}
+		eta_dbMapsWaiting = qfalse;
+		ETA_Speech_Say(va("%d maps. Up and Down choose, Enter votes%s", cgs.dbNumMaps,
+			cgs.dbMapMultiVote ? ", up to three choices" : ""));
+		ETA_DebriefSayMap(cgs.dbSelectedMap >= 0 ? cgs.dbSelectedMap : cgs.dbMapVotedFor[0]);
+		break;
+	case 1:
+		/* ends the report, with the board in it */
+		CG_AccessibilityScoresPressed( qfalse );
+		break;
+	case 2:
+		if (!cgs.dbAwardsParsed) {
+			CG_Debreifing2_Awards_Parse();
+		}
+		ETA_Speech_Say(va("%d awards. Up and Down go through them", ETA_DebriefAwardCount()));
+		break;
+	default:
+		ETA_Speech_Say("Up and Down go through the players");
+		ETA_DebriefSayPlayer(cgs.dbSelectedClient);
+		break;
+	}
+	ETA_Speech_EndReport();
+	eta_dbSpokenMode = cgs.dbMode;
+}
+
+/* Every frame of the debriefing. */
+void CG_AccessibilityDebriefingFrame(void) {
+	if (!eta_dbIntroduced) {
+		const char *winner = Info_ValueForKey(CG_ConfigString(CS_MULTI_MAPWINNER), "winner");
+
+		eta_dbIntroduced = qtrue;
+		eta_dbAward = -1;
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(atoi(winner) == -1 ? "Match over" : atoi(winner) ? "Match over. Allies win" : "Match over. Axis win");
+		ETA_Speech_Say("Page Up and Page Down change the page");
+		ETA_DebriefSayPage();	// ends the report
+		return;
+	}
+
+	if (cgs.dbMode != eta_dbSpokenMode) {
+		ETA_DebriefSayPage();	// changed with the mouse
+	}
+	else if (cgs.dbMode == 0 && eta_dbMapsWaiting && cgs.dbMapListReceived) {
+		ETA_DebriefSayPage();
+	}
+	else if (cgs.dbMode == 3 && eta_dbWeaponsWaiting == cgs.dbSelectedClient && cgs.dbWeaponStatsRecieved) {
+		ETA_DebriefSayPlayer(cgs.dbSelectedClient);
+	}
+}
+
+/* The debriefing is over: the next one introduces itself again. */
+void CG_AccessibilityDebriefingReset(void) {
+	eta_dbIntroduced = qfalse;
+	eta_dbSpokenMode = -1;
+	eta_dbMapsWaiting = qfalse;
+	eta_dbWeaponsWaiting = -1;
+}
+
+static void ETA_DebriefVote(void) {
+	int map = cgs.dbSelectedMap, k;
+
+	if (!cg.snap || map < 0 || map >= cgs.dbNumMaps) {
+		ETA_Speech_Say("Choose a map with Up and Down first");
+		return;
+	}
+	if (!cgs.dbMapMultiVote) {
+		trap_SendClientCommand(va("mapvote %d", cgs.dbMapID[map]));
+		cgs.dbMapVotedFor[0] = map;
+		ETA_Speech_Say(va("Voted for %s", cgs.dbMapDispName[map]));
+		return;
+	}
+	for (k = 0; k < 3; k++) {
+		if (cgs.dbMapVotedFor[k] == map) {
+			ETA_Speech_Say("You have chosen that one already");
+			return;
+		}
+	}
+	for (k = 0; k < 3 && cgs.dbMapVotedFor[k] != -1; k++) {
+	}
+	if (k == 3) {
+		ETA_Speech_Say("You have made all three choices");
+		return;
+	}
+	trap_SendClientCommand(va("mapvote %d %d", cgs.dbMapID[map], k + 1));
+	cgs.dbMapVotedFor[k] = map;
+	ETA_Speech_Say(va("%s choice: %s", k == 0 ? "First" : k == 1 ? "Second" : "Third", cgs.dbMapDispName[map]));
+}
+
+/* A key in the debriefing. qtrue: it was the mode's, and nothing else
+   gets it. */
+qboolean CG_AccessibilityDebriefingKey(int key, qboolean down) {
+	int step, i, mode;
+
+	if (!down) {
+		return qfalse;
+	}
+
+	switch (key) {
+	case K_PGUP:
+	case K_PGDN:
+		step = key == K_PGDN ? 1 : 3;
+		mode = cgs.dbMode;
+		for (i = 0; i < 4; i++) {
+			mode = (mode + step) % 4;
+			if (ETA_DebriefHasPage(mode)) {
+				break;
+			}
+		}
+		cgs.dbMode = mode;
+		trap_S_StartLocalSound(trap_S_RegisterSound("sound/menu/menu_click.wav", qtrue), CHAN_LOCAL_SOUND);
+		ETA_DebriefSayPage();
+		return qtrue;
+
+	case K_HOME:
+		ETA_DebriefSayPage();
+		return qtrue;
+
+	case K_END:
+		if (cg.snap && (cg.snap->ps.eFlags & EF_READY)) {
+			ETA_Speech_Say("You are ready already");
+		}
+		else {
+			trap_SendClientCommand("imready");
+			ETA_Speech_Say("Ready");
+		}
+		return qtrue;
+
+	case K_UPARROW:
+	case K_DOWNARROW:
+		step = key == K_DOWNARROW ? 1 : -1;
+		if (cgs.dbMode == 0) {
+			int map = cgs.dbSelectedMap;
+
+			if (cgs.dbNumMaps <= 0) {
+				ETA_Speech_Say("No maps yet");
+				return qtrue;
+			}
+			map = map < 0 ? 0 : (map + step + cgs.dbNumMaps) % cgs.dbNumMaps;
+			cgs.dbSelectedMap = map;
+			cgs.dbSelectedMapTime = cg.time;
+			if (map < cgs.dbMapVoteListOffset) {
+				cgs.dbMapVoteListOffset = map;
+			}
+			else if (map >= cgs.dbMapVoteListOffset + 18) {
+				cgs.dbMapVoteListOffset = map - 17;
+			}
+			ETA_DebriefSayMap(map);
+		}
+		else if (cgs.dbMode == 2) {
+			int award = eta_dbAward;
+
+			if (!cgs.dbAwardsParsed) {
+				CG_Debreifing2_Awards_Parse();
+			}
+			if (ETA_DebriefAwardCount() == 0) {
+				ETA_Speech_Say("No awards");
+				return qtrue;
+			}
+			do {
+				award = (award + step + NUM_ENDGAME_AWARDS) % NUM_ENDGAME_AWARDS;
+			} while (cgs.dbAwardTeams[award] == -1);
+			eta_dbAward = award;
+			ETA_DebriefSayAward(award);
+		}
+		else if (cgs.dbMode == 3) {
+			int count = 0, at = 0;
+
+			for (i = 0; i < cgs.maxclients; i++) {
+				cgs.dbSortedClients[i] = i;
+			}
+			qsort(cgs.dbSortedClients, cgs.maxclients, sizeof(int), CG_SortPlayersByXP);
+			for (i = 0; i < cgs.maxclients && cgs.clientinfo[cgs.dbSortedClients[i]].infoValid; i++) {
+				if (cgs.dbSortedClients[i] == cgs.dbSelectedClient) {
+					at = i;
+				}
+				count++;
+			}
+			if (count == 0) {
+				return qtrue;
+			}
+			at = (at + step + count) % count;
+			CG_Debrieing_SetSelectedClient(cgs.dbSortedClients[at]);
+			ETA_DebriefSayPlayer(cgs.dbSelectedClient);
+		}
+		else {
+			CG_AccessibilityScoresPressed( qfalse );
+		}
+		return qtrue;
+
+	case K_ENTER:
+	case K_KP_ENTER:
+		{
+			char chat[MAX_SAY_TEXT];
+
+			trap_Cvar_VariableStringBuffer("chattext", chat, sizeof(chat));
+			if (chat[0]) {
+				return qfalse;	// sends the chat
+			}
+			if (cgs.dbMode == 0) {
+				ETA_DebriefVote();
+			}
+			else {
+				ETA_DebriefSayPage();
+			}
+		}
+		return qtrue;
+	}
+
+	return qfalse;
+}
+#endif
