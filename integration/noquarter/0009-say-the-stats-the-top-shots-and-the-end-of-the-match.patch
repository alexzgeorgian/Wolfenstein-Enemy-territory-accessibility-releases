diff --git a/src/cgame/cg_accessibility.c b/src/cgame/cg_accessibility.c
index ca21c6b..d66cc64 100644
--- a/src/cgame/cg_accessibility.c
+++ b/src/cgame/cg_accessibility.c
@@ -1509,6 +1509,93 @@ void CG_AccessibilityScoresArrived(void) {
 	eta_scoresPending = 0;
 }
 
+/*
+=====================================================================
+Stats and top shots
+=====================================================================
+*/
+
+/* Each is built as the server's answer is parsed, and said when it is
+   the answer to a key just pressed. The windows lay them out in columns
+   of abbreviations; these are the same figures as a person reads them. */
+#define ETA_REPORT_PARTS 40
+#define ETA_REPORT_PART  96
+
+typedef struct {
+	char	text[ETA_REPORT_PARTS][ETA_REPORT_PART];
+	int		count;
+	int		pending;
+} eta_report_t;
+
+static eta_report_t eta_reports[ETA_REPORT_COUNT];
+
+void CG_AccessibilityReportBegin(eta_reportKind_t kind) {
+	eta_reports[kind].count = 0;
+}
+
+void CG_AccessibilityReportAdd(eta_reportKind_t kind, const char *text) {
+	eta_report_t *report = &eta_reports[kind];
+
+	if (report->count < ETA_REPORT_PARTS) {
+		Q_strncpyz(report->text[report->count++], text, ETA_REPORT_PART);
+	}
+}
+
+int CG_AccessibilityReportCount(eta_reportKind_t kind) {
+	return eta_reports[kind].count;
+}
+
+static void ETA_ReportSpeak(const eta_report_t *report) {
+	int i;
+
+	ETA_Speech_BeginReport();
+	for (i = 0; i < report->count; i++) {
+		ETA_Speech_Say(report->text[i]);
+	}
+	ETA_Speech_EndReport();
+}
+
+/* The answer is whole: say it if it was asked for a moment ago. */
+void CG_AccessibilityReportDone(eta_reportKind_t kind) {
+	eta_report_t *report = &eta_reports[kind];
+
+	if (report->pending && cg.time - report->pending >= 0 && cg.time - report->pending < ETA_ANSWER_WAIT_MS) {
+		ETA_ReportSpeak(report);
+	}
+	report->pending = 0;
+}
+
+/* The key for it was pressed. requested: a fresh answer was asked for,
+   so it is said when it arrives; otherwise the last one is said now. */
+void CG_AccessibilityReportPressed(eta_reportKind_t kind, qboolean requested) {
+	eta_report_t *report = &eta_reports[kind];
+
+	if (requested || report->count == 0) {
+		report->pending = cg.time | 1;
+		return;
+	}
+	ETA_ReportSpeak(report);
+}
+
+/* A weapon's stats name as a person says it: the window abbreviates to
+   fit a column, and a screen reader spells "F.Thrower" out. */
+const char *CG_AccessibilityStatsWeaponName(int stat) {
+	switch (stat) {
+	case WS_FLAMETHROWER:		return "Flamethrower";
+	case WS_GRENADELAUNCHER:	return "Rifle grenade";
+	case WS_MG42:				return "MG 42";
+	case WS_BROWNING:			return "Browning";
+	case WS_GARAND:				return "Garand";
+	case WS_K43:				return "K43";
+	case WS_FOOTKICK:			return "Kick";
+	default:
+		if (stat >= 0 && stat < WS_MAX) {
+			return CG_AccessibilityWeaponName((weapon_t)aWeaponInfo[stat].WP_Index);
+		}
+		return "Weapon";
+	}
+}
+
