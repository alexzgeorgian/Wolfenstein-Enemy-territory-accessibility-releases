+/*
+=====================================================================
+Hosting
+
+The mode's Hosting page, as in the ET: Legacy mode: friends joining
+with the plain game, how many bots and how good, and here also map
+voting, which No Quarter's Host Game screen does not offer. Applied on
+Start Server, before the map command it queues has run.
+=====================================================================
+*/
+static vmCvar_t eta_hostPlain;
+static vmCvar_t eta_hostBotCount;
+static vmCvar_t eta_hostBotSkill;
+static vmCvar_t eta_hostMapVote;
+
+/* With the host, the 20 players the Host Game screen makes room for. */
+#define ETA_HOST_BOTS_MAX 19
+
+static void UI_AccessibilityRegisterHostCvars( void ) {
+	trap_Cvar_Register( &eta_hostPlain, "eta_hostPlain", "1", CVAR_ARCHIVE );
+	trap_Cvar_Register( &eta_hostBotCount, "eta_hostBotCount", "0", CVAR_ARCHIVE );
+	trap_Cvar_Register( &eta_hostBotSkill, "eta_hostBotSkill", "2", CVAR_ARCHIVE );
+	trap_Cvar_Register( &eta_hostMapVote, "eta_hostMapVote", "0", CVAR_ARCHIVE );
+}
+
+/* That many bots, however many people join: Omni-bot adds bots up to
+   minbots whoever else is playing, and takes them away only past
+   maxbots players in all - so with both at the count, it stays. */
+static const char *UI_AccessibilityBotCommand( int bots ) {
+	return va( "bot minbots %i ; bot maxbots %i", bots, bots );
+}
+
+static void UI_AccessibilityHostServer( void ) {
+	trap_Cvar_Update( &eta_hostPlain );
+	trap_Cvar_Update( &eta_hostBotCount );
+	trap_Cvar_Update( &eta_hostBotSkill );
+	trap_Cvar_Update( &eta_hostMapVote );
+
+	/* The mode's pk3 is in the nq folder, and a pure server asks everyone
+	   who joins for it; this lets friends join with the game they have. */
+	if( eta_hostPlain.integer ) {
+		trap_Cvar_Set( "sv_pure", "0" );
+		trap_Cvar_Set( "sv_allowDownload", "0" );
+	}
+
+	/* Map voting is a game type of its own, after the match and between
+	   maps: the server offers a list, and the debriefing says it. */
+	if( eta_hostMapVote.integer && ui_netGameType.integer != GT_WOLF_CAMPAIGN ) {
+		trap_Cvar_Set( "g_gametype", va( "%i", GT_WOLF_MAPVOTE ) );
+	}
+
+	if( eta_hostBotCount.integer <= 0 ) {
+		/* Off means off: omnibot_enable is archived, so a server hosted
+		   with bots once would otherwise have them every time after. */
+		trap_Cvar_Set( "omnibot_enable", "0" );
+		return;
+	}
+
+	trap_Cvar_Set( "omnibot_enable", "1" );
+#ifndef __APPLE__
+	/* Where the No Quarter download keeps Omni-bot, unless the player
+	   has said otherwise. On a Mac the game looks in its own places. */
+	{
+		char path[MAX_OSPATH];
+
+		trap_Cvar_VariableStringBuffer( "omnibot_path", path, sizeof(path) );
+		if( !path[0] ) {
+			char base[MAX_OSPATH];
+
+			trap_Cvar_VariableStringBuffer( "fs_basepath", base, sizeof(base) );
+			trap_Cvar_Set( "omnibot_path", va( "%s/nq/omni-bot", base ) );
+		}
+	}
+#endif
+	/* Omni-bot loads with the map, so the count waits behind it */
+	trap_Cmd_ExecuteText( EXEC_APPEND, va( "wait 10 ; bot difficulty %i ; %s\n",
+		(int)Com_Clamp( 1, 6, eta_hostBotSkill.integer ),
+		UI_AccessibilityBotCommand( (int)Com_Clamp( 1, ETA_HOST_BOTS_MAX, eta_hostBotCount.integer ) ) ) );
+}
+
+/* The bot count changed during a match the player hosts: sent to
+   Omni-bot at once, and said. On somebody else's server it waits for
+   the next game they host. */
+static void UI_AccessibilityBotsFrame( void ) {
+	static int		said = -1;
+	uiClientState_t	cstate;
+	int				bots;
+
+	trap_Cvar_Update( &eta_hostBotCount );
+	bots = (int)Com_Clamp( 0, ETA_HOST_BOTS_MAX, eta_hostBotCount.integer );
+
+	trap_GetClientState( &cstate );
+	if( said < 0 || cstate.connState != CA_ACTIVE || trap_Cvar_VariableValue( "sv_running" ) == 0.f ) {
+		said = bots;
+		return;
+	}
+	if( bots == said ) {
+		return;
+	}
+	said = bots;
+
+	if( trap_Cvar_VariableValue( "omnibot_enable" ) == 0.f ) {
+		if( bots > 0 ) {
+			trap_Cvar_Set( "omnibot_enable", "1" );
+			UI_AccessibilitySay( va( "%i %s from the next map: this one started without bots", bots, bots == 1 ? "bot joins" : "bots join" ) );
+		}
+		return;
+	}
+
+	trap_Cmd_ExecuteText( EXEC_APPEND, va( "%s\n", UI_AccessibilityBotCommand( bots ) ) );
+	UI_AccessibilitySay( bots ? va( "%i %s now", bots, bots == 1 ? "bot" : "bots" ) : "No bots now" );
+}
+
 /*
