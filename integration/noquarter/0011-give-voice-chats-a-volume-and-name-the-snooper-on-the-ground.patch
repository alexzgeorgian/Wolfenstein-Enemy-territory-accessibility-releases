+/* Players' and bots' voice chats, 0 to 127 as a sound is played, or -1
+   at 100 to leave them alone. Asked for so that bots calling for medics
+   all match long do not drown the marker; their words are still read in
+   the chat. */
+int CG_AccessibilityVoiceVolume(void) {
+	int percent = eta_voiceVolume.integer;
+
+	if (percent >= 100) {
+		return -1;
+	}
+	return percent <= 0 ? 0 : (127 * percent) / 100;
+}
