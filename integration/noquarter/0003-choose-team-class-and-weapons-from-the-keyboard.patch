@@ -1196,6 +1200,49 @@ typedef struct {
 	void	(*function)(void);
 } consoleCommand_t;
 
+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * [Accessibility]: repeat and stop, answered by whichever module is in
+ * front of the player. The cgame and the ui each have their own copy of
+ * the speech library and cannot see each other's. Once a match is
+ * running the engine offers every command to the cgame first, so with a
+ * menu open mid-match the request is handed to the ui under a name only
+ * the ui answers.
+ */
+static qboolean CG_AccessibilityForwardToUI( const char *uiCommand ) {
+	if( !(trap_Key_GetCatcher() & KEYCATCH_UI) ) {
+		return qfalse;
+	}
+
+	trap_SendConsoleCommand( va( "%s\n", uiCommand ) );
+	return qtrue;
+}
+
+static void CG_AccessibilityRepeat_f( void ) {
+	if( CG_AccessibilityForwardToUI( "accessibilityRepeatMenuItem" ) ) {
+		return;
+	}
+	ETA_Speech_RepeatLast();
+}
+
+static void CG_AccessibilityStopSpeech_f( void ) {
+	if( CG_AccessibilityForwardToUI( "accessibilityStopSpeechMenu" ) ) {
+		return;
+	}
+	ETA_Speech_Stop();
+}
+
+/* Checked by name ahead of the hashed table below, so no hash has to be
+   worked out and kept in step with the name. */
+static const struct {
+	const char	*cmd;
+	void		(*function)( void );
+} etaCommands[] = {
+	{ "accessibilityRepeat",		CG_AccessibilityRepeat_f },
+	{ "accessibilityStopSpeech",	CG_AccessibilityStopSpeech_f },
+};
+#endif
+
 // CG_Printf("My convertThis hash value: %lu\n", BG_StringHashValue( "convertThis" ));
 static consoleCommand_t	commands[] =
 {
@@ -1328,6 +1375,15 @@ qboolean CG_ConsoleCommand( void ) {
 
 	cmd = CG_Argv(0);
 
+#ifdef FEATURE_ACCESSIBILITY
+	for ( i = 0; i < (int)(sizeof(etaCommands) / sizeof(etaCommands[0])); i++ ) {
+		if ( !Q_stricmp( cmd, etaCommands[i].cmd ) ) {
+			etaCommands[i].function();
+			return qtrue;
+		}
+	}
+#endif
+
 	// core: create a hash-value for faster "string"-comparing..
 	cmdHash = BG_StringHashValue(cmd);
 
@@ -1357,6 +1413,12 @@ void CG_InitConsoleCommands( void ) {
 		trap_AddCommand( commands[i].cmd );
 	}
 
+#ifdef FEATURE_ACCESSIBILITY
+	for ( i = 0; i < (int)(sizeof(etaCommands) / sizeof(etaCommands[0])); i++ ) {
+		trap_AddCommand( etaCommands[i].cmd );
