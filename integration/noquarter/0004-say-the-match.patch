+	Q_CleanStr( out );
+}
+
+/* The game's message made for "You": "were", "yourself", "your own". */
+static void ETA_ObituaryForYou( char *text, int size ) {
+	static const char *const swaps[][2] = {
+		{ "You was ", "You were " }, { "himself", "yourself" }, { "his own", "your own" }, { " his ", " your " }
+	};
+	int i;
+
+	for( i = 0; i < (int)(sizeof(swaps) / sizeof(swaps[0])); i++ ) {
+		char *at = strstr( text, swaps[i][0] );
+
+		if( at ) {
+			char rest[256];
+
+			Q_strncpyz( rest, at + strlen( swaps[i][0] ), sizeof(rest) );
+			*at = '\0';
+			Q_strcat( text, size, swaps[i][1] );
+			Q_strcat( text, size, rest );
+		}
+	}
+}
+
+static void ETA_NarrateObituary( int target, int attacker, int mod, weapon_t weapon, int flags ) {
+	int			viewed = cg.snap ? cg.snap->ps.clientNum : cg.clientNum;
+	const char	*message = NULL, *message2 = NULL;
+	char		targetName[MAX_QPATH], attackerName[MAX_QPATH];
+	char		text[256];
+	qboolean	hasAttacker = (attacker >= 0 && attacker < MAX_CLIENTS) ? qtrue : qfalse;
+
+	if( target != viewed && attacker != viewed ) {
+		return;
+	}
+	if( mod < 0 || mod >= MOD_NUM_MODS || mod == MOD_SWITCHTEAM ) {
+		return;
+	}
+
+	ETA_ObituaryName( target, targetName, sizeof(targetName) );
+
+	if( hasAttacker && attacker == viewed && attacker != target ) {
+		ETA_ObituaryName( attacker, attackerName, sizeof(attackerName) );
+		if( mod == MOD_SWAP_PLACES ) {
+			Com_sprintf( text, sizeof(text), "%s swapped places with %s", attackerName, targetName );
+		} else {
+			Com_sprintf( text, sizeof(text), "%s killed %s%s", attackerName,
+						 cgs.clientinfo[attacker].team == cgs.clientinfo[target].team ? "teammate " : "", targetName );
+		}
+	}
+	else if( !hasAttacker || attacker == target ) {
+		message = hasAttacker ? obituaries_suicide[mod].message : obituaries_singleclient[mod].message;
+		if( message && weapon > WP_NONE && weapon < WP_NUM_WEAPONS && BG_Weapons[weapon].selfKillMessage[0] ) {
+			message = BG_Weapons[weapon].selfKillMessage;
+		}
+		Com_sprintf( text, sizeof(text), "%s %s", targetName, message ? CG_TranslateString( message ) : "died" );
+	}
+	else {
+		message = obituaries_kill[mod].message;
+		message2 = obituaries_kill[mod].message2;
+		if( weapon > WP_NONE && weapon < WP_NUM_WEAPONS && mod != MOD_THROWKNIFE
+			&& message && BG_Weapons[weapon].KillMessage[0] && BG_Weapons[weapon].KillMessage2[0] ) {
+			message = BG_Weapons[weapon].KillMessage;
+			message2 = BG_Weapons[weapon].KillMessage2;
+		}
+		if( flags & OBIT_EXECUTED ) {
+			message = "was executed by";
+			message2 = ".";
+		}
+		ETA_ObituaryName( attacker, attackerName, sizeof(attackerName) );
+		if( message ) {
+			Com_sprintf( text, sizeof(text), "%s %s %s%s", targetName, CG_TranslateString( message ), attackerName,
+						 message2 ? CG_TranslateString( message2 ) : "" );
+		} else {
+			Com_sprintf( text, sizeof(text), "%s was killed by %s", targetName, attackerName );
+		}
+	}
+
+	Q_CleanStr( text );
+
+	if( target == cg.clientNum ) {
+		ETA_ObituaryForYou( text, sizeof(text) );
+		CG_AccessibilityObituary( text, qtrue );
+		return;
+	}
+
+	CG_AccessibilityObituary( text, qfalse );
+}
+#endif
