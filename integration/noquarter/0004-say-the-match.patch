@@ -477,6 +477,83 @@ const char *UI_DownloadInfo( const char *downloadName ) {
     return "";
 }
 
+#ifdef FEATURE_ACCESSIBILITY
+#include "speech/speech_manager.h"
+
+/*
+ * [Accessibility]: the connection screen, said as it changes. Before the
+ * map loads the screen says who the game is connecting to and what it is
+ * waiting for, with a bar when a file is being downloaded; silent, that
+ * stretch sounds like the game has hung. Each new state is said once,
+ * not the packet counter beside it, a download at each quarter, and the
+ * server's own message, such as a refusal, when it changes.
+ */
+static void ETA_UiNarrateConnect( const uiClientState_t *cstate, const char *downloadName ) {
+	static int lastState = -1;
+	static char lastDownload[MAX_QPATH];
+	static char lastMessage[MAX_STRING_CHARS];
+	static int lastQuarter;
+	char text[MAX_STRING_CHARS];
+
+	if( cstate->connState != lastState ) {
+		lastState = cstate->connState;
+
+		switch( cstate->connState ) {
+			case CA_CONNECTING:
+				Q_strncpyz( text, va( "Connecting to %s", cstate->servername ), sizeof(text) );
+				Q_CleanStr( text );
+				ETA_Speech_Say( text );
+				break;
+			case CA_CHALLENGING:
+				ETA_Speech_Say( "Awaiting challenge" );
+				break;
+			case CA_CONNECTED:
+				if( !*downloadName ) {
+					ETA_Speech_Say( "Connected. Awaiting game state" );
+				}
+				break;
+			default:
+				/* Loading is the map's to say. */
+				break;
+		}
+	}
+
+	if( *downloadName ) {
+		int count = (int)trap_Cvar_VariableValue( "cl_downloadCount" );
+		int size = (int)trap_Cvar_VariableValue( "cl_downloadSize" );
+
+		if( Q_stricmp( downloadName, lastDownload ) ) {
+			Q_strncpyz( lastDownload, downloadName, sizeof(lastDownload) );
+			lastQuarter = 0;
+			ETA_Speech_Say( va( "Downloading %s", COM_SkipPath( (char *)downloadName ) ) );
+		}
+		else if( size > 0 ) {
+			int quarter = (4 * (count / 1024)) / ((size / 1024) > 0 ? (size / 1024) : 1);
+
+			if( quarter > 3 ) {
+				quarter = 3;
+			}
+			if( quarter > lastQuarter ) {
+				lastQuarter = quarter;
+				ETA_Speech_Say( va( "Downloading, %i percent", quarter * 25 ) );
+			}
+		}
+	}
+	else {
+		lastDownload[0] = '\0';
+	}
+
+	if( cstate->connState < CA_CONNECTED && Q_stricmp( cstate->messageString, lastMessage ) ) {
+		Q_strncpyz( lastMessage, cstate->messageString, sizeof(lastMessage) );
+		if( lastMessage[0] ) {
+			Q_strncpyz( text, lastMessage, sizeof(text) );
+			Q_CleanStr( text );
+			ETA_Speech_Say( text );
+		}
+	}
+}
+#endif
