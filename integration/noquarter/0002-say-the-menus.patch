+/*
+ * Says when the console opens or closes over the menus. A tester opened
+ * it by mistake and never knew. Only before a match: in one, the cgame's
+ * own speech covers it.
+ */
+static void UI_AccessibilityConsoleFrame( void ) {
+	static qboolean wasOpen;
+	uiClientState_t cstate;
+	qboolean open = ( trap_Key_GetCatcher() & KEYCATCH_CONSOLE ) ? qtrue : qfalse;
+
+	trap_GetClientState( &cstate );
+	if( cstate.connState == CA_ACTIVE ) {
+		wasOpen = open;
+		return;
+	}
+
+	if( open == wasOpen ) {
+		return;
+	}
+	wasOpen = open;
+
+	UI_AccessibilitySay( open ? "Console open. The same key closes it" : "Console closed" );
+}
+
+/*
+ * The keys the accessibility commands need, offered once if the player
+ * has not already spoken for them. A command is worth nothing until a
+ * key reaches it.
+ *
+ * Two rules keep this from being a key thief. A key already bound is
+ * left alone, so a player who uses F6 for something else keeps it. And
+ * eta_bindsInstalled, archived, records the newest generation offered,
+ * so a key deliberately unbound does not come back - while rows added
+ * by a later version, with a newer generation, still are offered.
+ *
+ * F6 and F8 are free in the stock default.cfg, which binds F1 to F4, F7
+ * and F11 and F12. The match's own keys join this table as the mod's
+ * match speech comes to No Quarter.
+ */
+void UI_AccessibilityInstallBinds( void ) {
+	static const struct {
+		int			key;
+		const char	*command;
+		int			generation;
+	} binds[] = {
+		{ K_F6, "accessibilityRepeat",     1 },
+		{ K_F8, "accessibilityStopSpeech", 1 },
+	};
+
+	vmCvar_t installed;
+	int i;
+	int newest = 0;
+
+	trap_Cvar_Register( &installed, "eta_bindsInstalled", "0", CVAR_ARCHIVE );
+
+	for( i = 0; i < (int)( sizeof( binds ) / sizeof( binds[0] ) ); i++ ) {
+		char current[MAX_STRING_CHARS];
+
+		if( binds[i].generation > newest ) {
+			newest = binds[i].generation;
+		}
+
+		if( binds[i].generation <= installed.integer ) {
+			continue;
+		}
+
+		current[0] = '\0';
+		trap_Key_GetBindingBuf( binds[i].key, current, sizeof( current ) );
+
+		if( current[0] == '\0' ) {
+			trap_Key_SetBinding( binds[i].key, binds[i].command );
+		}
+	}
+
+	if( newest > installed.integer ) {
+		trap_Cvar_Set( "eta_bindsInstalled", va( "%i", newest ) );
+	}
+
+	/* The controls pages keep their own copy of which key each command is
+	   on, read at start-up. Left stale, the first key changed there would
+	   write that copy back over what was just installed. */
+	Controls_GetConfig();
+}
+
+/*
+ * A server, as said when the server list is on it. On screen a row is
+ * five columns and a row of small icons - a padlock, crossed guns and
+ * the rest - and none of it was said. This is the row in words: name,
+ * map, game type, players, ping, and each icon it shows.
+ */
+static const char *UI_AccessibilityFeederRow( int feederID, int index ) {
+	static char row[512];
+	char info[MAX_STRING_CHARS];
+	char name[256];
+	const char *type = NULL;
+	const char *humans;
+	int ping, game, clients, maxclients, i;
+
+	if( feederID != FEEDER_SERVERS || index < 0 || index >= uiInfo.serverStatus.numDisplayServers ) {
+		return NULL;
+	}
+
+	trap_LAN_GetServerInfo( ui_netSource.integer, uiInfo.serverStatus.displayServers[index], info, sizeof( info ) );
+	ping = atoi( Info_ValueForKey( info, "ping" ) );
+	if( ping <= 0 ) {
+		Com_sprintf( row, sizeof( row ), "%s, not answering yet", Info_ValueForKey( info, "addr" ) );
+		return row;
+	}
+
+	Q_strncpyz( name, Info_ValueForKey( info, "hostname" ), sizeof( name ) );
+	Q_CleanStr( name );
+
+	game = atoi( Info_ValueForKey( info, "gametype" ) );
+	for( i = 0; i < uiInfo.numGameTypes; i++ ) {
+		if( uiInfo.gameTypes[i].gtEnum == game ) {
+			type = uiInfo.gameTypes[i].gameType;
+			break;
+		}
+	}
+
+	clients = atoi( Info_ValueForKey( info, "clients" ) );
+	maxclients = atoi( Info_ValueForKey( info, "sv_maxclients" ) );
+	humans = Info_ValueForKey( info, "humans" );
+
+	Com_sprintf( row, sizeof( row ), "%s, map %s, %s, ", name[0] ? name : Info_ValueForKey( info, "addr" ),
+				 Info_ValueForKey( info, "mapname" ), type ? type : "unknown game type" );
+
+	/* Only a server that says how many are human tells them from bots. */
+	if( humans[0] && clients > atoi( humans ) ) {
+		int h = atoi( humans );
+
+		Q_strcat( row, sizeof( row ), va( "%i %s and %i %s of %i, ", h, h == 1 ? "player" : "players",
+										  clients - h, clients - h == 1 ? "bot" : "bots", maxclients ) );
+	} else {
+		Q_strcat( row, sizeof( row ), va( "%i of %i players, ", clients, maxclients ) );
+	}
+	Q_strcat( row, sizeof( row ), va( "ping %i", ping ) );
+
+	/* The icons, in the order the screen draws them. */
+	if( atoi( Info_ValueForKey( info, "needpass" ) ) ) {
+		Q_strcat( row, sizeof( row ), ", password" );
+	}
+	if( atoi( Info_ValueForKey( info, "friendlyFire" ) ) & 1 ) {
+		Q_strcat( row, sizeof( row ), ", friendly fire" );
+	}
+	if( atoi( Info_ValueForKey( info, "maxlives" ) ) ) {
+		Q_strcat( row, sizeof( row ), ", max lives" );
+	}
+	if( atoi( Info_ValueForKey( info, "punkbuster" ) ) ) {
+		Q_strcat( row, sizeof( row ), ", PunkBuster" );
+	}
+	if( atoi( Info_ValueForKey( info, "weaprestrict" ) ) < 100 ) {
+		Q_strcat( row, sizeof( row ), ", weapon limits" );
+	}
+	if( atoi( Info_ValueForKey( info, "g_antilag" ) ) ) {
+		Q_strcat( row, sizeof( row ), ", anti-lag" );
+	}
+	if( atoi( Info_ValueForKey( info, "balancedteams" ) ) ) {
+		Q_strcat( row, sizeof( row ), ", balanced teams" );
+	}
+	if( !Q_stricmp( Info_ValueForKey( info, "game" ), "nq" ) ) {
+		Q_strcat( row, sizeof( row ), ", No Quarter" );
+	}
+	return row;
+}
+#endif
