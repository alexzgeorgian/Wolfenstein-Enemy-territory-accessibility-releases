+/*
+ * Can this key act on this item? The settings controls asked two things:
+ * does the item have focus, and is the mouse cursor inside it. From the
+ * keyboard the second can never be true - arrowing onto an item does not
+ * move the cursor - so Enter on a highlighted setting did nothing. A
+ * mouse button keeps the cursor test; every other key is the keyboard,
+ * whose place is wherever the focus is.
+ */
+static qboolean ETA_ItemTakesKey(itemDef_t *item, int key) {
+	if (!(item->window.flags & WINDOW_HASFOCUS)) {
+		return qfalse;
+	}
+
+	if (key == K_MOUSE1 || key == K_MOUSE2 || key == K_MOUSE3
+		|| key == K_MOUSE4 || key == K_MOUSE5) {
+		return Rect_ContainsPoint(&item->window.rect, DC->cursorx, DC->cursory);
+	}
+
+	return qtrue;
+}
