+/**
+ * @brief How loud one of the mod's looping sounds plays, on the scale the
+ * game hands a looping sound: 255 is full, the level they always had.
+ */
+int CG_AccessibilityLoopVolume(eta_loopSoundType_t which)
+{
+	const vmCvar_t *cvar;
+
+	switch (which)
+	{
+	case ETA_LOOP_DOOR:
+	case ETA_LOOP_DOOR_LOCKED:
+		cvar = &eta_doorVolume;
+		break;
+	case ETA_LOOP_CROSSHAIR_ENEMY:
+	case ETA_LOOP_CROSSHAIR_TEAMMATE:
+		cvar = &eta_crosshairVolume;
+		break;
+	case ETA_LOOP_BUILD_SITE:
+	case ETA_LOOP_DEMOLITION_TARGET:
+	case ETA_LOOP_FLAG:
+		cvar = &eta_siteVolume;
+		break;
+	case ETA_LOOP_LADDER:
+		cvar = &eta_ladderVolume;
+		break;
+	default:
+		cvar = &eta_markerVolume;
+		break;
+	}
+
+	return (255 * ETA_VolumePercent(cvar)) / 100;
+}
