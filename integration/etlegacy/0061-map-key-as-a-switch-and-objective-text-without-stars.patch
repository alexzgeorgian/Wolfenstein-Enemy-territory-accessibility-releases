 static void CG_AutomapExpandDown_f(void)
 {
+#ifdef FEATURE_ACCESSIBILITY
+	/* The map key as a switch rather than a button to hold. The survey
+	   walks the map with the other hand, and a tester asked not to have
+	   to keep one finger on the map key the whole time to do it: one
