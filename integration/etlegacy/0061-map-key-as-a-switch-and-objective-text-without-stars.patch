+/**
+ * @brief Map text as it should be heard.
+ *
+ * ET's objective and map descriptions break their lines with '*' - the
+ * panel draws each one on a line of its own - and a tester heard the
+ * stars read out as characters. Each break becomes the end of a
+ * sentence, runs of them and of spaces collapse to one, and nothing is
+ * left at either end.
+ */
+void CG_AccessibilitySpeakableText(const char *in, char *out, size_t outSize)
+{
+	size_t   used      = 0;
+	qboolean lineBreak = qfalse;
+
+	if (!outSize)
+	{
+		return;
+	}
+
+	while (in && *in && used + 3 < outSize)
+	{
+		char c = *in++;
+
+		if (c == '*' || c == '\n' || c == '\r')
+		{
+			lineBreak = qtrue;
+			continue;
+		}
+
+		if (c == ' ' && (used == 0 || lineBreak || out[used - 1] == ' '))
+		{
+			continue;
+		}
+
+		if (lineBreak)
+		{
+			while (used > 0 && out[used - 1] == ' ')
+			{
+				used--;
+			}
+
+			if (used > 0)
+			{
+				if (!strchr(".!?:;,", out[used - 1]))
+				{
+					out[used++] = '.';
+				}
+
+				out[used++] = ' ';
+			}
+
+			lineBreak = qfalse;
+		}
+
+		out[used++] = c;
+	}
+
+	while (used > 0 && out[used - 1] == ' ')
+	{
+		used--;
+	}
+
+	out[used] = '\0';
+}
+
 const char *CG_AccessibilityObjectiveDescription(team_t team, int number)
 {
-	const char *text;
+	/* Two, so a caller holding one while asking for another keeps it. */
+	static char spoken[2][MAX_STRING_CHARS];
+	static int  next;
+	const char  *text;
+	char        *out;
 
 	if (number < 1 || number > MAX_OBJECTIVES)
 	{
@@ -1701,7 +1770,17 @@ const char *CG_AccessibilityObjectiveDescription(team_t team, int number)
 	text = (team == TEAM_AXIS) ? cg.objDescription_Axis[number - 1]
 	                           : cg.objDescription_Allied[number - 1];
 
-	return (text && text[0]) ? text : NULL;
+	if (!text || !text[0])
+	{
+		return NULL;
+	}
+
+	out  = spoken[next];
+	next = (next + 1) % 2;
+
+	CG_AccessibilitySpeakableText(text, out, sizeof(spoken[0]));
+
+	return out[0] ? out : NULL;
 }
 
