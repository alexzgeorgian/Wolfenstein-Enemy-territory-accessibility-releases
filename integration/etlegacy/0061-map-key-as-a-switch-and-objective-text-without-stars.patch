+static void CG_AutomapExpandUp_f(void)
+{
+#ifdef FEATURE_ACCESSIBILITY
+	/* Letting go of the map key leaves the map up when it is a switch;
+	   the next press closes it. */
+	if (eta_mapToggle.integer)
+	{
+		return;
+	}
+#endif
+
+	CG_AutomapCollapse();
+}
