diff --git a/src/cgame/cg_playerstate.c b/src/cgame/cg_playerstate.c
index 81edc0e..75d2106 100644
--- a/src/cgame/cg_playerstate.c
+++ b/src/cgame/cg_playerstate.c
@@ -369,6 +369,68 @@ void CG_CheckLocalSounds(playerState_t *ps, playerState_t *ops)
 	}
 }
 
+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief Narrates the objective and objective-direction audio cues when the
+ * player's team's current main objective changes.
+ *
+ * CG_MainObjectiveForTeam (cg_consolecmds.c) resolves the same
+ * CS_MAIN_AXIS_OBJECTIVE / CS_MAIN_ALLIES_OBJECTIVE + cgs.oidInfo[] lookup
+ * the on-demand /accessibilityStatus command already uses, so "changed"
+ * here means exactly what that command would report differently: a new
+ * objective entity replacing the old one (destroyed/captured and
+ * reassigned), or the player joining/switching to a playing team and
+ * picking up that team's current objective for the first time. This is
+ * the "ambient event, not manual query" trigger the follow-up needed -
+ * unlike the on-demand status command, it only speaks on a real change,
+ * not on every call.
+ *
+ * The direction cue mirrors 0005's damage-direction cue: a world-space
+ * vector (here, objective origin minus the player's own predicted origin)
+ * run through the engine's own vec3_to_angles, then normalized relative to
+ * the player's current view yaw via AngleNormalize360, giving the same
+ * 0 = front / 90 = right / 180 = behind / 270 = left convention.
+ * @param[in] ps
+ */
+static void ETA_NarrateObjectiveChange(playerState_t *ps)
+{
+	static team_t lastTeam   = TEAM_SPECTATOR;
+	static int    lastEntNum = -1;
+	team_t        team       = (team_t)ps->persistant[PERS_TEAM];
+	oidInfo_t     *objective;
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		lastTeam   = team;
+		lastEntNum = -1;
+		return;
+	}
+
+	objective = CG_MainObjectiveForTeam(team);
+
+	if (!objective)
+	{
+		lastTeam   = team;
+		lastEntNum = -1;
+		return;
+	}
+
+	if (team != lastTeam || objective->entityNum != lastEntNum)
+	{
+		vec3_t delta, angles;
+
+		ETA_AudioCueSystem_PlayObjectiveCue();
+
+		VectorSubtract(objective->origin, ps->origin, delta);
+		vectoangles(delta, angles);
+		ETA_AudioCueSystem_PlayObjectiveDirectionCue((int)AngleNormalize360(ps->viewangles[YAW] - angles[YAW]));
+	}
+
+	lastTeam   = team;
+	lastEntNum = objective->entityNum;
+}
+#endif
+
 /**
