@@ -585,6 +647,10 @@ void CG_TransitionPlayerState(playerState_t *ps, playerState_t *ops)
 		cg.wasProne   = ops->eFlags & EF_PRONE;
 		VectorSubtract(ops->origin, ps->origin, cg.deltaProne);
 	}
+
+#ifdef FEATURE_ACCESSIBILITY
+	ETA_NarrateObjectiveChange(ps);
+#endif
 }
 
