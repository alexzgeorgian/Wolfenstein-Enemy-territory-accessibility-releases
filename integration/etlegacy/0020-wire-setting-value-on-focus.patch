+/* Defined further down this file and declared in no header, so the
+   accessibility block above its definition needs this. */
+const char *Item_Multi_Setting(itemDef_t *item);
+
+/**
+ * @brief Fields whose contents speech must not read out.
+ *
+ * Wider than the engine's own Item_IsPasswordField, and deliberately
+ * separate from it. That one drives the *drawing*, and is not behind the
+ * feature flag: widening it would mask a field on screen for every player
+ * running this mod, feature on or off, which is not this mod's call to
+ * make. Speech gets to be more careful than the screen without changing
+ * what the screen does.
+ *
+ * g_password is the server join password on the host-game screens. ET
+ * draws it in clear, but a password read aloud in a room is a different
+ * exposure from one shown on a monitor its owner is sitting at.
+ * @param[in] item
+ * @return
+ */
+static qboolean ETA_IsSecretField(itemDef_t *item)
+{
+	if (Item_IsPasswordField(item))
+	{
+		return qtrue;
+	}
+
+	if (item && item->cvar && !Q_stricmp(item->cvar, "g_password"))
+	{
+		return qtrue;
+	}
+
+	return qfalse;
+}
