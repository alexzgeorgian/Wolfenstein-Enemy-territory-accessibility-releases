 }
 
+/**
+ * @brief What one setting currently reads as.
+ *
+ * The single place each type's value is turned into words. Both the
+ * narration on arriving at a row and the narration on changing it call
+ * this, so the two cannot drift apart and start describing the same
+ * setting differently - which is the bug a second copy of these
+ * expressions would eventually produce.
+ * @param[in] item
+ * @return the value as spoken text, or NULL for a type that has none.
+ */
+const char *ETA_MenuItem_SettingText(itemDef_t *item)
+{
+	if (!item || !item->cvar)
+	{
+		return NULL;
+	}
+
+	switch (item->type)
+	{
+	case ITEM_TYPE_MULTI:
+	case ITEM_TYPE_TRICHECKBOX:
+		return Item_Multi_Setting(item);
+	case ITEM_TYPE_CHECKBOX:
+		return (DC->getCVarValue(item->cvar) != 0.f) ? "On" : "Off";
+	case ITEM_TYPE_YESNO:
+		return (DC->getCVarValue(item->cvar) != 0.f) ? "Yes" : "No";
+	case ITEM_TYPE_SLIDER:
+		return va("%.2f", DC->getCVarValue(item->cvar));
+	default:
+		return NULL;
+	}
+}
