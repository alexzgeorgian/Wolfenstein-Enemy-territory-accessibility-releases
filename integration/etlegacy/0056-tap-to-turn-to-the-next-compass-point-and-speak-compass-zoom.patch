index 7d65575..22bf61a 100644
--- a/src/cgame/cg_consolecmds.c
+++ b/src/cgame/cg_consolecmds.c
@@ -1532,6 +1532,357 @@ static void CG_AccessibilityMarkerClear_f(void)
