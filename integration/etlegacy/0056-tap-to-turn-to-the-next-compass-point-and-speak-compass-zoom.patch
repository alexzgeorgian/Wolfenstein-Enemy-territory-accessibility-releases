+#ifdef FEATURE_ACCESSIBILITY
+	/* The compass is a picture, and zooming it changes nothing a player
+	   who cannot see it can tell - not even whether the key did anything.
+	   So each step says where it now stands, as one of the thirteen steps
+	   the game allows, and how far the compass reaches in metres: the
+	   part of the map it shows is the map's width divided by the zoom,
