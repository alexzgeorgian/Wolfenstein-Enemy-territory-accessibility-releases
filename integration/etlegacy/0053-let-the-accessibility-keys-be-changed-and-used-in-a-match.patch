diff --git a/src/cgame/cg_consolecmds.c b/src/cgame/cg_consolecmds.c
index 9c63d56..9c98966 100644
--- a/src/cgame/cg_consolecmds.c
+++ b/src/cgame/cg_consolecmds.c
@@ -4595,10 +4595,22 @@ void CG_InitConsoleCommands(void)
 	CG_AddGameConsoleCommand();
 
 	// remove engine commands to avoid abuse
+#ifndef FEATURE_ACCESSIBILITY
 	trap_RemoveCommand("+lookup");
 	trap_RemoveCommand("-lookup");
 	trap_RemoveCommand("+lookdown");
 	trap_RemoveCommand("-lookdown");
+#else
+	/* Kept. They are the only way to tip the view without a mouse, and
+	   this was deleting them the moment a match loaded: the up and down
+	   arrows looked fine in the controls list and did nothing in play,
+	   and nothing brings them back short of restarting the game.
+
+	   What they are removed "to avoid abuse" of is not recorded here or
+	   upstream, and a key held down to tip the view at cl_pitchspeed is
+	   slower than any mouse. Turning with +left and +right, the same
+	   kind of command, was never removed. */
+#endif
 
 	// only allow configstrings command when cheats enabled
 	if (!cgs.sv_cheats)
diff --git a/src/ui/ui_main.c b/src/ui/ui_main.c
index 67a9da0..bad1bb9 100644
--- a/src/ui/ui_main.c
+++ b/src/ui/ui_main.c
@@ -1575,7 +1575,6 @@ void UI_LoadMenus(const char *menuFile, qboolean reset)
 	   by this point, and a player whose pk3 is half-installed is better
 	   off with a game that runs. */
 	UI_ParseMenu("ui/options_accessibility.menu");
-	UI_ParseMenu("ui/options_controls_accessibility.menu");
 #endif
 
 	Com_DPrintf("UI menu load time = %d milli seconds\n", trap_Milliseconds() - start);
@@ -8972,6 +8971,13 @@ void UI_AccessibilityInstallBinds(void)
 
 	/* Records the newest generation offered, not merely "yes". */
 	trap_Cvar_Set("eta_bindsInstalled", va("%i", newest));
+
+	/* The controls pages keep their own copy of which key each command
+	   is on, read once at start-up - before this ran. Left stale, the
+	   first key the player changes writes that copy back over the whole
+	   keyboard: the keypad goes back to selectbuddy and 9 and 0 to the
+	   weapon banks, undoing what was just installed. */
+	Controls_GetConfig();
 }
 #endif
 
