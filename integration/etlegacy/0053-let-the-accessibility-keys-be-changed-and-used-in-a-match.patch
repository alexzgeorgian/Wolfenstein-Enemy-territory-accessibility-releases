+	{ "accessibilitymapnorth",                     -1,              -1,  -1,              -1,  -1, -1, -1 },
+	{ "accessibilitymapsouth",                     -1,              -1,  -1,              -1,  -1, -1, -1 },
+	{ "accessibilitymapeast",                      -1,              -1,  -1,              -1,  -1, -1, -1 },
+	{ "accessibilitymapwest",                      -1,              -1,  -1,              -1,  -1, -1, -1 },
+	{ "accessibilitymapup",                        -1,              -1,  -1,              -1,  -1, -1, -1 },
+	{ "accessibilitymapdown",                      -1,              -1,  -1,              -1,  -1, -1, -1 },
