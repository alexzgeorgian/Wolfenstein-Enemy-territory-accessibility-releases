+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief CG_AccessibilityStatus_f
+ * On-demand "query basic match state" command for the accessibility HUD
+ * narrator (Milestone 4's exit condition). Bindable to a key; narrates
+ * health, the active weapon, and its ammo in one status report rather than
+ * announcing every stat change automatically, since health/ammo change too
+ * often during combat for that to be anything but noise.
+ */
+static void CG_AccessibilityStatus_f(void)
+{
+	playerState_t *ps = &cg.snap->ps;
+	weapon_t      weap;
+
+	ETA_HudNarrator_SpeakHealth(ps->stats[STAT_HEALTH]);
+
+	weap = (weapon_t)ps->weapon;
+
+	if (IS_VALID_WEAPON(weap))
+	{
+		int ammo, clips, akimboammo, maxammo;
+
+		ETA_HudNarrator_SpeakWeapon(GetWeaponTableData(weap)->desc);
+
+		CG_PlayerAmmoValue(&ammo, &clips, &akimboammo, &maxammo, NULL);
+
+		if (ammo >= 0)
+		{
+			ETA_HudNarrator_SpeakAmmo(ammo);
+		}
+	}
+}
+#endif
+
