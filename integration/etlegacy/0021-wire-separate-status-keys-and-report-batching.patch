+/**
+ * @brief The current weapon's loaded rounds, or -1 when it has none to
+ * report - a knife, or a weapon the engine gives no ammo value for.
+ * @param[out] ammo
+ * @return qtrue when ammo was written.
+ */
+static qboolean CG_AccessibilityAmmoValue(int *ammo)
+{
+	int clips, akimboammo, maxammo;
+
+	if (!cg.snap || !IS_VALID_WEAPON((weapon_t)cg.snap->ps.weapon))
+	{
+		return qfalse;
+	}
+
+	CG_PlayerAmmoValue(ammo, &clips, &akimboammo, &maxammo, NULL);
+
+	return (qboolean)(*ammo >= 0);
+}
+
+/**
+ * @brief Speaks the team's current main objective, how far off it is and
+ * which way to turn for it.
+ *
+ * Shared by the full status report and the objectives key, so the two
+ * cannot drift into describing the same objective differently. The caller
+ * opens the report; this only contributes parts to it.
+ *
+ * The route correction reuses the bearing ETA_NarrateObjectiveChange
+ * (cg_playerstate.c) already computes for the objective-direction cue, via
+ * AngleSubtract rather than AngleNormalize360 - the same helper
+ * cg_commandmap.c's CG_DrawCompassIcon uses to place a compass icon
+ * relative to view yaw - because a signed [-180, 180] "which way to turn"
+ * reads more naturally aloud than a 0-359 clock position. The +-15 degree
+ * "ahead" band is a judgment call, not a value found in this engine.
+ */
+static void CG_AccessibilityNarrateObjective(void)
+{
+	playerState_t *ps;
+	oidInfo_t     *objective;
+	vec3_t        delta, angles;
+	float         relativeYaw;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ps        = &cg.snap->ps;
+	objective = CG_MainObjectiveForTeam(cgs.clientinfo[cg.clientNum].team);
+
+	if (!objective)
+	{
+		return;
+	}
+
+	ETA_HudNarrator_SpeakObjective(objective->name);
+
+	ETA_NavigationSystem_AnnounceDistance((int)(Distance(ps->origin, objective->origin) * ETA_QU_TO_METERS));
+
+	VectorSubtract(objective->origin, ps->origin, delta);
+	vectoangles(delta, angles);
+	relativeYaw = AngleSubtract(angles[YAW], ps->viewangles[YAW]);
+
+	if (fabsf(relativeYaw) <= 15.0f)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Objective is ahead");
+	}
+	else if (relativeYaw > 0.0f)
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Turn left toward the objective");
+	}
+	else
+	{
+		ETA_NavigationSystem_AnnounceRouteCorrection("Turn right toward the objective");
+	}
+}
+
+/**
+ * @brief CG_AccessibilityHealth_f
+ * Health alone, for a key the player can reach without leaving the
+ * movement keys. The full status report answers the same question but
+ * takes several seconds to get there, which is no use in a firefight.
+ */
+static void CG_AccessibilityHealth_f(void)
+{
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ETA_HudNarrator_SpeakHealth(cg.snap->ps.stats[STAT_HEALTH]);
+}
+
+/**
+ * @brief CG_AccessibilityAmmo_f
+ * Loaded rounds alone. Paired with the health command above: between them
+ * they answer the two questions that decide whether to keep fighting.
+ */
+static void CG_AccessibilityAmmo_f(void)
+{
+	int ammo;
+
+	if (CG_AccessibilityAmmoValue(&ammo))
+	{
+		ETA_HudNarrator_SpeakAmmo(ammo);
+	}
+	else
+	{
+		ETA_Speech_Say("No ammo");
+	}
+}
