 	}
 
-	/* The player turning by hand takes over from any aim, and the lock
-	   leaves them to it for a moment. */
+	/* The player turning by hand takes over from any aim or climb, and
+	   the lock leaves them to it for a moment. */
+	if (eta_climb.active)
+	{
+		ETA_ClimbStop("Climb stopped");
+	}
 	if (eta_aim.mode != ETA_AIM_NONE)
 	{
 		ETA_AimStop();
@@ -2677,6 +2947,8 @@ void CG_AccessibilityTurnShutdown(void)
 	{
