+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief Names the mod supplies where the engine has none worth speaking.
+ *
+ * Deliberately tiny, and only ever a fallback. Fifteen of the fifty-five
+ * weapons have an empty `desc`, which is what the narration used to read
+ * and why grenades announced their ammo and no name at all. Almost all of
+ * them do have a usable `pickup_name` on their item - "Grenade",
+ * "Binoculars", "Landmine", "Smoke Bomb", "M1 Garand Scope" - so that is
+ * the first fallback and these two are the remainder, where the engine's
+ * own string is an internal token rather than a name:
+ *
+ *   WP_MEDKIT       pickup_name is "medicheal"
+ *   WP_SMOKE_MARKER pickup_name is "smokeGrenade"
+ *
+ * Both are things a player holds and switches to, so neither can be left
+ * reading out its token. Nothing else belongs in this table: a weapon the
+ * engine names is named by the engine.
+ */
+static const struct
+{
+	weapon_t   weapon;
+	const char *name;
+} eta_weaponNameFallbacks[] =
+{
+	{ WP_MEDKIT,       "Health pack"  },
+	{ WP_SMOKE_MARKER, "Smoke marker" }
+};
+
+/**
+ * @brief What to call a weapon out loud.
+ *
+ * In order: the weapon table's own description, the small table above
+ * where that is empty, then the item's pickup name, then a last-resort
+ * label. The order matters - the engine's own name always wins, so this
+ * can only ever fill a gap, never shadow or rename anything upstream.
+ *
+ * Never returns NULL or an empty string. Silence here is indistinguishable
+ * from the mod being broken, which is the failure this project keeps
+ * having to design out, and it is how this defect reached a release: the
+ * empty description was passed straight to the narrator, the input guard
+ * correctly refused it, and the player heard the ammo with no weapon.
+ *
+ * @param[in] weap
+ * @return a name safe to speak
+ */
+const char *CG_AccessibilityWeaponName(weapon_t weap)
+{
+	const char *name;
+	size_t     i;
+	int        item;
+
+	if (!IS_VALID_WEAPON(weap))
+	{
+		return "Weapon";
+	}
+
+	name = GetWeaponTableData(weap)->desc;
+
+	if (name && name[0])
+	{
+		return name;
+	}
+
+	for (i = 0; i < sizeof(eta_weaponNameFallbacks) / sizeof(eta_weaponNameFallbacks[0]); i++)
+	{
+		if (eta_weaponNameFallbacks[i].weapon == weap)
+		{
+			return eta_weaponNameFallbacks[i].name;
+		}
+	}
+
+	/* BG_GetItem does not range check, so this does. */
+	item = (int)GetWeaponTableData(weap)->item;
+
+	if (item > 0 && item < ITEM_MAX_ITEMS)
+	{
+		const gitem_t *gitem = BG_GetItem(item);
+
+		if (gitem && gitem->pickup_name && gitem->pickup_name[0])
+		{
+			return gitem->pickup_name;
+		}
+	}
+
+	return "Weapon";
+}
+#endif
