+/**
+ * @brief The map's voice at eta_announcerVolume, as a share of full:
+ * 0 to 99 - or -1 at 100, for the game's own way of playing it.
+ *
+ * Full is not one number. A voice the map streams plays as loud as an
+ * ordinary sound at 255, the top of the game's scale; one it plays as an
+ * ordinary sound is played at 127. Each caller scales its own.
+ */
+int CG_AccessibilityAnnouncerVolume(void)
+{
+	int percent = eta_announcerVolume.integer;
+
+	if (percent >= 100)
+	{
+		return -1;
+	}
+
+	return percent <= 0 ? 0 : percent;
+}
