-		lastEntNum = -1;
-		ETA_NavigationSystem_ResetApproach();
-		return;
-	}
-
-	if (objective.entityNum != lastEntNum)
-	{
-		lastEntNum = objective.entityNum;
-		ETA_NavigationSystem_ResetApproach();
-	}
-
-	/* With each distance called on the way in, whether it is up or down
-	   - the closer the player gets, the more it matters. */
-	if (ETA_NavigationSystem_UpdateApproach((int)(Distance(ps->origin, objective.origin) * ETA_QU_TO_METERS)))
-	{
-		ETA_NavigationSystem_AnnounceHeight((objective.origin[2] - ps->origin[2]) * ETA_QU_TO_METERS);
