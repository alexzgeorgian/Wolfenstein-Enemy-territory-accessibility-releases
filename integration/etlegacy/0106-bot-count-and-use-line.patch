+/**
+ * @brief The bot count changed during a match the player is hosting:
+ * sent to Omni-bot at once, and said.
+ *
+ * The tester asked to choose how many bots play. Before a match the
+ * Hosting page sets it for Start Server; during one, in a game they
+ * host, the same row adds or sends away bots there and then. Omni-bot
+ * only loads as a map starts, so in a game hosted without bots, they
+ * come with the next map. On somebody else's server it is not theirs to
+ * change, and waits for the next game they host.
+ */
+static void UI_AccessibilityBotsFrame(void)
+{
+	static int      said = -1;
+	uiClientState_t cstate;
+	int             bots;
+
+	trap_Cvar_Update(&eta_hostBotCount);
+	bots = (int)Com_Clamp(0, ETA_HOST_BOTS_MAX, eta_hostBotCount.integer);
+
+	trap_GetClientState(&cstate);
+	if (said < 0 || cstate.connState != CA_ACTIVE || trap_Cvar_VariableValue("sv_running") == 0.f)
+	{
+		said = bots;
+		return;
+	}
+
+	if (bots == said)
+	{
+		return;
+	}
+	said = bots;
+
+	if (trap_Cvar_VariableValue("omnibot_enable") == 0.f)
+	{
+		if (bots > 0)
+		{
+			trap_Cvar_Set("omnibot_enable", "1");
+			UI_AccessibilityUpdateSay(va("%i %s from the next map: this one started without bots", bots,
+			                             bots == 1 ? "bot joins" : "bots join"));
+		}
+		return;
+	}
+
+	trap_Cmd_ExecuteText(EXEC_APPEND, va("%s\n", UI_AccessibilityBotCommand(bots)));
+	UI_AccessibilityUpdateSay(bots ? va("%i %s now", bots, bots == 1 ? "bot" : "bots") : "No bots now");
 }
 
