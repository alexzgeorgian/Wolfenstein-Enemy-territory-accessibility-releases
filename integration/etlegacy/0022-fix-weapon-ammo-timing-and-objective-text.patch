+/**
+ * @brief Speaks the map's objective description for the player's team.
+ *
+ * This is the text the objectives panel itself draws (cg_info.c's
+ * CG_ObjectivesDraw reads the same three fields), parsed out of the map's
+ * configstrings in cg_main.c. It is what the player pressing the
+ * objectives key is actually asking for: what am I meant to be doing on
+ * this map.
+ *
+ * Deliberately separate from the main-objective lookup used by the status
+ * report. That one answers "which objective, how far, which way" and
+ * depends on a configstring plenty of maps never set - which is why the
+ * objectives key said nothing at all in testing. This reads the
+ * description, which maps do set, and says so plainly when they have not.
+ *
+ * '*' is the separator the map text uses for a line break; the panel turns
+ * each into a newline, and speech turns each into a pause.
+ */
+static void CG_AccessibilityNarrateObjectiveText(void)
+{
+	char       text[384];
+	const char *source;
+	team_t     team;
+	int        i;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	team = cgs.clientinfo[cg.snap->ps.clientNum].team;
+
+	if (team == TEAM_AXIS)
+	{
+		source = cg.objMapDescription_Axis;
+	}
+	else if (team == TEAM_ALLIES)
+	{
+		source = cg.objMapDescription_Allied;
+	}
+	else
+	{
+		source = cg.objMapDescription_Neutral;
+	}
+
+	Q_strncpyz(text, source, sizeof(text));
+
+	for (i = 0; text[i]; i++)
+	{
+		if (text[i] == '*')
+		{
+			text[i] = ',';
+		}
+	}
+
+	if (!text[0])
+	{
+		ETA_Speech_Say("This map has no objective description");
+		return;
+	}
+
+	ETA_HudNarrator_SpeakObjective(text);
+}
