+/**
+ * @brief Narrates the weapon in hand, and what is in it, when it changes.
+ *
+ * Driven off cg.predictedPlayerEntity.currentState.weapon rather than off
+ * the playerstate transition, and that is the whole point of where this
+ * lives. CG_PlayerAmmoValue reads the weapon out of that same entity
+ * state; asking it for ammo from CG_TransitionPlayerState, where the
+ * playerstate has changed but prediction has not yet caught up, answers
+ * for the weapon being put away or for no weapon at all. That is why the
+ * first version of this spoke the new weapon's name with no ammo after
+ * it - the name came from the playerstate and was right, the ammo came
+ * from the entity and was not there yet.
+ *
+ * Reading both from the same source removes the timing question rather
+ * than trying to get the timing right.
+ */
+static void ETA_NarrateWeaponChange(void)
+{
+	static weapon_t spoken = WP_NONE;
+	weapon_t        weap;
+	int             ammo, clips, akimboammo, maxammo;
+
+	if (!cg.snap || cg.snap->ps.pm_type == PM_INTERMISSION)
+	{
+		return;
+	}
+
+	weap = (weapon_t)cg.predictedPlayerEntity.currentState.weapon;
+
+	if (weap == spoken)
+	{
+		return;
+	}
+
+	spoken = weap;
+
+	if (!IS_VALID_WEAPON(weap))
+	{
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+
+	ETA_HudNarrator_SpeakWeapon(GetWeaponTableData(weap)->desc);
+
+	CG_PlayerAmmoValue(&ammo, &clips, &akimboammo, &maxammo, NULL);
+
+	if (ammo >= 0)
+	{
+		/* Loaded rounds and what is left to reload from, because "8" on its
+		   own does not say whether the next reload is coming. A weapon with
+		   no reserve to speak of - a grenade, a knife - reports neither. */
+		ETA_HudNarrator_SpeakAmmoDetail(ammo + (akimboammo > 0 ? akimboammo : 0), clips);
+	}
+
+	ETA_Speech_EndReport();
+}
