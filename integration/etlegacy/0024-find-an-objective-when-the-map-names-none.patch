+/**
+ * @struct etaObjective_t
+ * @brief Where the accessibility narration should be pointing the player.
+ *
+ * Deliberately not an oidInfo_t: the objective the mod reports is not
+ * always one the client has a complete cgs.oidInfo[] entry for, and where
+ * it does, that entry's origin is the trigger's, not the live position of
+ * the thing being defended. This carries only what the narration actually
+ * needs - a label, somewhere to measure to, and an identity stable enough
+ * to notice when the target changes.
+ */
+typedef struct
+{
+	const char *name;       ///< the map's short name for it, or NULL if it gave none
+	vec3_t     origin;      ///< world position, for distance and bearing
+	int        entityNum;   ///< identity, for spotting a change of target
+} etaObjective_t;
+
+qboolean CG_AccessibilityObjective(team_t team, const vec3_t from, etaObjective_t *out);
+qboolean CG_AccessibilityNearestObjective(team_t team, const vec3_t from, etaObjective_t *out);
