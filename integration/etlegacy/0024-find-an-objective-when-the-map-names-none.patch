+/**
+ * @brief The objective every piece of accessibility navigation points at.
+ *
+ * The map's designated main objective when it has one, and otherwise the
+ * nearest objective on the player's own command map
+ * (CG_AccessibilityNearestObjective, cg_commandmap.c).
+ *
+ * The fallback is the whole point. Everything this mod says about where to
+ * go - the distance, the turn direction, the objective audio cue, the
+ * report the stuck detector gives - used to be gated on the main-objective
+ * configstrings alone, and those are set only by a map script command that
+ * most maps never run. A player testing this on such a map heard no
+ * navigation assistance whatsoever and had no way to tell that from the
+ * feature being broken.
+ *
+ * The chosen target is sticky. Without that, two objectives at similar
+ * range would swap places as the player strafed between them, re-firing
+ * the objective cue and changing what "the objective" means mid-approach.
+ * The current target is kept while it is still on the command map unless
+ * another is a quarter closer - a margin, not a fixed distance, so it
+ * scales with how far apart a given map spreads its objectives.
+ *
+ * @param[in]  team
+ * @param[in]  from
+ * @param[out] out
+ * @return qtrue when there is somewhere to point the player
+ */
+qboolean CG_AccessibilityObjective(team_t team, const vec3_t from, etaObjective_t *out)
+{
+	static team_t stickyTeam    = TEAM_FREE;
+	static int    stickyEntNum  = -1;
+	oidInfo_t     *mainObjective;
+	etaObjective_t nearest;
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		stickyTeam   = TEAM_FREE;
+		stickyEntNum = -1;
+		return qfalse;
+	}
+
+	mainObjective = CG_MainObjectiveForTeam(team);
+
+	if (mainObjective)
+	{
+		out->name      = mainObjective->name[0] ? mainObjective->name : NULL;
+		out->entityNum = mainObjective->entityNum;
+		VectorCopy(mainObjective->origin, out->origin);
+
+		stickyTeam   = team;
+		stickyEntNum = mainObjective->entityNum;
+		return qtrue;
+	}
+
+	if (!CG_AccessibilityNearestObjective(team, from, &nearest))
+	{
+		stickyTeam   = TEAM_FREE;
+		stickyEntNum = -1;
+		return qfalse;
+	}
+
+	if (team == stickyTeam && stickyEntNum != nearest.entityNum)
+	{
+		etaObjective_t sticky;
+
+		if (CG_AccessibilityObjectiveByEntityNum(team, stickyEntNum, &sticky)
+		    && Distance(from, nearest.origin) >= 0.75f * Distance(from, sticky.origin))
+		{
+			nearest = sticky;
+		}
+	}
+
+	*out = nearest;
+
+	stickyTeam   = team;
+	stickyEntNum = nearest.entityNum;
+	return qtrue;
+}
