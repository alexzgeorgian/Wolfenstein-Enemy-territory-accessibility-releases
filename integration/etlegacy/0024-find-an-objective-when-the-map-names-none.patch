+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief Resolves where a command map objective entry actually is, and
+ * which cgs.oidInfo[] entry describes it.
+ *
+ * Exactly the resolution CG_DrawMapEntity above already does to place the
+ * icon it draws for the same entry, kept next to it so the two cannot
+ * drift: ME_CONSTRUCT / ME_DESTRUCT / ME_DESTRUCT_2 carry the entity
+ * number of the broadcast indicator entity in mEnt->data, whose
+ * lerpOrigin is the objective's world position and whose modelindex2 is
+ * its oidInfo index; ME_TANK / ME_TANK_DEAD are located through the
+ * ET_OID_TRIGGER in the current snapshot whose teamNum matches
+ * mEnt->data; ME_COMMANDMAP_MARKER has no entity of its own and is
+ * positioned straight from its oidInfo.
+ *
+ * mEnt->x / mEnt->y are deliberately not used: CG_ParseMapEntity above
+ * quantizes them to 128-unit steps, which is fine for a map icon and much
+ * too coarse for a spoken distance in meters.
+ *
+ * @param[in]  mEnt
+ * @param[out] origin
+ * @param[out] oidIndex
+ * @return qtrue when both a position and an oidInfo index were found
+ */
+static qboolean CG_AccessibilityMapObjectiveAt(const mapEntityData_t *mEnt, vec3_t origin, int *oidIndex)
+{
+	const centity_t *cent;
+	int             j;
+
+	// mEnt->data is server-supplied, so range-check it before indexing
+	if (mEnt->data < 0 || mEnt->data >= MAX_GENTITIES)
+	{
+		return qfalse;
+	}
+
+	switch (mEnt->type)
+	{
+	case ME_CONSTRUCT:
+	case ME_DESTRUCT:
+	case ME_DESTRUCT_2:
+		cent = &cg_entities[mEnt->data];
+
+		if (!cent->currentValid)
+		{
+			return qfalse;
+		}
+
+		*oidIndex = cent->currentState.modelindex2;
+		VectorCopy(cent->lerpOrigin, origin);
+		return qtrue;
+	case ME_TANK:
+	case ME_TANK_DEAD:
+		if (!cg.snap)
+		{
+			return qfalse;
+		}
+
+		for (j = 0; j < cg.snap->numEntities; j++)
+		{
+			if (cg.snap->entities[j].eType == ET_OID_TRIGGER && cg.snap->entities[j].teamNum == mEnt->data)
+			{
+				*oidIndex = mEnt->data;
+				VectorCopy(cg_entities[cg.snap->entities[j].number].lerpOrigin, origin);
+				return qtrue;
+			}
+		}
+		return qfalse;
+	case ME_COMMANDMAP_MARKER:
+		if (mEnt->data >= MAX_OID_TRIGGERS)
+		{
+			return qfalse;
+		}
+
+		*oidIndex = mEnt->data;
+		VectorCopy(cgs.oidInfo[mEnt->data].origin, origin);
+		return qtrue;
+	default:
+		return qfalse;
+	}
+}
+
+/**
+ * @brief Finds the objective on the command map nearest to from, for the
+ * accessibility narration to point the player at.
+ *
+ * This is the fallback for the many maps that never run the
+ * wm_set_main_objective script command and so leave
+ * CS_MAIN_AXIS_OBJECTIVE / CS_MAIN_ALLIES_OBJECTIVE empty - which, until
+ * now, silently took every distance, bearing and objective cue in the mod
+ * with it (see CG_AccessibilityObjective in cg_consolecmds.c).
+ *
+ * mapEntities[] is the right list to fall back to because the server
+ * pushes it to every playing client once a second whether or not the
+ * command map is open (G_SendMapEntityInfo, called from ClientThink_real),
+ * it already contains only that client's own team's entries, and entries
+ * drop out as objectives are completed. So "nearest objective" here means
+ * the nearest of exactly the icons the player's own command map is
+ * drawing - not a guess this mod invented.
+ *
+ * Entries whose oidInfo marks them a health/ammo cabinet are skipped, and
+ * ones it marks a real objective (spawnflag bit 4, the same IS_OBJECTIVE
+ * test cg_draw_hud.c uses to pick out primary objectives) win over ones it
+ * does not, before distance is considered at all. Distance only breaks
+ * ties within a tier, so a far objective still beats a near construction
+ * site.
+ *
+ * @param[in]  team
+ * @param[in]  from
+ * @param[out] out
+ * @return qtrue when this team has an objective the client can place
+ */
+qboolean CG_AccessibilityNearestObjective(team_t team, const vec3_t from, etaObjective_t *out)
+{
+	int      i;
+	int      bestTier     = 0;
+	float    bestDistance = 0;
+	qboolean found        = qfalse;
+
+	for (i = 0; i < mapEntityCount; i++)
+	{
+		const mapEntityData_t *mEnt = &mapEntities[i];
+		vec3_t                origin;
+		int                   oidIndex = -1;
+		int                   tier;
+		float                 distance;
+
+		if (mEnt->team != team)
+		{
+			continue;
+		}
+
+		if (!CG_AccessibilityMapObjectiveAt(mEnt, origin, &oidIndex))
+		{
+			continue;
+		}
+
+		if (oidIndex < 0 || oidIndex >= MAX_OID_TRIGGERS)
+		{
+			continue;
+		}
+
+		// a cabinet is somewhere to go, but never the objective
+		if (cgs.oidInfo[oidIndex].spawnflags & (1 << 5))
+		{
+			continue;
+		}
+
+		tier     = (cgs.oidInfo[oidIndex].spawnflags & (1 << 4)) ? 1 : 0;
+		distance = Distance(from, origin);
+
+		if (found && (tier < bestTier || (tier == bestTier && distance >= bestDistance)))
+		{
+			continue;
+		}
+
+		bestTier     = tier;
+		bestDistance = distance;
+		found        = qtrue;
+
+		out->name      = cgs.oidInfo[oidIndex].name[0] ? cgs.oidInfo[oidIndex].name : NULL;
+		out->entityNum = cgs.oidInfo[oidIndex].entityNum;
+		VectorCopy(origin, out->origin);
+	}
+
+	return found;
+}
+
+/**
+ * @brief Re-finds a previously chosen objective, to see whether it is
+ * still on the command map and where it has got to.
+ *
+ * CG_AccessibilityObjective (cg_consolecmds.c) keeps pointing at the
+ * target it already chose rather than swapping to whatever is marginally
+ * nearer this frame, so once a frame it has to ask that question about an
+ * objective it is no longer searching for. Same list, same filters and
+ * same position resolution as above, matched on identity instead of
+ * distance.
+ *
+ * @param[in]  team
+ * @param[in]  entityNum
+ * @param[out] out
+ * @return qtrue when that objective is still on this team's command map
+ */
+qboolean CG_AccessibilityObjectiveByEntityNum(team_t team, int entityNum, etaObjective_t *out)
+{
+	int i;
+
+	for (i = 0; i < mapEntityCount; i++)
+	{
+		const mapEntityData_t *mEnt = &mapEntities[i];
+		vec3_t                origin;
+		int                   oidIndex = -1;
+
+		if (mEnt->team != team)
+		{
+			continue;
+		}
+
+		if (!CG_AccessibilityMapObjectiveAt(mEnt, origin, &oidIndex))
+		{
+			continue;
+		}
+
+		if (oidIndex < 0 || oidIndex >= MAX_OID_TRIGGERS)
+		{
+			continue;
+		}
+
+		if (cgs.oidInfo[oidIndex].entityNum != entityNum)
+		{
+			continue;
+		}
+
+		out->name      = cgs.oidInfo[oidIndex].name[0] ? cgs.oidInfo[oidIndex].name : NULL;
+		out->entityNum = cgs.oidInfo[oidIndex].entityNum;
+		VectorCopy(origin, out->origin);
+		return qtrue;
+	}
+
+	return qfalse;
+}
+#endif
