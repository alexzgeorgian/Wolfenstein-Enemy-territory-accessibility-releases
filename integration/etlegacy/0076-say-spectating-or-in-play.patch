+/**
+ * @brief Whether the player is in the match or watching it, from the
+ *        game's own flags.
+ *
+ * Watching someone - as a spectator, or from limbo between lives - the
+ * snapshot's player state is the watched player's, with PMF_FOLLOW set
+ * on it by the server (SpectatorClientEndFrame), and PMF_LIMBO too when
+ * it is limbo. So the player's own team comes from their client info,
+ * never from the state being watched, and a watched player's health is
+ * never taken for the player's own.
+ */
+static ETA_PlayState ETA_PlayStateNow(char *following, size_t followingSize)
+{
+	const playerState_t *ps   = &cg.snap->ps;
+	team_t              team  = cgs.clientinfo[cg.clientNum].team;
+	qboolean            watch = (qboolean)((ps->pm_flags & PMF_FOLLOW) && ps->clientNum != cg.clientNum
+	                                       && ps->clientNum >= 0 && ps->clientNum < MAX_CLIENTS);
+
+	following[0] = '\0';
+
+	if (watch)
+	{
+		Q_strncpyz(following, cgs.clientinfo[ps->clientNum].name, (int)followingSize);
+		Q_CleanStr(following);
+	}
+
+	if (ps->pm_type == PM_INTERMISSION)
+	{
+		return ETA_PLAY_MATCH_OVER;
+	}
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		return ETA_PLAY_SPECTATING;
+	}
+
+	if ((ps->pm_flags & PMF_LIMBO) || watch)
+	{
+		return ETA_PLAY_LIMBO;
+	}
+
+	if (ps->stats[STAT_HEALTH] <= 0 || ps->pm_type == PM_DEAD)
+	{
+		return ETA_PLAY_DOWN;
+	}
+
+	return ETA_PLAY_IN_PLAY;
+}
+
+static void ETA_SpeakPlayState(ETA_PlayState state, const char *following)
+{
+	team_t      team = cgs.clientinfo[cg.clientNum].team;
+	const char *side = team == TEAM_AXIS ? "Axis" : team == TEAM_ALLIES ? "Allies" : "";
+
+	ETA_HudNarrator_SpeakPlayState(state, side,
+	                               state == ETA_PLAY_IN_PLAY ? BG_ClassnameForNumber(cgs.clientinfo[cg.clientNum].cls) : "",
+	                               following);
+}
+
+/**
+ * @brief The status key's opening words: in the match or watching it.
+ */
+void CG_AccessibilitySpeakPlayState(void)
+{
+	char following[MAX_NAME_LENGTH];
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ETA_SpeakPlayState(ETA_PlayStateNow(following, sizeof(following)), following);
+}
+
+/**
+ * @brief Says it when the player goes from watching to playing, or back.
+ *
+ * A change has to hold for a moment before it is said: joining a team
+ * passes through a frame or two of states that are not where the player
+ * ends up, and a spectator cycling through players should hear the one
+ * they stop on rather than every one they skipped. It is an event, said
+ * once, so it is not held back by the quiet after a question.
+ */
+#define ETA_PLAY_STATE_SETTLE_MS 400
+
+static void ETA_NarratePlayState(void)
+{
+	static ETA_PlayState said    = ETA_PLAY_UNKNOWN;
+	static char          saidFollowing[MAX_NAME_LENGTH];
+	static ETA_PlayState pending = ETA_PLAY_UNKNOWN;
+	static char          pendingFollowing[MAX_NAME_LENGTH];
+	static int           pendingSince;
+	char                 following[MAX_NAME_LENGTH];
+	ETA_PlayState        now;
+
+	if (!cg.snap)
+	{
+		said = ETA_PLAY_UNKNOWN;
+		return;
+	}
+
+	now = ETA_PlayStateNow(following, sizeof(following));
+
+	if (now == said && !strcmp(following, saidFollowing))
+	{
+		pending = ETA_PLAY_UNKNOWN;
+		return;
+	}
+
+	if (now != pending || strcmp(following, pendingFollowing))
+	{
+		pending      = now;
+		pendingSince = cg.time;
+		Q_strncpyz(pendingFollowing, following, sizeof(pendingFollowing));
+		return;
+	}
+
+	if (cg.time - pendingSince < ETA_PLAY_STATE_SETTLE_MS && cg.time >= pendingSince)
+	{
+		return;
+	}
+
+	said = now;
+	Q_strncpyz(saidFollowing, following, sizeof(saidFollowing));
+	pending = ETA_PLAY_UNKNOWN;
+
+	ETA_Speech_BeginReport();
+	ETA_SpeakPlayState(now, following);
+	ETA_Speech_EndReport();
+}
