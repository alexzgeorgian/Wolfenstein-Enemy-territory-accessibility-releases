+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief The command map survey, on the arrow keys and the navigation
+ * cluster above them.
+ *
+ * Every one of these does nothing unless the command map is actually
+ * up, which is what lets the arrow keys carry a second job without
+ * taking anything away from the game: while the map key is not held
+ * they fall through to whatever the player has bound there, and in a
+ * stock install that is nothing at all.
+ */
+static void CG_AccessibilityMapNorth_f(void)
+{
+	CG_AccessibilityMapStep(ETA_MAP_STEP_NORTH);
+}
+
+static void CG_AccessibilityMapSouth_f(void)
+{
+	CG_AccessibilityMapStep(ETA_MAP_STEP_SOUTH);
+}
+
+static void CG_AccessibilityMapEast_f(void)
+{
+	CG_AccessibilityMapStep(ETA_MAP_STEP_EAST);
+}
+
+static void CG_AccessibilityMapWest_f(void)
+{
+	CG_AccessibilityMapStep(ETA_MAP_STEP_WEST);
+}
+
+static void CG_AccessibilityMapUp_f(void)
+{
+	CG_AccessibilityMapLayer(1);
+}
+
+static void CG_AccessibilityMapDown_f(void)
+{
+	CG_AccessibilityMapLayer(-1);
+}
+
