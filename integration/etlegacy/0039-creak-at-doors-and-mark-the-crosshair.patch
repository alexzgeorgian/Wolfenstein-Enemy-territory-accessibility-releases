+/**
+ * @brief The four sounds this mod brings with it, and why they are not
+ *        the game's own.
+ *
+ * Every other cue here is a sound ET already ships, chosen by a cvar, so
+ * a player can read the path and know what they are hearing. These four
+ * cannot work that way. They loop continuously, and ET's sound set is
+ * combat and world effects - one-shot transients with hard onsets, which
+ * buzz when looped tightly and grate when looped slowly. Nothing in the
+ * game fits, so these are generated (release/make-cue-sounds.py) and
+ * shipped inside the pk3.
+ *
+ * Still cvars, and still re-registered when one changes, so a player who
+ * prefers one of the game's own sounds can say so.
+ */
+static eta_cueSound_t eta_loopSounds[] =
+{
+	{ "eta_cueDoor",              "sound/accessibility/door_creak.wav",         { 0 }, 0, { 0 } },
+	{ "eta_cueDoorLocked",        "sound/accessibility/door_creak_locked.wav",  { 0 }, 0, { 0 } },
+	{ "eta_cueCrosshairEnemy",    "sound/accessibility/crosshair_enemy.wav",    { 0 }, 0, { 0 } },
+	{ "eta_cueCrosshairTeammate", "sound/accessibility/crosshair_teammate.wav", { 0 }, 0, { 0 } }
+};
 
