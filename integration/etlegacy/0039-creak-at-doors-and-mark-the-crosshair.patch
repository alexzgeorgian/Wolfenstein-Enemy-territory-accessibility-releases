+/**
+ * @brief The handle for one of the mod's own looping sounds.
+ *
+ * Zero when the sound could not be registered - a player who pointed a
+ * cue cvar at a file that is not there gets silence, which is the same
+ * thing the engine does and the reason cue_sounds_test.py exists.
+ */
+sfxHandle_t CG_AccessibilityLoopSound(eta_loopSoundType_t which)
+{
+	if ((int)which < 0 || (int)which >= (int)(sizeof(eta_loopSounds) / sizeof(eta_loopSounds[0])))
+	{
+		return 0;
+	}
+
+	return ETA_CueSound(&eta_loopSounds[which]);
+}
