+static void ETA_LimboPanel_TakePick(void)
+{
+	const eta_limboStop_t *stop = &eta_limboStops[eta_limboIndex];
+	panel_button_t        *button = NULL;
+
+	if (stop->kind == ETA_LIMBO_TEAM)
+	{
+		button = eta_limboTeams[eta_limboPick];
+	}
+	else if (stop->kind == ETA_LIMBO_CLASS)
+	{
+		button = eta_limboClasses[eta_limboPick];
+	}
+	else if (stop->kind == ETA_LIMBO_WEAPON)
+	{
+		weapon_t options[MAX_WEAPS_PER_CLASS];
+		int      count = ETA_LimboPanel_WeaponOptions(stop->slot, options, MAX_WEAPS_PER_CLASS);
+
+		if (eta_limboPick >= 0 && eta_limboPick < count)
+		{
+			CG_LimboPanel_SetSelectedWeaponNum(stop->slot, options[eta_limboPick]);
+			SOUND_SELECT;
+		}
+		return;
+	}
+	if (button && button->onKeyDown)
+	{
+		/* The cursor is already on the control, so its own handler sees
+		   exactly what it would see under a real click. */
+		ETA_LimboPanel_CursorTo(button);
+		button->onKeyDown(button, K_MOUSE1);
