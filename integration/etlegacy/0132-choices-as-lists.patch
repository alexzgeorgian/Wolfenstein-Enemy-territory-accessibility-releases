+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * A choice opened as a list. Enter on a setting with several choices
+ * stepped it on to the next one, and the tester asked for a list instead:
+ * Enter opens it, Up and Down go through the choices, Enter picks one and
+ * Escape leaves it as it was. Stepping also lost a setting that was none
+ * of the choices: Auto-Configure Server reads "Custom" until one is
+ * picked, and after that Custom was never offered again. It stays in the
+ * list, as the first choice, keeping what the setting held.
+ *
+ * The mouse is left as it was: a click steps the setting on.
+ */
+#define ETA_DROP_KEPT 16
+
+static itemDef_t *eta_dropItem;
+static int       eta_dropAt;
+static int       eta_dropOpenedAt;
+
+/* What a setting held that none of its choices is, by item, kept for the
+   session so "Custom" can be picked again. */
+static struct
+{
+	itemDef_t *item;
+	char      value[256];
+} eta_dropKept[ETA_DROP_KEPT];
+
+static int ETA_DropListed(itemDef_t *item)
+{
+	multiDef_t *multiPtr = (multiDef_t *)item->typeData;
+	char       buff[256];
+	float      value = 0.f;
+	int        i;
+
+	if (multiPtr->strDef)
+	{
+		DC->getCVarString(item->cvar, buff, sizeof(buff));
+	}
+	else
+	{
+		value = DC->getCVarValue(item->cvar);
+	}
+	for (i = 0; i < multiPtr->count; i++)
+	{
+		if (multiPtr->strDef ? !Q_stricmp(buff, multiPtr->cvarStr[i]) : multiPtr->cvarValue[i] == value)
+		{
+			return i;
+		}
+	}
+	return -1;
+}
+
+/* The kept value for the item, NULL with none; with remember, the
+   setting's present value is kept when it is none of the choices. */
+static const char *ETA_DropKept(itemDef_t *item, qboolean remember)
+{
+	int i, free = -1;
+
+	for (i = 0; i < ETA_DROP_KEPT; i++)
+	{
+		if (eta_dropKept[i].item == item)
+		{
+			break;
+		}
+		if (!eta_dropKept[i].item && free < 0)
+		{
+			free = i;
+		}
+	}
+	if (i == ETA_DROP_KEPT && remember && free >= 0 && ETA_DropListed(item) < 0)
+	{
+		i                    = free;
+		eta_dropKept[i].item = item;
+		DC->getCVarString(item->cvar, eta_dropKept[i].value, sizeof(eta_dropKept[i].value));
+	}
+	return i < ETA_DROP_KEPT ? eta_dropKept[i].value : NULL;
+}
+
+/* Choices in the list: Custom first when kept, then the setting's own. */
+static int ETA_DropCount(itemDef_t *item)
+{
+	return ((multiDef_t *)item->typeData)->count + (ETA_DropKept(item, qfalse) ? 1 : 0);
+}
+
+static const char *ETA_DropName(itemDef_t *item, int at)
+{
+	multiDef_t *multiPtr = (multiDef_t *)item->typeData;
+
+	if (ETA_DropKept(item, qfalse))
+	{
+		if (at == 0)
+		{
+			return DC->translateString(_("Custom"));
+		}
+		at--;
+	}
+	return (at >= 0 && at < multiPtr->count) ? multiPtr->cvarList[at] : "";
+}
+
+/* The setting's name without the colon the screen shows after it. */
+static const char *ETA_DropLabel(itemDef_t *item)
+{
+	static char label[ETA_MAX_MENU_TEXT_LENGTH];
+	size_t      length;
+
+	Q_strncpyz(label, ETA_MenuItem_SpokenLabel(item) ? ETA_MenuItem_SpokenLabel(item) : "Setting", sizeof(label));
+	length = strlen(label);
+	while (length > 0 && ( label[length - 1] == ':' || label[length - 1] == ' ' ))
+	{
+		label[--length] = '\0';
+	}
+	return label;
+}
+
+static void ETA_DropSay(itemDef_t *item, const char *before)
+{
+	menuDef_t *parent = (menuDef_t *)item->parent;
+	char      text[ETA_MAX_MENU_TEXT_LENGTH];
+
+	Com_sprintf(text, sizeof(text), "%s%s, %i of %i", before ? before : "", ETA_DropName(item, eta_dropAt),
+	            eta_dropAt + 1, ETA_DropCount(item));
+	ETA_MenuNarrator_OnFocusChanged(parent ? parent->window.name : NULL, text);
+}
+
+/* Where the setting is now, in the list's count. */
+static int ETA_DropCurrent(itemDef_t *item)
+{
+	int listed = ETA_DropListed(item);
+
+	if (ETA_DropKept(item, qfalse))
+	{
+		return listed + 1;   /* -1, none of the choices, is Custom: 0 */
+	}
+	return listed < 0 ? 0 : listed;
+}
+
+/**
+ * @brief A key while a setting is focused, for its list: 0 not taken, 1
+ * taken, 2 taken and a choice made, for the item's action to run.
+ */
+int ETA_MenuItem_DropdownKey(itemDef_t *item, int key, qboolean down)
+{
+	multiDef_t *multiPtr;
+	int        count, step = 0;
+
+	if (eta_dropItem && eta_dropItem != item)
+	{
+		eta_dropItem = NULL;   /* focus went elsewhere: the list is shut */
+	}
+	if (!item || item->type != ITEM_TYPE_MULTI || !item->cvar || !item->typeData
+	    || !(item->window.flags & WINDOW_HASFOCUS) || !((multiDef_t *)item->typeData)->count)
+	{
+		return 0;
+	}
+	multiPtr = (multiDef_t *)item->typeData;
+
+	if (!eta_dropItem)
+	{
+		if (!down || (key != K_ENTER && key != K_KP_ENTER))
+		{
+			return 0;
+		}
+		ETA_DropKept(item, qtrue);
+		eta_dropItem     = item;
+		eta_dropAt       = ETA_DropCurrent(item);
+		eta_dropOpenedAt = eta_dropAt;
+		{
+			char before[ETA_MAX_MENU_TEXT_LENGTH];
+
+			Com_sprintf(before, sizeof(before), "%s list, %i choices. Up and Down go through them, Enter picks, Escape leaves it. ",
+			            ETA_DropLabel(item), ETA_DropCount(item));
+			ETA_DropSay(item, before);
+		}
+		return 1;
+	}
+
+	if (!down)
+	{
+		return 1;
+	}
+	count = ETA_DropCount(item);
+	switch (key)
+	{
+	case K_UPARROW: case K_KP_UPARROW: case K_PAD0_DPAD_UP: case K_LEFTARROW: case K_KP_LEFTARROW: step = -1; break;
+	case K_DOWNARROW: case K_KP_DOWNARROW: case K_PAD0_DPAD_DOWN: case K_RIGHTARROW: case K_KP_RIGHTARROW: step = 1; break;
+	case K_HOME: case K_KP_HOME: case K_PGUP: case K_KP_PGUP: step = -count; break;
+	case K_END: case K_KP_END: case K_PGDN: case K_KP_PGDN: step = count; break;
+	case K_ESCAPE: case K_PAD0_BACK: case K_BACKSPACE: case K_TAB:
+		eta_dropItem = NULL;
+	{
+		char text[ETA_MAX_MENU_TEXT_LENGTH];
+
+		Com_sprintf(text, sizeof(text), "List closed. %s, %s", ETA_DropLabel(item), Item_Multi_Setting(item));
+		ETA_MenuNarrator_OnFocusChanged(((menuDef_t *)item->parent) ? ((menuDef_t *)item->parent)->window.name : NULL, text);
+	}
+		return 1;
+	case K_ENTER: case K_KP_ENTER:
+	{
+		const char *kept = ETA_DropKept(item, qfalse);
+		int        at    = eta_dropAt - (kept ? 1 : 0);
+
+		eta_dropItem = NULL;
+		if (eta_dropAt == eta_dropOpenedAt)
+		{
+			ETA_MenuNarrator_OnValueChanged(ETA_MenuItem_SpokenLabel(item), va("%s, kept", Item_Multi_Setting(item)));
+			return 1;
+		}
+		if (at < 0)
+		{
+			DC->setCVar(item->cvar, kept);
+		}
+		else if (multiPtr->strDef)
+		{
+			DC->setCVar(item->cvar, multiPtr->cvarStr[at]);
+		}
+		else if ((float)(int)multiPtr->cvarValue[at] == multiPtr->cvarValue[at])
+		{
+			DC->setCVar(item->cvar, va("%i", (int)multiPtr->cvarValue[at]));
+		}
+		else
+		{
+			DC->setCVar(item->cvar, va("%f", multiPtr->cvarValue[at]));
+		}
+		ETA_MenuNarrator_OnValueChanged(ETA_MenuItem_SpokenLabel(item), va("%s, picked", ETA_DropName(item, eta_dropAt)));
+		return 2;
+	}
+	default:
+		return 1;   /* nothing else while the list is open */
+	}
+	eta_dropAt += step;
+	eta_dropAt  = eta_dropAt < 0 ? 0 : (eta_dropAt >= count ? count - 1 : eta_dropAt);
+	ETA_DropSay(item, NULL);
+	return 1;
+}
+
+/* Said with a setting's name when it is focused: Enter opens its list. */
+qboolean ETA_MenuItem_IsDropdown(itemDef_t *item)
+{
+	return (qboolean)(item && item->type == ITEM_TYPE_MULTI && item->cvar && item->typeData
+	                  && ((multiDef_t *)item->typeData)->count > 1);
+}
+#endif
