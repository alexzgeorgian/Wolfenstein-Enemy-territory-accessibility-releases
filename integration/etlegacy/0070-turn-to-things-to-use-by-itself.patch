+/**
+ * @brief Things to use, by themselves: standing still beside one with
+ * nothing under the crosshair turns the view onto it.
+ */
+static void ETA_AutoUse(void)
+{
+	const playerState_t *ps = &cg.predictedPlayerState;
+	etaAimTarget_t      list[ETA_AIM_MAX_TARGETS];
+	vec3_t              flat;
+	qboolean            hint;
+	int                 count, i, j;
+
+	VectorSet(flat, ps->velocity[0], ps->velocity[1], 0.0f);
+
+	if (VectorLength(flat) > ETA_USE_STILL_SPEED)
+	{
+		eta_use.stillSince = 0;
+	}
+	else if (!eta_use.stillSince || cg.time < eta_use.stillSince)
+	{
+		eta_use.stillSince = cg.time;
+	}
+
+	/* Walked away from something already turned to: it is news again. */
+	for (i = 0; i < eta_use.doneCount; )
+	{
+		if (Distance(ps->origin, eta_use.doneAt[i]) > (ETA_USE_REACH_METERS + 1.5f) / ETA_QU_TO_METERS)
+		{
+			eta_use.done[i] = eta_use.done[eta_use.doneCount - 1];
+			VectorCopy(eta_use.doneAt[eta_use.doneCount - 1], eta_use.doneAt[i]);
+			eta_use.doneCount--;
+			continue;
+		}
+		i++;
+	}
+
+	if (!eta_autoUse.integer || !eta_use.stillSince || cg.time - eta_use.stillSince < ETA_USE_STILL_MS
+	    || cgs.autoMapExpanded || eta_turn.step || eta_turn.held || CG_AccessibilityBuildBusy())
+	{
+		return;
+	}
+
+	/* A turn by hand is the player looking somewhere on purpose. */
+	if (cg.time < eta_aim.manualUntil && eta_aim.manualUntil - cg.time <= ETA_AIM_MANUAL_MS)
+	{
+		return;
+	}
+
+	hint = (qboolean)(cg.cursorHintIcon != HINT_NONE && cg.cursorHintTime != 0 && cg.cursorHintFade > 0
+	                  && cg.time - cg.cursorHintTime < cg.cursorHintFade);
+	if (hint)
+	{
+		return;
+	}
+
+	count = CG_AccessibilityUseTargets(list, ETA_AIM_MAX_TARGETS);
+
+	for (i = 0; i < count && list[i].meters <= ETA_USE_REACH_METERS; i++)
+	{
+		for (j = 0; j < eta_use.doneCount; j++)
+		{
+			if (eta_use.done[j] == list[i].entityNum)
+			{
+				break;
+			}
+		}
+
+		if (j < eta_use.doneCount)
+		{
+			continue;
+		}
+
+		if (eta_use.doneCount < ETA_USE_DONE_MAX)
+		{
+			eta_use.done[eta_use.doneCount] = list[i].entityNum;
+			VectorCopy(ps->origin, eta_use.doneAt[eta_use.doneCount]);
+			eta_use.doneCount++;
+		}
+
+		ETA_AimStartSnap(&list[i], NULL);
+		eta_aim.automatic = qtrue;
+		return;
+	}
+}
