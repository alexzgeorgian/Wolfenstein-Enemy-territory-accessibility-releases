@@ -5609,6 +5609,25 @@ void CG_AccessibilityMarkerWhere(void)
 	ETA_Speech_EndReport();
 }
 
+/**
+ * @brief For N: the point to face for the way to the marker - round the
+ * walls, as the ping is placed - and how far the marker is.
+ *
+ * @param[out] out
+ * @param[out] meters
+ * @return qfalse with no marker
+ */
+qboolean CG_AccessibilityMarkerFacePoint(vec3_t out, int *meters)
+{
+	if (!eta_marker.active)
+	{
+		return qfalse;
+	}
+	ETA_MarkerTarget(out);
+	*meters = ETA_MarkerDistance();
+	return qtrue;
+}
+
 /**
  * @brief Takes the marker away.
  */
diff --git a/src/cgame/cg_consolecmds.c b/src/cgame/cg_consolecmds.c
index 0868d8b..bddcea6 100644
--- a/src/cgame/cg_consolecmds.c
+++ b/src/cgame/cg_consolecmds.c
@@ -1587,6 +1587,37 @@ static void CG_AccessibilityMarkerWhere_f(void)
 	CG_AccessibilityMarkerWhere();
 }
 
+/*
+ * Period: turned toward the way to the marker, as O turns the player in the
+ * RTCW mode - round the walls, where the ping is - and how far it is.
+ * The tester, used to O there, wanted a key that leads them straight to
+ * the marker rather than turning by ear.
+ */
+static void ETA_AimStartSnap(const etaAimTarget_t *target, const char *label);
+
+static void CG_AccessibilityMarkerFace_f(void)
+{
+	etaAimTarget_t target;
+	vec3_t         point;
+	int            meters;
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	if (!CG_AccessibilityMarkerFacePoint(point, &meters))
+	{
+		ETA_Speech_Say("No marker set. Keypad plus puts it on the objective");
+		return;
+	}
+
+	/* Faced level: the way's point is on the floor, and looking down at
+	   it would leave the player staring at their feet. */
+	memset(&target, 0, sizeof(target));
+	target.entityNum = -1;
+	VectorCopy(point, target.point);
+	target.point[2] = cg.predictedPlayerState.origin[2] + cg.predictedPlayerState.viewheight;
+	ETA_AimStartSnap(&target, NULL);
+	ETA_Speech_Say(meters <= 1 ? "Facing the marker, here" : va("Facing the way. %d meters to marker", meters));
+}
+
