+/**
+ * @brief Collects the weapons the panel offers for a slot, in the order its
+ * own dropdown lists them - which is the order the panel's 1-9 accelerator
+ * keys count in, so what is spoken and what those keys do cannot disagree.
+ * @param[in]  slot
+ * @param[out] out
+ * @param[in]  max
+ * @return how many options were written to out.
+ */
+static int ETA_LimboPanel_WeaponOptions(int slot, weapon_t *out, int max)
+{
+	bg_playerclass_t *classInfo = CG_LimboPanel_GetPlayerClass();
+	int              saved      = cgs.ccSelectedWeaponSlot;
+	int              i, cnt     = 0;
+
+	if (!classInfo || CG_LimboPanel_GetTeam() == TEAM_SPECTATOR)
+	{
+		return 0;
+	}
+
+	/* CG_LimboPanel_WeaponPanel_GetSelectableWeaponOption reads the live slot
+	   rather than taking one, so the slot is moved for the walk and put back.
+	   Its secondary-slot answer depends on the current primary pick, which is
+	   why the list is read fresh every time rather than cached. */
+	cgs.ccSelectedWeaponSlot = slot;
+
+	for (i = 0; i < MAX_WEAPS_PER_CLASS && cnt < max; i++)
+	{
+		weapon_t weap = CG_LimboPanel_WeaponPanel_GetSelectableWeaponOption(classInfo, i);
+
+		if (weap != WP_NONE)
+		{
+			out[cnt++] = weap;
+		}
+	}
+
+	cgs.ccSelectedWeaponSlot = saved;
+	return cnt;
+}
+
+/**
+ * @brief A stop worth stopping on. A class with one weapon in a slot has
+ * nothing to choose there, and a spectator has no weapons at all; walking
+ * onto either would say something the player cannot act on.
+ * @param[in] index
+ * @return
+ */
+static qboolean ETA_LimboPanel_StopIsAvailable(int index)
+{
+	weapon_t options[MAX_WEAPS_PER_CLASS];
+
+	if (index < 0 || index >= ETA_LIMBO_STOP_COUNT)
+	{
+		return qfalse;
+	}
+
+	if (eta_limboStops[index].kind != ETA_LIMBO_WEAPON)
+	{
+		return qtrue;
+	}
+
+	return (qboolean)(ETA_LimboPanel_WeaponOptions(eta_limboStops[index].slot, options,
+	                                               MAX_WEAPS_PER_CLASS) > 1);
+}
