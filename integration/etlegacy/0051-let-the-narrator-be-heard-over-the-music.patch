+/**
+ * @brief How quickly the music gets out of the way, and how slowly it returns.
+ *
+ * Down fast enough to be clear of the first syllable, up slowly enough
+ * that an estimate which expired a little early is heard as the music
+ * coming back rather than as a click.
+ */
+#define ETA_MUSIC_DUCK_DOWN_MS 200
+#define ETA_MUSIC_DUCK_UP_MS   600
+
+/**
+ * @brief The music level the game itself last asked for.
+ *
+ * Not always 1. A map script fades the music for its own reasons -
+ * mu_fade is one of the commands the server sends - and restoring to full
+ * after a narration would override that, turning a deliberate hush back
+ * into a soundtrack. So the duck is applied as a fraction of whatever the
+ * game last asked for, and the restore goes back to that and not to 1.
+ */
+static float gMusicBaseline = 1.0f;
+static qboolean gMusicDucked = qfalse;
+static int      gMusicDuckUntil = 0;
+static int      gMusicDuckSerial = 0;
+
+/**
+ * @brief Records a music level the game asked for, and applies the duck to it.
+ *
+ * @param[in] level the level the game wants, 0 to 1
+ * @param[in] restarted qtrue when a new track was started rather than faded
+ */
+void ETA_MusicFadeRequested(float level, qboolean restarted)
+{
+	gMusicBaseline = level;
+
+	if (restarted)
+	{
+		/* A new stream starts unfaded, so whatever duck was in place has
+		   already been cancelled by the engine. Following it here keeps
+		   this from believing it is still ducked and never restoring. */
+		gMusicDucked = qfalse;
+		return;
+	}
+
+	/* Mid-duck, the game has just set a new level underneath us. Re-apply
+	   the duck on top of it rather than leaving the music at the level the
+	   script asked for while the narrator is still talking over it. */
+	if (gMusicDucked)
+	{
+		trap_S_FadeBackgroundTrack(gMusicBaseline * eta_musicDuck.value,
+		                           ETA_MUSIC_DUCK_DOWN_MS, 0);
+	}
+}
+
+/**
+ * @brief Turns the music down while the narrator is talking.
+ *
+ * A tester turned the music up and found the narrator underneath it. The
+ * two are mixed by different things and neither knows about the other:
+ * the music is the engine's, and the speech is NVDA's or SAPI's, going
+ * out through Windows rather than through the game at all. So no volume
+ * setting anywhere can balance them against each other - turning the
+ * music up genuinely does bury the narration, and there is nothing in
+ * either mixer that would stop it.
+ *
+ * What the mod can do is the thing broadcast has always done: duck the
+ * bed while the voice is on it. This is the game's own music fade, the
+ * same one map scripts use, so it costs nothing and needs no new mixing.
+ *
+ * It works whichever backend is speaking, which matters more than it
+ * looks: the obvious fix - a speech volume setting - would do nothing at
+ * all for an NVDA user, because NVDA speaks at the volume its own user
+ * configured and exposes no way to ask otherwise.
+ *
+ * How long to stay out of the way is an estimate, because neither
+ * backend reports when the words stop. See
+ * ETA_Speech_EstimateDurationMs.
+ */
+static void ETA_DuckMusicForSpeech(void)
+{
+	int serial = ETA_Speech_GetSpokenSerial();
+
+	/* 1 is the off position, and it is the default: ducking changes what
+	   a player already had set up, so it is opt-in by setting rather than
+	   something that happens to them. */
+	if (eta_musicDuck.value >= 1.0f)
+	{
+		if (gMusicDucked)
+		{
+			trap_S_FadeBackgroundTrack(gMusicBaseline, ETA_MUSIC_DUCK_UP_MS, 0);
+			gMusicDucked = qfalse;
+		}
+
+		gMusicDuckSerial = serial;
+		return;
+	}
+
+	if (serial != gMusicDuckSerial)
+	{
+		gMusicDuckSerial = serial;
+
+		/* Each new line pushes the end out again, so a run of reports is
+		   one continuous duck rather than a stutter of dips. */
+		gMusicDuckUntil = cg.time
+		                  + ETA_Speech_EstimateDurationMs(ETA_Speech_GetLastMessage());
+
+		if (!gMusicDucked)
+		{
+			gMusicDucked = qtrue;
+			trap_S_FadeBackgroundTrack(gMusicBaseline * eta_musicDuck.value,
+			                           ETA_MUSIC_DUCK_DOWN_MS, 0);
+		}
+
+		return;
+	}
+
+	/* Subtraction rather than a comparison, so a clock that rewound on a
+	   map change costs one early restore instead of leaving the music
+	   ducked until something else is spoken. */
+	if (gMusicDucked && cg.time - gMusicDuckUntil >= 0)
+	{
+		trap_S_FadeBackgroundTrack(gMusicBaseline, ETA_MUSIC_DUCK_UP_MS, 0);
+		gMusicDucked = qfalse;
+	}
+}
