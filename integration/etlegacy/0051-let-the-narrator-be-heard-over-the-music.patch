+/**
+ * @brief Every setting the mod adds, in one list.
+ *
+ * One list rather than a run of registration calls, because there are two
+ * things that have to happen to each of these and they were drifting
+ * apart. Registering a cvar fills the module's copy of it once; nothing
+ * refreshes that copy afterwards unless somebody asks, and nobody was
+ * asking. So every one of these settings could be changed - from the
+ * console, from a config, from a menu - and the change would not be seen
+ * until the map reloaded, because the module kept reading the value it
+ * was handed at startup.
+ *
+ * That is the kind of failure this project keeps meeting: it compiles, it
+ * stores the new value, `\cvarlist` shows it, and the game behaves as
+ * though nothing happened. A list used by both the registration and the
+ * refresh is what stops it coming back the next time a setting is added.
+ */
+typedef struct
+{
+	vmCvar_t   *cvar;
+	const char *name;
+	const char *defaultValue;
+} eta_setting_t;
+
+static eta_setting_t eta_settings[] =
+{
+	{ &eta_objectiveCallouts,   "eta_objectiveCallouts",   "1" },
+	{ &eta_environmentCallouts, "eta_environmentCallouts", "1" },
+	{ &eta_facingCallouts,      "eta_facingCallouts",      "1" },
+	{ &eta_locationCallouts,    "eta_locationCallouts",    "1" },
+	{ &eta_interactionCallouts, "eta_interactionCallouts", "1" },
+	{ &eta_mapCallouts,         "eta_mapCallouts",         "1" },
+	{ &eta_doorCues,            "eta_doorCues",            "1" },
+	{ &eta_crosshairCues,       "eta_crosshairCues",       "1" },
+	{ &eta_musicDuck,           "eta_musicDuck",           "1" },
+	{ &eta_speechRate,          "eta_speechRate",          "0" },
+	{ &eta_speechPitch,         "eta_speechPitch",         "0" },
+	{ &eta_speechVolume,        "eta_speechVolume",        "100" }
+};
+
+/**
+ * @brief Re-reads the mod's settings, so changing one takes effect now.
+ *
+ * Called every frame. trap_Cvar_Update on an unchanged cvar is a copy of
+ * a few bytes, and the alternative - tracking modification counts - would
+ * cost about as much as it saved.
+ */
+void ETA_UpdateAccessibilitySettings(void)
+{
+	size_t i;
+
+	for (i = 0; i < sizeof(eta_settings) / sizeof(eta_settings[0]); i++)
+	{
+		trap_Cvar_Update(eta_settings[i].cvar);
+	}
+
+	/* Pushed rather than polled, because the library has no way to read a
+	   cvar: it is a static library linked into this module, with no
+	   engine of its own. Setting the same values again costs two SAPI
+	   calls on a COM object that is already local, and skipping them
+	   would mean tracking three modification counts to save it. */
+	ETA_Speech_SetVoice(eta_speechRate.integer, eta_speechPitch.integer,
+	                    eta_speechVolume.integer);
+}
