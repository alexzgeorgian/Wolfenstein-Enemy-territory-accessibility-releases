diff --git a/src/cgame/cg_consolecmds.c b/src/cgame/cg_consolecmds.c
index bfa524e..bfb0781 100644
--- a/src/cgame/cg_consolecmds.c
+++ b/src/cgame/cg_consolecmds.c
@@ -541,6 +541,22 @@ void CG_AccessibilityNarrateObjective(void)
 	{
 		ETA_NavigationSystem_AnnounceRouteCorrection("Turn right toward the objective");
 	}
+
+	/* The two compass points together say how far round to turn, which
+	   "turn left" on its own never does: a player who hears they are
+	   facing south and the objective is north knows to keep turning past
+	   the point where a vaguer instruction would have them stop.
+	   `angles[YAW]` is already the objective's own world yaw, so both come
+	   out of the same conversion the compass uses. */
+	{
+		char compass[96];
+
+		Com_sprintf(compass, sizeof(compass), "Objective lies %s, you are facing %s",
+		            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(angles[YAW])),
+		            ETA_HudNarrator_FacingName(ETA_HudNarrator_FacingFromYaw(ps->viewangles[YAW])));
+
+		ETA_NavigationSystem_AnnounceRouteCorrection(compass);
+	}
 }
 
