+/**
+ * @brief Puts the marker on the nearest room, or the next one.
+ *
+ * As the sniper spot key does: pressed again within a few seconds, the
+ * next room further off. Each is said with the map's own name for the
+ * place, which floor it is on and its size - "Room 2 of 12: Water Pump,
+ * ground floor, 8 by 6 meters" - and the marker's sound leads the way
+ * there, through the door. Arriving says "inside" it.
+ */
+void CG_AccessibilityRoom(void)
+{
+	const ETA_Room *room;
+	char            text[128];
+	int             distance;
+	qboolean        cycling;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_Speech_Say("Only in play: spawn first, then ask for a room");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	cycling = (qboolean)(eta_rooms.lastPress && cg.time >= eta_rooms.lastPress
+	                     && cg.time - eta_rooms.lastPress < ETA_MARKER_CYCLE_MS);
+
+	if (!cycling || eta_rooms.count <= 0)
+	{
+		eta_rooms.count = eta_rooms.built
+		                  ? ETA_RoomList_Nearest(&eta_rooms.list, cg.predictedPlayerState.origin,
+		                                         eta_rooms.order, ETA_ROOM_MAX)
+		                  : 0;
+		eta_rooms.index = 0;
+	}
+	else
+	{
+		eta_rooms.index = (eta_rooms.index + 1) % eta_rooms.count;
+	}
+
+	if (eta_rooms.count <= 0)
+	{
+		eta_rooms.lastPress = 0;
+		ETA_Speech_Say(eta_rooms.built ? "No rooms found on this map"
+		                               : "Still looking over the map for rooms. Ask again in a moment");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	eta_rooms.lastPress = cg.time;
+	eta_rooms.marked    = eta_rooms.order[eta_rooms.index];
+	eta_rooms.judged    = qfalse;
+	room                = &eta_rooms.list.rooms[eta_rooms.marked];
+
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	eta_marker.objective = qtrue;
+	eta_marker.leftIt    = qtrue;
+	VectorCopy(room->origin, eta_marker.origin);
+	Q_strncpyz(eta_marker.name, room->name[0] ? va("inside %s", room->name) : "inside the room",
+	           sizeof(eta_marker.name));
+	eta_marker.active = qtrue;
+	ETA_RouteForget();
+	distance = ETA_MarkerDistance();
+	ETA_NavigationSystem_StartMarkerApproach(distance);
+
+	ETA_Room_Text(room, ETA_SPOT_SPACING, text, sizeof(text));
+	ETA_Speech_Say(va("Room %d of %d: %s", eta_rooms.index + 1, eta_rooms.count, text));
+	ETA_NavigationSystem_AnnounceMarkerDistance(distance);
+	ETA_NavigationSystem_AnnounceHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	ETA_MarkerSpeakWay();
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief How many rooms the map has in a square of the command map, for
+ * the survey.
+ */
+static int ETA_RoomsInCell(int column, int row)
+{
+	vec2_t start, step;
+	int    columns, rows;
+
+	if (!eta_rooms.built || !ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return 0;
+	}
+
+	return ETA_RoomList_CountIn(&eta_rooms.list,
+	                            start[0] + (float)column * step[0], start[1] - (float)(row + 1) * step[1],
+	                            start[0] + (float)(column + 1) * step[0], start[1] - (float)row * step[1]);
+}
