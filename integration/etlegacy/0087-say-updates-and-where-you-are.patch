+/*
+ * Where the player is, said as the main menu or the in-game menu opens.
+ * The tester asked for it: at start-up the update check's answer first,
+ * then "Main menu"; in a match, Escape says which menu came up. While the
+ * start-up check is still to come or still running, the menu's name
+ * waits and is said after the answer, in the same breath - said
+ * separately, the second line would cut off the first.
+ */
+static char etaMenuTitle[32];
+
+static qboolean UI_AccessibilityStartupCheckPending(void)
+{
+	trap_Cvar_Update(&eta_updateCheck);
+
+	if (etaUpdate.stage == ETA_UPDATE_STAGE_CHECKING && !etaUpdate.manual)
+	{
+		return qtrue;
+	}
+
+	return (qboolean)(eta_updateCheck.integer && ETA_WindowsUpdate_Supported()
+	                  && ETA_Update_IsReleaseBuild(ETA_Update_InstalledVersion())
+	                  && trap_Cvar_VariableValue("eta_updateAsked") == 0.f);
+}
+
+static void UI_AccessibilitySayMenu(const char *title)
+{
+	if (UI_AccessibilityStartupCheckPending())
+	{
+		Q_strncpyz(etaMenuTitle, title, sizeof(etaMenuTitle));
+		return;
+	}
+
+	etaMenuTitle[0] = '\0';
+	UI_AccessibilityUpdateSay(title);
+}
+
+/* The start-up check's answer, and then where the player is. */
+static void UI_AccessibilityStartupSay(const char *text)
+{
+	if (etaMenuTitle[0])
+	{
+		UI_AccessibilityUpdateSay(va("%s %s.", text, etaMenuTitle));
+		etaMenuTitle[0] = '\0';
+	}
+	else
+	{
+		UI_AccessibilityUpdateSay(text);
+	}
+}
