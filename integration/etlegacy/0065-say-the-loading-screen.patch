+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief The connection screen, said as it changes.
+ *
+ * Before the map loads there is a stretch where the screen says who the
+ * game is connecting to and what it is waiting for, and a download bar
+ * when the server has a file the player does not. Silent, that stretch
+ * is indistinguishable from the game having hung. Each new state is
+ * said once - not the packet counter that ticks beside it - and a
+ * download at a quarter, a half and three quarters. The server's own
+ * message, such as a refusal, is said when it changes.
+ */
+static void ETA_UiNarrateConnect(const uiClientState_t *cstate, char *downloadName)
+{
+	static int  lastState = -1;
+	static char lastDownload[MAX_QPATH];
+	static char lastMessage[MAX_STRING_CHARS];
+	static int  lastQuarter;
+
+	if (cstate->connState != lastState)
+	{
+		lastState = cstate->connState;
+
+		switch (cstate->connState)
+		{
+		case CA_CONNECTING:
+			ETA_Speech_Say(va("Connecting to %s", cstate->servername));
+			break;
+		case CA_CHALLENGING:
+			ETA_Speech_Say("Awaiting challenge");
+			break;
+		case CA_CONNECTED:
+			if (!*downloadName)
+			{
+				ETA_Speech_Say("Connected. Awaiting game state");
+			}
+			break;
+		default:
+			/* Loading is the map's to say: the game speaks its name and
+			   briefing from there. */
+			break;
+		}
+	}
+
+	if (*downloadName)
+	{
+		int count = (int)trap_Cvar_VariableValue("cl_downloadCount");
+		int size  = (int)trap_Cvar_VariableValue("cl_downloadSize");
+
+		if (Q_stricmp(downloadName, lastDownload))
+		{
+			Q_strncpyz(lastDownload, downloadName, sizeof(lastDownload));
+			lastQuarter = 0;
+			ETA_Speech_Say(va("Downloading %s", COM_SkipPath(downloadName)));
+		}
+		else if (size > 0)
+		{
+			int quarter = MIN(4 * count / size, 3);
+
+			if (quarter > lastQuarter)
+			{
+				lastQuarter = quarter;
+				ETA_Speech_Say(va("Downloading, %i percent", 100 * count / size));
+			}
+		}
+	}
+	else
+	{
+		lastDownload[0] = '\0';
+	}
+
+	if (cstate->connState < CA_CONNECTED && Q_stricmp(cstate->messageString, lastMessage))
+	{
+		Q_strncpyz(lastMessage, cstate->messageString, sizeof(lastMessage));
+
+		if (lastMessage[0])
+		{
+			ETA_Speech_Say(lastMessage);
+		}
+	}
+}
+#endif
