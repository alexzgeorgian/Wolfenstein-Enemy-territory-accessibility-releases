 extern displayContextDef_t *DC;
 
 qboolean  bg_loadscreeninited = qfalse;
@@ -783,3 +789,158 @@ void CG_LoadPanel_LoadingBarText(panel_button_t *button)
 {
 	CG_Text_Paint_Ext(button->rect.x, button->rect.y, button->font->scalex, button->font->scaley, button->font->colour, cg.infoScreenText, 0, 0, 0, button->font->font);
 }
+
+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief The loading screen, said.
+ *
+ * A sighted player spends the load reading it: the map's name, the game
+ * type, and the mission briefing, with a bar filling underneath. A
+ * tester asked for the same, and to be told when the load was over and
+ * the team and class menu could be opened.
+ *
+ * The briefing is said as the load begins - the game has it by then -
+ * and the bar at a quarter, a half and three quarters, but never over
+ * the top of the briefing: every speech backend cuts off the line in
+ * progress, so a figure arriving mid-briefing would lose the briefing.
+ * The line that the load is over waits for the briefing too, once.
+ */
+static int      eta_loadingBriefingUntil;   /* in trap_Milliseconds */
+static int      eta_loadingMilestones;      /* bit per quarter said */
+static qboolean eta_loadingReadySaid = qtrue;
+
+static void ETA_LoadingSay(const char *text)
+{
+	ETA_Speech_Say(text);
+	eta_loadingBriefingUntil = trap_Milliseconds() + ETA_Speech_EstimateDurationMs(text);
+}
+
+void CG_AccessibilityLoadingBegin(void)
+{
+	char       text[ETA_MAX_SPEECH_TEXT_LENGTH + 1];
+	char       briefing[2048];
+	const char *name        = cgs.rawmapname;
+	const char *description = "";
+	char       *end;
+
+	/* The rest of the mod's start-up comes at the end of the load. The
+	   voice is needed now, and starting it twice is harmless. */
+	ETA_AccessibilityRuntime_Init();
+
+	eta_loadingMilestones = 0;
+	eta_loadingReadySaid  = qfalse;
+
+	if (cgs.gametype == GT_WOLF_CAMPAIGN && cgs.campaignInfoLoaded)
+	{
+		name        = va("%s, map %i of %i", cgs.campaignData.campaignName,
+		                 cgs.currentCampaignMap + 1, cgs.campaignData.mapCount);
+		description = cgs.campaignData.campaignDescription;
+	}
+	else if (cgs.arenaInfoLoaded)
+	{
+		name        = cgs.arenaData.longname;
+		description = (cgs.gametype == GT_WOLF_LMS) ? cgs.arenaData.lmsdescription
+		                                           : cgs.arenaData.description;
+	}
+
+	CG_AccessibilitySpeakableText(description, briefing, sizeof(briefing));
+
+	Com_sprintf(text, sizeof(text), "Loading %s. %s. %s", name,
+	            CG_LoadPanel_GameTypeName(cgs.gametype), briefing);
+
+	/* Too long for one line: end at the last whole sentence that fits,
+	   rather than lose the lot. */
+	if (strlen(text) >= ETA_MAX_SPEECH_TEXT_LENGTH)
+	{
+		text[ETA_MAX_SPEECH_TEXT_LENGTH - 1] = '\0';
+		end = strrchr(text, '.');
+		if (end)
+		{
+			end[1] = '\0';
+		}
+	}
+
+	ETA_LoadingSay(text);
+}
+
+void CG_AccessibilityLoadingProgress(void)
+{
+	int used, expected, percent, quarter;
+
+	if (eta_loadingReadySaid)
+	{
+		return;
+	}
+
+	trap_GetHunkData(&used, &expected);
+
+	if (expected <= 0)
+	{
+		/* The first load of a map on this machine has nothing to measure
+		   against; the bar on screen is empty then too. */
+		return;
+	}
+
+	percent = (int)(100.0f * (float)used / (float)expected);
+	quarter = MIN(percent / 25, 3);
+
+	if (quarter < 1 || (eta_loadingMilestones & (1 << quarter)))
+	{
+		return;
+	}
+
+	/* Spent even when not said, so a briefing that outlasts the first
+	   quarter is not followed by three numbers at once. */
+	eta_loadingMilestones |= (1 << quarter);
+
+	if (trap_Milliseconds() < eta_loadingBriefingUntil)
+	{
+		return;
+	}
+
+	ETA_LoadingSay(va("Loading, %i percent", MIN(percent, 99)));
+}
+
+void CG_AccessibilityLoadingFrame(void)
+{
+	char text[128];
+	int  key1 = -1, key2 = -1;
+
+	if (eta_loadingReadySaid || !cg.snap)
+	{
+		return;
+	}
+
+	if (trap_Milliseconds() < eta_loadingBriefingUntil)
+	{
+		return;
+	}
+
+	eta_loadingReadySaid = qtrue;
+
+	if (cg.snap->ps.persistant[PERS_TEAM] != TEAM_SPECTATOR)
+	{
+		ETA_Speech_Say("Loaded");
+		return;
+	}
+
+	trap_Key_KeysForBinding("openlimbomenu", &key1, &key2);
+
+	if (key1 != -1)
+	{
+		char keyName[32];
+
+		trap_Key_KeynumToStringBuf(key1, keyName, sizeof(keyName));
+		Q_strupr(keyName);
+		Com_sprintf(text, sizeof(text),
+		            "Loaded. Press %s to choose your team and class", keyName);
+	}
+	else
+	{
+		Q_strncpyz(text, "Loaded. Open the limbo menu to choose your team and class",
+		           sizeof(text));
+	}
+
+	ETA_Speech_Say(text);
+}
+#endif
