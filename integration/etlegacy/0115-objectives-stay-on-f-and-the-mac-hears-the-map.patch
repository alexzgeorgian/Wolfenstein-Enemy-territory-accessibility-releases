+/* On a Mac the briefing waits for the end of the load. The game does the
+   whole load without once letting the Mac's own event loop run, and
+   VoiceOver and the system voice both need it to: what was said as the
+   load began was lost, and the tester never heard which map it was. So
+   on a Mac the briefing is kept, and said with "Loaded" once the load is
+   over. */
+static char eta_loadingBriefing[ETA_MAX_SPEECH_TEXT_LENGTH + 1];
+#endif
+
