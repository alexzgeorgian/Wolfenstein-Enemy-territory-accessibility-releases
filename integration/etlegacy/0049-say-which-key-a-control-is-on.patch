diff --git a/src/ui/ui_menuitem.c b/src/ui/ui_menuitem.c
index e1c56df..1bb81a3 100644
--- a/src/ui/ui_menuitem.c
+++ b/src/ui/ui_menuitem.c
@@ -229,6 +229,33 @@ static void ETA_TextFieldValue(itemDef_t *item, char *out, size_t size)
  * @param[in] item
  * @return the value as spoken text, or NULL for a type that has none.
  */
+/**
+ * @brief Which key or keys a control is on, said out loud.
+ *
+ * The engine already renders this for the eye, beside the label, and
+ * Item_Bind_Paint draws whatever Binding_FromName returns - so that is
+ * the string, rather than one assembled here that could disagree with
+ * what everybody else is looking at.
+ *
+ * The one substitution is for nothing being bound. The engine draws
+ * "(???)" there, which is clear enough on a screen and is three
+ * question marks to a screen reader.
+ *
+ * @param[in] item
+ * @return the key names, or "not bound"
+ */
+static const char *ETA_BindingText(itemDef_t *item)
+{
+	const char *binding = Binding_FromName(item->cvar);
+
+	if (!binding || !*binding || binding[0] == '(')
+	{
+		return "not bound";
+	}
+
+	return binding;
+}
+
 const char *ETA_MenuItem_SettingText(itemDef_t *item)
 {
 	if (!item || !item->cvar)
@@ -247,6 +274,11 @@ const char *ETA_MenuItem_SettingText(itemDef_t *item)
 		return (DC->getCVarValue(item->cvar) != 0.f) ? "Yes" : "No";
 	case ITEM_TYPE_SLIDER:
 		return va("%.2f", DC->getCVarValue(item->cvar));
+	case ITEM_TYPE_BIND:
+		/* A controls list that reads out only "Crouch" tells a player
+		   the control exists and nothing about it. The key it is on is
+		   the entire content of the row. */
+		return ETA_BindingText(item);
 	default:
 		return NULL;
 	}
@@ -4113,12 +4145,33 @@ qboolean Item_Bind_HandleKey(itemDef_t *item, int key, qboolean down)
 {
 	int id;
 
+#ifdef FEATURE_ACCESSIBILITY
+	/* Focus is enough, as it is for every other control now. The
+	   rectangle test alone can never be satisfied from the keyboard:
+	   arrowing onto a row does not move the cursor. Written out rather
+	   than going through ETA_ITEM_REACHED because this row, unlike the
+	   others, never asked for focus at all - so the feature-off text
+	   has to stay exactly the engine's own. */
+	if (ETA_ItemTakesKey(item, key) && !g_waitingForKey)
+#else
 	if (Rect_ContainsPoint(&item->window.rect, DC->cursorx, DC->cursory) && !g_waitingForKey)
+#endif
 	{
 		if (down && (key == K_MOUSE1 || key == K_ENTER))
 		{
 			g_waitingForKey = qtrue;
 			g_bindItem      = item;
+
+#ifdef FEATURE_ACCESSIBILITY
+			/* The screen turns the row red to say it is listening. With
+			   nothing said, a player presses Enter, hears silence, and
+			   has no way to know the game is now waiting on them - and
+			   whatever they press next becomes the binding. */
+			ETA_MenuNarrator_OnValueChanged(
+				item->text ? item->text : "Control",
+				"press the key to use. Escape to cancel, backspace to clear");
+#endif
+
 			return qtrue;
 		}
 		else
@@ -4143,6 +4196,17 @@ qboolean Item_Bind_HandleKey(itemDef_t *item, int key, qboolean down)
 		case K_ESCAPE:
 			g_waitingForKey = qfalse;
 			g_bindItem      = NULL;
+
+#ifdef FEATURE_ACCESSIBILITY
+			/* Reads the binding back rather than just saying "cancelled":
+			   what the player wants to know is what the control is on
+			   now, and after a cancel that is the one thing they cannot
+			   infer from what they pressed. */
+			ETA_MenuNarrator_OnValueChanged(
+				item->text ? item->text : "Control",
+				va("unchanged, %s", ETA_BindingText(item)));
+#endif
+
 			return qtrue;
 
 		case K_BACKSPACE:
@@ -4151,6 +4215,12 @@ qboolean Item_Bind_HandleKey(itemDef_t *item, int key, qboolean down)
 			Controls_SetConfig(qtrue);
 			g_waitingForKey = qfalse;
 			g_bindItem      = NULL;
+
+#ifdef FEATURE_ACCESSIBILITY
+			ETA_MenuNarrator_OnValueChanged(
+				item->text ? item->text : "Control", "not bound");
+#endif
+
 			return qtrue;
 
 		case '`':
@@ -4220,6 +4290,16 @@ qboolean Item_Bind_HandleKey(itemDef_t *item, int key, qboolean down)
 	g_waitingForKey = qfalse;
 	g_bindItem      = NULL;
 
+#ifdef FEATURE_ACCESSIBILITY
+	/* Read back after the binding is applied, not from the key that was
+	   pressed: this code may have taken that key off another control,
+	   or added it as a second binding, or replaced both. Only the row
+	   itself knows how it ended up, and it is the row the player will
+	   hear next time they arrow past. */
+	ETA_MenuNarrator_OnValueChanged(item->text ? item->text : "Control",
+	                                va("bound to %s", ETA_BindingText(item)));
+#endif
+
 	return qtrue;
 }
 
