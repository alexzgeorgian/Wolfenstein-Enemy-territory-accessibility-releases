+/**
+ * @brief The floors a player could stand on, straight down through one
+ * point of the map, highest first.
+ *
+ * Found the way a dropped stone would find them, again and again: down
+ * from far above, through the sky over the map, to the first surface
+ * that faces up; then on down from just under it, the trace starting
+ * inside that floor and so passing out of it, to the next. A floor with
+ * no room for a body over it is the top of something solid, not a floor.
+ * The sealed space under the map is lined with surfaces nobody sees, and
+ * the tops of the buildings that cannot be entered are sky: neither is a
+ * floor anyone stands on.
+ *
+ * @return how many were found, at most max
+ */
+#define ETA_SURVEY_HIGH 16384.0f
+
+static int ETA_SurveyFloors(float x, float y, vec3_t *out, int max)
+{
+	static const vec3_t mins = { -15.0f, -15.0f, 0.0f };
+	static const vec3_t maxs = { 15.0f, 15.0f, 56.0f };
+	trace_t trace;
+	vec3_t  start, end;
+	float   z     = ETA_SURVEY_HIGH;
+	int     count = 0, guard;
+
+	for (guard = 0; guard < 32 && count < max; guard++)
+	{
+		trace_t room;
+		vec3_t  body;
+
+		VectorSet(start, x, y, z);
+		VectorSet(end, x, y, -ETA_SURVEY_HIGH);
+		trap_CM_BoxTrace(&trace, start, end, NULL, NULL, 0, MASK_PLAYERSOLID);
+
+		if (trace.allsolid || trace.fraction >= 1.0f)
+		{
+			break;
+		}
+
+		z = trace.endpos[2] - 1.0f;
+
+		if (guard == 0 || trace.plane.normal[2] < 0.7f
+		    || (trace.surfaceFlags & (SURF_NODRAW | SURF_SKY)))
+		{
+			continue;   /* the first is the outside of the sky over the map */
+		}
+
+		/* Lifted a little, so a sloping floor does not catch the box. */
+		VectorSet(body, x, y, trace.endpos[2] + 12.0f);
+		trap_CM_BoxTrace(&room, body, body, mins, maxs, 0, MASK_PLAYERSOLID);
+
+		if (!room.startsolid)
+		{
+			VectorCopy(trace.endpos, out[count]);
+			count++;
+		}
+	}
+
+	return count;
+}
