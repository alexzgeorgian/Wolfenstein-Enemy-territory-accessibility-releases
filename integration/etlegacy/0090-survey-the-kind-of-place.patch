+/**
+ * @brief What kind of places a square of the command map holds, in words.
+ *
+ * A grid of points across the square, ten to a side, and at each the
+ * same probe the walking callouts use stood on every floor there is -
+ * navigation/place_classifier.c then reads the grid as a whole. On a
+ * map built in layers only the floors of the layer being surveyed count.
+ */
+static void ETA_MapCellPlaces(int column, int row, int layer, char *out, size_t outSize)
+{
+	static ETA_PlaceSurvey survey;
+	vec2_t                 start, step;
+	int                    columns, rows, i, j;
+
+	out[0] = '\0';
+
+	if (!ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return;
+	}
+
+	ETA_PlaceSurvey_Clear(&survey);
+
+	for (j = 0; j < ETA_PLACE_SURVEY_SIDE; j++)
+	{
+		for (i = 0; i < ETA_PLACE_SURVEY_SIDE; i++)
+		{
+			float  x = start[0] + ((float)column + ((float)i + 0.5f) / ETA_PLACE_SURVEY_SIDE) * step[0];
+			float  y = start[1] - ((float)row + ((float)j + 0.5f) / ETA_PLACE_SURVEY_SIDE) * step[1];
+			vec3_t floors[ETA_PLACE_SURVEY_FLOORS];
+			int    count = ETA_SurveyFloors(x, y, floors, ETA_PLACE_SURVEY_FLOORS);
+			int    k;
+
+			/* Lowest first. */
+			for (k = count - 1; k >= 0; k--)
+			{
+				ETA_Place place;
+				vec3_t    origin;
+
+				if (cgs.ccLayers && CG_CurLayerForZ((int)floors[k][2]) != layer)
+				{
+					continue;
+				}
+
+				VectorSet(origin, floors[k][0], floors[k][1], floors[k][2] + 24.0f);
+				CG_AccessibilityPlace(origin, &place);
+				ETA_PlaceSurvey_Add(&survey, j, i, &place);
+			}
+		}
+	}
+
+	ETA_PlaceSurvey_Describe(&survey, out, outSize);
+}
