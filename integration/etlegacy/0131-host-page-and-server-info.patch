diff --git a/src/ui/ui_main.c b/src/ui/ui_main.c
index 3eb6f62..b565cd9 100644
--- a/src/ui/ui_main.c
+++ b/src/ui/ui_main.c
@@ -10505,6 +10505,43 @@ static const char *UI_AccessibilityFeederRow(int feederID, int index)
 	const char  *type = NULL;
 	int         ping, game, clients, humans, maxclients, i;
 
+	/* The server info page's players come last, under a heading row of
+	   "num, score, ping, name", and each was said as its four bare
+	   columns - "0, 0, 0, "tester"". Said as a player, by name. */
+	if (feederID == FEEDER_SERVERSTATUS && index >= 0 && index < uiInfo.serverStatusInfo.numLines)
+	{
+		char **cols = uiInfo.serverStatusInfo.lines[index];
+
+		if (cols[0] && !Q_stricmp(cols[0], "num") && cols[3] && !Q_stricmp(cols[3], "name"))
+		{
+			return "Players";
+		}
+		for (i = index - 1; i >= 0; i--)
+		{
+			if (uiInfo.serverStatusInfo.lines[i][0] && !Q_stricmp(uiInfo.serverStatusInfo.lines[i][0], "num"))
+			{
+				break;
+			}
+		}
+		if (i >= 0 && cols[3] && cols[3][0])
+		{
+			Q_strncpyz(name, cols[3], sizeof(name));
+			Q_CleanStr(name);
+			/* The name comes quoted. */
+			if (name[0] == '"')
+			{
+				memmove(name, name + 1, strlen(name));
+			}
+			if (name[0] && name[strlen(name) - 1] == '"')
+			{
+				name[strlen(name) - 1] = '\0';
+			}
+			Com_sprintf(row, sizeof(row), "%s, score %s, ping %s", name, cols[1] ? cols[1] : "0", cols[2] ? cols[2] : "0");
+			return row;
+		}
+		return NULL;
+	}
+
 	if (feederID != FEEDER_SERVERS || index < 0 || index >= uiInfo.serverStatus.numDisplayServers)
 	{
 		return NULL;
