index af56356..bbca90d 100644
--- a/src/cgame/cg_draw.c
+++ b/src/cgame/cg_draw.c
@@ -3761,6 +3761,352 @@ static int ETA_GatherAwareness(ETA_AwareThing *list, int max, qboolean players,
