+/**
+ * @brief ", press space": the key the player jumps with, for the jump
+ * callout. Nothing when jump is on no key.
+ */
+static const char *ETA_RouteJumpKey(void)
+{
+	static char text[48];
+	char        name[32];
+	int         key = trap_Key_GetKey("+moveup");
+
+	if (key < 0)
+	{
+		return "";
+	}
+
+	name[0] = '\0';
+	trap_Key_KeynumToStringBuf(key, name, sizeof(name));
+	if (!name[0])
+	{
+		return "";
+	}
+
+	Q_strlwr(name);
+	Com_sprintf(text, sizeof(text), ", press %s", name);
+	return text;
+}
