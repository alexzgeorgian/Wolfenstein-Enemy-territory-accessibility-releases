+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief Says a message the server puts in the middle of the screen.
+ *
+ * Those were only drawn. Joining a team the balance rule refuses is
+ * answered that way alone - "The Axis has too many players." - and the
+ * tester, on a Mac hosting with bots, confirmed Axis again and again and
+ * stayed a spectator without a word of why. Colour codes and line breaks
+ * left out; the same line within three seconds is said once.
+ * @param[in] text
+ */
+void CG_AccessibilitySayServerCenter(const char *text)
+{
+	static char last[256];
+	static int  lastAt;
+	char        clean[256];
+	int         i;
+
+	if (!text || !text[0])
+	{
+		return;
+	}
+	Q_strncpyz(clean, text, sizeof(clean));
+	Q_CleanStr(clean);
+	for (i = 0; clean[i]; i++)
+	{
+		if (clean[i] == '\n' || clean[i] == '\r')
+		{
+			clean[i] = ' ';
+		}
+	}
+	{
+		const char *said = Q_TrimStr(clean);
+
+		if (!said[0] || ( !Q_stricmp(said, last) && cg.time - lastAt < 3000 && cg.time >= lastAt ))
+		{
+			return;
+		}
+		Q_strncpyz(last, said, sizeof(last));
+		lastAt = cg.time;
+		ETA_Speech_Say(said);
+	}
+}
+#endif
