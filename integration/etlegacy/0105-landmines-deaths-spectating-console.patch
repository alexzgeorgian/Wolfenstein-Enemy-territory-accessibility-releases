+/**
+ * @brief Says when the console opens or closes over the menus.
+ *
+ * The tester opened it by mistake and never knew. In a match the cgame
+ * says it (cg_draw.c), so here it is only before one: the menus, and
+ * connecting.
+ */
+static void UI_AccessibilityConsoleFrame(void)
+{
+	static qboolean wasOpen;
+	uiClientState_t cstate;
+	qboolean        open = (qboolean)((trap_Key_GetCatcher() & KEYCATCH_CONSOLE) != 0);
+
+	trap_GetClientState(&cstate);
+	if (cstate.connState == CA_ACTIVE)
+	{
+		wasOpen = open;
+		return;
+	}
+
+	if (open == wasOpen)
+	{
+		return;
+	}
+	wasOpen = open;
+
+	UI_AccessibilityUpdateSay(open ? "Console open. The same key closes it" : "Console closed");
+}
