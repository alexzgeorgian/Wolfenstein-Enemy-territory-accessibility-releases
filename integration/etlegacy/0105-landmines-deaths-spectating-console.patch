+/**
+ * @brief "Hans revived": the one watched, back up where they fell.
+ *
+ * A player who is revived gets up where they lay; one who spawns again
+ * appears somewhere else. So back on their feet near where they went
+ * down is a revive, and anywhere else is not said - the play state
+ * says the rest.
+ */
+#define ETA_REVIVED_NEAR 128.0f
+
+static void ETA_NarrateFollowedRevive(void)
+{
+	static int    watched = -1;
+	static qboolean down;
+	static vec3_t downAt;
+	const playerState_t *ps = &cg.snap->ps;
+	qboolean      isDown;
+
+	if (!(ps->pm_flags & PMF_FOLLOW) || ps->clientNum == cg.clientNum)
+	{
+		watched = -1;
+		return;
+	}
+
+	isDown = (qboolean)(ps->stats[STAT_HEALTH] <= 0 || ps->pm_type == PM_DEAD);
+	if (ps->clientNum != watched)
+	{
+		watched = ps->clientNum;
+		down    = isDown;
+		VectorCopy(ps->origin, downAt);
+		return;
+	}
+
+	if (isDown && !down)
+	{
+		VectorCopy(ps->origin, downAt);
+	}
+	else if (!isDown && down && Distance(ps->origin, downAt) <= ETA_REVIVED_NEAR)
+	{
+		char name[MAX_NAME_LENGTH];
+
+		Q_strncpyz(name, cgs.clientinfo[ps->clientNum].name, sizeof(name));
+		Q_CleanStr(name);
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say(va("%s revived", name));
+		ETA_Speech_EndReport();
+	}
+	down = isDown;
 }
 
