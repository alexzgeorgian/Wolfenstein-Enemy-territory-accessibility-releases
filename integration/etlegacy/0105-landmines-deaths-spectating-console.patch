+
+/**
+ * @brief A name as it is said: the player's own as "You", any other
+ * without its colour codes.
+ */
+static void ETA_ObituaryName(int client, char *out, size_t outSize)
+{
+	if (client == cg.clientNum)
+	{
+		Q_strncpyz(out, "You", (int)outSize);
+		return;
+	}
+	Q_strncpyz(out, cgs.clientinfo[client].name, (int)outSize);
+	Q_CleanStr(out);
+}
+
+/**
+ * @brief The game's own death message, made for "You": "was" is "were",
+ * "his own" is "your own", "himself" is "yourself".
+ */
+static void ETA_ObituaryForYou(char *text, size_t size)
+{
+	static const char *const swaps[][2] =
+	{
+		{ "You was ", "You were " }, { "himself", "yourself" }, { "his own", "your own" }, { " his ", " your " }
+	};
+	int i;
+
+	for (i = 0; i < (int)(sizeof(swaps) / sizeof(swaps[0])); i++)
+	{
+		char *at = strstr(text, swaps[i][0]);
+
+		if (at)
+		{
+			char rest[256];
+
+			Q_strncpyz(rest, at + strlen(swaps[i][0]), sizeof(rest));
+			*at = '\0';
+			Q_strcat(text, (int)size, swaps[i][1]);
+			Q_strcat(text, (int)size, rest);
+		}
+	}
+}
+
+/**
+ * @brief Who killed whom, said when it is the player - or, watching
+ * someone, the one being watched.
+ *
+ * The tester kept dying to landmines and never heard what had killed
+ * them: the game shows it in the kill feed and the middle of the screen,
+ * and said nothing. So a death of the player's, or a kill, is said in
+ * the game's own words - "You failed to spot Hans's Landmine", "You
+ * killed Hans" - and so are the deaths and kills of a player being
+ * watched. Everyone else's stay in the feed: a match's every death would
+ * bury everything else.
+ */
+static void ETA_NarrateObituary(int target, int attacker, meansOfDeath_t mod)
+{
+	int         viewed = cg.snap ? cg.snap->ps.clientNum : cg.clientNum;
+	const char *message1, *message2;
+	char        targetName[MAX_NAME_LENGTH], attackerName[MAX_NAME_LENGTH];
+	char        text[256];
+
+	if (target != viewed && attacker != viewed)
+	{
+		return;
+	}
+
+	ETA_ObituaryName(target, targetName, sizeof(targetName));
+
+	if (attacker == viewed && attacker != target && attacker >= 0 && attacker < MAX_CLIENTS)
+	{
+		ETA_ObituaryName(attacker, attackerName, sizeof(attackerName));
+		Com_sprintf(text, sizeof(text), "%s killed %s%s", attackerName,
+		            cgs.clientinfo[attacker].team == cgs.clientinfo[target].team ? "teammate " : "", targetName);
+	}
+	else if (attacker < 0 || attacker >= MAX_CLIENTS || attacker == target)
+	{
+		message1 = attacker == target ? GetMODTableData(mod)->obituarySelfKillMessage
+		                              : GetMODTableData(mod)->obituaryNoAttackerMessage;
+		Com_sprintf(text, sizeof(text), "%s %s", targetName, message1 ? CG_TranslateString(message1) : "died");
+	}
+	else
+	{
+		message1 = GetMODTableData(mod)->obituaryKillMessage1;
+		message2 = GetMODTableData(mod)->obituaryKillMessage2;
+		ETA_ObituaryName(attacker, attackerName, sizeof(attackerName));
+		if (message1)
+		{
+			Com_sprintf(text, sizeof(text), "%s %s %s%s", targetName, CG_TranslateString(message1), attackerName,
+			            message2 ? CG_TranslateString(message2) : "");
+		}
+		else
+		{
+			Com_sprintf(text, sizeof(text), "%s was killed by %s", targetName, attackerName);
+		}
+	}
+
+	Q_CleanStr(text);
+	if (target == cg.clientNum)
+	{
+		/* Said with the "Down" or "Waiting to respawn" that follows it,
+		   as one line, so neither cuts the other off. */
+		ETA_ObituaryForYou(text, sizeof(text));
+		Q_strncpyz(eta_deathWords, text, sizeof(eta_deathWords));
+		eta_deathWordsAt = cg.time;
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(text);
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief How the player died, if it is still to be said: handed out
+ * once, then gone. Said alone once it has waited ETA_DEATH_WORDS_WAIT
+ * for the play state to say it with.
+ */
+#define ETA_DEATH_WORDS_WAIT 1500
+
+const char *CG_AccessibilityDeathWords(qboolean alone)
+{
+	static char said[256];
+
+	if (!eta_deathWords[0])
+	{
+		return NULL;
+	}
+
+	if (alone && cg.time - eta_deathWordsAt < ETA_DEATH_WORDS_WAIT && cg.time >= eta_deathWordsAt)
+	{
+		return NULL;
+	}
+
+	Q_strncpyz(said, eta_deathWords, sizeof(said));
+	eta_deathWords[0] = '\0';
+	return said;
+}
