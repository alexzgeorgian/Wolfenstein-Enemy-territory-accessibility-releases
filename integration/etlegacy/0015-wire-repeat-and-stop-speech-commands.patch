+/**
+ * @brief Which module should answer a repeat or stop request.
+ *
+ * Both modules link their own copy of the accessibility library and
+ * neither can see the other's state: the menu narrator's "current item"
+ * lives in ui, the last HUD announcement lives here. So the command has
+ * to be answered by whichever module is actually in front of the player.
+ *
+ * The engine decides that for us in the wrong order. Cmd_ExecuteString
+ * (qcommon/cmd.c) tries CL_GameCommand before UI_GameCommand, so once a
+ * snapshot exists cgame is offered every command first and answering it
+ * here is final - CG_ConsoleCommand returns qtrue on any name in its
+ * table and the ui module never sees it. Opening the options menu
+ * mid-match would then repeat the last health report instead of the
+ * focused menu item.
+ *
+ * The key catcher is what distinguishes the two. When KEYCATCH_UI is
+ * set, a menu owns the keyboard and the request belongs to ui; the
+ * command is pushed back through the buffer under a name only ui
+ * registers, which reaches it on the next Cbuf_Execute. Before a
+ * snapshot exists CG_ConsoleCommand declines everything outright, so the
+ * main menu never gets here at all and ui is offered the original name
+ * directly.
+ *
+ * @return qtrue when the request was handed to the ui module.
+ */
+static qboolean CG_AccessibilityForwardToUI(const char *uiCommand)
+{
+	if (!(trap_Key_GetCatcher() & KEYCATCH_UI))
+	{
+		return qfalse;
+	}
+
+	/* Queued, not executed here, so this cannot re-enter itself: the
+	   name below is registered by ui and by nothing in this module. */
+	trap_SendConsoleCommand(va("%s\n", uiCommand));
+	return qtrue;
+}
+
+/**
+ * @brief CG_AccessibilityRepeat_f
+ * Says the last thing that was spoken again, for the word that was
+ * missed because a gunshot landed on top of it.
+ */
+static void CG_AccessibilityRepeat_f(void)
+{
+	if (CG_AccessibilityForwardToUI("accessibilityRepeatMenuItem"))
+	{
+		return;
+	}
+
+	ETA_Speech_RepeatLast();
+}
+
+/**
+ * @brief CG_AccessibilityStopSpeech_f
+ * Cuts off whatever is being spoken. Worth having on a key of its own:
+ * an objective report is several seconds of speech that cannot otherwise
+ * be interrupted, and a player who needs to hear the match instead
+ * should not have to wait it out.
+ */
+static void CG_AccessibilityStopSpeech_f(void)
+{
+	if (CG_AccessibilityForwardToUI("accessibilityStopSpeechMenu"))
+	{
+		return;
+	}
+
+	ETA_Speech_Stop();
+}
+
