+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief UI_AccessibilityRepeat_f
+ * Speaks the focused menu item again. Menu narration is a single pass -
+ * the item is spoken when focus lands on it and never again - so
+ * without this the only way back to a name you missed is to move focus
+ * away and return, which on a list of one item is not possible at all.
+ *
+ * Reached two ways. In the main menu no snapshot exists, so
+ * CG_ConsoleCommand declines every command and the engine offers ui the
+ * name the player bound. In a menu opened mid-match cgame is offered it
+ * first and pushes it back under the second name below, which only this
+ * module registers. Both land here.
+ */
+static void UI_AccessibilityRepeat_f(void)
+{
+	ETA_MenuNarrator_RepeatCurrentItem();
+}
+
+/**
+ * @brief UI_AccessibilityStopSpeech_f
+ * Cuts off whatever is being spoken, for the same reason cgame has its
+ * own copy of this: a long setting description is not worth sitting
+ * through twice.
+ */
+static void UI_AccessibilityStopSpeech_f(void)
+{
+	ETA_MenuNarrator_Stop();
+}
+#endif
