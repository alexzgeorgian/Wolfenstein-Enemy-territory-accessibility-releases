+/**
+ * @brief Players' voice chats at eta_voiceVolume, 0 to 127 - or -1 at 100,
+ * for the game's own way of playing them.
+ *
+ * Asked for by the tester: bots calling for medics and ammo all match
+ * long drowned the marker's beacon while he was walking to it. Turned
+ * down, a voice chat is still said in the chat speech; only the voice
+ * is quieter.
+ */
+int CG_AccessibilityVoiceVolume(void)
+{
+	int percent = eta_voiceVolume.integer;
+
+	if (percent >= 100)
+	{
+		return -1;
+	}
+
+	return percent <= 0 ? 0 : (127 * percent) / 100;
+}
