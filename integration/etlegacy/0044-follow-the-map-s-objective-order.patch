+/**
+ * @brief Says when an objective is finished, or lost.
+ *
+ * The single most useful thing to hear on a map played alone, and the
+ * mod said nothing about it. A sighted player watches a stamp land on
+ * the objective panel; without it, the only evidence that a job is done
+ * is that the thing you were walking towards stops being there.
+ *
+ * The state comes from the map script, which is the same source the
+ * panel's stamp comes from, so this cannot claim something the game
+ * does not agree with.
+ *
+ * Not held back by the passive hold: finishing an objective is news
+ * that outranks a report the player asked for, and unlike the scenery
+ * it happens once.
+ */
+static void ETA_NarrateObjectiveOrder(void)
+{
+	static int  lastStates[MAX_OBJECTIVES + 1];
+	static team_t lastTeam = TEAM_FREE;
+	team_t      team       = cgs.clientinfo[cg.clientNum].team;
+	int         count, i;
+
+	if (!cg.snap || !eta_objectiveCallouts.integer
+	    || (team != TEAM_AXIS && team != TEAM_ALLIES))
+	{
+		lastTeam = TEAM_FREE;
+		return;
+	}
+
+	count = CG_AccessibilityObjectiveCount(team);
+
+	if (count <= 0 || count > MAX_OBJECTIVES)
+	{
+		lastTeam = TEAM_FREE;
+		return;
+	}
+
+	/* Changing team means a different list with different numbering, so
+	   the remembered states describe somebody else's map. Taking them as
+	   this team's would announce a handful of objectives as freshly
+	   completed the moment a player switched sides. */
+	if (team != lastTeam)
+	{
+		for (i = 1; i <= MAX_OBJECTIVES; i++)
+		{
+			lastStates[i] = CG_AccessibilityObjectiveState(team, i);
+		}
+
+		lastTeam = team;
+		return;
+	}
+
+	for (i = 1; i <= count; i++)
+	{
+		int state = CG_AccessibilityObjectiveState(team, i);
+
+		if (state == lastStates[i])
+		{
+			continue;
+		}
+
+		lastStates[i] = state;
+
+		/* Only ever forward. A state going back to pending is a map
+		   script resetting something, not an objective un-finishing,
+		   and announcing it would be nonsense. */
+		if (state != 1 && state != 2)
+		{
+			continue;
+		}
+
+		ETA_Speech_BeginReport();
+		ETA_HudNarrator_SpeakObjectiveStep(i, count,
+		                                   state == 1 ? ETA_OBJECTIVE_COMPLETE
+		                                              : ETA_OBJECTIVE_FAILED,
+		                                   CG_AccessibilityObjectiveDescription(team, i));
+		ETA_Speech_EndReport();
+
+		/* One per frame. Two stamps landing together would destroy each
+		   other, and the next frame will find the second one. */
+		return;
+	}
+
+	if (CG_AccessibilityCurrentObjective(team) < 0)
+	{
+		static qboolean saidComplete = qfalse;
+
+		if (!saidComplete)
+		{
+			saidComplete = qtrue;
+
+			ETA_Speech_BeginReport();
+			ETA_HudNarrator_SpeakObjectivesComplete();
+			ETA_Speech_EndReport();
+		}
+	}
+}
