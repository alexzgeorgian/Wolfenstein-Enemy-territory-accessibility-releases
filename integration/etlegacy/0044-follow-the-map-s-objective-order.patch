+/**
+ * @brief How many objectives this team's map has.
+ *
+ * Straight out of CS_MULTI_INFO, which is where the limbo panel gets
+ * the same number for its own objective list.
+ */
+int CG_AccessibilityObjectiveCount(team_t team)
+{
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		return 0;
+	}
+
+	return Q_atoi(Info_ValueForKey(CG_ConfigString(CS_MULTI_INFO), "o"));
+}
+
+/**
+ * @brief The state of one numbered objective, for this team.
+ *
+ * The numbering and the three states are the engine's own. A map script
+ * sets them with its objective status command, keyed "x<n>" for Axis
+ * and "a<n>" for Allies, counting from one - and that command's own
+ * error message states what the values mean: 0 default, 1 complete,
+ * 2 failed. Nothing here is this mod's invention, which matters,
+ * because the whole point is to follow the order the map was written
+ * in rather than one the mod made up.
+ *
+ * @param[in] team
+ * @param[in] number 1-based
+ */
+int CG_AccessibilityObjectiveState(team_t team, int number)
+{
+	const char *cs;
+
+	if (number < 1 || number > MAX_OBJECTIVES)
+	{
+		return 0;
+	}
+
+	cs = CG_ConfigString(CS_MULTI_OBJECTIVE);
+
+	return Q_atoi(Info_ValueForKey(cs, va("%s%i",
+	                                      team == TEAM_AXIS ? "x" : "a",
+	                                      number)));
+}
+
+/**
+ * @brief The map's description of one numbered objective, or NULL.
+ */
+const char *CG_AccessibilityObjectiveDescription(team_t team, int number)
+{
+	const char *text;
+
+	if (number < 1 || number > MAX_OBJECTIVES)
+	{
+		return NULL;
+	}
+
+	text = (team == TEAM_AXIS) ? cg.objDescription_Axis[number - 1]
+	                           : cg.objDescription_Allied[number - 1];
+
+	return (text && text[0]) ? text : NULL;
+}
+
+/**
+ * @brief The first objective this team still has to do.
+ *
+ * The lowest-numbered one that is neither complete nor failed. A tester
+ * playing on their own reported wandering the map because the narration
+ * pointed at whichever objective was *nearest*, and a map's objectives
+ * have to be done in order - so the nearest one is usually one that
+ * cannot be started yet.
+ *
+ * A failed objective is stepped over rather than stopped at: it is not
+ * coming back, and standing the player in front of it forever would be
+ * worse than moving them on.
+ *
+ * @return the 1-based number, or -1 when there is nothing left to do
+ */
+int CG_AccessibilityCurrentObjective(team_t team)
+{
+	int count = CG_AccessibilityObjectiveCount(team);
+	int i;
+
+	for (i = 1; i <= count; i++)
+	{
+		if (CG_AccessibilityObjectiveState(team, i) == 0)
+		{
+			return i;
+		}
+	}
+
+	return -1;
+}
+
+/**
+ * @brief Where on the map a numbered objective is.
+ *
+ * The link between "objective 2 of 4" and a place to walk to is the
+ * objflags bitmask the map author puts on each trigger - the engine's
+ * own comment calls it "which commandmap objectives this entity belongs
+ * to" - and the stock command map uses exactly this test to highlight
+ * the objective the player has selected in the limbo panel.
+ *
+ * Not every map sets it. When none of the entities claims this
+ * objective number there is nothing to point at, and the caller falls
+ * back to the nearest rather than inventing a position.
+ *
+ * @param[in]  team
+ * @param[in]  number 1-based
+ * @param[out] out
+ * @return qtrue when this objective has a place on the map
+ */
+qboolean CG_AccessibilityObjectiveByNumber(team_t team, int number, etaObjective_t *out)
+{
+	int i;
+
+	if (number < 1 || number > MAX_OBJECTIVES)
+	{
+		return qfalse;
+	}
+
+	for (i = 0; i < mapEntityCount; i++)
+	{
+		const mapEntityData_t *mEnt = &mapEntities[i];
+		vec3_t                origin;
+		int                   oidIndex = -1;
+
+		if (mEnt->team != team)
+		{
+			continue;
+		}
+
+		if (!CG_AccessibilityMapObjectiveAt(mEnt, origin, &oidIndex))
+		{
+			continue;
+		}
+
+		if (oidIndex < 0 || oidIndex >= MAX_OID_TRIGGERS)
+		{
+			continue;
+		}
+
+		/* A cabinet is somewhere to go and never the objective. */
+		if (cgs.oidInfo[oidIndex].spawnflags & (1 << 5))
+		{
+			continue;
+		}
+
+		if (!(cgs.oidInfo[oidIndex].objflags & (1 << (number - 1))))
+		{
+			continue;
+		}
+
+		out->name      = cgs.oidInfo[oidIndex].name[0] ? cgs.oidInfo[oidIndex].name : NULL;
+		out->entityNum = cgs.oidInfo[oidIndex].entityNum;
+		VectorCopy(origin, out->origin);
+
+		return qtrue;
+	}
+
+	return qfalse;
+}
+
 qboolean CG_AccessibilityNearestObjective(team_t team, const vec3_t from, etaObjective_t *out)
 {
 	int      i;
