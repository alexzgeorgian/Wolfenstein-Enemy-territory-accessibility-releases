+/**
+ * @brief Says which objective is next, and how many are behind it.
+ *
+ * The piece a player on their own could not get any other way. ET's
+ * maps run their objectives in sequence and the mod was pointing at
+ * whichever was closest, so a tester spent a match walking between
+ * things that could not be started yet. This reads the map's own list,
+ * in the map's own order, with the map's own idea of what is done.
+ */
+void CG_AccessibilityNarrateObjectiveOrder(void)
+{
+	team_t     team    = cgs.clientinfo[cg.clientNum].team;
+	int        count   = CG_AccessibilityObjectiveCount(team);
+	int        current = CG_AccessibilityCurrentObjective(team);
+	const char *text;
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		return;
+	}
+
+	if (count <= 0)
+	{
+		/* Plenty of maps list none. Saying so is better than silence,
+		   which a player reads as the report having failed. */
+		ETA_Speech_Say("This map lists no objectives");
+		return;
+	}
+
+	if (current < 0)
+	{
+		ETA_HudNarrator_SpeakObjectivesComplete();
+		return;
+	}
+
+	text = CG_AccessibilityObjectiveDescription(team, current);
+
+	ETA_HudNarrator_SpeakObjectiveStep(current, count, ETA_OBJECTIVE_PENDING, text);
+}
