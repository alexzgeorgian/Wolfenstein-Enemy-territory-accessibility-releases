diff --git a/src/cgame/cg_draw.c b/src/cgame/cg_draw.c
index a640274..2d163db 100644
--- a/src/cgame/cg_draw.c
+++ b/src/cgame/cg_draw.c
@@ -3655,6 +3655,105 @@ static qboolean ETA_GroundRiseAhead(const playerState_t *ps, const vec3_t forwar
  * are looking when they are standing still, which is the same rule the
  * drop warning uses and for the same reason.
