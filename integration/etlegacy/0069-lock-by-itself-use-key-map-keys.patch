+/**
+ * @brief The keys belong to the map while it is open.
+ *
+ * With the map open, the arrow keys still turned and looked and the
+ * movement keys still walked, so walking the survey with the arrows
+ * moved the player as well. A tester put it plainly: while the map is
+ * open the arrows should walk the map, and nothing should move; close it
+ * and everything is as it was.
+ *
+ * So opening the map (as a switch - held, its release must still reach
+ * the game) gives the keys to this module: the arrow keys and the keypad
+ * arrows move the survey cursor, the map key or Escape closes it, a key
+ * on one of the mod's own commands - the reports, the marker, the
+ * survey's other keys - still does its job, and every held action -
+ * walking, firing, looking - is ignored. Letting go of a key that was
+ * already held still reaches the game, which the client guarantees for
+ * every + command, so nothing is left running.
+ */
+static qboolean eta_mapCatching;
+
+static void ETA_MapCatchKeys(qboolean on)
+{
+	if (on && !eta_mapCatching && cgs.eventHandling == CGAME_EVENT_NONE)
+	{
+		if (eta_turn.step)
+		{
+			ETA_TurnStopStep(qfalse);
+		}
+		ETA_AimStop();
+		trap_Key_SetCatcher(trap_Key_GetCatcher() | KEYCATCH_CGAME);
+		eta_mapCatching = qtrue;
+	}
+	else if (!on && eta_mapCatching)
+	{
+		if (cgs.eventHandling == CGAME_EVENT_NONE)
+		{
+			trap_Key_SetCatcher(trap_Key_GetCatcher() & ~KEYCATCH_CGAME);
+		}
+		eta_mapCatching = qfalse;
+	}
+}
+
+/* Escape is the client's: it takes the keys back without asking. Then the
+   map closes too, rather than staying open with the keys gone. */
+static void ETA_MapCatchFrame(void)
+{
+	if (!eta_mapCatching)
+	{
+		return;
+	}
+
+	if (cgs.eventHandling != CGAME_EVENT_NONE)
+	{
+		/* Another panel - the limbo menu - has the keys now. */
+		eta_mapCatching = qfalse;
+		return;
+	}
+
+	if (!(trap_Key_GetCatcher() & KEYCATCH_CGAME) || !cgs.autoMapExpanded)
+	{
+		eta_mapCatching = qfalse;
+		if (cgs.autoMapExpanded)
+		{
+			CG_AutomapCollapse();
+			ETA_Speech_Say("Map closed");
+		}
+		else if (trap_Key_GetCatcher() & KEYCATCH_CGAME)
+		{
+			trap_Key_SetCatcher(trap_Key_GetCatcher() & ~KEYCATCH_CGAME);
+		}
+	}
+}
+
+/**
+ * @brief A key while the map has them. qtrue when it was the map's.
+ */
+qboolean CG_AccessibilityMapKeyEvent(int key, qboolean down)
+{
+	char binding[256];
+
+	if (!eta_mapCatching)
+	{
+		return qfalse;
+	}
+
+	if (!cgs.autoMapExpanded || cgs.eventHandling != CGAME_EVENT_NONE)
+	{
+		ETA_MapCatchKeys(qfalse);
+		return qfalse;
+	}
+
+	/* Letting go is the client's to deliver, and it already has. */
+	if (!down)
+	{
+		return qtrue;
+	}
+
+	switch (key)
+	{
+	case K_UPARROW:
+	case K_KP_UPARROW:
+		CG_AccessibilityMapNorth_f();
+		return qtrue;
+	case K_DOWNARROW:
+	case K_KP_DOWNARROW:
+		CG_AccessibilityMapSouth_f();
+		return qtrue;
+	case K_RIGHTARROW:
+	case K_KP_RIGHTARROW:
+		CG_AccessibilityMapEast_f();
+		return qtrue;
+	case K_LEFTARROW:
+	case K_KP_LEFTARROW:
+		CG_AccessibilityMapWest_f();
+		return qtrue;
+	case K_ESCAPE:
+		CG_AutomapCollapse();
+		ETA_Speech_Say("Map closed");
+		return qtrue;
+	default:
+		break;
+	}
+
+	trap_Key_GetBindingBuf(key, binding, sizeof(binding));
+
+	if (!Q_stricmp(binding, "+mapexpand"))
+	{
+		CG_AutomapCollapse();
+		ETA_Speech_Say("Map closed");
+		return qtrue;
+	}
+
+	/* A command that does a thing once - a report, the marker, the rest
+	   of the survey, a chat line - still does it. A held action - walking,
+	   firing, looking, turning - waits until the map is closed. */
+	if (binding[0] && binding[0] != '+')
+	{
+		trap_SendConsoleCommand(va("%s\n", binding));
+	}
+
+	return qtrue;
+}
