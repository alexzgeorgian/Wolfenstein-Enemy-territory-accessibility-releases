+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief Has the mouse cursor moved since the last time this was asked?
+ *
+ * Deliberately exact rather than a tolerance: the question is whether the
+ * player touched the mouse at all, and any real movement crosses more than
+ * zero. A cursor resting untouched answers qfalse forever, which is the
+ * whole point - keyboard focus then survives every key press.
+ *
+ * The first call answers qtrue, so a menu opened with the cursor already
+ * over something still picks that up once, exactly as it did before.
+ *
+ * @param[in] x
+ * @param[in] y
+ * @return qtrue when the cursor is somewhere new
+ */
+static qboolean ETA_MenuCursorMoved(float x, float y)
+{
+	static qboolean seen = qfalse;
+	static float    lastX, lastY;
+
+	if (seen && lastX == x && lastY == y)
+	{
+		return qfalse;
+	}
+
+	seen  = qtrue;
+	lastX = x;
+	lastY = y;
+
+	return qtrue;
+}
+#endif
