diff --git a/src/cgame/cg_consolecmds.c b/src/cgame/cg_consolecmds.c
index 9012823..b471cb2 100644
--- a/src/cgame/cg_consolecmds.c
+++ b/src/cgame/cg_consolecmds.c
@@ -1587,6 +1587,24 @@ static void CG_AccessibilityMarkerWhere_f(void)
 	CG_AccessibilityMarkerWhere();
 }
 
+/*
+ * Shift+N's turn toward the marker. The tester heard "Facing the way" and
+ * was not turned: the words were said as the turn began, whether or not
+ * it went anywhere, and the turn began with Shift still held. So it now
+ * waits for Shift to be let go (pending), and the words come once the
+ * turn has landed, from where the view really is (speak).
+ */
+static struct
+{
+	qboolean pending;
+	int      pendingAt;
+	qboolean speak;
+	int      meters;
+} eta_face;
+
+#define ETA_FACE_SHIFT_WAIT_MS 1500   /* Shift still held after this: turned anyway */
+#define ETA_FACE_LANDED_DEGREES 15.0f
+
 /*
  * Shift+N: turned toward the way to the marker, as O turns the player in
  * the RTCW mode - round the walls, where the ping is - and how far it is.
@@ -1616,8 +1634,14 @@ static void CG_AccessibilityMarkerFace_f(void)
 	target.entityNum = -1;
 	VectorCopy(point, target.point);
 	target.point[2] = cg.predictedPlayerState.origin[2] + cg.predictedPlayerState.viewheight;
+	if (meters <= 1)
+	{
+		ETA_Speech_Say("Facing the marker, here");
+		return;
+	}
 	ETA_AimStartSnap(&target, NULL);
-	ETA_Speech_Say(meters <= 1 ? "Facing the marker, here" : va("Facing the way. %d meters to marker", meters));
+	eta_face.speak  = qtrue;
+	eta_face.meters = meters;
 }
 
 static void CG_TimerReset_f(void);
@@ -1631,7 +1655,9 @@ static void CG_AccessibilityTimerReset_f(void)
 {
 	if (trap_Key_IsDown(K_LSHIFT) || trap_Key_IsDown(K_RSHIFT))
 	{
-		CG_AccessibilityMarkerFace_f();
+		/* Turned once Shift is let go: see eta_face. */
+		eta_face.pending   = qtrue;
+		eta_face.pendingAt = cg.time;
 		return;
 	}
 	CG_TimerReset_f();
@@ -2045,6 +2071,7 @@ static void ETA_AimKeys(int yaw, int pitch)
 
 static void ETA_AimStop(void)
 {
+	eta_face.speak = qfalse;
 	ETA_AimKeys(0, 0);
 	ETA_TurnBoost(qfalse);
 	eta_aim.mode      = ETA_AIM_NONE;
@@ -3241,6 +3268,15 @@ void CG_AccessibilityAimFrame(void)
 		return;
 	}
 
+	/* Shift+N, once Shift is up. */
+	if (eta_face.pending
+	    && (!( trap_Key_IsDown(K_LSHIFT) || trap_Key_IsDown(K_RSHIFT) )
+	        || cg.time - eta_face.pendingAt > ETA_FACE_SHIFT_WAIT_MS || cg.time < eta_face.pendingAt))
+	{
+		eta_face.pending = qfalse;
+		CG_AccessibilityMarkerFace_f();
+	}
+
 	ETA_UniformFrame();
 
 	/* A use pressed on arrival lets go a moment later, if the player's
@@ -3299,6 +3335,22 @@ void CG_AccessibilityAimFrame(void)
 			qboolean use  = eta_use.pending;
 			int      body = eta_aim.entityNum;
 
+			/* Shift+N's words, from where the view has landed. */
+			if (eta_face.speak)
+			{
+				vec3_t toward;
+				float  off;
+
+				VectorSubtract(eta_aim.point, cg.predictedPlayerState.origin, toward);
+				off = fabsf(AngleSubtract(vectoyaw(toward), cg.predictedPlayerState.viewangles[YAW]));
+				ETA_Speech_Say(off <= ETA_FACE_LANDED_DEGREES
+				               ? va("Facing the way. %d meters to marker", eta_face.meters)
+				               : va("Could not turn all the way: the way to the marker is %s, %d meters",
+				                    ETA_HudNarrator_RelativeDirection(CG_AccessibilityLeftOfView(eta_aim.point)),
+				                    eta_face.meters));
+				eta_face.speak = qfalse;
+			}
+
 			/* Something on the ground across the line would be what is
 			   used: aim a little higher over it, and failing that, say
 			   so rather than pick it up. */
