+/**
+ * @brief What the player would say if asked where they are.
+ *
+ * ET already answers this for everyone else, twice over. Most maps ship
+ * a file of named places - "Old City Wall", "Axis Command Post" - and
+ * CG_GetLocationMsg picks the nearest one that is actually in view.
+ * Maps without that file still have the command map's lettered grid.
+ * Between them there is always an answer, and on either path it is the
+ * same wording a sighted teammate reads off their own screen, which is
+ * the point: saying "I am at the Old City Wall" has to mean something
+ * to the person hearing it.
+ *
+ * The colour codes come off because these names are authored for the
+ * screen and carry them - a screen reader would otherwise pronounce the
+ * markup.
+ *
+ * @return the place name, or NULL when the engine has no answer
+ */
+static const char *ETA_LocationName(void)
+{
+	static char name[96];
+	const char  *raw;
+
+	if (!cg.snap)
+	{
+		return NULL;
+	}
+
+	raw = CG_GetLocationMsg(cg.clientNum, cg.predictedPlayerState.origin);
+
+	if (raw && Q_stricmp(raw, "Unknown"))
+	{
+		Q_strncpyz(name, raw, sizeof(name));
+	}
+	else
+	{
+		/* No named place here. The grid square is what a sighted player
+		   would read off the command map, and every map has one. */
+		Com_sprintf(name, sizeof(name), "grid %s",
+		            BG_GetLocationString(cg.predictedPlayerState.origin[0],
+		                                 cg.predictedPlayerState.origin[1]));
+	}
+
+	Q_CleanStr(name);
+
+	return name[0] ? name : NULL;
+}
+
+/**
+ * @brief How far up to look for sky, in Quake units.
+ *
+ * Past the tallest indoor space in the stock maps, so a high hall does
+ * not read as open air, and short enough that the trace is cheap.
+ */
+#define ETA_OVERHEAD_PROBE 2048.0f
+
+/**
+ * @brief Whether there is sky directly overhead.
+ *
+ * Only ever reports what it measured. A trace that reaches sky proves
+ * open air; anything else proves only that something is above you, and
+ * that something might be a roof, a bridge, a tunnel or an awning. So
+ * this says "under cover" rather than "indoors" - the stronger word
+ * would be a guess wearing a fact's clothes.
+ *
+ * Worth having in its own right: an airstrike or a mortar round needs
+ * open sky to come through, so this is not scenery, it is whether half
+ * the game's ordnance can reach you.
+ */
+static ETA_Overhead ETA_OverheadState(void)
+{
+	trace_t trace;
+	vec3_t  start, end;
+
+	if (!cg.snap)
+	{
+		return ETA_OVERHEAD_UNKNOWN;
+	}
+
+	VectorCopy(cg.predictedPlayerState.origin, start);
+	start[2] += cg.predictedPlayerState.viewheight;
+
+	VectorCopy(start, end);
+	end[2] += ETA_OVERHEAD_PROBE;
+
+	CG_Trace(&trace, start, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SOLID);
+
+	if (trace.fraction == 1.0f || (trace.surfaceFlags & SURF_SKY))
+	{
+		return ETA_OVERHEAD_OPEN_SKY;
+	}
+
+	return ETA_OVERHEAD_COVERED;
+}
+
+/**
+ * @brief Says where the player is, once they have actually got there.
+ *
+ * The damping is the whole design. Oasis names 114 places and Radar
+ * 134, and a player crossing a courtyard passes through several of them
+ * at a walk - announcing each would be a voice that never stops and
+ * never says anything useful. The library holds a new place for two
+ * seconds before it counts as an arrival.
+ */
+static void ETA_NarrateLocation(void)
+{
+	const char *name;
+
+	if (!cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_locationCallouts.integer)
+	{
+		ETA_HudNarrator_ResetLocation();
+		return;
+	}
+
+	name = ETA_LocationName();
+
+	if (ETA_HudNarrator_UpdateLocation(name, cg.time))
+	{
+		ETA_Speech_BeginReport();
+		ETA_HudNarrator_SpeakLocation(name);
+		ETA_Speech_EndReport();
+	}
+}
+
+/**
+ * @brief Speaks where the player is, into an already-open report.
+ *
+ * The status key's job is to answer everything at once, so it does not
+ * wait for the two-second settle the passive announcement uses - being
+ * asked is itself the evidence that the player wants to know now.
+ */
+void CG_AccessibilitySpeakLocation(void)
+{
+	const char   *name = ETA_LocationName();
+	ETA_Overhead overhead = ETA_OverheadState();
+
+	if (name)
+	{
+		ETA_HudNarrator_SpeakLocation(name);
+	}
+
+	ETA_HudNarrator_SpeakOverhead(overhead);
+}
