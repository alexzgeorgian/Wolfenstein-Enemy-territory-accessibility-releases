+/**
+ * @brief How far from a square's middle still counts as being in it.
+ *
+ * A square is reached by walking into it anywhere, and its middle can be
+ * inside a building; the way there only has to get into the square.
+ */
+static float ETA_MarkerSquareRadius(void)
+{
+	vec2_t start, step;
+	int    columns, rows;
+
+	if (!ETA_MapGrid(start, step, &columns, &rows))
+	{
+		return 256.0f;
+	}
+
+	return 0.45f * MIN(step[0], step[1]);
+}
