diff --git a/src/cgame/cg_draw.c b/src/cgame/cg_draw.c
index be85c47..d23740d 100644
--- a/src/cgame/cg_draw.c
+++ b/src/cgame/cg_draw.c
@@ -6954,6 +6954,36 @@ static void ETA_NarrateConsole(void)
 	ETA_Speech_EndReport();
 }
 
+/**
+ * @brief Says, a moment into a match the player hosts, why bots did not
+ *        come.
+ *
+ * The menus find it as Start Server is pressed (on a Mac: no bots file,
+ * one from another version, or no Omni-bot) but cannot say it then: the
+ * loading screen's speech talks over it. So it waits in eta_botsProblem
+ * and is said here, once the map is up, and then forgotten.
+ */
+static void ETA_SayBotsProblem(void)
+{
+	char problem[MAX_CVAR_VALUE_STRING];
+
+	if (!cg.snap || cg.time < cgs.levelStartTime + 3000)
+	{
+		return;
+	}
+
+	trap_Cvar_VariableStringBuffer("eta_botsProblem", problem, sizeof(problem));
+	if (!problem[0])
+	{
+		return;
+	}
+	trap_Cvar_Set("eta_botsProblem", "");
+
+	ETA_Speech_BeginReport();
+	ETA_Speech_Say(problem);
+	ETA_Speech_EndReport();
+}
+
 /**
  * @brief How near a ladder has to be to be said, and to be climbed with
  *        the use key: two metres, a couple of steps.
@@ -10785,6 +10815,9 @@ void CG_DrawActive()
 	/* The console opening over the match, or closing. */
 	ETA_NarrateConsole();
 
+	/* Why a hosted match has no bots, once it is up. */
+	ETA_SayBotsProblem();
+
 	/* Every active frame, so a weapon change is caught wherever it came
 	   from - a number key, the mouse wheel, running dry, or being handed a
 	   weapon on spawn. */
