+/* Where the marker is, then the turn toward the way to it: the tester
+   uses one key for both. */
+static void ETA_MarkerWhereAndFace(void)
+{
+	vec3_t point;
+	int    meters;
+
+	if (CG_AccessibilityMarkerFacePoint(point, &meters) && meters > 1)
+	{
+		ETA_HudNarrator_HoldPassive(cg.time);
+		CG_AccessibilityMarkerWhereBrief();
+		CG_AccessibilityMarkerFace_f();
+		eta_face.brief = eta_face.speak;
+		return;
+	}
+	CG_AccessibilityMarkerFace_f();
+}
