-	   That lift is the whole fix: it is what the engine gives the player
-	   to get up a stair, so anything that fits under it is not an
-	   obstacle to them and must not be announced as one. */
+	   That lift is what lets a stair riser pass underneath, exactly as
+	   the player's feet do. */
 	VectorCopy(ps->mins, mins);
 	VectorCopy(ps->maxs, maxs);
 	mins[2] += ETA_DROP_STEP_UNITS;
@@ -3457,7 +3509,7 @@ static void ETA_NarrateObstacleAhead(void)
