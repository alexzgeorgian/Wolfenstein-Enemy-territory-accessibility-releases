-		{ K_F8, "accessibilityStopSpeech", NULL            },
-		{ '9',  "accessibilityHealth",     "weaponbank 9"  },
-		{ '0',  "accessibilityAmmo",       "weaponbank 10" }
+		{ K_F5,       "accessibilityStatus",     NULL            },
+		{ K_F6,       "accessibilityRepeat",     NULL            },
+		{ K_F8,       "accessibilityStopSpeech", NULL            },
+		{ '9',        "accessibilityHealth",     "weaponbank 9"  },
+		{ '0',        "accessibilityAmmo",       "weaponbank 10" },
