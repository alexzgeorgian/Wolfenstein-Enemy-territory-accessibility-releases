 			// set timelimit
@@ -9221,6 +9291,7 @@ void UI_Init(int etLegacyClient, int clientVersion)
 	ETA_AccessibilityRuntime_Init();
 	ETA_MenuNarrator_Init();
 	UI_AccessibilityInstallBinds();
+	UI_AccessibilityRegisterHostCvars();
 #endif
