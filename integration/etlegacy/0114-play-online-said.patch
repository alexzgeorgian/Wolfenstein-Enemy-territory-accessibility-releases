+/**
+ * @brief Controls the game draws with no words of their own.
+ *
+ * The server browser's filters are a row of three-way boxes beside
+ * small icons - a padlock, a crossed-out gun - and the server name box
+ * is drawn under a picture too. On screen the icon is the label; to a
+ * screen reader there was nothing, so arrowing past the name box went
+ * silent and stayed silent through all nine filters. Each gets a name
+ * here, from what its own tooltip says it does.
+ */
+static const struct
+{
+	const char *cvar;
+	const char *label;
+} eta_unlabelled[] =
+{
+	{ "ui_browserServerNameFilterCheckBox", "Server name filter"         },
+	{ "ui_browserMapFilter",                "Server name to filter by"   },
+	{ "ui_browserShowEmptyOrFull",          "Empty or full servers"      },
+	{ "ui_browserShowPasswordProtected",    "Password protected servers" },
+	{ "ui_browserShowFriendlyFire",         "Friendly fire"              },
+	{ "ui_browserShowMaxlives",             "Max lives"                  },
+	{ "ui_browserShowWeaponsRestricted",    "Weapon limits"              },
+	{ "ui_browserShowAntilag",              "Anti-lag"                   },
+	{ "ui_browserShowTeamBalanced",         "Team balance"               },
+	{ "ui_browserShowHumans",               "Human players"              },
+};
+
+/* Set by the ui module: a fuller line for a row of a list it feeds - a
+   server's name, map, players and what its icons show - than the
+   columns on screen give. NULL in the cgame. */
+const char *(*ETA_FeederRowText)(int feederID, int index) = NULL;
+
+/**
+ * @brief What a control is called when spoken: its text, or the name
+ *        given above, or for a list what it lists. May be NULL.
+ */
+const char *ETA_MenuItem_Label(itemDef_t *item)
+{
+	size_t i;
+
+	if (!item)
+	{
+		return NULL;
+	}
+	if (item->text && item->text[0])
+	{
+		return item->text;
+	}
+	if (item->cvar)
+	{
+		for (i = 0; i < ARRAY_LEN(eta_unlabelled); i++)
+		{
+			if (!Q_stricmp(item->cvar, eta_unlabelled[i].cvar))
+			{
+				return eta_unlabelled[i].label;
+			}
+		}
+	}
+	if (item->type == ITEM_TYPE_LISTBOX)
+	{
+		switch (item->special)
+		{
+		case FEEDER_SERVERS:
+			return "Server list";
+		case FEEDER_SERVERSTATUS:
+			return "Server details";
+		default:
+			return "List";
+		}
+	}
+	return NULL;
+}
+
+/* The same, never NULL: what a change of value is said against. */
+static const char *ETA_MenuItem_SpokenLabel(itemDef_t *item)
+{
+	const char *label = ETA_MenuItem_Label(item);
+
+	return label ? label : "Control";
+}
+
+/**
+ * @brief One row of a list, as said: the row's columns, or the fuller
+ *        line the ui gives for it, then where it is in the list.
+ *
+ * The lists were silent: arrowing through the servers, the changelog's
+ * files or a server's details said nothing at all, so a list was only
+ * any use to someone who could see it.
+ *
+ * @param[in] item a list box
+ * @param[out] out
+ * @param[in] outSize
+ * @return qfalse when the list is empty
+ */
+static qboolean ETA_ListBoxRowText(itemDef_t *item, char *out, size_t outSize)
+{
+	listBoxDef_t *listPtr = (listBoxDef_t *)item->typeData;
+	int          count    = DC->feederCount(item->special);
+	int          index    = item->cursorPos;
+	const char   *custom;
+	char         cell[256];
+
+	out[0] = '\0';
+	if (count <= 0)
+	{
+		return qfalse;
+	}
+	if (index < 0 || index >= count)
+	{
+		index = 0;
+	}
+
+	custom = ETA_FeederRowText ? ETA_FeederRowText(item->special, index) : NULL;
+	if (custom && custom[0])
+	{
+		Q_strncpyz(out, custom, outSize);
+	}
+	else
+	{
+		int columns = (listPtr && listPtr->numColumns > 0) ? listPtr->numColumns : 1;
+		int j;
+
+		for (j = 0; j < columns; j++)
+		{
+			qhandle_t  images[MAX_LB_COLUMNS];
+			int        numImages = 0;
+			const char *text     = DC->feederItemText(item->special, index, j, images, &numImages);
+
+			if (!text || !text[0])
+			{
+				continue;
+			}
+			Q_strncpyz(cell, text, sizeof(cell));
+			Q_CleanStr(cell);
+			if (!cell[0])
+			{
+				continue;
+			}
+			if (out[0])
+			{
+				Q_strcat(out, outSize, ", ");
+			}
+			Q_strcat(out, outSize, cell);
+		}
+	}
+
+	Q_strcat(out, outSize, va(", %i of %i", index + 1, count));
+	return qtrue;
+}
+
+/**
+ * @brief Says the row a list is on, after the keyboard moved it.
+ * @param[in] item a list box
+ */
+void ETA_MenuItem_NarrateListRow(itemDef_t *item)
+{
+	char       row[ETA_MAX_MENU_TEXT_LENGTH];
+	menuDef_t  *parent;
+
+	if (!item || item->type != ITEM_TYPE_LISTBOX || !ETA_ListBoxRowText(item, row, sizeof(row)))
+	{
+		return;
+	}
+	parent = (menuDef_t *)item->parent;
+	ETA_MenuNarrator_OnFocusChanged(parent ? parent->window.name : NULL, row);
+}
