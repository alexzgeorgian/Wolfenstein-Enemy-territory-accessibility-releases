+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * @brief A server, as said when the server list is on it.
+ *
+ * The list on screen is five columns and a row of small icons - a
+ * padlock for a password, crossed guns for friendly fire, and the rest -
+ * and none of it was said. This is the row in words: name, map, game
+ * type, who is playing out of how many, the ping, and each icon it would
+ * show. A server that has not answered is said as such, by its address,
+ * as the screen shows it.
+ *
+ * @param[in] feederID
+ * @param[in] index
+ * @return the line, or NULL for any other list
+ */
+static const char *UI_AccessibilityFeederRow(int feederID, int index)
+{
+	static char row[512];
+	char        info[MAX_STRING_CHARS];
+	char        name[256];
+	const char  *type = NULL;
+	int         ping, game, clients, humans, maxclients, i;
+
+	if (feederID != FEEDER_SERVERS || index < 0 || index >= uiInfo.serverStatus.numDisplayServers)
+	{
+		return NULL;
+	}
+
+	trap_LAN_GetServerInfo(ui_netSource.integer, uiInfo.serverStatus.displayServers[index], info, sizeof(info));
+	ping = Q_atoi(Info_ValueForKey(info, "ping"));
+	if (ping <= 0)
+	{
+		Com_sprintf(row, sizeof(row), "%s, not answering yet", Info_ValueForKey(info, "addr"));
+		return row;
+	}
+
+	Q_strncpyz(name, Info_ValueForKey(info, "hostname"), sizeof(name));
+	Q_CleanStr(name);
+	Q_TrimStr(name);
+
+	game = Q_atoi(Info_ValueForKey(info, "gametype"));
+	for (i = 0; i < uiInfo.numGameTypes; i++)
+	{
+		if (uiInfo.gameTypes[i].gtEnum == game)
+		{
+			type = uiInfo.gameTypes[i].gameType;
+			break;
+		}
+	}
+
+	clients    = Q_atoi(Info_ValueForKey(info, "clients"));
+	humans     = Q_atoi(Info_ValueForKey(info, "humans"));
+	maxclients = Q_atoi(Info_ValueForKey(info, "sv_maxclients"));
+
+	Com_sprintf(row, sizeof(row), "%s, map %s, %s, ", name[0] ? name : Info_ValueForKey(info, "addr"),
+	            Info_ValueForKey(info, "mapname"), type ? type : "unknown game type");
+
+	/* Only an ET: Legacy server tells humans from bots. */
+	if (strstr(Info_ValueForKey(info, "version"), PRODUCT_LABEL) && clients > humans)
+	{
+		Q_strcat(row, sizeof(row), va("%i %s and %i %s of %i, ", humans, humans == 1 ? "player" : "players",
+		                              clients - humans, clients - humans == 1 ? "bot" : "bots", maxclients));
+	}
+	else
+	{
+		Q_strcat(row, sizeof(row), va("%i of %i players, ", clients, maxclients));
+	}
+	Q_strcat(row, sizeof(row), va("ping %i", ping));
+
+	/* The icons, in the order the screen draws them. */
+	if (Q_atoi(Info_ValueForKey(info, "needpass")))
+	{
+		Q_strcat(row, sizeof(row), ", password");
+	}
+	if (Q_atoi(Info_ValueForKey(info, "friendlyFire")))
+	{
+		Q_strcat(row, sizeof(row), ", friendly fire");
+	}
+	if (Q_atoi(Info_ValueForKey(info, "maxlives")))
+	{
+		Q_strcat(row, sizeof(row), ", max lives");
+	}
+	if (Q_atoi(Info_ValueForKey(info, "weaprestrict")) != 100)
+	{
+		Q_strcat(row, sizeof(row), ", weapon limits");
+	}
+	if (Q_atoi(Info_ValueForKey(info, "g_antilag")))
+	{
+		Q_strcat(row, sizeof(row), ", anti-lag");
+	}
+	if (Q_atoi(Info_ValueForKey(info, "balancedteams")))
+	{
+		Q_strcat(row, sizeof(row), ", balanced teams");
+	}
+	return row;
+}
