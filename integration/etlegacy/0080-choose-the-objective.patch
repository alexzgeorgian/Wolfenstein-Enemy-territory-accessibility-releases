@@ -3696,7 +3755,27 @@ void CG_AccessibilityMarkerPlace(void)
  * The marker goes on the floor under the objective's point, where the
  * player will stand: the point itself is the middle of the objective's
  * trigger, often a metre or more up, where nobody can stand.
+ *
+ * The first press takes the current objective - the one the map says is
+ * next. But that is not always where a player means to go: a command
+ * post to build, a gun nest to defend, the cabinets to restock at. So
+ * pressing again within a few seconds moves the marker to the next
+ * objective on the team's command map, nearest first, and round again:
+ * "Marker on Garrison MG Nest, 3 of 7". The list is taken at the first
+ * press and kept while the presses come, so walking a step between them
+ * does not shuffle it.
  */
+#define ETA_MARKER_OBJECTIVES      24
+#define ETA_MARKER_CYCLE_MS        5000
+
+static struct
+{
+	int lastPress;
+	int index;
+	int count;
+	int entityNums[ETA_MARKER_OBJECTIVES];
+} eta_objectiveCycle;
