 #ifdef FEATURE_ACCESSIBILITY
 oidInfo_t *CG_MainObjectiveForTeam(team_t team);
+
+/**
+ * Quake units to meters, for the accessibility navigation system's
+ * distance/movement APIs (which work in real-world meters). Neither this
+ * engine nor the original id Software GPL release defines an authoritative
+ * units-per-meter constant anywhere; this uses id Tech 3's commonly cited
+ * external convention of 1 Quake unit = 1 inch (0.0254 m), not a value
+ * verified against this codebase.
+ */
+#define ETA_QU_TO_METERS 0.0254f
 #endif
 
 void CG_ForceTapOut_f(void);
