 /**
@@ -259,6 +260,10 @@ void CG_Respawn(qboolean revived)
 
 	// clear medic/ammo request voice chat sprites
 	CG_ResetVoiceSprites(revived);
+
+#ifdef FEATURE_ACCESSIBILITY
