diff --git a/src/cgame/cg_servercmds.c b/src/cgame/cg_servercmds.c
index 5eb2ede..2205158 100644
--- a/src/cgame/cg_servercmds.c
+++ b/src/cgame/cg_servercmds.c
@@ -38,6 +38,275 @@
 
 #include "cg_local.h"
 
+#ifdef FEATURE_ACCESSIBILITY
+#include "speech/speech_manager.h"
+#include "hud/hud_narrator.h"
+
+/**
+ * @brief The scoreboard, the player stats and the top shots, said.
+ *
+ * All three are windows a sighted player holds a key to look at, and all
+ * three were silent. Their contents arrive from the server a moment
+ * after the key is pressed - the key sends the request - so each is
+ * spoken when its answer arrives, from the raw numbers rather than from
+ * the columns the window draws, which only line up for the eye. A press
+ * inside the game's own two-second window reuses what it already has and
+ * is spoken at once.
+ *
+ * A report is capped by the speech layer, and a part that does not fit
+ * is dropped whole; so each is ordered with what matters first.
+ */
+/* When each was asked for, or 0. An answer is spoken only if it comes
+   within ETA_ANSWER_WAIT_MS of the key: a reply that never came - a demo,
+   a dropped packet - must not make the board speak out of nowhere the
+   next time the server happens to send scores. */
+static int eta_scoresPending   = 0;
+static int eta_statsPending    = 0;
+static int eta_topshotsPending = 0;
+
+#define ETA_ANSWER_WAIT_MS 3000
+
+static qboolean eta_scoresReady = qfalse;
+
+static qboolean ETA_AnswerDue(int *pendingSince)
+{
+	qboolean due = (qboolean)(*pendingSince && cg.time - *pendingSince >= 0
+	                          && cg.time - *pendingSince < ETA_ANSWER_WAIT_MS);
+
+	*pendingSince = 0;
+	return due;
+}
+
+#define ETA_REPORT_PARTS 40
+#define ETA_REPORT_PART  96
+
+typedef struct
+{
+	char text[ETA_REPORT_PARTS][ETA_REPORT_PART];
+	int  count;
+} eta_report_t;
+
+static eta_report_t eta_statsReport;
+static eta_report_t eta_topshotsReport;
+static eta_report_t eta_weaponsReport;
+
+static void ETA_ReportAdd(eta_report_t *report, const char *text)
+{
+	if (report->count < ETA_REPORT_PARTS)
+	{
+		Q_strncpyz(report->text[report->count++], text, ETA_REPORT_PART);
+	}
+}
+
+static void ETA_ReportSpeak(const eta_report_t *report)
+{
+	int i;
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_BeginReport();
+	for (i = 0; i < report->count; i++)
+	{
+		ETA_Speech_Say(report->text[i]);
+	}
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief A weapon's name as a person would say it.
+ *
+ * The stats table abbreviates to fit a column - "F.Thrower", "Scp.K43" -
+ * which a screen reader reads out letter by letter or as "dot".
+ */
+static const char *ETA_StatsWeaponName(int weapon)
+{
+	switch (weapon)
+	{
+	case WS_FLAMETHROWER:
+		return "Flamethrower";
+	case WS_MORTAR2:
+		return "Granatwerfer";
+	case WS_GRENADELAUNCHER:
+		return "Grenade launcher";
+	case WS_MG42:
+		return "MG 42";
+	case WS_GARAND:
+		return "Scoped Garand";
+	case WS_K43:
+		return "Scoped K43";
+	default:
+		return aWeaponInfo[weapon].pszName;
+	}
+}
+
+static int ETA_Percent(float value)
+{
+	return (int)(value + 0.5f);
+}
+
+/**
+ * @brief The scoreboard, most useful first.
+ *
+ * The time, then each team's size and XP, then where the player stands on
+ * their own team - the thing a glance at the board is usually for - and
+ * then every name with its XP, the player's own team first. The players
+ * are sorted here rather than trusted to arrive sorted.
+ */
+static void ETA_SpeakScores(void)
+{
+	team_t mine = cgs.clientinfo[cg.clientNum].team;
+	team_t order[2];
+	int    members[2][MAX_CLIENTS];
+	int    counts[2] = { 0, 0 };
+	int    totals[2] = { 0, 0 };
+	int    t, i, j;
+
+	if (mine == TEAM_AXIS)
+	{
+		order[0] = TEAM_AXIS;
+		order[1] = TEAM_ALLIES;
+	}
+	else
+	{
+		order[0] = TEAM_ALLIES;
+		order[1] = TEAM_AXIS;
+	}
+
+	for (t = 0; t < 2; t++)
+	{
+		for (i = 0; i < cg.numScores && i < MAX_CLIENTS; i++)
+		{
+			if (cg.scores[i].team != order[t])
+			{
+				continue;
+			}
+
+			/* Insertion by XP, highest first. */
+			for (j = counts[t]; j > 0 && cg.scores[members[t][j - 1]].score < cg.scores[i].score; j--)
+			{
+				members[t][j] = members[t][j - 1];
+			}
+			members[t][j] = i;
+			counts[t]++;
+			totals[t] += cg.scores[i].score;
+		}
+	}
+
+	ETA_HudNarrator_HoldPassive(cg.time);
+	ETA_Speech_BeginReport();
+
+	if (cgs.gamestate == GS_PLAYING && cgs.timelimit > 0.0f)
+	{
+		int msec = (int)(cgs.timelimit * 60000.f) - (cg.time - cgs.levelStartTime);
+
+		if (msec < 0)
+		{
+			ETA_Speech_Say("Sudden death");
+		}
+		else
+		{
+			int seconds = msec / 1000;
+
+			ETA_Speech_Say(va("%d minutes %d seconds left", seconds / 60, seconds % 60));
+		}
+	}
+	else if (cgs.gamestate == GS_WARMUP || cgs.gamestate == GS_WARMUP_COUNTDOWN)
+	{
+		ETA_Speech_Say("Warmup");
+	}
+	else if (cgs.gamestate == GS_INTERMISSION)
+	{
+		ETA_Speech_Say("Match over");
+	}
+
+	for (t = 0; t < 2; t++)
+	{
+		ETA_Speech_Say(va("%s, %d %s, %d XP", order[t] == TEAM_AXIS ? "Axis" : "Allies",
+		                  counts[t], counts[t] == 1 ? "player" : "players", totals[t]));
+	}
+
+	if (mine == TEAM_AXIS || mine == TEAM_ALLIES)
+	{
+		for (j = 0; j < counts[0]; j++)
+		{
+			if (cg.scores[members[0][j]].client == cg.clientNum)
+			{
+				ETA_Speech_Say(va("you are %d of %d, %d XP", j + 1, counts[0],
+				                  cg.scores[members[0][j]].score));
+				break;
+			}
+		}
+	}
+
+	for (t = 0; t < 2; t++)
+	{
+		if (counts[t] == 0)
+		{
+			continue;
+		}
+
+		ETA_Speech_Say(order[t] == TEAM_AXIS ? "Axis" : "Allies");
+
+		for (j = 0; j < counts[t]; j++)
+		{
+			const score_t *sc = &cg.scores[members[t][j]];
+
+			ETA_Speech_Say(va("%s %d", cgs.clientinfo[sc->client].cleanname, sc->score));
+		}
+	}
+
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Every frame: speaks a scoreboard that arrived last frame.
+ */
+void CG_AccessibilityScoresFrame(void)
+{
+	if (eta_scoresReady)
+	{
+		eta_scoresReady = qfalse;
+		ETA_SpeakScores();
+	}
+}
+
+/**
+ * @brief The scoreboard key was pressed. requested is qtrue when fresh
+ * scores were asked for, so the answer is spoken when it arrives.
+ */
+void CG_AccessibilityScoresPressed(qboolean requested)
+{
+	if (requested || cg.numScores <= 0)
+	{
+		eta_scoresPending = cg.time | 1;
+		return;
+	}
+
+	ETA_SpeakScores();
+}
+
+void CG_AccessibilityStatsPressed(qboolean requested)
+{
+	if (requested || eta_statsReport.count == 0)
+	{
+		eta_statsPending = cg.time | 1;
+		return;
+	}
+
+	ETA_ReportSpeak(&eta_statsReport);
+}
+
+void CG_AccessibilityTopshotsPressed(qboolean requested)
+{
+	if (requested || eta_topshotsReport.count == 0)
+	{
+		eta_topshotsPending = cg.time | 1;
+		return;
+	}
+
+	ETA_ReportSpeak(&eta_topshotsReport);
+}
+#endif
+
 #ifdef FEATURE_RATING
 static void CG_ParseSkillRating(int version)
 {
@@ -122,6 +391,19 @@ static void CG_ParseScore(team_t team)
 			cgs.dbLastScoreReceived = qtrue;
 		}
 	}
+
+#ifdef FEATURE_ACCESSIBILITY
+	/* Not spoken here. "sc0" and "sc1" are not the two teams: the server
+	   packs as many players as fit into sc0 and sends sc1 only for the
+	   rest (G_SendScore), so after sc0 alone the board may be whole or
+	   half. Both are sent in the same server frame and so parsed in the
+	   same client frame - so the board is whole by the next one, and
+	   CG_AccessibilityScoresFrame speaks it there. */
+	if (ETA_AnswerDue(&eta_scoresPending))
+	{
+		eta_scoresReady = qtrue;
+	}
+#endif
 }
 
