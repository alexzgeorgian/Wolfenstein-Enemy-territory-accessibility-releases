+	ETA_Speech_Say(va("The match you host limits each team to %i %s. As its host, the limit is lifted, and you join again",
+	                  limit, limit == 1 ? "player" : "players"));
+}
+
+/* Every frame: the join sent again, once the match has the limit lifted. */
+void CG_AccessibilityTeamFullFrame(void)
+{
+	if (!eta_teamFullRetryAt || cg.time < eta_teamFullRetryAt - 5000)
+	{
+		eta_teamFullRetryAt = 0;
+		return;
+	}
+	if (cg.time < eta_teamFullRetryAt)
+	{
+		return;
+	}
+	eta_teamFullRetryAt = 0;
+	CG_LimboPanel_SendSetupMsg(qtrue);
+}
 #endif
 
