+/* Players on a team as the menu counts them: everyone else on it, bots
+   too. */
+static int ETA_LimboPanel_TeamPlayers(team_t team)
+{
+	int i, count = 0;
+
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		if (i != cg.clientNum && cgs.clientinfo[i].infoValid && cgs.clientinfo[i].team == team)
+		{
+			count++;
+		}
+	}
+	return count;
+}
+
+/*
+ * Why the menu calls a team closed, with its numbers; NULL when it does
+ * not. On a Mac hosting with bots the tester heard "Axis, full", though
+ * they had fewer bots than before and the team limit raised, and Allies
+ * let them in: "full" was the menu's one word for three different checks.
+ */
+static const char *ETA_LimboPanel_TeamRefusal(team_t team)
+{
+	const char *name = team == TEAM_AXIS ? "Axis" : "Allies";
+
+	if (team != TEAM_AXIS && team != TEAM_ALLIES)
+	{
+		return NULL;
+	}
+	if (cgs.clientinfo[cg.clientNum].shoutcaster)
+	{
+		return "a shoutcaster joins no team";
+	}
+	if (CG_LimboPanel_TeamIsFull(team))
+	{
+		return va("%s has %i players, and this match allows %i a team", name, ETA_LimboPanel_TeamPlayers(team), cg.maxPlayers);
+	}
+	if (CG_LimboPanel_FindFreeClass(team) == -1)
+	{
+		return va("every %s class is at the match's limit for it", name);
+	}
+	return NULL;
+}
