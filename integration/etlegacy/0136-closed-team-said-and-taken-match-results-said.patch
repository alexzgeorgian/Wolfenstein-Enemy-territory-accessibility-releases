+#ifdef FEATURE_ACCESSIBILITY
+/*
+ * The end of the match, said: the results screen was only drawn. The
+ * tester, hearing server messages read, asked for the results too. Who
+ * won, where the player came, and the best three, by experience points
+ * as the screen orders them; once each match end, when the scores have
+ * come in.
+ */
+static void ETA_Debriefing_Say(void)
+{
+	static int saidFor = -1;
+	const char *s, *buf, *winner;
+	int        order[MAX_CLIENTS], count = 0, i, j, me = -1;
+	char       top[512];
+
+	if (saidFor == cgs.intermissionStartTime || cg.time - cgs.intermissionStartTime < 1500 || cg.numScores <= 0)
+	{
+		return;
+	}
+	saidFor = cgs.intermissionStartTime;
+
+	if (cg_gameType.integer == GT_WOLF_STOPWATCH)
+	{
+		winner = cgs.currentRound ? "First round over" : "Match over";
+	}
+	else
+	{
+		s      = CG_ConfigString(CS_MULTI_MAPWINNER);
+		buf    = Info_ValueForKey(s, "w");
+		winner = atoi(buf) == -1 ? "Match over: a tie" : atoi(buf) ? "Match over: Allies win" : "Match over: Axis win";
+	}
+
+	for (i = 0; i < cgs.maxclients && i < MAX_CLIENTS; i++)
+	{
+		if (cgs.clientinfo[i].infoValid && cgs.clientinfo[i].team != TEAM_SPECTATOR)
+		{
+			order[count++] = i;
+		}
+	}
+	for (i = 1; i < count; i++)
+	{
+		int c = order[i];
+
+		for (j = i; j > 0 && cgs.clientinfo[order[j - 1]].score < cgs.clientinfo[c].score; j--)
+		{
+			order[j] = order[j - 1];
+		}
+		order[j] = c;
+	}
+
+	top[0] = 0;
+	for (i = 0; i < count; i++)
+	{
+		char name[MAX_QPATH];
+
+		if (order[i] == cg.clientNum)
+		{
+			me = i;
+		}
+		if (i < 3)
+		{
+			Q_strncpyz(name, cgs.clientinfo[order[i]].name, sizeof(name));
+			Q_CleanStr(name);
+			Q_strcat(top, sizeof(top), va("%s%i, %s, %i XP", i ? "; " : "", i + 1, name, cgs.clientinfo[order[i]].score));
+		}
+	}
+
+	{
+		char mine[96] = "";
+		char said[768];
+
+		if (me >= 0)
+		{
+			Com_sprintf(mine, sizeof(mine), "You came %i of %i, with %i XP. ", me + 1, count, cgs.clientinfo[cg.clientNum].score);
+		}
+		Com_sprintf(said, sizeof(said), "%s. %sBest: %s. Next map in about %i seconds", winner, mine, top[0] ? top : "nobody",
+		            MAX(60 - (cg.time - cgs.intermissionStartTime) / 1000, 0));
+		ETA_Speech_Say(said);
+	}
+}
+#endif
