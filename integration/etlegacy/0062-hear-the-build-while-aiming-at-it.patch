+/**
+ * @brief How far from the player a construction they are working on can be.
+ *
+ * The trigger a player stands in to build is often wider than the thing
+ * being built, and the construction is a brush whose middle can be some
+ * way off. Sixteen metres covers the ones on the stock maps and is too
+ * short to reach across to another objective.
+ */
+#define ETA_BUILD_SEARCH_RANGE 640.0f
+
+/**
+ * @brief The progress of the nearest construction of the player's team.
+ *
+ * The cursor hint is one way the game says how a construction is going,
+ * and it goes quiet at exactly the wrong moment: G_CheckForCursorHints
+ * returns early, sending nothing, while the player's crosshair is on a
+ * partly built construction of their own team. A player who aims at the
+ * thing they are building - which the look keys now make the natural
+ * thing to do - heard "Pliers, build here" and then silence, because the
+ * hint stopped the moment the work began.
+ *
+ * The same number travels a second way: it is the construction's own
+ * angles2[0], which the server raises as the work goes on and which is
+ * in every snapshot the construction is in. That does not depend on
+ * where the player is looking.
+ *
+ * @return 0 to 255, or -1 when there is no construction of theirs under
+ *         way nearby
+ */
+static int ETA_NearbyConstructionProgress(int following, int *entityNum)
+{
+	const team_t team     = cgs.clientinfo[cg.clientNum].team;
+	float        nearest  = ETA_BUILD_SEARCH_RANGE;
+	int          progress = -1;
+	int          i;
+
+	for (i = 0; i < cg.snap->numEntities; i++)
+	{
+		const entityState_t *es = &cg.snap->entities[i];
+		vec3_t              origin;
+		float               distance;
+
+		if (es->eType != ET_CONSTRUCTIBLE || es->teamNum != team)
+		{
+			continue;
+		}
+
+		/* One under way, or the one already being followed - whose
+		   figure dropping to nothing is how it is heard to finish. A
+		   finished construction next door must not hide the one the
+		   player is working on. */
+		if (es->angles2[0] <= 0.f && es->number != following)
+		{
+			continue;
+		}
+
+		VectorCopy(cg_entities[es->number].lerpOrigin, origin);
+		if (es->modelindex > 0 && es->modelindex < MAX_MODELS)
+		{
+			VectorAdd(origin, cgs.inlineModelMidpoints[es->modelindex], origin);
+		}
+
+		distance = Distance(cg.predictedPlayerState.origin, origin);
+
+		if (distance < nearest)
+		{
+			nearest   = distance;
+			progress  = (int)es->angles2[0];
+			*entityNum = es->number;
+		}
+	}
+
+	return progress;
+}
