+/**
+ * @brief How loud the bump sounds play, played once each rather than
+ * looped: 127, the game's own level for a sound played once, at 100.
+ */
+int CG_AccessibilityBumpVolume(void)
+{
+	return (127 * ETA_VolumePercent(&eta_bumpVolume)) / 100;
+}
