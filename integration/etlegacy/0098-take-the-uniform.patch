+}
+
+/**
+ * @brief Taking an enemy's uniform: use held on the body until it is on.
+ *
+ * The game takes a uniform only for use held on the body for two and a
+ * half seconds; F pressed at it and let go a moment later, so a blind
+ * covert op never got one. So on arriving at a body F holds use for the
+ * player, until the uniform is taken, the body is gone, or
+ * ETA_UNIFORM_HOLD_MS have passed - and says which.
+ */
+static void ETA_UniformStart(int body)
+{
+	ETA_UseKey(qtrue);
+	eta_use.releaseAt = 0;
+	eta_use.body      = body;
+	eta_use.bodyUntil = cg.time + ETA_UNIFORM_HOLD_MS;
+	eta_use.disguised = (qboolean)(cg.predictedPlayerState.powerups[PW_OPS_DISGUISED] != 0);
+	ETA_Speech_Say("Taking the uniform");
+}
+
+static void ETA_UniformEnd(const char *text)
+{
+	ETA_UseKey(qfalse);
+	eta_use.bodyUntil = 0;
+	ETA_Speech_Say(text);
+}
+
+static void ETA_UniformFrame(void)
+{
+	const centity_t *cent;
+
+	if (!eta_use.bodyUntil)
+	{
+		return;
+	}
+
+	cent = (eta_use.body >= 0 && eta_use.body < MAX_GENTITIES) ? &cg_entities[eta_use.body] : NULL;
+
+	/* Taken: the body's uniform is marked gone - or, with two bodies
+	   close together, the player is in disguise who was not. */
+	if ((cent && cent->currentValid && cent->currentState.eType == ET_CORPSE && cent->currentState.time2 == 1)
+	    || (!eta_use.disguised && cg.predictedPlayerState.powerups[PW_OPS_DISGUISED]))
+	{
+		ETA_UniformEnd("Uniform taken, you are in disguise");
+		return;
+	}
+
+	/* The player down themselves: nothing to say about the uniform. */
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_UseKey(qfalse);
+		eta_use.bodyUntil = 0;
+		return;
+	}
+
+	if (!cent || !cent->currentValid || cent->currentState.eType != ET_CORPSE)
+	{
+		ETA_UniformEnd("The body is gone");
+		return;
+	}
+
+	if (cg.time >= eta_use.bodyUntil || eta_use.bodyUntil - cg.time > ETA_UNIFORM_HOLD_MS)
+	{
+		ETA_UniformEnd("No uniform taken. Walk right up to the body and press F again");
+	}
 }
 
