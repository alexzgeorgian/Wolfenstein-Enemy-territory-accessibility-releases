+/**
+ * @brief Puts the marker on the nearest sniper spot, or the next one.
+ *
+ * Pressed again within a few seconds, the next spot further off, as the
+ * objective key steps through the objectives. Each is said with what it
+ * looks out over - "Rooftop, sees 60 meters to the south-east, 6 meters
+ * up" - and the marker's sound then leads the way there, up the stairs
+ * or the ladder. Arriving says which way to look.
+ */
+void CG_AccessibilitySniperSpot(void)
+{
+	const ETA_Spot *spot;
+	char            text[128];
+	int             distance;
+	qboolean        cycling;
+
+	if (!cg.snap)
+	{
+		return;
+	}
+
+	ETA_Speech_BeginReport();
+
+	if (cg.predictedPlayerState.pm_type != PM_NORMAL)
+	{
+		ETA_Speech_Say("Only in play: spawn first, then ask for a sniper spot");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	cycling = (qboolean)(eta_spots.lastPress && cg.time >= eta_spots.lastPress
+	                     && cg.time - eta_spots.lastPress < ETA_MARKER_CYCLE_MS);
+
+	if (!cycling || eta_spots.count <= 0)
+	{
+		eta_spots.count = ETA_SpotList_Nearest(&eta_spots.list, cg.predictedPlayerState.origin,
+		                                       eta_spots.order, ETA_SPOT_MAX);
+		eta_spots.index = 0;
+	}
+	else
+	{
+		eta_spots.index = (eta_spots.index + 1) % eta_spots.count;
+	}
+
+	if (eta_spots.count <= 0)
+	{
+		eta_spots.lastPress = 0;
+		ETA_Speech_Say(eta_spots.done ? "No sniper spots found on this map"
+		                              : "Still looking over the map for sniper spots. Ask again in a moment");
+		ETA_Speech_EndReport();
+		return;
+	}
+
+	eta_spots.lastPress = cg.time;
+	eta_spots.marked    = eta_spots.order[eta_spots.index];
+	eta_spots.judged    = qfalse;
+	spot                = &eta_spots.list.spots[eta_spots.marked];
+
+	memset(&eta_marker, 0, sizeof(eta_marker));
+	eta_marker.objective = qtrue;
+	eta_marker.leftIt    = qtrue;
+	VectorCopy(spot->origin, eta_marker.origin);
+	Q_strncpyz(eta_marker.name, va("sniper spot, look %s", ETA_Spot_Compass(spot->rating.bearing)),
+	           sizeof(eta_marker.name));
+	eta_marker.active = qtrue;
+	ETA_RouteForget();
+	distance = ETA_MarkerDistance();
+	ETA_NavigationSystem_StartMarkerApproach(distance);
+
+	ETA_Spot_Text(spot->kind, &spot->rating, text, sizeof(text));
+	ETA_Speech_Say(va("Sniper spot %d of %d%s: %s", eta_spots.index + 1, eta_spots.count,
+	                  eta_spots.done ? "" : ", more still being looked for", text));
+	ETA_NavigationSystem_AnnounceMarkerDistance(distance);
+	ETA_NavigationSystem_AnnounceHeight((eta_marker.origin[2] - cg.predictedPlayerState.origin[2]) * ETA_QU_TO_METERS);
+	ETA_MarkerSpeakWay();
+	ETA_Speech_EndReport();
+}
+
+/**
+ * @brief Whether the way up to the sniper spot under the marker was found.
+ *
+ * A roof can look out a long way and have no way onto it at all: on
+ * Oasis about a third of the raised places that see far are the tops of
+ * walls and of houses nobody can climb. Looking for the way to every one
+ * of them is minutes of searching, so it is looked for only for the spot
+ * chosen - the search the marker makes anyway. When that search gives
+ * up right underneath the spot, there is no way up from here: the player
+ * is told, the marker taken away, and the spot left off the list.
+ */
+#define ETA_SPOT_UNDER_UNITS 320.0f   /* given up this close to it, flat: underneath */
+
+static void ETA_SpotJudgeWay(void)
+{
+	ETA_Spot *spot;
+	float     end[3];
+	int       points;
+
+	if (eta_spots.judged || eta_spots.marked < 0 || eta_spots.marked >= eta_spots.list.count
+	    || !eta_marker.active || !eta_route.jumps)
+	{
+		return;
+	}
+
+	spot = &eta_spots.list.spots[eta_spots.marked];
+	if (!VectorCompare(spot->origin, eta_marker.origin))
+	{
+		eta_spots.marked = -1;   /* the marker was put somewhere else */
+		return;
+	}
+
+	if (ETA_PathFinder_State() == ETA_PATH_FOUND)
+	{
+		eta_spots.judged = qtrue;
+		return;
+	}
+
+	points = ETA_PathFinder_PointCount();
+	if (ETA_PathFinder_State() != ETA_PATH_PARTIAL || points <= 0)
+	{
+		return;
+	}
+
+	eta_spots.judged = qtrue;
+	ETA_PathFinder_Point(points - 1, end);
+
+	if ((end[0] - spot->origin[0]) * (end[0] - spot->origin[0])
+	    + (end[1] - spot->origin[1]) * (end[1] - spot->origin[1]) < ETA_SPOT_UNDER_UNITS * ETA_SPOT_UNDER_UNITS
+	    && spot->origin[2] - end[2] > 64.0f)
+	{
+		spot->unreachable = 1;
+		eta_marker.active = qfalse;
+		ETA_RouteForget();
+		eta_spots.lastPress = 0;
+
+		ETA_Speech_BeginReport();
+		ETA_Speech_Say("No way up to that sniper spot from here. It is left off the list; ask for the next");
+		ETA_Speech_EndReport();
+	}
+}
