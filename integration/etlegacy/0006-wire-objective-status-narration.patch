+/**
+ * @brief CG_MainObjectiveNameForTeam
+ * Looks up the display name of a team's current main objective. The
+ * server publishes the objective's entity number in CS_MAIN_AXIS_OBJECTIVE
+ * / CS_MAIN_ALLIES_OBJECTIVE (see cg_draw_hud.c's ET_EXPLOSIVE_INDICATOR /
+ * ET_CONSTRUCTIBLE_INDICATOR handling, which resolves the same pair the
+ * same way for the on-screen objective icons); cgs.oidInfo[] is the
+ * matching array of parsed objective entities, populated from configstrings
+ * in cg_servercmds.c. Returns NULL if there's no current main objective or
+ * its oidInfo entry hasn't arrived yet.
+ * @param[in] team
+ * @return
+ */
+static const char *CG_MainObjectiveNameForTeam(team_t team)
+{
+	int entNum = Q_atoi(CG_ConfigString(team == TEAM_AXIS ? CS_MAIN_AXIS_OBJECTIVE : CS_MAIN_ALLIES_OBJECTIVE));
+	int i;
+
+	for (i = 0; i < MAX_OID_TRIGGERS; i++)
+	{
+		if (cgs.oidInfo[i].name[0] && cgs.oidInfo[i].entityNum == entNum)
+		{
+			return cgs.oidInfo[i].name;
+		}
+	}
+
+	return NULL;
+}
