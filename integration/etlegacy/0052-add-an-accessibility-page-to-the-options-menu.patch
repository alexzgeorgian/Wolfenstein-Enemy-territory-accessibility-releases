 		}
 	}
 
+#ifdef FEATURE_ACCESSIBILITY
+	/* The mod's own page, added after the game's own list rather than by
+	   shipping a copy of that list.
+
+	   ui/menus.txt names all eighty-odd menu files, so a copy of it in
+	   the mod's pk3 would shadow the real one and quietly freeze the set
+	   of menus at whatever the engine shipped the day this was written -
+	   a menu added upstream would simply stop loading, with nothing
+	   anywhere to say why. Parsing one extra file here adds a page and
+	   shadows nothing.
+
+	   A missing file is not an error worth failing over: UI_ParseMenu
+	   prints its own complaint, the rest of the menus are already loaded
+	   by this point, and a player whose pk3 is half-installed is better
+	   off with a game that runs. */
+	UI_ParseMenu("ui/options_accessibility.menu");
+	UI_ParseMenu("ui/options_controls_accessibility.menu");
+#endif
