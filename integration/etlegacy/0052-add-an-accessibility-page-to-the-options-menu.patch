@@ -6472,6 +6491,24 @@ void UI_RunMenuScript(char **args)
 		{
 			int ui_handedness = (int)(trap_Cvar_VariableValue("ui_handedness"));
 
+#ifdef FEATURE_ACCESSIBILITY
+			/* Resetting the controls execs the stock config, which binds
+			   every key the game ships with and drops every key it does
+			   not - including all of this mod's. Without what follows
+			   they are gone permanently: the installer records which
+			   generation of binds a player has been offered, and having
+			   offered them once it never offers them again, so a single
+			   press of DEFAULT would silently take the status key, the
+			   map survey and the look keys away for good.
+
+			   Forgetting which generation was offered is what makes them
+			   come back. The exec is queued rather than immediate, so
+			   the re-offer is queued behind it - doing it here and now
+			   would write binds that the config then overwrote. */
+			trap_Cvar_Set("eta_bindsInstalled", "0");
+			trap_Cmd_ExecuteText(EXEC_APPEND, "accessibilityInstallBinds\n");
+#endif
+
 			if (ui_handedness == 0)
 			{
 				// exec default.cfg
