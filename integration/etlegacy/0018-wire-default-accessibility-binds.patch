  * @param[in] etLegacyClient
@@ -8945,6 +9005,7 @@ void UI_Init(int etLegacyClient, int clientVersion)
 	   relying on cgame's. */
 	ETA_AccessibilityRuntime_Init();
 	ETA_MenuNarrator_Init();
+	UI_AccessibilityInstallBinds();
 #endif
