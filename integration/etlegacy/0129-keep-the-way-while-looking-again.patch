 static eta_route_t eta_route;
 
+/*
+ * The way being followed: the last one a search found, kept while the
+ * next search runs. A search for a far marker takes a while - on Oasis,
+ * the way from the Allied camp to the Old City Water Pump through the
+ * flooded caves took ten to twelve seconds - and the way is looked for
+ * again every five seconds and whenever the player strays. The search
+ * starts afresh each time, and the way was gone with it: for the whole
+ * search the ping pointed at the last point it had, the player walked on
+ * past it, and N turned them east, then west, then east again, round and
+ * round on the road outside the Old City wall. So the found way is
+ * copied here, followed while the next search runs, and replaced only
+ * when that search has an answer.
+ */
+static struct
+{
+	int           count;
+	ETA_PathState state;      /* the search it came from: found, or as near as it got */
+	int           search;     /* eta_route.searches when it was copied */
+	float         points[ETA_PATH_MAX_POINTS][3];
+	ETA_PathKind  kinds[ETA_PATH_MAX_POINTS];
+} eta_way;
+
+static int ETA_WayCount(void)
+{
+	return eta_way.count;
+}
+
+static void ETA_WayPoint(int index, float out[3])
+{
+	if (index < 0 || index >= eta_way.count)
+	{
+		out[0] = out[1] = out[2] = 0.0f;
+		return;
+	}
+	out[0] = eta_way.points[index][0];
+	out[1] = eta_way.points[index][1];
+	out[2] = eta_way.points[index][2];
+}
+
+static ETA_PathKind ETA_WayKind(int index)
+{
+	return index < 0 || index >= eta_way.count ? ETA_PATH_NONE : eta_way.kinds[index];
+}
+
+/* A search has its answer: it is the way from now on, followed from its
+   start. No way at all leaves none to follow. */
+static void ETA_WayTake(ETA_PathState state)
+{
+	int i, count = ETA_PathFinder_PointCount();
+
+	eta_way.search = eta_route.searches;
+	eta_way.state  = state;
+	eta_way.count  = (state == ETA_PATH_FOUND || state == ETA_PATH_PARTIAL) ? count : 0;
+	for (i = 0; i < eta_way.count; i++)
+	{
+		ETA_PathFinder_Point(i, eta_way.points[i]);
+		eta_way.kinds[i] = ETA_PathFinder_PointKind(i);
+	}
+	eta_route.along    = 0;
+	eta_route.saidJump = -1;
+	eta_route.done     = qfalse;
+}
