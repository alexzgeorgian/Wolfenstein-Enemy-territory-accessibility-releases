+
+			if ( nudged != current ) {
+				DC->setCVar( item->cvar, va( "%f", nudged ) );
+			}
+
+			/* Answered even when the value did not move, so the end of
+			   the range says itself rather than going silent. */
+			return qtrue;
+		}
+	}
+#endif
