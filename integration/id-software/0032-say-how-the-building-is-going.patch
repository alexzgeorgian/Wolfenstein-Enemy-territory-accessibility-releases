+/* Says how a construction is coming along while it is being built.
+
+   The tester finished a construction and said afterwards that they had
+   known to keep holding the key only because they remembered the bar
+   filling on screen. That bar is already arriving - the game sends a
+   constructible's progress as the value beside the cursor icon, the same
+   number the HUD draws - and nothing said it out loud once the work had
+   started. The interaction report speaks the figure once, when the icon
+   settles, and then goes quiet for the whole climb.
+
+   Milestones rather than a running count, for the reason the objective
+   distance uses them: a number that changes every frame is a voice that
+   never stops.
+
+   There is deliberately no "complete". The build routine sets the
+   progress back to zero the instant a construction finishes, so a value
+   that has dropped cannot be told from a player who let go of the key,
+   and announcing "built" over something still half standing is the kind
+   of confident wrongness this mod exists to avoid. */
+static void ETA_NarrateBuildProgress( qboolean active ) {
+	static qboolean building = qfalse;
+	int percent;
+
+	if ( !cg.snap || !eta_interactionCallouts.integer ) {
+		building = qfalse;
+		ETA_HudNarrator_ResetBuildProgress();
+		return;
+	}
+
+	if ( !active
+		 || ( cg.cursorHintIcon != HINT_BUILD && cg.cursorHintIcon != HINT_CONSTRUCTIBLE )
+		 || cg.cursorHintValue <= 0 ) {
+		/* Looking away starts the climb afresh, so coming back to a
+		   part-built construction is announced rather than met with
+		   silence. */
+		if ( building ) {
+			building = qfalse;
+			ETA_HudNarrator_ResetBuildProgress();
+		}
+
+		return;
+	}
+
+	building = qtrue;
+
+	/* The same figure the status bar under the icon draws, from the same
+	   value, so the words and the bar cannot disagree. */
+	percent = (int)( ( (float)cg.cursorHintValue / 255.0f ) * 100.0f );
+
+	if ( percent > 100 ) {
+		percent = 100;
+	}
+
+	ETA_HudNarrator_UpdateBuildProgress( percent );
+}
+
 static void ETA_NarrateInteractionHint( qboolean active ) {
