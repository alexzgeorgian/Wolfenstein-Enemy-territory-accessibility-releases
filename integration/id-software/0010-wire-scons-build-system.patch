diff --git a/src/SConscript.cgame b/src/SConscript.cgame
index 2a4a73c..b3be88b 100644
--- a/src/SConscript.cgame
+++ b/src/SConscript.cgame
@@ -64,6 +64,27 @@ cg_window.c
 ../ui/ui_shared.c
 """
 
+# accessibility layer, compiled in when ACCESSIBILITY=1. Listed as sources
+# rather than linked from the accessibility-mode project's own CMake static
+# library so it always builds with this module's exact flags and target
+# architecture - a separately built library would have to be matched to
+# 'gcc -m32' by hand.
+accessibility_string = """
+audio/audio_cue_system.c
+core/accessibility_runtime.c
+core/debug_log.c
+core/error_handler.c
+core/event_router.c
+core/runtime_guard.c
+hud/hud_narrator.c
+menu/menu_narrator.c
+navigation/navigation_system.c
+platform/windows/windows_audio_cue.c
+platform/windows/windows_nvda.c
+platform/windows/windows_speech.c
+speech/speech_manager.c
+"""
+
 cgame_list = scons_utils.BuildList( 'cgame', cgame_string )
 
 local_env = g_env.Clone()
@@ -81,5 +102,19 @@ try:
 except:
 	pass
 
+# accessibility-mode lives outside this source tree (alongside it, not under
+# it), so its paths are resolved to absolutes up front: SCons is running from
+# the directory holding SConstruct, and absolute paths are not subject to the
+# BuildDir remapping the relative entries above go through.
+# ACCESSIBILITY isn't exported in all usage paths, same as GAMERANGER above.
+try:
+	if ( ACCESSIBILITY == '1' ):
+		accessibility_root = os.path.abspath( os.path.join( os.getcwd(), '..', 'accessibility-mode', 'src', 'accessibility' ) )
+		local_env.Append( CPPDEFINES = [ 'FEATURE_ACCESSIBILITY' ] )
+		local_env.Append( CPPPATH = [ accessibility_root ] )
+		source_list = source_list + scons_utils.BuildList( accessibility_root, accessibility_string )
+except:
+	pass
+
 ret = local_env.SharedLibrary( target = 'cgame', source = source_list )
 Return( 'ret' )
