  * The distance goes too: against something the player is up against it
  * is always nearly zero, and "0 metres" was the part that read as broken.
  */
+/* How slowly the player has to be going to count as stopped - a metre a
+   second. Above that they are getting somewhere, and whatever is beside
+   them is not stopping them however close it is. */
+#define ETA_OBSTACLE_STOPPED_SPEED 40.0f
+
+/* Says what is blocking the way, and only when something is.
+
+   Second attempt; the first was half a fix. It began as a ray from the
+   eye, which found the upright face of every stair in the game. The cure
+   was to ask "what is stopping me" with a trace of the player's own box,
+   lifted by the engine's step height.
+
+   That fixed the shape of the probe and left its aim alone - still the
+   view yaw - so it went on answering "what am I looking at" with a fatter
+   instrument. The tester came back: metres of walking with a wall
+   announced the whole way, because running down a corridor while glancing
+   sideways is the commonest thing in this game.
+
+   So the aim now comes from the player's own movement keys, turned into
+   the world by their view: the direction they are asking to go. And it
+   says nothing unless they are asking to move and failing to, which is
+   what being blocked means. */
 static void ETA_NarrateObstacleAhead( void ) {
 	static char lastDescription[128];
 	static int lastTime;
 	char description[128];
 
 	playerState_t *ps;
+	usercmd_t cmd;
 	trace_t trace;
-	vec3_t angles, forward, start, end, mins, maxs;
+	vec3_t angles, forward, right, wish, start, end, mins, maxs;
+	float speedSq;
 
 	if ( !cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer ) {
 		lastDescription[0] = '\0';
@@ -5304,17 +5328,44 @@ static void ETA_NarrateObstacleAhead( void ) {
 		return;
 	}
 
+	/* Covering ground. Whatever is beside them is not stopping them, and
+	   this is the whole of what the tester reported. */
+	speedSq = ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1];
+
+	if ( speedSq > ETA_OBSTACLE_STOPPED_SPEED * ETA_OBSTACLE_STOPPED_SPEED ) {
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Standing still on purpose is not being blocked either. Without this,
+	   anyone who stopped to listen would be told about the nearest wall for
+	   as long as they stood there. */
+	if ( !trap_GetUserCmd( trap_GetCurrentCmdNumber(), &cmd )
+		 || ( cmd.forwardmove == 0 && cmd.rightmove == 0 ) ) {
+		lastDescription[0] = '\0';
+		return;
+	}
+
 	/* Flattened: looking down at your boots must not aim the probe into
 	   the floor, and looking up must not aim it over the obstacle. */
 	angles[PITCH] = 0.0f;
 	angles[YAW] = cg.refdefViewAngles[YAW];
 	angles[ROLL] = 0.0f;
-	AngleVectors( angles, forward, NULL, NULL );
+	AngleVectors( angles, forward, right, NULL );
+
+	/* The direction being asked for, not the one being looked in. */
+	VectorScale( forward, (float)cmd.forwardmove, wish );
+	VectorMA( wish, (float)cmd.rightmove, right, wish );
+	wish[2] = 0.0f;
+
+	if ( VectorNormalize( wish ) < 0.1f ) {
+		lastDescription[0] = '\0';
+		return;
+	}
 
 	/* The player's own box - crouched when they are crouched - with the
-	   base raised by one step. That lift is the whole fix: it is what the
-	   engine gives the player to get up a stair, so anything fitting
-	   under it is not an obstacle and must not be announced as one. */
+	   base raised by one step, so a stair riser passes underneath it
+	   exactly as the player's feet do. */
 	VectorCopy( ps->mins, mins );
 	VectorCopy( ps->maxs, maxs );
 	mins[2] += ETA_DROP_STEP_UNITS;
@@ -5326,7 +5377,7 @@ static void ETA_NarrateObstacleAhead( void ) {
 	}
 
 	VectorCopy( ps->origin, start );
-	VectorMA( start, ETA_OBSTACLE_PROBE_DISTANCE, forward, end );
+	VectorMA( start, ETA_OBSTACLE_PROBE_DISTANCE, wish, end );
 
 	CG_Trace( &trace, start, mins, maxs, end, ps->clientNum, MASK_PLAYERSOLID );
 
