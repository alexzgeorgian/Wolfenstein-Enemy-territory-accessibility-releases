diff --git a/src/cgame/cg_draw.c b/src/cgame/cg_draw.c
index 5acbb2a..4d69ed3 100644
--- a/src/cgame/cg_draw.c
+++ b/src/cgame/cg_draw.c
@@ -4864,6 +4864,34 @@ static void ETA_NarrateZoom( void ) {
 	ETA_Speech_EndReport();
 }
 
+/**
+ * Says which way the player is facing when it changes.
+ *
+ * The direction is how a sighted player holds a route in their head
+ * between one landmark and the next. The conversion from view yaw lives
+ * in the shared library so both integrations say the same word for the
+ * same heading, and so it can be checked without a game running: getting
+ * it backwards would be confidently wrong, and wrong in the direction
+ * the player then walks. The library also owns the hysteresis that keeps
+ * a player lining up on a doorway from hearing the direction flip.
+ */
+static void ETA_NarrateFacing( void ) {
+	ETA_Facing facing;
+
+	if ( !cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_facingCallouts.integer ) {
+		ETA_HudNarrator_ResetFacing();
+		return;
+	}
+
+	/* Predicted rather than the snapshot's, for the same reason the
+	   stance is: turning is a local action and the snapshot lags it. */
+	if ( ETA_HudNarrator_UpdateFacing( cg.predictedPlayerState.viewangles[YAW], &facing ) ) {
+		ETA_Speech_BeginReport();
+		ETA_HudNarrator_SpeakFacing( facing );
+		ETA_Speech_EndReport();
+	}
+}
+
 #define ETA_OBSTACLE_MIN_INTERVAL 3000
 
