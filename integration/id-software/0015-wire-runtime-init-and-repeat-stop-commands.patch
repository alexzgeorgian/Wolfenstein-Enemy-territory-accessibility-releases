+#ifdef FEATURE_ACCESSIBILITY
+/*
+=================
+ETA_InitAccessibility
+
+Nothing in this integration speaks until this has run. Both speech
+backends check a handle that only their Init creates - the NVDA
+controller client's speakText entry point, and the SAPI voice - and
+return immediately while it is NULL. So every narration call in every
+patch before this one was reaching a backend that silently discarded it.
+
+The cgame module links its own copy of the accessibility library and
+cannot see the ui module's, so it needs its own Init rather than
+relying on the one in _UI_Init.
+=================
+*/
+static void ETA_InitAccessibility( void ) {
+	ETA_AccessibilityRuntime_Init();
+	ETA_AudioCueSystem_Init();
+	ETA_HudNarrator_Init();
+	ETA_NavigationSystem_Init();
+}
+
+/*
+=================
+ETA_ShutdownAccessibility
+=================
+*/
+static void ETA_ShutdownAccessibility( void ) {
+	ETA_NavigationSystem_Shutdown();
+	ETA_HudNarrator_Shutdown();
+	ETA_AudioCueSystem_Shutdown();
+	ETA_AccessibilityRuntime_Shutdown();
+}
+#endif
