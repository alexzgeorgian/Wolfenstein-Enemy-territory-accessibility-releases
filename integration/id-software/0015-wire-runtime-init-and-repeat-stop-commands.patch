 #ifdef FEATURE_ACCESSIBILITY
+/*
+=================
+CG_AccessibilityForwardToUI
+
+Which module should answer a repeat or stop request.
+
+Both modules link their own copy of the accessibility library and
+neither can see the other's state: the menu narrator's "current item"
+lives in ui, the last HUD announcement lives here. So the request has to
+be answered by whichever module is in front of the player.
+
+The engine decides that in the wrong order. Cmd_ExecuteString
+(qcommon/cmd.c) tries CL_GameCommand before UI_GameCommand, so once a
+snapshot exists cgame is offered every command first, and answering it
+here is final - CG_ConsoleCommand returns qtrue for any name in its
+table and the ui module never sees it. Opening the options menu
+mid-match would then repeat the last health report instead of the
+focused menu item.
+
+The key catcher distinguishes the two. When KEYCATCH_UI is set a menu
+owns the keyboard and the request belongs to ui, so it is pushed back
+through the command buffer under a name only ui answers. Before a
+snapshot exists CG_ConsoleCommand declines everything outright, so the
+main menu never reaches here and ui is offered the bound name directly.
+
+Returns qtrue when the request was handed to the ui module.
+=================
+*/
+static qboolean CG_AccessibilityForwardToUI( const char *uiCommand ) {
+	if ( !( trap_Key_GetCatcher() & KEYCATCH_UI ) ) {
+		return qfalse;
+	}
+
+	/* Queued, not executed here, so this cannot re-enter itself: the
+	   name below is answered by ui and by nothing in this module. */
+	trap_SendConsoleCommand( va( "%s\n", uiCommand ) );
+	return qtrue;
+}
+
+/*
+=================
+CG_AccessibilityRepeat_f
+
+Says the last thing that was spoken again, for the word that was missed
+because a gunshot landed on top of it.
+=================
+*/
+static void CG_AccessibilityRepeat_f( void ) {
+	if ( CG_AccessibilityForwardToUI( "accessibilityRepeatMenuItem" ) ) {
+		return;
+	}
+
+	ETA_Speech_RepeatLast();
+}
+
+/*
+=================
+CG_AccessibilityStopSpeech_f
+
+Cuts off whatever is being spoken. Worth a key of its own: an objective
+report is several seconds of speech that cannot otherwise be
+interrupted, and a player who needs to hear the match instead should not
+have to wait it out.
+=================
+*/
+static void CG_AccessibilityStopSpeech_f( void ) {
+	if ( CG_AccessibilityForwardToUI( "accessibilityStopSpeechMenu" ) ) {
+		return;
+	}
+
+	ETA_Speech_Stop();
+}
+
 /**
  * On-demand "query basic match state" command for the accessibility HUD
  * narrator (Milestone 4's exit condition). Bindable to a key; narrates
@@ -1112,6 +1186,8 @@ static consoleCommand_t commands[] =
 
