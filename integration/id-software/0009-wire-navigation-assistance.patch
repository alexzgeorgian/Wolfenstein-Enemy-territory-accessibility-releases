+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Finds the world origin of the map objective belonging to team that is
+ * nearest to from, for the accessibility navigation system's distance and
+ * route-correction announcements. Returns qfalse when the client doesn't
+ * currently know a position for any of that team's objectives.
+ *
+ * mapEntities[] is the live list the server publishes through its "entnfo"
+ * command (G_SendMapEntityInfo, g_teammapdata.c) and CG_ParseMapEntityInfo
+ * parses - the same list, filtered by the same team test CG_DrawMap uses,
+ * that the command map already draws objective icons from. It is entirely
+ * separate from the CS_MAIN_AXIS_OBJECTIVE/CS_MAIN_ALLIES_OBJECTIVE
+ * configstrings, which are dead in this release (see the README).
+ *
+ * Positions are resolved exactly the way CG_DrawMapEntity above already
+ * resolves them for drawing: ME_CONSTRUCT/ME_DESTRUCT/ME_DESTRUCT_2 carry
+ * an entity number in mEnt->data whose lerpOrigin is the objective's
+ * position, and ME_TANK/ME_TANK_DEAD are located through the
+ * ET_OID_TRIGGER entity in the current snapshot whose teamNum matches
+ * mEnt->data. mEnt->x/y are deliberately not used: CG_ParseMapEntity only
+ * fills those in for tanks and players, leaving them stale for the
+ * constructible/destructible types, and quantizes them to 128-unit steps
+ * even then.
+ *
+ * "Nearest" is this integration's own choice of navigation target, not an
+ * engine concept - this release designates no "main" objective at all.
+ */
+qboolean ETA_NearestObjectiveOrigin( team_t team, const vec3_t from, vec3_t origin ) {
+	int i, j;
+	float bestDistance = 0;
+	qboolean found = qfalse;
+
+	for ( i = 0; i < mapEntityCount; i++ ) {
+		mapEntityData_t *mEnt = &mapEntities[i];
+		centity_t *cent = NULL;
+		float distance;
+
+		if ( mEnt->team != team ) {
+			continue;
+		}
+
+		// mEnt->data is server-supplied, so range-check it before indexing
+		if ( mEnt->data < 0 || mEnt->data >= MAX_GENTITIES ) {
+			continue;
+		}
+
+		if ( mEnt->type == ME_CONSTRUCT || mEnt->type == ME_DESTRUCT || mEnt->type == ME_DESTRUCT_2 ) {
+			cent = &cg_entities[mEnt->data];
+		} else if ( mEnt->type == ME_TANK || mEnt->type == ME_TANK_DEAD ) {
+			for ( j = 0; j < cg.snap->numEntities; j++ ) {
+				if ( cg.snap->entities[j].eType == ET_OID_TRIGGER && cg.snap->entities[j].teamNum == mEnt->data ) {
+					cent = &cg_entities[cg.snap->entities[j].number];
+					break;
+				}
+			}
+		}
+
+		if ( !cent ) {
+			continue;
+		}
+
+		distance = Distance( from, cent->lerpOrigin );
+
+		if ( !found || distance < bestDistance ) {
+			bestDistance = distance;
+			VectorCopy( cent->lerpOrigin, origin );
+			found = qtrue;
+		}
+	}
+
+	return found;
+}
+#endif
