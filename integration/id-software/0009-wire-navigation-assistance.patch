 void CG_TargetCommand_f( void ) {
@@ -946,13 +947,24 @@ static void CG_CPM_f( void ) {
 /**
  * On-demand "query basic match state" command for the accessibility HUD
  * narrator (Milestone 4's exit condition). Bindable to a key; narrates
- * health, the active weapon, and its ammo in one status report rather
- * than announcing every stat change automatically, since health/ammo
- * change too often during combat for that to be anything but noise.
+ * health, the active weapon, and its ammo - plus, per Milestone 6, the
+ * distance to the nearest objective and a turn-left/right/ahead route
+ * correction toward it - in one status report rather than announcing any
+ * of it automatically, since health/ammo change too often during combat,
+ * and a walking player's bearing to an objective changes too continuously,
+ * for that to be anything but noise.
+ *
+ * The bearing uses AngleSubtract - the same helper cg_draw.c's mortar
+ * reticle already uses to express one yaw relative to another - because a
+ * signed [-180, 180] "which way to turn" value reads more naturally as
+ * spoken text than a 0-359 compass bearing does. The +-15 degree "ahead"
+ * band is a judgment call, not a value found anywhere in this engine: no
+ * comparable on-course tolerance exists here to match it against.
  */
 static void CG_AccessibilityStatus_f( void ) {
 	playerState_t *ps = &cg.snap->ps;
 	gitem_t *item;
+	vec3_t objectiveOrigin;
 
 	ETA_HudNarrator_SpeakHealth( ps->stats[STAT_HEALTH] );
 
@@ -969,6 +981,25 @@ static void CG_AccessibilityStatus_f( void ) {
 			ETA_HudNarrator_SpeakAmmo( ammo );
 		}
 	}
+
+	if ( ETA_NearestObjectiveOrigin( CG_LimboPanel_GetRealTeam(), ps->origin, objectiveOrigin ) ) {
+		vec3_t delta, angles;
+		float relativeYaw;
+
+		ETA_NavigationSystem_AnnounceDistance( (int)( Distance( ps->origin, objectiveOrigin ) * ETA_QU_TO_METERS ) );
+
+		VectorSubtract( objectiveOrigin, ps->origin, delta );
+		vectoangles( delta, angles );
+		relativeYaw = AngleSubtract( angles[YAW], ps->viewangles[YAW] );
+
+		if ( fabs( relativeYaw ) <= 15.0f ) {
+			ETA_NavigationSystem_AnnounceRouteCorrection( "Objective is ahead" );
+		} else if ( relativeYaw > 0.0f ) {
+			ETA_NavigationSystem_AnnounceRouteCorrection( "Turn left toward the objective" );
+		} else {
+			ETA_NavigationSystem_AnnounceRouteCorrection( "Turn right toward the objective" );
+		}
+	}
 }
 #endif
 
