+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Feeds real per-frame movement into the accessibility navigation system's
+ * stuck detection (ETA_NavigationSystem_UpdateMovement), which narrates
+ * "You may be stuck" on its own once the player has stayed under its own
+ * movement threshold for long enough.
+ *
+ * Only runs while the player is on a playing team and actually able to
+ * move under their own control: PM_NORMAL is the only pm_type this
+ * release's Pmove lets a live, unfrozen player move freely in (the others
+ * being PM_DEAD, PM_SPECTATOR, PM_NOCLIP, PM_FREEZE and PM_INTERMISSION).
+ * Outside that, stuck detection is reset rather than fed zero movement, so
+ * time spent dead, spectating or between rounds can never itself count as
+ * being stuck, and so the reset CG_Respawn already does above isn't
+ * immediately re-armed by a stale timer from before death.
+ */
+static void ETA_NarrateStuckDetection( playerState_t *ps, playerState_t *ops ) {
+	team_t team = (team_t)ps->persistant[PERS_TEAM];
+
+	if ( ( team != TEAM_AXIS && team != TEAM_ALLIES ) || ps->pm_type != PM_NORMAL ) {
+		ETA_NavigationSystem_ResetStuckDetection();
+		return;
+	}
+
+	ETA_NavigationSystem_UpdateMovement( Distance( ps->origin, ops->origin ) * ETA_QU_TO_METERS, cg.frametime / 1000.0f );
+}
+#endif
