diff --git a/src/cgame/cg_draw.c b/src/cgame/cg_draw.c
index 86841eb..c4fee5e 100644
--- a/src/cgame/cg_draw.c
+++ b/src/cgame/cg_draw.c
@@ -5231,6 +5231,93 @@ static void ETA_NarrateFacing( void ) {
 	}
 }
 
+#define ETA_MUSIC_DUCK_DOWN_MS 200
+#define ETA_MUSIC_DUCK_UP_MS   600
+
+/*
+ * The music level the game itself last asked for.
+ *
+ * Not always 1. A map script fades the music for its own reasons -
+ * mu_fade is one of the commands the server sends - and restoring to full
+ * after a narration would override that, turning a deliberate hush back
+ * into a soundtrack. So the duck is a fraction of whatever the game last
+ * asked for, and the restore goes back to that and not to 1.
+ */
+static float gMusicBaseline = 1.0f;
+static qboolean gMusicDucked = qfalse;
+static int gMusicDuckUntil = 0;
+static int gMusicDuckSerial = 0;
+
+void ETA_MusicFadeRequested( float level, qboolean restarted ) {
+	gMusicBaseline = level;
+
+	if ( restarted ) {
+		/* A new stream starts unfaded, so the engine has already
+		   cancelled whatever duck was in place. */
+		gMusicDucked = qfalse;
+		return;
+	}
+
+	if ( gMusicDucked ) {
+		trap_S_FadeBackgroundTrack( gMusicBaseline * eta_musicDuck.value,
+									ETA_MUSIC_DUCK_DOWN_MS, 0 );
+	}
+}
+
+/*
+ * Turns the music down while the narrator is talking.
+ *
+ * A tester turned the music up and found the narrator underneath it. The
+ * two are mixed by different things and neither knows about the other:
+ * the music is the engine's, and the speech is NVDA's or SAPI's, going
+ * out through Windows rather than through the game at all. So no volume
+ * setting anywhere can balance them against each other.
+ *
+ * What the mod can do is what broadcast has always done: duck the bed
+ * while the voice is on it. This is the game's own music fade, the same
+ * one map scripts use.
+ *
+ * How long to stay out of the way is an estimate, because neither
+ * backend reports when the words stop.
+ */
+static void ETA_DuckMusicForSpeech( void ) {
+	int serial = ETA_Speech_GetSpokenSerial();
+
+	if ( eta_musicDuck.value >= 1.0f ) {
+		if ( gMusicDucked ) {
+			trap_S_FadeBackgroundTrack( gMusicBaseline, ETA_MUSIC_DUCK_UP_MS, 0 );
+			gMusicDucked = qfalse;
+		}
+
+		gMusicDuckSerial = serial;
+		return;
+	}
+
+	if ( serial != gMusicDuckSerial ) {
+		gMusicDuckSerial = serial;
+
+		/* Each new line pushes the end out, so a run of reports is one
+		   continuous duck rather than a stutter of dips. */
+		gMusicDuckUntil = cg.time
+						  + ETA_Speech_EstimateDurationMs( ETA_Speech_GetLastMessage() );
+
+		if ( !gMusicDucked ) {
+			gMusicDucked = qtrue;
+			trap_S_FadeBackgroundTrack( gMusicBaseline * eta_musicDuck.value,
+										ETA_MUSIC_DUCK_DOWN_MS, 0 );
+		}
+
+		return;
+	}
+
+	/* Subtraction rather than a comparison, so a rewound clock costs one
+	   early restore instead of a duck that never lifts. */
+	if ( gMusicDucked && cg.time - gMusicDuckUntil >= 0 ) {
+		trap_S_FadeBackgroundTrack( gMusicBaseline, ETA_MUSIC_DUCK_UP_MS, 0 );
+		gMusicDucked = qfalse;
+	}
+}
+
 /**
  * Says what the player is looking at when they aim up or down.
  *
@@ -5760,6 +5847,10 @@ void CG_DrawActive( stereoFrame_t stereoView ) {
 
 	ETA_NarrateZoom();
 
+	/* Not speech, so not behind the passive hold: this is the mixer
+	   getting out of the way of whatever is being said. */
+	ETA_DuckMusicForSpeech();
+
 	/* Bookkeeping rather than speech, so it runs whatever else is being
 	   said: this is what a pickup next frame is measured against. */
 	CG_AccessibilitySampleTotals();
