 	ETA_Speech_Stop();
 }
 
+/**
+ * Speaks where the team's nearest objective is: how far off, and which way
+ * to turn for it.
+ *
+ * Shared by the status report and the stuck detector, so the two cannot
+ * drift into describing the same objective differently. The caller opens
+ * the speech report; this only contributes parts to it.
+ *
+ * The bearing uses AngleSubtract - the same helper cg_draw.c's mortar
+ * reticle already uses to express one yaw relative to another - because a
+ * signed [-180, 180] "which way to turn" value reads more naturally as
+ * spoken text than a 0-359 compass bearing does. The +-15 degree "ahead"
+ * band is a judgment call, not a value found anywhere in this engine.
+ */
+void CG_AccessibilityNarrateObjective( void ) {
+	playerState_t *ps;
+	vec3_t objectiveOrigin;
+	vec3_t delta, angles;
+	float relativeYaw;
+
+	if ( !cg.snap ) {
+		return;
+	}
+
+	ps = &cg.snap->ps;
+
+	if ( !ETA_NearestObjectiveOrigin( CG_LimboPanel_GetRealTeam(), ps->origin, objectiveOrigin ) ) {
+		/* Never silence: "no objective here" and "the mod has stopped
+		   working" must not sound the same. */
+		ETA_Speech_Say( "No current objective" );
+		return;
+	}
+
+	ETA_NavigationSystem_AnnounceDistance( (int)( Distance( ps->origin, objectiveOrigin ) * ETA_QU_TO_METERS ) );
+
+	VectorSubtract( objectiveOrigin, ps->origin, delta );
+	vectoangles( delta, angles );
+
+	/**
+	 * Yaw increases counterclockwise here, so a target to the player's
+	 * LEFT is at a *higher* yaw than the view: relativeYaw > 0 means
+	 * turn left, < 0 means turn right. Worth stating explicitly - this
+	 * is the one place in the integration where getting the sign
+	 * backwards produces working, confident, wrong directions.
+	 */
+	relativeYaw = AngleSubtract( angles[YAW], ps->viewangles[YAW] );
+
+	if ( fabs( relativeYaw ) <= 15.0f ) {
+		ETA_NavigationSystem_AnnounceRouteCorrection( "Objective is ahead" );
+	} else if ( relativeYaw > 0.0f ) {
+		ETA_NavigationSystem_AnnounceRouteCorrection( "Turn left toward the objective" );
+	} else {
+		ETA_NavigationSystem_AnnounceRouteCorrection( "Turn right toward the objective" );
+	}
+}
+
 /**
  * On-demand "query basic match state" command for the accessibility HUD
  * narrator (Milestone 4's exit condition). Bindable to a key; narrates
@@ -1046,7 +1102,6 @@ static void CG_AccessibilityStopSpeech_f( void ) {
 static void CG_AccessibilityStatus_f( void ) {
 	playerState_t *ps = &cg.snap->ps;
 	gitem_t *item;
-	vec3_t objectiveOrigin;
 
 	ETA_HudNarrator_SpeakHealth( ps->stats[STAT_HEALTH] );
 
@@ -1085,44 +1140,7 @@ static void CG_AccessibilityStatus_f( void ) {
 		}
 	}
 
-	if ( ETA_NearestObjectiveOrigin( CG_LimboPanel_GetRealTeam(), ps->origin, objectiveOrigin ) ) {
-		vec3_t delta, angles;
-		float relativeYaw;
-
-		ETA_NavigationSystem_AnnounceDistance( (int)( Distance( ps->origin, objectiveOrigin ) * ETA_QU_TO_METERS ) );
-
-		VectorSubtract( objectiveOrigin, ps->origin, delta );
-		vectoangles( delta, angles );
-
-		/**
-		 * Yaw increases counterclockwise here, so a target to the player's
-		 * LEFT is at a *higher* yaw than the view: relativeYaw > 0 means
-		 * turn left, < 0 means turn right. Worth stating explicitly - this
-		 * is the one place in the integration where getting the sign
-		 * backwards produces working, confident, wrong directions.
-		 */
-		relativeYaw = AngleSubtract( angles[YAW], ps->viewangles[YAW] );
-
-		if ( fabs( relativeYaw ) <= 15.0f ) {
-			ETA_NavigationSystem_AnnounceRouteCorrection( "Objective is ahead" );
-		} else if ( relativeYaw > 0.0f ) {
-			ETA_NavigationSystem_AnnounceRouteCorrection( "Turn left toward the objective" );
-		} else {
-			ETA_NavigationSystem_AnnounceRouteCorrection( "Turn right toward the objective" );
-		}
-
-		/**
-		 * The two objective audio cues, on the same request: an attention
-		 * cue, then a directional one the player can simply turn toward.
-		 * The bearing is view-relative in the same 0 = front, 90 = right,
-		 * 180 = behind, 270 = left convention 0008's damage-direction cue
-		 * uses - which is view yaw minus target yaw, not the other way
-		 * round (see the README).
-		 */
-		ETA_AudioCueSystem_PlayObjectiveCue();
-		ETA_AudioCueSystem_PlayObjectiveDirectionCue(
-			(int)AngleNormalize360( ps->viewangles[YAW] - angles[YAW] ) );
-	}
