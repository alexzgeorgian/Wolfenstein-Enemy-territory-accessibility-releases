 int CG_DrawField( int x, int y, int width, int value, int charWidth, int charHeight, qboolean dodrawpic, qboolean leftAlign );      // NERVE - SMF
@@ -385,9 +387,141 @@ void CG_DrawPlayerWeaponIcon( rectDef_t *rect, qboolean drawHighlighted, int ali
  * fade window the icon itself is drawn with) - so the cue never fires for
  * a hint the player can't actually see.
  */
+/* The words for one of the engine's cursor hint icons.
+
+   Switched on the names, never the numbers. This tree still carries the
+   whole Wolfenstein list while ET: Legacy has struck a dozen of them out
+   without renumbering what was left, so the same icon is a different
+   number in the two engines and a table indexed by position would be
+   quietly wrong in one of them.
+
+   Every hint CG_DrawCursorhint below gives an icon to has a case here,
+   including the ones that deliberately say nothing. That is not tidiness:
+   a hint that falls through to a default would be announced as whatever
+   the last case happened to be, and there is no worse failure available
+   to this mod than confidently naming the wrong thing. */
+static ETA_Interaction ETA_InteractionForHint( int icon ) {
+	switch ( icon ) {
+	case HINT_ACTIVATE:
+	case HINT_PLAYER:
+	case HINT_BAD_USER:
+		return ETA_INTERACT_USABLE;
+	case HINT_CHAIR:
+		/* The engine draws "not usable" for this one - the chair icon
+		   behind it is #if 0'd out - so this is what a sighted player is
+		   actually being told. */
+		return ETA_INTERACT_NOT_USABLE;
+	case HINT_DOOR:
+	case HINT_DOOR_ROTATING:
+		return ETA_INTERACT_DOOR;
+	case HINT_DOOR_LOCKED:
+	case HINT_DOOR_ROTATING_LOCKED:
+	case HINT_LOCKPICK:
+		/* The lockpick draws the locked-door icon, and this game has no
+		   lockpick to use on it. What is on screen is a locked door. */
+		return ETA_INTERACT_DOOR_LOCKED;
+	case HINT_BUTTON:
+		return ETA_INTERACT_BUTTON;
+	case HINT_LADDER:
+		return ETA_INTERACT_LADDER;
+	case HINT_WATER:
+		return ETA_INTERACT_WATER;
+	case HINT_MG42:
+		return ETA_INTERACT_MG42;
+	case HINT_TANK:
+		return ETA_INTERACT_TANK;
+	case HINT_BREAKABLE:
+		return ETA_INTERACT_BREAKABLE;
+	case HINT_BREAKABLE_DYNAMITE:
+		return ETA_INTERACT_NEEDS_DYNAMITE;
+	/* The pliers, both ways round. The engine draws the same build icon
+	   for a construction as for a repair, so they are one report; the
+	   disarm is its own icon and its own words, because planting where
+	   you meant to defuse loses the round. */
+	case HINT_BUILD:
+	case HINT_CONSTRUCTIBLE:
+		return ETA_INTERACT_BUILD;
+	case HINT_DISARM:
+		return ETA_INTERACT_DISARM;
+	case HINT_DYNAMITE:
+		return ETA_INTERACT_PLANT_DYNAMITE;
+	case HINT_LANDMINE:
+		return ETA_INTERACT_LANDMINE;
+	case HINT_SATCHELCHARGE:
+		return ETA_INTERACT_SATCHEL;
+	case HINT_REVIVE:
+		return ETA_INTERACT_REVIVE;
+	case HINT_HEALTH:
+		return ETA_INTERACT_HEALTH;
+	case HINT_AMMO:
+		return ETA_INTERACT_AMMO;
+	case HINT_WEAPON:
+		return ETA_INTERACT_WEAPON;
+	case HINT_POWERUP:
+		return ETA_INTERACT_OBJECTIVE;
+	case HINT_UNIFORM:
+		return ETA_INTERACT_UNIFORM;
+	case HINT_KNIFE:
+		return ETA_INTERACT_KNIFE;
+	/* Wolfenstein signage. ET's own server code raises none of these,
+	   but a map can still ask for one by name through the cursorhint
+	   key, and a hint with no words is indistinguishable from no hint. */
+	case HINT_ALARM:
+		return ETA_INTERACT_ALARM;
+	case HINT_TREASURE:
+		return ETA_INTERACT_TREASURE;
+	case HINT_CAUTION:
+		return ETA_INTERACT_CAUTION;
+	case HINT_DANGER:
+		return ETA_INTERACT_DANGER;
+	case HINT_SECRET:
+		return ETA_INTERACT_SECRET;
+	case HINT_CLIPBOARD:
+		return ETA_INTERACT_NOTE;
+	case HINT_QUESTION:
+		return ETA_INTERACT_QUESTION;
+	case HINT_EXCLAMATION:
+		return ETA_INTERACT_ATTENTION;
+	case HINT_ARMOR:
+		return ETA_INTERACT_ARMOUR;
+	case HINT_HOLDABLE:
+	case HINT_INVENTORY:
+		return ETA_INTERACT_ITEM;
+	/* Said deliberately as nothing. HINT_NONE and HINT_FORCENONE mean
+	   there is nothing there; the four player icons name whoever is
+	   under the crosshair, which is a different question with a rule of
+	   its own - a disguised covert operative must sound like what a
+	   sighted player sees, and these icons do not carry that. */
+	case HINT_NONE:
+	case HINT_FORCENONE:
+	case HINT_PLYR_FRIEND:
+	case HINT_PLYR_NEUTRAL:
+	case HINT_PLYR_ENEMY:
+	case HINT_PLYR_UNKNOWN:
+	default:
+		return ETA_INTERACT_NONE;
+	}
+}
+
+/* How long a hint has to stay up before it is worth saying.
+
+   The cue fires the instant an icon appears, and should: that is the
+   sighted player's flicker of movement at the edge of the eye. The words
+   are different. Turning through a supply room puts four or five hints
+   under the crosshair in under a second, and naming every one of them is
+   a voice that cannot be listened to. So the sound says "there is
+   something here" at once, and the words follow for whatever the player
+   is still looking at a quarter of a second later. */
+#define ETA_HINT_SETTLE_MS 250
+
 static void ETA_NarrateInteractionHint( qboolean active ) {
 	static qboolean wasActive = qfalse;
 	static int lastIcon = HINT_NONE;
+	static int heldIcon = -1;
+	static int heldSince;
+	static qboolean heldSpoken = qfalse;
+	ETA_Interaction what;
+	int percent;
 
 	if ( active && ( !wasActive || cg.cursorHintIcon != lastIcon ) ) {
 		ETA_AudioCueSystem_PlayInteractionCue();
@@ -395,6 +529,46 @@ static void ETA_NarrateInteractionHint( qboolean active ) {
 	}
 
 	wasActive = active;
+
+	if ( !eta_interactionCallouts.integer || !active ) {
+		heldIcon = -1;
+		return;
+	}
+
+	if ( cg.cursorHintIcon != heldIcon ) {
+		heldIcon = cg.cursorHintIcon;
+		heldSince = cg.time;
+		heldSpoken = qfalse;
+		return;
+	}
+
+	if ( heldSpoken || cg.time - heldSince < ETA_HINT_SETTLE_MS ) {
+		return;
+	}
+
+	heldSpoken = qtrue;
+
+	what = ETA_InteractionForHint( cg.cursorHintIcon );
+
+	if ( what == ETA_INTERACT_NONE ) {
+		return;
+	}
+
+	/* The same number the status bar under the icon draws, on the same
+	   condition it draws it: how far a construction has got, how much is
+	   left of a breakable. Without it "pliers, build here" is the same
+	   sentence whether nobody has started or somebody is about to
+	   finish. */
+	percent = cg.cursorHintValue ?
+			  (int)( ( (float)cg.cursorHintValue / 255.0f ) * 100.0f ) : -1;
+
+	if ( percent > 100 ) {
+		percent = 100;
+	}
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakInteraction( what, percent );
+	ETA_Speech_EndReport();
 }
 #endif
 
