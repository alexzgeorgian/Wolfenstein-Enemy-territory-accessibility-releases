diff --git a/src/cgame/cg_draw.c b/src/cgame/cg_draw.c
index 323d6d6..afc7c8e 100644
--- a/src/cgame/cg_draw.c
+++ b/src/cgame/cg_draw.c
@@ -5357,6 +5357,162 @@ static void ETA_NarrateObstacleAhead( void ) {
 	ETA_Speech_EndReport();
 }
 
+/* How far ahead the first and second treads are sampled. The near one is
+   about half a stride, the far one a stride; the far one's only job is to
+   tell a single step from a flight of them. */
+#define ETA_STAIR_NEAR 28.0f
+#define ETA_STAIR_FAR 56.0f
+
+/* The smallest change in ground height worth calling a step. Below this
+   the ground is simply not level, which is most of this game. */
+#define ETA_STAIR_MIN_RISE 4.0f
+
+/* How flat a tread has to be, as the cosine of its slope - about eight
+   degrees. Stairs here are built of flat brushes and come back at exactly
+   1.0; ramps, rubble and desert do not. Anything short of flat is left
+   unsaid rather than called a staircase, because a player told to expect
+   steps and given a slope has been sent to feel for something that is not
+   there. Much stricter than the engine's own MIN_WALK_NORMAL of 0.7,
+   deliberately: that one answers "can this be walked on", which nearly
+   everything can. */
+#define ETA_STAIR_FLAT 0.99f
+
+#define ETA_STAIR_MIN_INTERVAL 3000
+
+/* The height of the flat ground a short way ahead, relative to fromZ.
+
+   A point trace straight down, from one step above the reference to one
+   step below it. That window is the engine's own step height on purpose:
+   ground outside it is not somewhere the player can simply walk to, so it
+   is not a step - it is a wall (the obstacle report's business) or a drop
+   (the drop warning's). */
+static qboolean ETA_GroundRiseAhead( const playerState_t *ps, const vec3_t forward,
+									 float distance, float fromZ, float *rise ) {
+	trace_t trace;
+	vec3_t start, end;
+
+	VectorMA( ps->origin, distance, forward, start );
+	start[2] = fromZ + ETA_DROP_STEP_UNITS + 1.0f;
+
+	VectorCopy( start, end );
+	end[2] = fromZ - ETA_DROP_STEP_UNITS - 1.0f;
+
+	CG_Trace( &trace, start, NULL, NULL, end, ps->clientNum, MASK_PLAYERSOLID );
+
+	if ( trace.startsolid || trace.allsolid || trace.fraction == 1.0f ) {
+		return qfalse;
+	}
+
+	if ( trace.plane.normal[2] < ETA_STAIR_FLAT ) {
+		return qfalse;
+	}
+
+	*rise = trace.endpos[2] - fromZ;
+
+	return qtrue;
+}
+
+/* Says when the ground ahead climbs or falls away in steps.
+
+   This is the other half of the obstacle fix, and it is owed. That fix
+   lifted the probe by the engine's step height so a stair riser would stop
+   being announced as a wall - which was right, and which left stairs
+   silent altogether. A sighted player sees a staircase from the far side
+   of a room; without this, someone playing by ear finds one by walking
+   into it.
+
+   It measures rather than looks: flat ground a short way ahead, at a
+   height the player could step to, is a step; two of those going the same
+   way is a flight. Nothing else is claimed - a slope comes back as nothing
+   at all rather than as stairs. */
+static void ETA_NarrateStairsAhead( void ) {
+	static int lastSpoken = -1;
+	static int lastTime;
+
+	const playerState_t *ps;
+	vec3_t angles, forward;
+	float footZ, first, second, speedSq;
+	ETA_Stairs kind;
+
+	if ( !cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer ) {
+		lastSpoken = -1;
+		return;
+	}
+
+	ps = &cg.predictedPlayerState;
+
+	/* Only from the ground: in the air every reading is about wherever
+	   the player has fallen to by the time it is spoken. */
+	if ( ps->groundEntityNum == ENTITYNUM_NONE ) {
+		lastSpoken = -1;
+		return;
+	}
+
+	/* A ladder is not a staircase and swimming is not walking; both have
+	   their own narration and neither wants this one over the top. */
+	if ( ( ps->pm_flags & PMF_LADDER ) || ETA_WaterLevel() > 1 ) {
+		lastSpoken = -1;
+		return;
+	}
+
+	speedSq = ps->velocity[0] * ps->velocity[0] + ps->velocity[1] * ps->velocity[1];
+
+	if ( speedSq > 40.0f * 40.0f ) {
+		forward[0] = ps->velocity[0];
+		forward[1] = ps->velocity[1];
+		forward[2] = 0.0f;
+		VectorNormalize( forward );
+	} else {
+		angles[PITCH] = 0.0f;
+		angles[YAW] = cg.refdefViewAngles[YAW];
+		angles[ROLL] = 0.0f;
+		AngleVectors( angles, forward, NULL, NULL );
+	}
+
+	footZ = ps->origin[2] + ps->mins[2];
+
+	if ( !ETA_GroundRiseAhead( ps, forward, ETA_STAIR_NEAR, footZ, &first ) ) {
+		lastSpoken = -1;
+		return;
+	}
+
+	if ( first > ETA_STAIR_MIN_RISE ) {
+		kind = ETA_STAIRS_STEP_UP;
+	} else if ( first < -ETA_STAIR_MIN_RISE ) {
+		kind = ETA_STAIRS_STEP_DOWN;
+	} else {
+		/* Level ground. Forgetting what was last said here is what lets
+		   walking away from a staircase and back be news again. */
+		lastSpoken = -1;
+		return;
+	}
+
+	/* The second tread is measured from the first, not from the player:
+	   three steps up is well past anything a trace from foot height could
+	   see, so measuring both against the feet would report every staircase
+	   as a single step. What is being asked is only whether the ground
+	   carries on the same way, which holds whatever the run of the steps -
+	   and that differs from map to map. */
+	if ( ETA_GroundRiseAhead( ps, forward, ETA_STAIR_FAR, footZ + first, &second ) ) {
+		if ( kind == ETA_STAIRS_STEP_UP && second > ETA_STAIR_MIN_RISE ) {
+			kind = ETA_STAIRS_UP;
+		} else if ( kind == ETA_STAIRS_STEP_DOWN && second < -ETA_STAIR_MIN_RISE ) {
+			kind = ETA_STAIRS_DOWN;
+		}
+	}
+
+	if ( (int)kind == lastSpoken || cg.time - lastTime < ETA_STAIR_MIN_INTERVAL ) {
+		return;
+	}
+
+	lastSpoken = (int)kind;
+	lastTime = cg.time;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakStairs( kind );
+	ETA_Speech_EndReport();
+}
+
 static void ETA_NarrateStanceChange( void ) {
 	static ETA_Stance spoken = (ETA_Stance)-1;
 	const playerState_t *ps;
@@ -5500,6 +5656,9 @@ void CG_DrawActive( stereoFrame_t stereoView ) {
 	   report. */
 	ETA_NarrateObstacleAhead();
 
+	/* Scenery too, and before the objective for the same reason. */
+	ETA_NarrateStairsAhead();
+
 	ETA_NarrateObjectiveApproach();
 
 	/* Last, so everything above still sees the previous frame's totals. */
