+/*
+ * How far ahead the player's own body is tested for an obstacle. Just
+ * over a stride: long enough to arrive slightly before the player does,
+ * short enough to describe what is stopping them rather than what is
+ * across the room.
+ */
+#define ETA_OBSTACLE_PROBE_DISTANCE 48.0f
+
+/*
+ * Says what is blocking the way, and only when something is.
+ *
+ * This used to trace a ray from the eye and announce whatever it hit
+ * within a couple of metres. A tester reported it saying "wall, 0
+ * metres" while they walked on perfectly well, and they were right to
+ * call it noise: a ray from the eye answers "what am I looking at",
+ * which is a different question from "what is stopping me".
+ *
+ * Two false positives, both common. Stairs: every step has an upright
+ * face, so a ray sees a wall on every staircase in the game while the
+ * player climbs it without difficulty. And any wall beside a corridor,
+ * which is a wall you are looking at rather than walking into.
+ *
+ * So the probe is now the player's own bounding box, pushed forward the
+ * way the engine pushes it, with its base lifted by the engine's own
+ * step height. If the box can move, nothing is in the way and nothing is
+ * said - a stair riser passes under it exactly as the player's feet do.
+ * If the box cannot move, neither can the player, which is the only
+ * moment this is worth saying.
+ *
+ * The distance goes too: against something the player is up against it
+ * is always nearly zero, and "0 metres" was the part that read as broken.
+ */
 static void ETA_NarrateObstacleAhead( void ) {
 	static char lastDescription[128];
 	static int lastTime;
 	char description[128];
+
+	playerState_t *ps;
 	trace_t trace;
-	int distance;
+	vec3_t angles, forward, start, end, mins, maxs;
 
 	if ( !cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer ) {
 		lastDescription[0] = '\0';
@@ -5252,25 +5296,54 @@ static void ETA_NarrateObstacleAhead( void ) {
 		return;
 	}
 
-	if ( !ETA_DescribeLookAhead( description, sizeof( description ), &distance, ETA_LOOK_AHEAD_RANGE_ON_FOOT, &trace ) ) {
+	ps = &cg.predictedPlayerState;
+
+	/* In the air there is nothing to be blocked from doing. */
+	if ( ps->groundEntityNum == ENTITYNUM_NONE ) {
+		lastDescription[0] = '\0';
 		return;
 	}
 
-	/* Looking down at the floor is not an obstacle, and at this range it
-	   is what the view meets every time the player glances at their feet.
-	   What is underfoot is the footstep narration's job. */
-	if ( trace.plane.normal[2] > 0.7f ) {
+	/* Flattened: looking down at your boots must not aim the probe into
+	   the floor, and looking up must not aim it over the obstacle. */
+	angles[PITCH] = 0.0f;
+	angles[YAW] = cg.refdefViewAngles[YAW];
+	angles[ROLL] = 0.0f;
+	AngleVectors( angles, forward, NULL, NULL );
+
+	/* The player's own box - crouched when they are crouched - with the
+	   base raised by one step. That lift is the whole fix: it is what the
+	   engine gives the player to get up a stair, so anything fitting
+	   under it is not an obstacle and must not be announced as one. */
+	VectorCopy( ps->mins, mins );
+	VectorCopy( ps->maxs, maxs );
+	mins[2] += ETA_DROP_STEP_UNITS;
+
+	if ( mins[2] >= maxs[2] ) {
+		/* Prone, or some other posture shorter than a step. */
 		lastDescription[0] = '\0';
 		return;
 	}
 
-	/* Nothing close enough to bump into. Clearing the memory here is what
