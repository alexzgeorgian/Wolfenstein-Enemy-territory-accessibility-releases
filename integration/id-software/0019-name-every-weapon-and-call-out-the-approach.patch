diff --git a/src/cgame/cg_weapons.c b/src/cgame/cg_weapons.c
index f08fbee..ce4e183 100644
--- a/src/cgame/cg_weapons.c
+++ b/src/cgame/cg_weapons.c
@@ -35,6 +35,54 @@ If you have questions concerning this license or the applicable additional terms
 
 #include "cg_local.h"
 
+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Names the mod supplies where the engine's own string is an internal
+ * token rather than something to say out loud.
+ *
+ * This release has no weapon description field, so the item's pickup name
+ * is the only name there is, and for almost everything it is a good one -
+ * "Grenade", "Binoculars", "Landmine", "Smoke Bomb". These two are the
+ * exceptions:
+ *
+ *   WP_MEDKIT       pickup_name is "medicheal"
+ *   WP_SMOKE_MARKER pickup_name is "smokeGrenade"
+ *
+ * Both are things a player holds and switches to, so neither can be left
+ * reading out its token. Nothing else belongs here.
+ */
+static const struct {
+	weapon_t weapon;
+	const char *name;
+} eta_weaponNameFallbacks[] = {
+	{ WP_MEDKIT,       "Health pack"  },
+	{ WP_SMOKE_MARKER, "Smoke marker" }
+};
+
+/**
+ * What to call a weapon out loud. Never returns NULL or an empty string:
+ * silence is indistinguishable from the mod being broken.
+ */
+const char *CG_AccessibilityWeaponName( weapon_t weap ) {
+	gitem_t *item;
+	size_t i;
+
+	for ( i = 0; i < sizeof( eta_weaponNameFallbacks ) / sizeof( eta_weaponNameFallbacks[0] ); i++ ) {
+		if ( eta_weaponNameFallbacks[i].weapon == weap ) {
+			return eta_weaponNameFallbacks[i].name;
+		}
+	}
+
+	item = BG_FindItemForWeaponSafe( weap );
+
+	if ( item && item->pickup_name && item->pickup_name[0] ) {
+		return item->pickup_name;
+	}
+
+	return "Weapon";
+}
+#endif
+
 vec3_t ejectBrassCasingOrigin;
 
