 #define STATUSBARHEIGHT 452
@@ -4600,6 +4601,49 @@ void CG_DrawMiscGamemodels( void ) {
  * why standing up from prone is heard as "Crouched" then "Standing" -
  * that is the engine's own behaviour, not an artifact of this narration.
  */
+/**
+ * Calls out the distance to the objective as the player closes on it.
+ *
+ * The on-demand report answers "how far is it" when asked. This answers
+ * "am I getting there", which is the question a player actually has while
+ * walking - and which otherwise takes two key presses and two remembered
+ * numbers to answer.
+ *
+ * The milestones and their hysteresis live in the shared library
+ * (ETA_NavigationSystem_UpdateApproach), so both integrations announce at
+ * the same points; this only supplies the distance and says when the
+ * target changed. Reset on a change of objective because distance to a
+ * different objective is not progress toward this one.
+ */
+static void ETA_NarrateObjectiveApproach( void ) {
+	static int lastEntNum = -1;
+	const playerState_t *ps;
+	etaObjective_t objective;
+
+	if ( !cg.snap || !eta_objectiveCallouts.integer ) {
+		return;
+	}
+
+	ps = &cg.predictedPlayerState;
+
+	if ( ps->pm_type != PM_NORMAL ) {
+		return;
+	}
+
+	if ( !ETA_CurrentObjective( CG_LimboPanel_GetRealTeam(), ps->origin, &objective ) ) {
+		lastEntNum = -1;
+		ETA_NavigationSystem_ResetApproach();
+		return;
+	}
+
+	if ( objective.entityNum != lastEntNum ) {
+		lastEntNum = objective.entityNum;
+		ETA_NavigationSystem_ResetApproach();
+	}
+
+	ETA_NavigationSystem_UpdateApproach( (int)( Distance( ps->origin, objective.origin ) * ETA_QU_TO_METERS ) );
+}
+
