+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Narrates a newly shown popup/confirm dialog by reading every static
+ * text item it declares (its title plus any body labels), in declaration
+ * order. This relies on the SUBWINDOW/SUBWINDOWBLACK/LABEL/LABELWHITE .menu
+ * macros (etmain/ui/menumacros.h) always emitting ITEM_TYPE_TEXT decoration
+ * items with a literal text string - true of every popup built with them -
+ * but not guaranteed for a hand-rolled popup that doesn't use those macros.
+ */
+static void ETA_NarrateConfirmDialog( menuDef_t *menu ) {
+	char text[ETA_MAX_MENU_TEXT_LENGTH + 1];
+	int i;
+
+	text[0] = '\0';
+
+	for ( i = 0; i < menu->itemCount; i++ ) {
+		itemDef_t *item = menu->items[i];
+
+		if ( item->type == ITEM_TYPE_TEXT && item->text ) {
+			if ( text[0] != '\0' ) {
+				Q_strcat( text, sizeof( text ), " " );
+			}
+			Q_strcat( text, sizeof( text ), item->text );
+		}
+	}
+
+	if ( text[0] != '\0' ) {
+		ETA_MenuNarrator_OnConfirmDialogShown( text );
+	}
+}
+#endif
+
