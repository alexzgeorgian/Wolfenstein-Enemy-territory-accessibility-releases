 }
 
+/**
+ * What to call each of the engine's footstep types out loud.
+ *
+ * Indexed by the footstep type itself, so the word and the sound cannot
+ * drift apart: these are the values BG_FootstepForSurface derives from
+ * the surface flags and the ones cgs.media.footsteps is indexed by,
+ * which is why FOOTSTEP_NORMAL is "Stone" - the engine loads stone1.wav
+ * through stone4.wav for it.
+ *
+ * FOOTSTEP_TOTAL is not here and never reaches this: it is the engine's
+ * marker for a surface that makes no footstep sound at all, and a
+ * surface a sighted player cannot hear is not one to announce.
+ */
+static const char *const eta_footstepNames[FOOTSTEP_TOTAL] = {
+	"Stone",    // FOOTSTEP_NORMAL
+	"Metal",    // FOOTSTEP_METAL
+	"Wood",     // FOOTSTEP_WOOD
+	"Grass",    // FOOTSTEP_GRASS
+	"Gravel",   // FOOTSTEP_GRAVEL
+	"Water",    // FOOTSTEP_SPLASH
+	"Roof",     // FOOTSTEP_ROOF
+	"Snow",     // FOOTSTEP_SNOW
+	"Carpet"    // FOOTSTEP_CARPET
+};
+
+/**
+ * Says what the player is walking on, when it changes.
+ *
+ * Without binoculars or a scoped weapon - which is most classes, most of
+ * the time - the mod had nothing at all to say about the surroundings,
+ * and the ground is the part of them that is always underfoot.
+ *
+ * Driven by the footstep event rather than a trace of our own, so the
+ * word spoken is the surface the engine just played a footstep sound
+ * for. They cannot disagree.
+ */
+static void ETA_NarrateFooting( int footstep ) {
+	static int spoken = -1;
+
+	if ( !eta_environmentCallouts.integer ) {
+		spoken = -1;
+		return;
+	}
+
+	if ( footstep < 0 || footstep >= FOOTSTEP_TOTAL ) {
+		return;
+	}
+
+	if ( footstep == spoken ) {
+		return;
+	}
+
+	spoken = footstep;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakFooting( eta_footstepNames[footstep] );
+	ETA_Speech_EndReport();
+}
+
 static void ETA_NarrateItemPickup( int itemNum ) {
 	gitem_t *item = &bg_itemlist[itemNum];
 	char text[256];
@@ -1917,8 +1976,24 @@ void CG_EntityEvent( centity_t *cent, vec3_t position ) {
 		DEBUGNAME( "EV_FOOTSTEP" );
 		if ( es->eventParm != FOOTSTEP_TOTAL ) {
 			if ( es->eventParm ) {
+#ifdef FEATURE_ACCESSIBILITY
+				/* Inside each branch rather than above them, so the type
+				   narrated is the one indexing the sound that plays - the
+				   engine resolves a zero parm to the character's own
+				   default, and reading the parm alone would call every
+				   such step stone. Other players' footsteps are heard,
+				   not walked on, so only the local player's are spoken. */
+				if ( es->number == cg.snap->ps.clientNum ) {
+					ETA_NarrateFooting( es->eventParm );
+				}
+#endif
 				CG_StartFootStepSound( classInfo, es, cgs.media.footsteps[ es->eventParm ][footstepcnt] );
 			} else {
+#ifdef FEATURE_ACCESSIBILITY
+				if ( es->number == cg.snap->ps.clientNum ) {
+					ETA_NarrateFooting( character->animModelInfo->footsteps );
+				}
+#endif
 				CG_StartFootStepSound( classInfo, es, cgs.media.footsteps[ character->animModelInfo->footsteps ][footstepcnt] );
 			}
 		}
