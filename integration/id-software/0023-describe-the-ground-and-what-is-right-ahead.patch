+#define ETA_OBSTACLE_MIN_INTERVAL 3000
+
+/**
+ * Says when the player is about to walk into something.
+ *
+ * The binoculars and the scope answer "what is in front of me" at range,
+ * which is what they are for. Most classes, most of the time, have no
+ * such key, and for them the question is smaller and more urgent: is
+ * there a wall right there.
+ *
+ * The same probe as the zoomed one, at arm's length, and it stands down
+ * while zoomed - that narration is already answering the same question
+ * at the range the player asked for.
+ */
+static void ETA_NarrateObstacleAhead( void ) {
+	static char lastDescription[128];
+	static int lastTime;
+	char description[128];
+	trace_t trace;
+	int distance;
+
+	if ( !cg.snap || cg.snap->ps.pm_type != PM_NORMAL || !eta_environmentCallouts.integer ) {
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	if ( cg.zoomed || cg.zoomedBinoc ) {
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	if ( !ETA_DescribeLookAhead( description, sizeof( description ), &distance, ETA_LOOK_AHEAD_RANGE_ON_FOOT, &trace ) ) {
+		return;
+	}
+
+	/* Looking down at the floor is not an obstacle, and at this range it
+	   is what the view meets every time the player glances at their feet.
+	   What is underfoot is the footstep narration's job. */
+	if ( trace.plane.normal[2] > 0.7f ) {
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	/* Nothing close enough to bump into. Clearing the memory here is what
+	   makes stepping away and back a fresh announcement. */
+	if ( distance < 0 ) {
+		lastDescription[0] = '\0';
+		return;
+	}
+
+	if ( !Q_stricmp( description, lastDescription ) && cg.time - lastTime < ETA_OBSTACLE_MIN_INTERVAL ) {
+		return;
+	}
+
+	Q_strncpyz( lastDescription, description, sizeof( lastDescription ) );
+	lastTime = cg.time;
+
+	ETA_Speech_BeginReport();
+	ETA_HudNarrator_SpeakLookAhead( description, distance );
+	ETA_Speech_EndReport();
+}
