+
 int CG_DrawField( int x, int y, int width, int value, int charWidth, int charHeight, qboolean dodrawpic, qboolean leftAlign );      // NERVE - SMF
 
 /*void CG_FitTextToWidth( char* instr, int w, int size) {
@@ -369,6 +373,31 @@ void CG_DrawPlayerWeaponIcon( rectDef_t *rect, qboolean drawHighlighted, int align, vec4_t *refcolor ) {
 
 #define CURSORHINT_SCALE    10
 
+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Plays the interaction audio cue when a real, currently-visible cursor
+ * hint icon first appears or changes to a different icon, and resets that
+ * tracking once the hint stops being visible. "Currently visible" here
+ * means exactly what CG_DrawCursorhint itself just resolved a few lines
+ * above each call site - a non-zero icon (HINT_NONE/HINT_FORCENONE both
+ * resolve to icon 0, as does a hint whose shader failed to load) and a
+ * non-NULL CG_FadeColor(cg.cursorHintTime, cg.cursorHintFade) (the same
+ * fade window the icon itself is drawn with) - so the cue never fires for
+ * a hint the player can't actually see.
+ */
+static void ETA_NarrateInteractionHint( qboolean active ) {
+	static qboolean wasActive = qfalse;
+	static int lastIcon = HINT_NONE;
+
+	if ( active && ( !wasActive || cg.cursorHintIcon != lastIcon ) ) {
+		ETA_AudioCueSystem_PlayInteractionCue();
+		lastIcon = cg.cursorHintIcon;
+	}
+
+	wasActive = active;
+}
+#endif
+
 /*
 ==============
 CG_DrawCursorHints
@@ -390,6 +419,9 @@ void CG_DrawCursorhint( rectDef_t *rect ) {
 	qboolean yellowbar = qfalse;
 
 	if ( !cg_cursorHints.integer ) {
+#ifdef FEATURE_ACCESSIBILITY
+		ETA_NarrateInteractionHint( qfalse );
+#endif
 		return;
 	}
 
@@ -555,6 +587,9 @@ void CG_DrawCursorhint( rectDef_t *rect ) {
 
 
 	if ( !icon ) {
+#ifdef FEATURE_ACCESSIBILITY
+		ETA_NarrateInteractionHint( qfalse );
+#endif
 		return;
 	}
 
@@ -563,9 +598,16 @@ void CG_DrawCursorhint( rectDef_t *rect ) {
 	color = CG_FadeColor( cg.cursorHintTime, cg.cursorHintFade );
 	if ( !color ) {
 		trap_R_SetColor( NULL );
+#ifdef FEATURE_ACCESSIBILITY
+		ETA_NarrateInteractionHint( qfalse );
+#endif
 		return;
 	}
 
+#ifdef FEATURE_ACCESSIBILITY
+	ETA_NarrateInteractionHint( qtrue );
+#endif
+
 	if ( cg_cursorHints.integer == 3 ) {
 		color[3] *= 0.5 + 0.5 * sin( (float)cg.time / 150.0 );
 	}
