diff --git a/src/cgame/cg_playerstate.c b/src/cgame/cg_playerstate.c
index f1f7f53..88293ba 100644
--- a/src/cgame/cg_playerstate.c
+++ b/src/cgame/cg_playerstate.c
@@ -36,6 +36,7 @@ If you have questions concerning this li
 #include "cg_local.h"
 
 #ifdef FEATURE_ACCESSIBILITY
+#include "audio/audio_cue_system.h"
 #include "hud/hud_narrator.h"
 #endif
 
@@ -188,6 +189,25 @@ void CG_DamageFeedback( int yawByte, int pitchByte, int damage ) {
 		left = DotProduct( dir, cg.refdef.viewaxis[1] );
 		up = DotProduct( dir, cg.refdef.viewaxis[2] );
 
+#ifdef FEATURE_ACCESSIBILITY
+		/**
+		 * front/left here are the same view-relative components the
+		 * on-screen damage blood-blob (CG_DamageBlendBlob, cg_view.c) uses
+		 * for its screen-space offset (vd->damageX/damageY below) - front
+		 * and left are already resolved through cg.refdef.viewaxis, so this
+		 * is the player's current view rotation baked in, not the raw
+		 * network-decoded world yaw. atan2(-left, front) turns that same
+		 * pair into a compass bearing using the same convention as the
+		 * navigation/objective cues elsewhere in this integration: 0 =
+		 * front, 90 = right, 180 = behind, 270 = left (left is positive
+		 * toward the left, so -left is positive toward the right).
+		 */
+		{
+			int directionDegrees = (int)AngleNormalize360( RAD2DEG( atan2( -left, front ) ) );
+			ETA_AudioCueSystem_PlayDamageDirectionCue( directionDegrees );
+		}
+#endif
+
 		dir[0] = front;
 		dir[1] = left;
 		dir[2] = 0;
@@ -410,6 +430,14 @@ void CG_CheckLocalSounds( playerState_t *ps, playerState_t *ops ) {
 			CG_PainEvent( &cg.predictedPlayerEntity, ps->stats[STAT_HEALTH], qfalse );
 
 			cg.painTime = cg.time;
+
+#ifdef FEATURE_ACCESSIBILITY
+			// same trigger as the pain sound above, but only while
+			// critically low, so routine chip damage doesn't cue every hit
+			if ( ps->stats[STAT_HEALTH] <= 25 ) {
+				ETA_AudioCueSystem_PlayLowHealthCue();
+			}
+#endif
 		}
 	}
 
