+/**
+ * Collects the display names of team's objectives into names, up to
+ * maxNames of them, and returns how many were filled in. The pointers are
+ * into cgs.oidInfo[], which lives as long as the map does.
+ *
+ * Same list and same team filter as ETA_NearestObjectiveOrigin above, and
+ * the names are resolved the way CG_DrawMapEntity resolves them for the
+ * command map's own hover label (`name = oidInfo->name`) - note it indexes
+ * cgs.oidInfo[] differently per type, through the entity's modelindex2 for
+ * the constructible/destructible types but through mEnt->data directly for
+ * tanks, so both are mirrored rather than unified. Entries whose oidInfo
+ * has no name are skipped: an objective the client has no name for yet is
+ * nothing to say out loud.
+ *
+ * This is deliberately the whole list rather than one "main" objective:
+ * this release has no such concept (see the README), so the honest spoken
+ * equivalent of the command map is every objective it would draw.
+ */
+int ETA_TeamObjectiveNames( team_t team, const char **names, int maxNames ) {
+	int i;
+	int count = 0;
+
+	for ( i = 0; i < mapEntityCount && count < maxNames; i++ ) {
+		mapEntityData_t *mEnt = &mapEntities[i];
+		int oid;
+
+		if ( mEnt->team != team ) {
+			continue;
+		}
+
+		// mEnt->data is server-supplied, so range-check it before indexing
+		if ( mEnt->data < 0 || mEnt->data >= MAX_GENTITIES ) {
+			continue;
+		}
+
+		if ( mEnt->type == ME_CONSTRUCT || mEnt->type == ME_DESTRUCT || mEnt->type == ME_DESTRUCT_2 ) {
+			oid = cg_entities[mEnt->data].currentState.modelindex2;
+		} else if ( mEnt->type == ME_TANK || mEnt->type == ME_TANK_DEAD ) {
+			oid = mEnt->data;
+		} else {
+			continue;
+		}
+
+		if ( oid < 0 || oid >= MAX_OID_TRIGGERS ) {
+			continue;
+		}
+
+		if ( !cgs.oidInfo[oid].name[0] ) {
+			continue;
+		}
+
+		names[count++] = cgs.oidInfo[oid].name;
+	}
+
+	return count;
+}
 #endif
 
