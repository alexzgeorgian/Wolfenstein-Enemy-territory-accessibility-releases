+/**
+ * Describes whatever the player's view runs into.
+ *
+ * The binoculars and the scope are for looking at something specific and
+ * finding out what it is. A trace along the view is the only honest way
+ * to answer that: it reports what the engine says is there.
+ *
+ * Orientation comes from the impact plane rather than the surface, which
+ * is what makes "wooden wall" and "gravel ground" come out right without
+ * a table of special cases.
+ */
+static qboolean ETA_DescribeLookAhead( char *out, size_t outSize, int *distanceMeters ) {
+	trace_t trace;
+	vec3_t start, end, forward;
+	int entityNum;
+
+	if ( !cg.snap ) {
+		return qfalse;
+	}
+
+	VectorCopy( cg.refdef.vieworg, start );
+	AngleVectors( cg.refdefViewAngles, forward, NULL, NULL );
+	VectorMA( start, ETA_LOOK_AHEAD_RANGE, forward, end );
+
+	CG_Trace( &trace, start, NULL, NULL, end, cg.snap->ps.clientNum, MASK_SHOT );
+
+	if ( trace.fraction == 1.0f ) {
+		Q_strncpyz( out, "Nothing in range", outSize );
+		*distanceMeters = -1;
+		return qtrue;
+	}
+
+	*distanceMeters = (int)( Distance( start, trace.endpos ) * ETA_QU_TO_METERS );
+
+	/* The skybox is not a thing you can walk into. */
+	if ( trace.surfaceFlags & SURF_SKY ) {
+		Q_strncpyz( out, "Open sky", outSize );
+		*distanceMeters = -1;
+		return qtrue;
+	}
+
+	entityNum = trace.entityNum;
+
+	if ( entityNum < MAX_CLIENTS ) {
+		clientInfo_t *ci = &cgs.clientinfo[entityNum];
+
+		Q_strncpyz( out, ci->infoValid && ci->name[0] ? ci->name : "Player", outSize );
+		Q_strcat( out, outSize,
+				  ci->team == cgs.clientinfo[cg.clientNum].team ? ", teammate" : ", enemy" );
+		return qtrue;
+	}
+
+	if ( entityNum != ENTITYNUM_WORLD ) {
+		switch ( cg_entities[entityNum].currentState.eType ) {
+		case ET_MOVER:
+			Q_strncpyz( out, "Door", outSize );
+			return qtrue;
+		case ET_EXPLOSIVE:
+			Q_strncpyz( out, "Explosive", outSize );
+			return qtrue;
+		case ET_ITEM:
+			Q_strncpyz( out, "Item", outSize );
+			return qtrue;
+		default:
+			Q_strncpyz( out, "Object", outSize );
+			return qtrue;
+		}
+	}
+
+	{
+		const char *material = ETA_SurfaceMaterial( trace.surfaceFlags );
+		const char *kind;
+
+		if ( trace.surfaceFlags & SURF_LADDER ) {
+			kind = "ladder";
+		} else if ( trace.plane.normal[2] > 0.7f ) {
+			kind = "ground";
+		} else if ( trace.plane.normal[2] < -0.7f ) {
+			kind = "ceiling";
+		} else {
+			kind = "wall";
+		}
+
+		if ( material ) {
+			Com_sprintf( out, outSize, "%s %s", material, kind );
+		} else {
+			Com_sprintf( out, outSize, "%c%s", toupper( kind[0] ), kind + 1 );
+		}
+	}
+
+	return qtrue;
+}
