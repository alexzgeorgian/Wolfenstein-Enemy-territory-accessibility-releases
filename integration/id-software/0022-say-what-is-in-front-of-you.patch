+/**
+ * Names the material of a surface, from the engine's own flags - the same
+ * ones it uses to pick footstep and impact sounds, so this is the game's
+ * idea of what a surface is made of rather than a guess of ours. Returns
+ * NULL when the engine does not say.
+ */
+static const char *ETA_SurfaceMaterial( int surfaceFlags ) {
+	if ( surfaceFlags & SURF_METAL ) {
+		return "Metal";
+	}
+	if ( surfaceFlags & SURF_WOOD ) {
+		return "Wooden";
+	}
+	if ( surfaceFlags & SURF_GLASS ) {
+		return "Glass";
+	}
+	if ( surfaceFlags & SURF_GRASS ) {
+		return "Grass";
+	}
+	if ( surfaceFlags & SURF_GRAVEL ) {
+		return "Gravel";
+	}
+	if ( surfaceFlags & SURF_SNOW ) {
+		return "Snow";
+	}
+	if ( surfaceFlags & SURF_CARPET ) {
+		return "Carpet";
+	}
+	if ( surfaceFlags & SURF_RUBBLE ) {
+		return "Rubble";
+	}
+
+	return NULL;
+}
