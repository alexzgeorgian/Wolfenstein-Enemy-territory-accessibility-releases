diff --git a/src/game/bg_misc.c b/src/game/bg_misc.c
index 4d83436..d0b0490 100644
--- a/src/game/bg_misc.c
+++ b/src/game/bg_misc.c
@@ -2594,6 +2594,28 @@ gitem_t *BG_FindItemForWeapon( weapon_t weapon ) {
 	return NULL;
 }
 
+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Same lookup as BG_FindItemForWeapon, but returns NULL instead of
+ * Com_Error(ERR_DROP, ...) when weapon has no matching IT_WEAPON entry in
+ * bg_itemlist. Needed because ps->weapon isn't guaranteed to only ever be
+ * a value BG_FindItemForWeapon can resolve - narration code calling it
+ * with an unresolvable value would otherwise fatally drop the client,
+ * an unacceptable failure mode for an accessibility feature.
+ */
+gitem_t *BG_FindItemForWeaponSafe( weapon_t weapon ) {
+	gitem_t *it;
+
+	for ( it = bg_itemlist + 1 ; it->classname ; it++ ) {
+		if ( it->giType == IT_WEAPON && it->giTag == weapon ) {
+			return it;
+		}
+	}
+
+	return NULL;
+}
+#endif
