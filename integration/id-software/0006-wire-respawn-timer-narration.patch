+#ifdef FEATURE_ACCESSIBILITY
+/**
+ * Narrates the same reinforcement countdown CG_DrawLimboMessage (below)
+ * is about to draw as "Reinforcements deploy in %d seconds.", via
+ * CG_CalculateReinfTime(qfalse) - the exact same call the on-screen text
+ * uses, so what's spoken always matches what's on screen. Like the
+ * on-screen text, stays silent once persistant[PERS_RESPAWNS_LEFT] hits 0
+ * ("No more reinforcements this round.").
+ *
+ * The countdown recomputes fresh from elapsed time every frame rather
+ * than being driven by a discrete state transition, so this does its own
+ * edge detection with a static local, narrating only when the integer
+ * actually changes - the same approach ET: Legacy's own respawn-timer
+ * patch uses for its equivalent HUD component.
+ */
+static void ETA_NarrateRespawnTimer( playerState_t *ps ) {
+	static int lastNarratedSeconds = -1;
+	int seconds;
+
+	if ( ps->persistant[PERS_RESPAWNS_LEFT] == 0 ) {
+		lastNarratedSeconds = -1;
+		return;
+	}
+
+	seconds = CG_CalculateReinfTime( qfalse );
+
+	if ( seconds != lastNarratedSeconds ) {
+		ETA_HudNarrator_SpeakRespawn( seconds );
+		lastNarratedSeconds = seconds;
+	}
+}
+#endif
