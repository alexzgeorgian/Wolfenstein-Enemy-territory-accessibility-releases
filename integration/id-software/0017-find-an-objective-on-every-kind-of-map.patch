+static qboolean ETA_MapObjectiveUsable( int oidIndex ) {
+	if ( oidIndex < 0 || oidIndex >= MAX_OID_TRIGGERS ) {
+		return qfalse;
+	}
+
+	if ( cgs.oidInfo[oidIndex].spawnflags & ( 1 << 5 ) ) {
+		return qfalse;
+	}
+
+	return qtrue;
